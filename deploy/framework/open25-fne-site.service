[Unit]
Description=Open25 FNE - Site Controller

[Service]
Type=simple
WorkingDirectory=%h/open25-fne
ExecStart=%h/open25-fne/open25-fne site --config %h/.local/state/open25-fne/site/service.json
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
