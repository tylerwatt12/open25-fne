diff --git a/src/bridge/UDPCallDeadline.h b/src/bridge/UDPCallDeadline.h
new file mode 100644
index 0000000..ffed50b
--- /dev/null
+++ b/src/bridge/UDPCallDeadline.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Monotonic UDP PCM inactivity deadline. No elapsed-tick attribution or I/O. */
+#ifndef __UDP_CALL_DEADLINE_H__
+#define __UDP_CALL_DEADLINE_H__
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+class UDPCallDeadline {
+public:
+    struct Expiry {
+        uint64_t count = 0U;
+        uint64_t atMs = 0U;
+        uint64_t acceptedAgeMs = 0U;
+        uint64_t enqueuedAgeMs = 0U;
+        uint64_t queuedFrames = 0U;
+        uint8_t p25N = 0U;
+    };
+    struct State {
+        uint64_t queuedFrames = 0U;
+        uint8_t p25N = 0U;
+    };
+
+    explicit UDPCallDeadline(uint32_t timeoutMs = 180U) :
+        m_timeoutMs(timeoutMs), m_acceptedMs(0U), m_enqueuedMs(0U), m_running(false) {}
+
+    static uint64_t nowMs() {
+        return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+    }
+    // Configuration happens before threads start; the atomic also makes diagnostic reads safe.
+    void setTimeout(uint32_t timeoutMs) { m_timeoutMs.store(timeoutMs); stop(); }
+    void noteEnqueue() { noteEnqueueAt(nowMs()); }
+    void noteEnqueueAt(uint64_t now) { m_enqueuedMs.store(now); }
+    // The bridge calls start/stop while holding its shared audio mutex.
+    void start() { startAt(nowMs()); }
+    void startAt(uint64_t now) { m_acceptedMs.store(now); m_running.store(m_timeoutMs.load() != 0U); }
+    void stop() { m_running.store(false); }
+    bool isRunning() const { return m_running.load(); }
+    bool hasExpiredAt(uint64_t now) const {
+        if (!m_running.load()) return false;
+        const uint64_t accepted = m_acceptedMs.load();
+        const uint32_t timeout = m_timeoutMs.load();
+        return timeout != 0U && now >= accepted && now - accepted >= timeout;
+    }
+
+    // Acquiring the same lock used by the PCM encoder is part of this operation.
+    // Read time and recheck only AFTER ownership; an earlier speculative check
+    // must never terminate a frame that was accepted while we waited.
+    template<class Now, class Metadata, class End>
+    bool expireIfIdle(std::mutex& audioMutex, Now now, Metadata metadata, End end) {
+        std::lock_guard<std::mutex> audioLock(audioMutex);
+        const uint64_t at = now();
+        if (!hasExpiredAt(at)) return false;
+        const State state = metadata();
+        const uint64_t accepted = m_acceptedMs.load();
+        const uint64_t enqueued = m_enqueuedMs.load();
+        {
+            std::lock_guard<std::mutex> diagnosticsLock(m_diagnosticsMutex);
+            ++m_expiry.count;
+            m_expiry.atMs = at;
+            m_expiry.acceptedAgeMs = at >= accepted ? at - accepted : 0U;
+            m_expiry.enqueuedAgeMs = at >= enqueued ? at - enqueued : 0U;
+            m_expiry.queuedFrames = state.queuedFrames;
+            m_expiry.p25N = state.p25N;
+        }
+        stop();
+        end();
+        return true;
+    }
+    Expiry expiry() const {
+        std::lock_guard<std::mutex> lock(m_diagnosticsMutex);
+        return m_expiry;
+    }
+
+private:
+    std::atomic<uint32_t> m_timeoutMs;
+    std::atomic<uint64_t> m_acceptedMs;
+    std::atomic<uint64_t> m_enqueuedMs;
+    std::atomic<bool> m_running;
+    mutable std::mutex m_diagnosticsMutex;
+    Expiry m_expiry;
+};
+#endif
diff --git a/tests/UDPCallDeadline_Tests.cpp b/tests/UDPCallDeadline_Tests.cpp
new file mode 100644
index 0000000..e3affd6
--- /dev/null
+++ b/tests/UDPCallDeadline_Tests.cpp
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Actual production deadline/Timer classes; deterministic times, no RF or sockets. */
+#include "bridge/UDPCallDeadline.h"
+#include "common/Timer.h"
+#include <catch2/catch_test_macros.hpp>
+#include <atomic>
+#include <future>
+#include <mutex>
+#include <thread>
+
+namespace {
+UDPCallDeadline::State emptyState() { return {}; }
+}
+
+TEST_CASE("UDP monotonic deadline excludes time before the most recent PCM acceptance", "[bridge][udp-deadline]") {
+    // Old production algorithm: watchdog baseline t=5; its delayed tick is t=200.
+    // Worker accepts a new frame t=195, but the entire old interval is charged.
+    Timer oldTimer(1000U, 0U, 180U);
+    oldTimer.start();
+    oldTimer.clock(5U);
+    oldTimer.start();
+    oldTimer.clock(195U);
+    REQUIRE(oldTimer.hasExpired());
+
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned ends = 0U;
+    deadline.startAt(0U);
+    deadline.startAt(195U);
+    REQUIRE_FALSE(deadline.hasExpiredAt(200U));
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [] { return 200U; }, emptyState, [&] { ++ends; }));
+    REQUIRE(ends == 0U);
+    REQUIRE(deadline.isRunning());
+}
+
+TEST_CASE("UDP inactivity expires exactly once at the unchanged180ms boundary", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned ends = 0U;
+    deadline.noteEnqueueAt(97U);
+    deadline.startAt(100U);
+    REQUIRE_FALSE(deadline.hasExpiredAt(99U)); // Backward sample must not underflow.
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [] { return 279U; }, emptyState, [&] { ++ends; }));
+    REQUIRE(deadline.expireIfIdle(audio, [] { return 280U; }, [] {
+        UDPCallDeadline::State state; state.queuedFrames = 3U; state.p25N = 17U; return state;
+    }, [&] {
+        auto ownership = std::async(std::launch::async, [&] {
+            if (!audio.try_lock()) return true;
+            audio.unlock(); return false;
+        });
+        REQUIRE(ownership.get()); // Another thread cannot enter the encoder mutex.
+        ++ends;
+        deadline.stop(); // HostBridge::callEnd also stops the deadline: no recursive-lock deadlock.
+    }));
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [] { return 999U; }, emptyState, [&] { ++ends; }));
+    REQUIRE(ends == 1U);
+    const auto snapshot = deadline.expiry();
+    REQUIRE(snapshot.count == 1U);
+    REQUIRE(snapshot.atMs == 280U);
+    REQUIRE(snapshot.acceptedAgeMs == 180U);
+    REQUIRE(snapshot.enqueuedAgeMs == 183U);
+    REQUIRE(snapshot.queuedFrames == 3U);
+    REQUIRE(snapshot.p25N == 17U);
+}
+
+TEST_CASE("UDP watchdog rechecks a fresh frame accepted while waiting for encoder ownership", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    std::atomic<uint64_t> now{300U};
+    unsigned ends = 0U;
+    deadline.startAt(100U); // A speculative pre-lock check would say expired.
+    REQUIRE(deadline.hasExpiredAt(now.load()));
+    std::unique_lock<std::mutex> encoder(audio);
+    std::promise<void> started;
+    auto check = std::async(std::launch::async, [&] {
+        started.set_value();
+        return deadline.expireIfIdle(audio, [&] { return now.load(); }, emptyState, [&] { ++ends; });
+    });
+    started.get_future().wait();
+    deadline.startAt(295U);
+    encoder.unlock();
+    REQUIRE_FALSE(check.get());
+    REQUIRE(ends == 0U);
+    REQUIRE(deadline.isRunning());
+}
+
+TEST_CASE("UDP tail cannot overlap an unfinished encoder or emit a false TDU", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned p25N = 0U, tdus = 0U;
+    std::promise<void> encoding, finish, watching;
+    auto finishFuture = finish.get_future();
+    auto worker = std::async(std::launch::async, [&] {
+        std::lock_guard<std::mutex> lock(audio);
+        deadline.startAt(195U);
+        p25N = 17U; // Encoder is between its LDU2 write and counter increment.
+        encoding.set_value();
+        finishFuture.wait();
+        p25N = 0U;
+    });
+    encoding.get_future().wait();
+    auto watchdog = std::async(std::launch::async, [&] {
+        watching.set_value();
+        return deadline.expireIfIdle(audio, [] { return 200U; }, [&] {
+            UDPCallDeadline::State state; state.p25N = uint8_t(p25N); return state;
+        }, [&] { ++tdus; });
+    });
+    watching.get_future().wait();
+    finish.set_value();
+    worker.get();
+    REQUIRE_FALSE(watchdog.get());
+    REQUIRE(p25N == 0U);
+    REQUIRE(tdus == 0U);
+}
+
+TEST_CASE("Concurrent UDP expiry checks serialize a single call end", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned ends = 0U;
+    deadline.startAt(100U);
+    auto check = [&] { return deadline.expireIfIdle(audio, [] { return 300U; }, emptyState, [&] { ++ends; }); };
+    auto first = std::async(std::launch::async, check);
+    auto second = std::async(std::launch::async, check);
+    const unsigned expired = unsigned(first.get()) + unsigned(second.get());
+    REQUIRE(expired == 1U);
+    REQUIRE(ends == 1U);
+    REQUIRE(deadline.expiry().count == 1U);
+}
+
+TEST_CASE("Continuous20ms PCM frames do not end the call across delayed watchdog schedules", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned tdus = 0U;
+    uint64_t last = 0U;
+    for (uint64_t frame = 0U; frame < 1000U; ++frame) {
+        last = frame * 20U;
+        {
+            std::lock_guard<std::mutex> lock(audio);
+            deadline.noteEnqueueAt(last);
+            deadline.startAt(last);
+        }
+        // Including long intervals between watchdog visits; real frame age is5ms.
+        if (frame % 10U == 0U)
+            REQUIRE_FALSE(deadline.expireIfIdle(audio, [&] { return last + 5U; }, emptyState, [&] { ++tdus; }));
+    }
+    REQUIRE(tdus == 0U);
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [&] { return last + 179U; }, emptyState, [&] { ++tdus; }));
+    REQUIRE(deadline.expireIfIdle(audio, [&] { return last + 180U; }, emptyState, [&] { ++tdus; }));
+    REQUIRE(tdus == 1U);
+}
+
+TEST_CASE("Stopped and disabled UDP deadlines do not end a call", "[bridge][udp-deadline]") {
+    UDPCallDeadline deadline(180U);
+    std::mutex audio;
+    unsigned ends = 0U;
+    deadline.startAt(10U);
+    deadline.stop();
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [] { return 10000U; }, emptyState, [&] { ++ends; }));
+    deadline.setTimeout(0U);
+    deadline.startAt(10U);
+    REQUIRE_FALSE(deadline.isRunning());
+    REQUIRE_FALSE(deadline.expireIfIdle(audio, [] { return 10000U; }, emptyState, [&] { ++ends; }));
+    REQUIRE(ends == 0U);
+}
