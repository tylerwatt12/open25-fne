+bool Data::validRFFrame(const uint8_t* data, uint32_t len)
+{
+    // BAAA-B7.2.4/Fig35: fill variable packets through the next status symbol.
+    // Current modem window: at most512 RF bytes; continuation is unqualified.
+    if (data == nullptr || len < 47U || len > P25_PDU_FRAME_LENGTH_BYTES + 2U)
+        return false;
+    uint8_t stripped[P25_PDU_FRAME_LENGTH_BYTES] = {0U};
+    const uint32_t available = P25Utils::decode(data + 2U, stripped, 0U, (len - 2U) * 8U);
+    if (available < P25_PREAMBLE_LENGTH_BITS + P25_PDU_FEC_LENGTH_BITS) return false;
+    uint8_t encoded[P25_PDU_FEC_LENGTH_BYTES] = {0U};
+    uint8_t decoded[P25_PDU_HEADER_LENGTH_BYTES] = {0U};
+    Utils::getBitRange(stripped, encoded, P25_PREAMBLE_LENGTH_BITS, P25_PDU_FEC_LENGTH_BITS);
+    edac::Trellis trellis;
+    if (!trellis.decode12(encoded, decoded) || !edac::CRC::checkCCITT162(decoded, sizeof(decoded))) return false;
+    data::DataHeader header;
+    if (!header.decode(decoded, true)) return false;
+    const uint32_t count = header.getBlocksToFollow();
+    const uint8_t format = header.getFormat();
+    if (format != PDUFormatType::CONFIRMED && format != PDUFormatType::UNCONFIRMED &&
+        format != PDUFormatType::RSP && format != PDUFormatType::AMBT) return false;
+    if (count >= P25_MAX_PDU_BLOCKS) return false;
+    if (format == PDUFormatType::RSP) {
+        if (count != 0U) return false; // supported response profile is header-only
+    } else {
+        const uint32_t capacity = count * (format == PDUFormatType::CONFIRMED ?
+            P25_PDU_CONFIRMED_DATA_LENGTH_BYTES : P25_PDU_UNCONFIRMED_LENGTH_BYTES);
+        if (capacity < 4U || header.getPadLength() > capacity - 4U ||
+            header.getHeaderOffset() > capacity - 4U - header.getPadLength()) return false;
+        const uint32_t packetLength = capacity - 4U - header.getPadLength();
+        uint32_t secondary = 0U;
+        if (header.getSAP() == PDUSAP::EXT_ADDR)
+            secondary = format == PDUFormatType::CONFIRMED ? 4U : 12U;
+        else if (header.getSAP() == PDUSAP::ENC_USER_DATA || header.getSAP() == PDUSAP::ENC_KMM)
+            secondary = 13U;
+        if (secondary > packetLength) return false;
+    }
+    const uint32_t bits = P25_PREAMBLE_LENGTH_BITS + (count + 1U) * P25_PDU_FEC_LENGTH_BITS;
+    const uint32_t rawBits = 72U * ((bits + 69U) / 70U);
+    if (available < bits || (len - 2U) * 8U < rawBits) return false;
+    // Verify body FEC/CRC in a local assembler before any CC/session effects.
+    if (format == PDUFormatType::RSP) return true;
+    data::Assembler probe;
+    if (!probe.disassemble(encoded, sizeof(encoded), true)) return false;
+    for (uint32_t i = 0U; i < count; ++i) {
+        Utils::getBitRange(stripped, encoded, P25_PREAMBLE_LENGTH_BITS + (i + 1U) * P25_PDU_FEC_LENGTH_BITS,
+            P25_PDU_FEC_LENGTH_BITS);
+        if (!probe.disassemble(encoded, sizeof(encoded))) return false;
+    }
+    return probe.getComplete() && !probe.getPacketCRCFailed() && probe.getUndecodableBlockCount() == 0U;
+}
