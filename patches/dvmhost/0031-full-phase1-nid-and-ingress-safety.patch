new file mode 100644
--- /dev/null
+++ b/src/common/p25/FrameBounds.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Fixed CAI modem spans: BAAA-B7.2/Figs29-34; AABB-B5/Fig5-1.
+#ifndef P25_FRAME_BOUNDS_H
+#define P25_FRAME_BOUNDS_H
+#include "common/p25/P25Defines.h"
+namespace p25 {
+static inline uint32_t fixedRFFrameBytes(uint8_t duid) {
+    using namespace defines;
+    switch (duid) {
+    case DUID::HDU: return P25_HDU_FRAME_LENGTH_BYTES;
+    case DUID::TDU: return P25_TDU_FRAME_LENGTH_BYTES;
+    case DUID::LDU1: case DUID::LDU2: case DUID::VSELP1: case DUID::VSELP2: return P25_LDU_FRAME_LENGTH_BYTES;
+    case DUID::TSDU: return P25_TSDU_FRAME_LENGTH_BYTES;
+    case DUID::TDULC: return P25_TDULC_FRAME_LENGTH_BYTES;
+    default: return 0U; // Variable PDU requires its parsed header/body.
+    }
+}
+}
+#endif
