+TEST_CASE("exact short fixed CAI buffers cannot change active receive state", "[p25][nid-ingress][voice-path]") {
+    VoiceFixture fixture(0x84U,7U); MI first{1U,2U,3U,4U,5U,6U,7U,8U,0U};
+    REQUIRE(fixture.rf(DUID::HDU,first)); fixture.drain();
+    REQUIRE(fixture.rf(DUID::LDU1,first)); fixture.requireLDU(DUID::LDU1,first);
+    NIDReceiveTestAccess::enableControl(*fixture.controller);
+    fixture.controller->setCCRunning(true); fixture.controller->setCCHalted(false);
+    NIDReceiveTestAccess::ageWatchdog(*fixture.controller);
+    const auto before=NIDReceiveTestAccess::state(*fixture.controller);
+    const auto forwarded=fixture.network.outgoing.size();
+    for (auto duid:{DUID::HDU,DUID::TDU,DUID::LDU1,DUID::LDU2,DUID::TSDU,DUID::TDULC}) {
+        const auto required=fixedRFFrameBytes(duid)+2U;
+        std::vector<uint8_t> full(required,0U);full[0]=modem::TAG_DATA;full[1]=1;
+        Sync::addP25Sync(full.data()+2);NID(NAC).encode(full.data()+2,duid);
+        for (unsigned n=0;n<required;++n) {
+            CAPTURE(unsigned(duid),n);
+            std::unique_ptr<uint8_t[]> exact(new uint8_t[n]);std::copy(full.begin(),full.begin()+n,exact.get());
+            REQUIRE_FALSE(fixture.controller->processFrame(exact.get(),n));
+            if(duid==DUID::TSDU) REQUIRE_FALSE(NIDReceiveTestAccess::signaling(*fixture.controller,exact.get(),n));
+            else REQUIRE_FALSE(NIDReceiveTestAccess::voice(*fixture.controller,exact.get(),n));
+            REQUIRE(NIDReceiveTestAccess::state(*fixture.controller)==before);
+        }
+    }
+    REQUIRE(fixture.drain().empty());REQUIRE(fixture.network.outgoing.size()==forwarded);
+    std::array<uint8_t,1> lost{{modem::TAG_LOST}};
+    REQUIRE_FALSE(fixture.controller->processFrame(lost.data(),lost.size())); // legitimate short loss input
+    REQUIRE(fixture.controller->getRFState()==RS_RF_AUDIO);
+}
