+namespace {
+std::vector<uint8_t> pduFrame(uint8_t format,unsigned count,bool badCRC=false,unsigned pad=0,unsigned offset=0,uint8_t sap=PDUSAP::USER_DATA) {
+    p25::data::DataHeader header;header.setFormat(format);header.setMFId(MFG_STANDARD);
+    header.setAckNeeded(false);header.setOutbound(false);header.setFullMessage(true);
+    header.setLLId(Source);header.setSAP(format==PDUFormatType::AMBT?PDUSAP::TRUNK_CTRL:sap);
+    header.setBlocksToFollow(count);header.setPadLength(pad);header.setHeaderOffset(offset);
+    const unsigned encodedBits=112+(count+1)*196,rawBytes=9*((encodedBits+69)/70);
+    const unsigned blockBytes=format==PDUFormatType::CONFIRMED?16:12;
+    std::vector<uint8_t> stripped(rawBytes+1,0U),body(count*blockBytes,0U);
+    std::array<uint8_t,25> encoded{};header.encode(encoded.data());
+    Utils::setBitRange(encoded.data(),stripped.data(),112,196);
+    if(body.size()>=4){for(unsigned i=0;i<body.size()-4;++i)body[i]=uint8_t(i+1);edac::CRC::addCRC32(body.data(),body.size());if(badCRC)body[0]^=1;}
+    for(unsigned i=0;i<count;++i){p25::data::DataBlock block;block.setFormat(format);block.setData(body.data()+i*blockBytes);block.encode(encoded.data());Utils::setBitRange(encoded.data(),stripped.data(),112+(i+1)*196,196);}
+    std::vector<uint8_t> result(rawBytes+2,0U);result[0]=modem::TAG_DATA;result[1]=1;
+    P25Utils::encode(stripped.data(),result.data()+2,0,rawBytes*8);
+    Sync::addP25Sync(result.data()+2);NID(NAC).encode(result.data()+2,DUID::PDU);
+    return result;
+}
+}
