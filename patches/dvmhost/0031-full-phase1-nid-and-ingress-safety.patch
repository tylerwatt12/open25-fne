+// Caller guarantees full raw span: 114 bits/15 bytes, excluding no input bytes.
+static inline void extract(const uint8_t* raw, uint8_t word[8])
+{
+    for (uint8_t i = 0U; i < 8U; ++i) word[i] = 0U;
+    for (uint8_t bit = 0U; bit < 64U; ++bit) {
+        const uint8_t airBit = 48U + bit + (bit >= 22U ? 2U : 0U);
+        if ((raw[airBit >> 3U] & (0x80U >> (airBit & 7U))) != 0U)
+            word[bit >> 3U] |= 0x80U >> (bit & 7U);
+    }
+}
