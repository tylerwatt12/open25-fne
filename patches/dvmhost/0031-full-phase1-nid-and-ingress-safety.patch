diff --git a/src/common/p25/NIDCodec.h b/src/common/p25/NIDCodec.h
new file mode 100644
--- /dev/null
+++ b/src/common/p25/NIDCodec.h
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Phase 1 NID codec: TIA-102.BAAA-B (June 2017), sections 4.9 and 7.5,
+ * Tables 6, 17-19; PDF pages 34, 57-59. Transmission order is MSB first.
+ * See docs/standards-audit/firmware-nid-plan.md for exact source provenance.
+ * Shared verbatim by the modem and host; no heap, recursion or hardware access.
+ */
+#ifndef P25_NID_CODEC_H
+#define P25_NID_CODEC_H
+#include <stdint.h>
+namespace p25nid {
+struct Result { uint16_t nac; uint8_t duid; uint8_t correctedBits; };
+// GF(64), primitive polynomial x^6+x+1. Values alpha^0 ... alpha^62.
+static const uint8_t EXP[63] = {
+    1,2,4,8,16,32,3,6,12,24,48,35,5,10,20,40,
+    19,38,15,30,60,59,53,41,17,34,7,14,28,56,51,37,
+    9,18,36,11,22,44,27,54,47,29,58,55,45,25,50,39,
+    13,26,52,43,21,42,23,46,31,62,63,61,57,49,33
+};
+static const uint8_t LOG[64] = {
+    255,0,1,6,2,12,7,26,3,32,13,35,8,48,27,18,
+    4,24,33,16,14,52,36,54,9,45,49,38,28,41,19,56,
+    5,62,25,11,34,31,17,47,15,23,53,51,37,44,55,40,
+    10,61,46,30,50,22,39,43,29,60,42,21,20,59,57,58
+};
+static inline uint8_t multiply(uint8_t a, uint8_t b)
+{
+    if (a == 0U || b == 0U) return 0U;
+    uint8_t exponent = LOG[a] + LOG[b];
+    if (exponent >= 63U) exponent -= 63U;
+    return EXP[exponent];
+}
+static inline uint8_t divide(uint8_t a, uint8_t b)
+{
+    if (a == 0U) return 0U; // caller guarantees nonzero divisor
+    int16_t exponent = int16_t(LOG[a]) - int16_t(LOG[b]);
+    if (exponent < 0) exponent += 63;
+    return EXP[exponent];
+}
+static inline uint64_t encode(uint16_t information)
+{
+    // Systematic (63,16,23), octal generator 6331 1413 6723 5453.
+    const uint64_t data = uint64_t(information) << 47U;
+    uint64_t remainder = data;
+    for (int8_t bit = 62; bit >= 47; --bit)
+        if ((remainder & (uint64_t(1U) << bit)) != 0U)
+            remainder ^= UINT64_C(0xCD930BDD3B2B) << (bit - 47);
+    const uint8_t p = ((information >> 1U) ^ information) & 1U;
+    return ((data | remainder) << 1U) | p;
+}
+static inline bool syndromes(uint64_t core, uint8_t out[22])
+{
+    // Binary-field identity S(2j)=S(j)^2 halves the explicit evaluations.
+    for (uint8_t j = 1U; j < 22U; j += 2U) {
+        uint8_t syndrome = 0U, exponent = 0U;
+        uint64_t bits = core;
+        for (uint8_t bit = 0U; bit < 63U; ++bit) {
+            if ((bits & 1U) != 0U) syndrome ^= EXP[exponent];
+            bits >>= 1U;
+            exponent += j;
+            if (exponent >= 63U) exponent -= 63U;
+        }
+        out[j - 1U] = syndrome;
+    }
+    for (uint8_t j = 2U; j <= 22U; j += 2U) {
+        const uint8_t half = out[j / 2U - 1U];
+        out[j - 1U] = multiply(half, half);
+    }
+    uint8_t any = 0U;
+    for (uint8_t i = 0U; i < 22U; ++i) any |= out[i];
+    return any == 0U;
+}
+static inline bool decode(const uint8_t word[8], Result& result)
+{
+    result.nac = 0U; result.duid = 0xFFU; result.correctedBits = 0U;
+    if (word == 0) return false;
+    uint64_t received = 0U;
+    for (uint8_t i = 0U; i < 8U; ++i) received = (received << 8U) | word[i];
+    uint64_t core = received >> 1U;
+    uint8_t s[22];
+    if (!syndromes(core, s)) {
+        // Berlekamp-Massey; fixed arrays, bounded by 22, no recursion or heap.
+        uint8_t c[23] = {1U}, b[23] = {1U}, previous[23];
+        uint8_t degree = 0U, shift = 1U, lastDiscrepancy = 1U;
+        for (uint8_t n = 0U; n < 22U; ++n) {
+            uint8_t discrepancy = s[n];
+            for (uint8_t i = 1U; i <= degree; ++i) discrepancy ^= multiply(c[i], s[n - i]);
+            if (discrepancy == 0U) { ++shift; continue; }
+            for (uint8_t i = 0U; i < 23U; ++i) previous[i] = c[i];
+            const uint8_t factor = divide(discrepancy, lastDiscrepancy);
+            for (uint8_t i = 0U; i + shift < 23U; ++i) c[i + shift] ^= multiply(factor, b[i]);
+            if (2U * degree <= n) {
+                degree = n + 1U - degree;
+                if (degree > 11U) return false;
+                for (uint8_t i = 0U; i < 23U; ++i) b[i] = previous[i];
+                lastDiscrepancy = discrepancy; shift = 1U;
+            } else ++shift;
+        }
+        uint8_t roots = 0U;
+        for (uint8_t bit = 0U; bit < 63U; ++bit) {
+            const uint8_t x = EXP[bit == 0U ? 0U : 63U - bit];
+            uint8_t value = c[degree];
+            for (uint8_t i = degree; i > 0U; --i) value = multiply(value, x) ^ c[i - 1U];
+            if (value == 0U) { core ^= uint64_t(1U) << bit; ++roots; }
+        }
+        if (roots != degree || !syndromes(core, s)) return false;
+    }
+    const uint16_t information = uint16_t(core >> 47U);
+    const uint64_t corrected = encode(information);
+    if ((corrected >> 1U) != core) return false;
+    uint64_t differences = received ^ corrected;
+    uint8_t errors = 0U;
+    while (differences != 0U) { differences &= differences - 1U; ++errors; }
