+TEST_CASE("variable PDU ingress validates complete bounded header and packet before state", "[p25][nid-ingress][packet-integrity]") {
+    VoiceFixture fixture(0x84U,7U);MI first{1U,2U,3U,4U,5U,6U,7U,8U,0U};
+    REQUIRE(fixture.rf(DUID::HDU,first));fixture.drain();REQUIRE(fixture.rf(DUID::LDU1,first));fixture.requireLDU(DUID::LDU1,first);
+    fixture.controller->setCCRunning(true);fixture.controller->setCCHalted(false);NIDReceiveTestAccess::ageWatchdog(*fixture.controller);
+    const auto before=NIDReceiveTestAccess::state(*fixture.controller);const auto forwarded=fixture.network.outgoing.size();
+    for(auto format:{PDUFormatType::CONFIRMED,PDUFormatType::UNCONFIRMED,PDUFormatType::AMBT,PDUFormatType::RSP}) {
+        auto full=pduFrame(format,format==PDUFormatType::RSP?0:1);
+        REQUIRE(packet::Data::validRFFrame(full.data(),full.size()));
+        REQUIRE(full.size()==(format==PDUFormatType::RSP?47U:74U));
+        for(unsigned n=0;n<full.size();++n){CAPTURE(unsigned(format),n);std::unique_ptr<uint8_t[]> exact(new uint8_t[n]);std::copy(full.begin(),full.begin()+n,exact.get());REQUIRE_FALSE(fixture.controller->processFrame(exact.get(),n));REQUIRE_FALSE(NIDReceiveTestAccess::packet(*fixture.controller,exact.get(),n));REQUIRE(NIDReceiveTestAccess::state(*fixture.controller)==before);}
+    }
+    for(auto format:{PDUFormatType::UNCONFIRMED,PDUFormatType::AMBT}){auto bad=pduFrame(format,1,true);REQUIRE_FALSE(packet::Data::validRFFrame(bad.data(),bad.size()));REQUIRE_FALSE(fixture.controller->processFrame(bad.data(),bad.size()));REQUIRE_FALSE(NIDReceiveTestAccess::packet(*fixture.controller,bad.data(),bad.size()));REQUIRE(NIDReceiveTestAccess::state(*fixture.controller)==before);}
+    auto maximum=pduFrame(PDUFormatType::UNCONFIRMED,18);REQUIRE(maximum.size()==497);REQUIRE(packet::Data::validRFFrame(maximum.data(),maximum.size()));
+    for(uint8_t sap:{PDUSAP::EXT_ADDR,PDUSAP::ENC_USER_DATA,PDUSAP::ENC_KMM}) {
+        auto malformed=pduFrame(PDUFormatType::UNCONFIRMED,1,false,0,0,sap);
+        REQUIRE_FALSE(packet::Data::validRFFrame(malformed.data(),malformed.size()));
+        REQUIRE_FALSE(fixture.controller->processFrame(malformed.data(),malformed.size()));
+        REQUIRE_FALSE(NIDReceiveTestAccess::packet(*fixture.controller,malformed.data(),malformed.size()));
+        REQUIRE(NIDReceiveTestAccess::state(*fixture.controller)==before);
+        uint8_t stripped[512]{},encoded[25]{};P25Utils::decode(malformed.data()+2,stripped,0,(malformed.size()-2)*8);
+        p25::data::Assembler probe;Utils::getBitRange(stripped,encoded,112,196);REQUIRE(probe.disassemble(encoded,25,true));Utils::getBitRange(stripped,encoded,308,196);REQUIRE_FALSE(probe.disassemble(encoded,25));
+    }
+    auto noBody=pduFrame(PDUFormatType::UNCONFIRMED,0);REQUIRE_FALSE(packet::Data::validRFFrame(noBody.data(),noBody.size()));
+    auto unknown=pduFrame(0x1FU,1);REQUIRE_FALSE(packet::Data::validRFFrame(unknown.data(),unknown.size()));
+    auto offset=pduFrame(PDUFormatType::CONFIRMED,1,false,0,63);REQUIRE_FALSE(packet::Data::validRFFrame(offset.data(),offset.size()));
+    auto tooLarge=pduFrame(PDUFormatType::UNCONFIRMED,19);tooLarge.resize(514);REQUIRE_FALSE(packet::Data::validRFFrame(tooLarge.data(),tooLarge.size()));
+    auto underflow=pduFrame(PDUFormatType::UNCONFIRMED,1,false,31);REQUIRE_FALSE(packet::Data::validRFFrame(underflow.data(),underflow.size()));
+    REQUIRE(fixture.drain().empty());REQUIRE(fixture.network.outgoing.size()==forwarded);
+}
