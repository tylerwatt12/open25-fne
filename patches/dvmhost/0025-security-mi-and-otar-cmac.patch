+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace packetcodec {
+// BAAC-D 2.6 and AAAD-B 3/3.1 (PDF 16/18, printed 6/8):
+// null encrypted MI is forbidden; the supported ciphers consume 64 MI bits.
+inline bool validMI(const uint8_t* mi) {
+    uint8_t effective = 0;
+    for (size_t i = 0; i < 8; i++) effective |= mi[i];
+    return effective != 0;
+}
+// Retry the reserved null value, then fail closed if the random source cannot
+// produce a usable value. The retry bound is local failure-handling policy.
+template<class RandomBytes>
+bool generateMI(std::array<uint8_t, 9>& mi, RandomBytes randomBytes) {
+    mi.fill(0);
+    for (unsigned attempt = 0; attempt < 4; attempt++) {
+        if (randomBytes(mi.data(), 8) != 1) { mi.fill(0); return false; }
+        if (validMI(mi.data())) return true;
+    }
+    mi.fill(0);
+    return false;
+}
+}
