+// SPDX-License-Identifier: GPL-2.0-only
+#include "bridge/PacketCodecMI.h"
+#include <catch2/catch_test_macros.hpp>
+
+TEST_CASE("Packet codec retries null MI and fails closed on RNG failure", "[p25][packet-mi]") {
+    std::array<uint8_t, 9> mi{};
+    unsigned calls = 0;
+    REQUIRE(packetcodec::generateMI(mi, [&](uint8_t* out, int length) {
+        REQUIRE(length == 8);
+        if (++calls == 2) out[7] = 1;
+        return 1;
+    }));
+    REQUIRE(calls == 2);
+    REQUIRE(mi[7] == 1);
+    REQUIRE(mi[8] == 0);
+    REQUIRE(packetcodec::validMI(mi.data()));
+    calls = 0;
+    REQUIRE_FALSE(packetcodec::generateMI(mi, [&](uint8_t*, int) { ++calls; return 1; }));
+    REQUIRE(calls == 4);
+    REQUIRE_FALSE(packetcodec::validMI(mi.data()));
+    REQUIRE_FALSE(packetcodec::generateMI(mi, [](uint8_t* out, int) { out[0] = 1; return 0; }));
+    REQUIRE_FALSE(packetcodec::validMI(mi.data()));
+    mi[8] = 1;
+    REQUIRE_FALSE(packetcodec::validMI(mi.data()));
+}
