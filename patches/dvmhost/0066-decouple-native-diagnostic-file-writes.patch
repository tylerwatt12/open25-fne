+class ArchiveWriter {
+public:
+    ~ArchiveWriter() { stop(); }
+    bool start()
+    {
+        std::lock_guard<std::mutex> lifetime(lifecycle);
+        std::lock_guard<std::mutex> lock(archiveMutex);
+        archiveHead = archiveCount = activityPending = 0U;
+        archiveStopping = false;
+        activitySink = nullptr;
+        finalActivity = nullptr;
+        try { worker = std::thread([this] { run(); }); }
+        catch (const std::system_error&) { return false; }
+        archiveAccepting = true;
+        return true;
+    }
+    void stop()
+    {
+        std::lock_guard<std::mutex> lifetime(lifecycle);
+        {
+            std::lock_guard<std::mutex> lock(archiveMutex);
+            archiveAccepting = false;
+            finalActivity = worker.joinable() ? activitySink : nullptr;
+            if (finalActivity != nullptr) ++activityPending; // Keep this sink alive through the final loss snapshot.
+            activitySink = nullptr;
+            archiveStopping = true;
+        }
+        archiveChanged.notify_all();
+        if (worker.joinable()) worker.join();
+    }
+private:
+    std::mutex lifecycle;
+    std::thread worker;
+    log_internal::ArchiveSink finalActivity = nullptr;
+    void run()
+    {
+        for (;;) {
+            ArchiveRecord record;
+            {
+                std::unique_lock<std::mutex> lock(archiveMutex);
+                archiveChanged.wait(lock, [] { return archiveCount != 0U || archiveStopping; });
+                if (archiveCount == 0U && archiveStopping) {
+                    lock.unlock();
+                    const std::time_t now = std::time(nullptr);
+                    if (!g_useSyslog) reportArchiveLoss(writeDiagnosticArchive, now);
+                    else if (finalActivity != nullptr) reportArchiveLoss(finalActivity, now);
+                    if (finalActivity != nullptr) {
+                        lock.lock();
+                        --activityPending;
+                        archiveChanged.notify_all();
+                    }
+                    return;
+                }
+                record = archiveRecords[archiveHead];
+                archiveHead = (archiveHead + 1U) % ARCHIVE_RECORDS;
+                --archiveCount;
+            }
+            const auto sink = record.sink == nullptr ? writeDiagnosticArchive : record.sink;
+            reportArchiveLoss(sink, record.when);
+            if (sink(record.text.data(), record.when)) ++archiveWritten;
+            else { ++archiveErrors; archiveErrno.store(errno); }
+            if (record.sink != nullptr) {
+                std::lock_guard<std::mutex> lock(archiveMutex);
+                --activityPending;
+                archiveChanged.notify_all();
+            }
+        }
+    }
+};
