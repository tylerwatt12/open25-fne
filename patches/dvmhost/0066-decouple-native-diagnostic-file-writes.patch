+void enqueueArchive(const std::string& text, std::time_t when, bool activity)
+{
+    if (text.size() >= ARCHIVE_BYTES) { ++archiveOversize; return; }
+    if (when == 0) ::time(&when);
+    std::unique_lock<std::mutex> lock(archiveMutex, std::try_to_lock);
+    if (!lock.owns_lock()) { ++archiveBusy; return; }
+    if (!archiveAccepting || (activity && activitySink == nullptr)) { ++archiveStopped; return; }
+    if (archiveCount == ARCHIVE_RECORDS) { ++archiveFull; return; }
+    auto& record = archiveRecords[(archiveHead + archiveCount) % ARCHIVE_RECORDS];
+    ::memcpy(record.text.data(), text.data(), text.size());
+    record.text[text.size()] = '\0';
+    record.when = when;
+    record.sink = activity ? activitySink : nullptr;
+    ++archiveCount;
+    if (activity) ++activityPending;
+    ++archiveEnqueued;
+    lock.unlock();
+    archiveChanged.notify_one();
+}
