+        static_cast<unsigned long long>(busy), static_cast<unsigned long long>(oversize),
+        static_cast<unsigned long long>(stopped));
+    if (sink(summary, when)) archiveReported = omitted;
+    else { ++archiveErrors; archiveErrno.store(errno); }
