+/* Pending latching and permit commits share a total order. */
+void Control::requestIdentification()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_permitMutex);
+    if (m_identificationEnabled.load()) {
+        m_identificationPending.store(true);
+        m_identificationUnavailable.store(true);
+    }
+}
+
+bool Control::tryBeginIdentification()
+{
+    std::unique_lock<std::recursive_mutex> lock(m_permitMutex, std::try_to_lock);
+    if (!lock.owns_lock())
+        return false;
+    if (m_identificationEnabled.load()) {
+        m_identificationPending.store(true);
+        m_identificationUnavailable.store(true);
+        m_identificationActive.store(true);
+    }
+    return true;
+}
+
+void Control::setIdentificationActive(bool active)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_permitMutex);
+    if (m_identificationEnabled.load())
+        m_identificationActive.store(active);
+}
