+TEST_CASE("CW pending latch is serialized with a permit already being committed", "[p25][cwid]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.controller->configureIdentification(true);
+    auto permit = CapacityPermitTestAccess::permitGuard(*voice.controller);
+    auto begin = std::async(std::launch::async, [&]() { return voice.controller->tryBeginIdentification(); });
+    REQUIRE_FALSE(begin.get()); // Host can honor its deadline without blocking here.
+    auto pending = std::async(std::launch::async, [&]() { voice.controller->requestIdentification(); });
+    const bool latchedDuringCommit = pending.wait_for(std::chrono::milliseconds(10)) == std::future_status::ready;
+    permit.unlock();
+    pending.get();
+    CHECK_FALSE(latchedDuringCommit);
+    REQUIRE(voice.controller->identificationUnavailable());
+    REQUIRE(voice.controller->tryBeginIdentification());
+    REQUIRE(voice.controller->identificationActive());
