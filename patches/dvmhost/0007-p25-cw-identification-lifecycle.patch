new file mode 100644
index 0000000..7a9707e
--- /dev/null
+++ b/tests/CWIDModem_Tests.cpp
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise the actual protocol writer with no opened modem port. */
+#include "host/modem/Modem.h"
+#include "host/modem/port/ModemNullPort.h"
+#include <catch2/catch_test_macros.hpp>
+#include <vector>
+#include <string>
+
+namespace {
+class CWWriteModem : public modem::Modem {
+public:
+    std::vector<std::vector<uint8_t>> commands;
+    bool shortWrite = false;
+    CWWriteModem() : Modem(new modem::port::ModemNullPort(), true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U,
+        true, true, false, false, false, false) {}
+    int write(const uint8_t* data, uint32_t length, bool = false) override {
+        commands.emplace_back(data, data + length);
+        return int(length) - (shortWrite ? 1 : 0);
+    }
+};
+}
+
+TEST_CASE("CW uses the actual protocol4 callsign command and detects short writes", "[modem][cwid]") {
+    CWWriteModem modem;
+    REQUIRE(modem.sendCWId("N0TEST"));
+    REQUIRE(modem.commands.size() == 1U);
+    const std::vector<uint8_t> expected{0xFEU, 9U, 0x0AU, 'K', 'D', '8', 'Z', 'M', 'M'};
+    REQUIRE(modem.commands.front() == expected);
+    modem.shortWrite = true;
+    REQUIRE_FALSE(modem.sendCWId("N0TEST"));
+    REQUIRE(modem.commands.size() == 2U);
+}
+
+TEST_CASE("CW abort cancels via P25 before IDLE and attempts every command on write failure", "[modem][cwid]") {
+    for (bool shortWrite : {false, true}) {
+        CWWriteModem modem;
+        modem.shortWrite = shortWrite;
+        REQUIRE(modem.abortCWId() == !shortWrite);
+        REQUIRE(modem.commands.size() == 3U);
+        const std::vector<uint8_t> p25{0xFEU, 4U, 0x03U, uint8_t(modem::STATE_P25)};
+        const std::vector<uint8_t> clear{0xFEU, 3U, 0x33U};
+        const std::vector<uint8_t> idle{0xFEU, 4U, 0x03U, uint8_t(modem::STATE_IDLE)};
+        REQUIRE(modem.commands[0] == p25);
+        REQUIRE(modem.commands[1] == clear);
+        REQUIRE(modem.commands[2] == idle);
+    }
+}
diff --git a/tests/CWIDPolicy_Tests.cpp b/tests/CWIDPolicy_Tests.cpp
new file mode 100644
index 0000000..9696d15
--- /dev/null
+++ b/tests/CWIDPolicy_Tests.cpp
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Offline clock/status and quiescence fixtures. No modem, network or RF. */
+#include "host/CWIDPolicy.h"
+#include <catch2/catch_test_macros.hpp>
+#include <functional>
+#include <future>
+#include <atomic>
+#include <chrono>
+#include <string>
+#include <vector>
+
+namespace {
+using identification::Policy;
+using identification::Result;
+
+struct FakeTransport : identification::Transport {
+    mutable uint64_t clock = 0U;
+    uint64_t idleAt = 40U, txAt = 80U, endAt = 140U;
+    uint32_t prepareCost = 0U, sendCost = 0U;
+    bool prepareOK = true, sendOK = true, freshIdle = true;
+    bool starts = true, finishes = true, fault = false, advance = true;
+    uint64_t faultAt = ~uint64_t(0U);
+    mutable unsigned calls = 0U;
+    unsigned sends = 0U, prepares = 0U, pumps = 0U;
+    bool sent = false;
+    std::string text;
+    mutable std::vector<std::string> phases;
+    std::function<void(FakeTransport&)> afterPrepare, afterSend, afterPump;
+
+    uint64_t nowMs() const override { ++calls; return clock; }
+    bool prepareIdle() override {
+        ++calls; ++prepares; phases.push_back("prepare"); clock += prepareCost;
+        if (afterPrepare) afterPrepare(*this);
+        return prepareOK;
+    }
+    bool idleReady() const override {
+        ++calls;
+        if (freshIdle && clock >= idleAt) { phases.push_back("idle"); return true; }
+        return false;
+    }
+    bool send(const std::string& value) override {
+        ++calls; ++sends; phases.push_back("send"); sent = true; text = value;
+        clock += sendCost;
+        if (afterSend) afterSend(*this);
+        return sendOK;
+    }
+    bool transmitting() const override {
+        ++calls;
+        const bool tx = sent && starts && clock >= txAt && (!finishes || clock < endAt);
+        phases.push_back(tx ? "tx" : "not-tx");
+        return tx;
+    }
+    bool healthy() const override { ++calls; return !fault && clock < faultAt; }
+    void pump(uint32_t milliseconds) override {
+        ++calls; ++pumps;
+        REQUIRE(milliseconds > 0U);
+        REQUIRE(milliseconds <= 20U);
+        if (advance) clock += milliseconds;
+        if (afterPump) afterPump(*this);
+    }
+};
+}
+
+TEST_CASE("CW policy identifies startup and real RF without self-generating idle RF", "[cwid][policy]") {
+    Policy policy;
+    REQUIRE_FALSE(policy.enabled());
+    REQUIRE_FALSE(policy.due(0U));
+    policy.configure(true, 540U);
+    REQUIRE(policy.enabled());
+    REQUIRE(policy.due(0U));
+    REQUIRE(std::string(policy.reason(0U)) == "startup");
+    REQUIRE(policy.finalDue());
+    policy.complete(100U);
+    REQUIRE_FALSE(policy.finalDue());
+    REQUIRE_FALSE(policy.due(10000000U)); // An unused capacity channel stays silent.
+    policy.observeRF(false);
+    REQUIRE_FALSE(policy.due(10000000U));
+    policy.observeRF(true);
+    REQUIRE(policy.finalDue());
+    REQUIRE_FALSE(policy.due(540099U));
+    REQUIRE(policy.due(540100U));
+    REQUIRE(std::string(policy.reason(540100U)) == "periodic");
+    policy.complete(540100U);
+    REQUIRE_FALSE(policy.due(540100U));
+    REQUIRE_FALSE(policy.finalDue());
+    policy.observeRF(false); // Completion reset the old TX edge.
+    REQUIRE_FALSE(policy.due(540101U));
+    policy.observeRF(true);
+    REQUIRE_FALSE(policy.due(540101U));
+    policy.observeRF(false);
+    REQUIRE(policy.due(540101U));
+    REQUIRE(std::string(policy.reason(540101U)) == "voice-end");
+}
+
+TEST_CASE("CW policy explicit end, reset and disabled observations preserve eligibility", "[cwid][policy]") {
+    Policy policy;
+    policy.configure(true, 540U);
+    policy.complete(900U);
+    policy.noteVoiceEnd();
+    REQUIRE(policy.due(901U));
+    REQUIRE(policy.finalDue());
+    REQUIRE(std::string(policy.reason(901U)) == "voice-end");
+    policy.complete(1000U);
+    policy.observeRF(true);
+    REQUIRE_FALSE(policy.due(999U)); // Clock regression must not wrap elapsed time.
+    policy.configure(false, 1U);
+    policy.observeRF(true); policy.observeRF(false); policy.noteVoiceEnd(); policy.complete(0U);
+    REQUIRE_FALSE(policy.enabled());
+    REQUIRE_FALSE(policy.due(~uint64_t(0U)));
+    REQUIRE_FALSE(policy.finalDue());
+    REQUIRE(std::string(policy.reason(0U)).empty());
+    policy.configure(true, 540U);
+    REQUIRE(std::string(policy.reason(0U)) == "startup");
+}
+
+TEST_CASE("Disabled CW executor performs absolutely no transport operations", "[cwid][executor]") {
+    FakeTransport transport;
+    REQUIRE(identification::transmit(transport, "N0TEST", false) == Result::Disabled);
+    REQUIRE(transport.calls == 0U);
+    REQUIRE(transport.sends == 0U);
+    REQUIRE(transport.prepares == 0U);
+}
+
+TEST_CASE("CW executor requires fresh idle followed by actual TX start and completion", "[cwid][executor]") {
+    FakeTransport transport;
+    REQUIRE(identification::transmit(transport, "N0TEST", true) == Result::Completed);
+    REQUIRE(transport.sends == 1U);
+    REQUIRE(transport.text == "N0TEST");
+    REQUIRE(transport.prepares == 1U);
+    REQUIRE(transport.clock == 140U);
+    REQUIRE(transport.phases.front() == "prepare");
+    REQUIRE(transport.phases[1U] == "idle");
+    REQUIRE(transport.phases[2U] == "send");
+    bool observedTX = false, observedEnd = false;
+    for (const auto& phase : transport.phases) {
+        if (phase == "tx") observedTX = true;
+        if (phase == "not-tx" && observedTX) observedEnd = true;
+    }
+    REQUIRE(observedTX);
+    REQUIRE(observedEnd);
+}
+
+TEST_CASE("CW executor reports operation failures without retrying or inventing TX", "[cwid][executor]") {
+    FakeTransport transport;
+    SECTION("prepare failure") {
+        transport.prepareOK = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true) == Result::PrepareFailed);
+        REQUIRE(transport.sends == 0U);
+    }
+    SECTION("send failure") {
+        transport.sendOK = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true) == Result::SendFailed);
+        REQUIRE(transport.sends == 1U);
+    }
+    SECTION("cached idle is insufficient") {
+        transport.freshIdle = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 60U) == Result::IdleTimeout);
+        REQUIRE(transport.clock == 60U);
+        REQUIRE(transport.sends == 0U);
+    }
+    SECTION("no TX transition") {
+        transport.starts = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 80U) == Result::StartTimeout);
+        REQUIRE(transport.clock == 120U);
+        REQUIRE(transport.sends == 1U);
+    }
+    SECTION("stuck transmitter") {
+        transport.finishes = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 200U) == Result::CompletionTimeout);
+        REQUIRE(transport.clock == 200U);
+        REQUIRE(transport.sends == 1U);
+    }
+}
+
+TEST_CASE("CW executor treats health failures in every transaction phase as faults", "[cwid][executor]") {
+    FakeTransport transport;
+    SECTION("already unhealthy") { transport.fault = true; }
+    SECTION("prepare failed and unhealthy") { transport.prepareOK = false; transport.afterPrepare = [](FakeTransport& t) { t.fault = true; }; }
+    SECTION("idle wait") { transport.faultAt = 20U; }
+    SECTION("send") { transport.afterSend = [](FakeTransport& t) { t.fault = true; }; }
+    SECTION("start wait") { transport.faultAt = 60U; }
+    SECTION("completion wait") { transport.faultAt = 100U; }
+    REQUIRE(identification::transmit(transport, "N0TEST", true) == Result::Fault);
+    REQUIRE(transport.sends <= 1U);
+}
+
+TEST_CASE("CW executor deadlines include callback work and the complete transaction", "[cwid][executor]") {
+    FakeTransport transport;
+    SECTION("prepare consumes idle budget") {
+        transport.prepareCost = 101U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U) == Result::IdleTimeout);
+        REQUIRE(transport.sends == 0U);
+    }
+    SECTION("send consumes start budget") {
+        transport.sendCost = 101U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U) == Result::StartTimeout);
+        REQUIRE(transport.sends == 1U);
+    }
+    SECTION("total budget limits completion even though local phases passed") {
+        transport.prepareCost = 10U;
+        transport.idleAt = 20U;
+        transport.sendCost = 15U;
+        transport.txAt = 60U;
+        transport.endAt = 100U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 80U) == Result::CompletionTimeout);
+        REQUIRE(transport.clock == 80U);
+    }
+    SECTION("total budget also bounds start wait") {
+        transport.starts = false;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 1000U, 90U) == Result::StartTimeout);
+        REQUIRE(transport.clock == 90U);
+    }
+    SECTION("zero total budget cannot send") {
+        transport.idleAt = 0U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 0U) == Result::IdleTimeout);
+        REQUIRE(transport.sends == 0U);
+        REQUIRE(transport.prepares == 0U);
+    }
+}
+
+TEST_CASE("CW deadline boundaries accept only transitions observed within the budget", "[cwid][executor]") {
+    FakeTransport transport;
+    SECTION("idle exactly at its deadline") {
+        transport.idleAt = 40U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 40U) == Result::Completed);
+    }
+    SECTION("idle after its deadline") {
+        transport.idleAt = 41U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 40U) == Result::IdleTimeout);
+        REQUIRE(transport.sends == 0U);
+    }
+    SECTION("TX exactly at its start deadline") {
+        transport.txAt = 80U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 40U) == Result::Completed);
+    }
+    SECTION("TX after its start deadline") {
+        transport.txAt = 81U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 40U) == Result::StartTimeout);
+    }
+    SECTION("completion exactly at total deadline") {
+        transport.endAt = 140U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 140U) == Result::Completed);
+    }
+    SECTION("completion after total deadline") {
+        transport.endAt = 141U;
+        REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 140U) == Result::CompletionTimeout);
+    }
+}
+
+TEST_CASE("CW executor cannot spin forever with a broken monotonic clock", "[cwid][executor]") {
+    FakeTransport transport;
+    SECTION("clock does not advance") { transport.advance = false; }
+    SECTION("clock moves backward") { transport.afterPump = [](FakeTransport& t) { t.clock = 0U; }; transport.clock = 10U; }
+    REQUIRE(identification::transmit(transport, "N0TEST", true, 100U, 100U, 200U) == Result::Fault);
+    REQUIRE(transport.sends == 0U);
+    REQUIRE(transport.pumps < 20U);
+}
+
+TEST_CASE("CW quiescence drains an in-flight RF reader before state reset", "[cwid]") {
+    identification::ActivityBarrier barrier;
+    auto frame = barrier.enter();
+    std::atomic<bool> frameFinished{false};
+    auto id = std::async(std::launch::async, [&]() {
+        auto exclusive = barrier.quiesce(500U);
+        return exclusive.owns_lock() && frameFinished.load();
+    });
+    const bool resetTooEarly = id.wait_for(std::chrono::milliseconds(10)) == std::future_status::ready;
+    frameFinished.store(true);
+    frame.unlock();
+    const bool safelyDrained = id.get();
+    CHECK_FALSE(resetTooEarly);
+    REQUIRE(safelyDrained);
+}
+
+TEST_CASE("A stuck RF reader fails bounded CW quiescence without resetting state", "[cwid]") {
+    identification::ActivityBarrier barrier;
+    auto frame = barrier.enter();
+    auto id = std::async(std::launch::async, [&]() {
+        auto exclusive = barrier.quiesce(10U);
+        return exclusive.owns_lock();
+    });
+    const bool resetAllowed = id.get();
+    frame.unlock();
+    REQUIRE_FALSE(resetAllowed);
+}
+
+TEST_CASE("CW ownership acquisition shares the absolute operation deadline", "[cwid][locking]") {
+    uint64_t clock = 0U, available = 3U;
+    unsigned attempts = 0U, waits = 0U;
+    bool healthy = true;
+    auto attempt = [&]() { ++attempts; return clock >= available; };
+    auto now = [&]() { return clock; };
+    auto wait = [&]() { ++waits; ++clock; };
+    auto health = [&]() { return healthy; };
+    SECTION("ownership obtained at the boundary") {
+        REQUIRE(identification::acquireUntil(attempt, 3U, now, wait, health));
+        REQUIRE(clock == 3U);
+        REQUIRE(attempts == 4U);
+    }
+    SECTION("blocked owner has no grace beyond deadline") {
+        available = 4U;
+        REQUIRE_FALSE(identification::acquireUntil(attempt, 3U, now, wait, health));
+        REQUIRE(clock == 3U);
+        REQUIRE(attempts == 4U);
+    }
+    SECTION("already elapsed budget does not attempt a lock") {
+        clock = 4U;
+        REQUIRE_FALSE(identification::acquireUntil(attempt, 3U, now, wait, health));
+        REQUIRE(attempts == 0U);
+        REQUIRE(waits == 0U);
+    }
+    SECTION("callback time cannot overrun the deadline") {
+        REQUIRE_FALSE(identification::acquireUntil([&]() { clock = 4U; return true; }, 3U, now, wait, health));
+    }
+    SECTION("hard cancellation does not wait for ownership") {
+        healthy = false;
+        REQUIRE_FALSE(identification::acquireUntil(attempt, 3U, now, wait, health));
+        REQUIRE(attempts == 0U);
+    }
+    SECTION("backwards time fails closed") {
+        clock = 1U;
+        REQUIRE_FALSE(identification::acquireUntil(attempt, 3U, now, [&]() { clock = 0U; }, health));
+    }
+    SECTION("stalled time cannot create an infinite lock wait") {
+        REQUIRE_FALSE(identification::acquireUntil(attempt, 3U, now, []() {}, health));
+        REQUIRE(attempts <= 10002U);
+    }
+}
