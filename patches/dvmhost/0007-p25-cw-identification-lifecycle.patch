+bool Host::sendIdentification(const char* reason, bool resume)
+{
+    if (!m_identification.enabled())
+        return true;
+    const uint64_t operationStarted = identificationNow();
+    const uint64_t operationDeadline = operationStarted + 10000U;
+    m_isTxCW.store(true);
+    m_modem->boundedCWOperation(true);
+    LogInfoEx(LOG_HOST, "CW, identification reason %s", reason);
+    LogInfoEx(LOG_HOST, "CW, start transmitting");
+    auto healthy = [this]() {
+        return !m_modem->hasError() && (!g_killed || g_signal == SIGINT || g_signal == SIGHUP);
+    };
+    auto wait = [this]() { m_mainLoopWatchdogTimer.start(); Thread::sleep(1U); };
+    auto fault = [this](bool modemOwned = false) {
+        // A blocked reader/owner must not be reset concurrently. Abort only
+        // when the modem writer is ours; process exit alone is no RF guarantee.
+        std::unique_lock<std::mutex> lock(m_clockingMutex, std::defer_lock);
+        if (modemOwned || lock.try_lock())
+            m_modem->abortCWId();
+        m_modem->boundedCWOperation(false);
+        m_identificationFailed = true;
+        g_killed = true;
+        LogError(LOG_HOST, "CW, identification failed");
+        return false;
+    };
+    if (!identification::acquireUntil([this]() { return m_p25 == nullptr || m_p25->tryBeginIdentification(); },
+            operationDeadline, identificationNow, wait, healthy))
+        return fault();
+    auto readerBarrier = m_p25Processing.quiesce(0U);
+    if (!identification::acquireUntil([&readerBarrier]() { return readerBarrier.owns_lock() || readerBarrier.try_lock(); },
+            std::min(operationDeadline, operationStarted + 1000U), identificationNow, wait, healthy))
+        return fault();
+    std::unique_lock<std::mutex> modemLock(m_clockingMutex, std::defer_lock);
+    if (!identification::acquireUntil([&modemLock]() { return modemLock.try_lock(); },
+            operationDeadline, identificationNow, wait, healthy))
+        return fault(modemLock.owns_lock());
+    std::unique_lock<std::recursive_mutex> stateLock(m_stateMutex, std::defer_lock);
+    if (!identification::acquireUntil([&stateLock]() { return stateLock.try_lock(); },
+            operationDeadline, identificationNow, wait, healthy)) {
+        return fault(true);
+    }
+    const bool wasControlRunning = m_p25 != nullptr && m_p25->getCCRunning();
+    m_p25DedicatedTxTestTimer.stop();
+    if (m_p25 != nullptr) {
+        m_p25->clearIdentificationTraffic();
+        m_p25->setCCRunning(false);
+        m_p25->affiliations()->releaseGrant(0U, true);
+        m_p25->reset();
+        m_p25->setCCHalted(true);
+    }
+    setState(STATE_IDLE);
+    m_modem->clearP25Receive();
+    CWModemTransport transport(*m_modem, [this]() { m_mainLoopWatchdogTimer.start(); });
+    const uint64_t elapsed = identificationNow() - operationStarted;
+    const uint32_t remaining = elapsed >= 10000U ? 0U : uint32_t(10000U - elapsed);
+    const auto result = identification::transmit(transport, m_cwCallsign, true, 2000U, 2000U, remaining);
+    m_modem->boundedCWOperation(false);
+    if (result != identification::Result::Completed) {
+        // In this firmware IDLE alone does not cancel CW: first select P25 to
+        // reset cwIdTX, clear its normal FIFO, then return to IDLE. Queued IO
+        // bits may still drain (~107ms); a killed host alone is no RF guarantee.
+        m_modem->abortCWId();
+        m_identificationFailed = true;
+        g_killed = true;
+        LogError(LOG_HOST, "CW, identification failure code %u", unsigned(result));
+        LogError(LOG_HOST, "CW, identification failed");
+        return false;
+    }
+    m_identification.complete(identificationNow());
+    m_nonIdentificationFrames.store(false);
+    m_modem->clearP25Receive();
+    if (m_p25 != nullptr) {
+        m_p25->reset();
+        m_p25->setCCRunning(wasControlRunning);
+        m_p25->setCCHalted(false);
+    }
+    m_p25TxWatchdogTimer.start();
+    m_p25TxLoopMS = 0U;
+    m_mainLoopWatchdogTimer.start();
+    m_isTxCW.store(false);
+    if (resume && !g_killed) {
+        setState(STATE_P25);
+        if (m_p25 != nullptr)
+            m_p25->completeIdentification();
+    }
+    m_mainLoopWatchdogTimer.start();
+    LogInfoEx(LOG_HOST, "CW, finished transmitting");
+    return true;
+}
