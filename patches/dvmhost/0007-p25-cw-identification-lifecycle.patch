+TEST_CASE("VC end latches unavailability before release and master off bypasses it", "[p25][cwid]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.controller->configureIdentification(true);
+    CapacityPermitTestAccess::notifyEnd(*voice.controller, GROUP);
+    REQUIRE(voice.controller->identificationPending());
+    REQUIRE(voice.controller->identificationUnavailable());
+    json::object permit, response;
+    setJSON<uint32_t>(permit, "dstId", GROUP);
+    permit["permitToken"].set<std::string>("abc:1");
+    permit = wireObject(permit);
+    REQUIRE(voice.rpc.dispatchRequest(RPC_PERMIT_P25_TG, permit, response));
+    REQUIRE(response["status"].get<int>() == network::NetRPC::BAD_REQUEST);
+    voice.controller->configureIdentification(false);
+    CapacityPermitTestAccess::notifyEnd(*voice.controller, GROUP);
+    REQUIRE_FALSE(voice.controller->identificationPending());
+    REQUIRE_FALSE(voice.controller->identificationUnavailable());
+    response.clear();
+    permit = wireObject(permit);
+    REQUIRE(voice.rpc.dispatchRequest(RPC_PERMIT_P25_TG, permit, response));
+    REQUIRE(response["status"].get<int>() == network::NetRPC::OK);
