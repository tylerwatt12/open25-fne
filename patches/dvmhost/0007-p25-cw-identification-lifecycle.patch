+TEST_CASE("Identification closes new grants and also rechecks an outstanding permit", "[p25][cwid]") {
+    for (bool duringReply : {false, true}) {
+        DYNAMIC_SECTION("CW pending during reply " << duringReply) {
+            ControllerFixture fixture(true, false);
+            fixture.registerAndAffiliate();
+            fixture.controller->configureIdentification(true);
+            fixture.controller->setSupervisor(true);
+            fixture.channels.setRFChData(VOICE_CHANNEL, ::lookups::VoiceChData(2U, VOICE_CHANNEL, "127.0.0.1", 48993U, "offline-test"));
+            if (duringReply) fixture.rpc.beforeReply = [&]() { fixture.controller->requestIdentification(); };
+            else fixture.controller->requestIdentification();
+            fixture.receive<IOSP_GRP_VCH>(SOURCE, GROUP);
