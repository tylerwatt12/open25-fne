+namespace {
+uint64_t identificationNow() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+class CWModemTransport final : public identification::Transport {
+public:
+    CWModemTransport(modem::Modem& value, std::function<void()> heartbeat) :
+        m_modem(value), m_heartbeat(heartbeat), m_lastPump(identificationNow()), m_initialStatus(0U) {}
+    uint64_t nowMs() const override { return identificationNow(); }
+    bool prepareIdle() override {
+        m_initialStatus = m_modem.statusGeneration();
+        m_modem.clearP25Frame();
+        return m_modem.setState(modem::STATE_IDLE);
+    }
+    bool idleReady() const override { return m_modem.statusGeneration() > m_initialStatus &&
+        m_modem.getState() == modem::STATE_IDLE && !m_modem.hasTX(); }
+    bool send(const std::string& text) override { return m_modem.sendCWId(text); }
+    bool transmitting() const override { return m_modem.hasTX(); }
+    bool healthy() const override {
+        const bool hardStop = g_killed && g_signal != SIGINT && g_signal != SIGHUP;
+        return !hardStop && !m_modem.hasError() && !m_modem.hasLockout() && !m_modem.cwIdRejected();
+    }
+    void pump(uint32_t ms) override {
+        Thread::sleep(ms);
+        const uint64_t now = nowMs();
+        m_heartbeat();
+        m_modem.clock(uint32_t(now - m_lastPump));
+        m_lastPump = now;
+    }
+private:
+    modem::Modem& m_modem;
+    std::function<void()> m_heartbeat;
+    uint64_t m_lastPump, m_initialStatus;
+};
+}
