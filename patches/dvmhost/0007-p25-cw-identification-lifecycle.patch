+++ b/src/host/CWIDPolicy.h
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pure identification scheduling and a bounded modem transaction. */
+#ifndef DVM_HOST_CWID_POLICY_H
+#define DVM_HOST_CWID_POLICY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <mutex>
+#include <chrono>
+
+namespace identification {
+
+class Policy {
+public:
+    Policy() : m_enabled(false), m_startup(false), m_pending(false),
+        m_dirty(false), m_previousRF(false), m_intervalMs(0U), m_completedAt(0U) {}
+
+    void configure(bool enabled, uint32_t intervalSeconds) {
+        m_enabled = enabled;
+        m_startup = enabled;
+        m_pending = m_dirty = m_previousRF = false;
+        m_intervalMs = uint64_t(intervalSeconds) * 1000U;
+        m_completedAt = 0U;
+    }
+    bool enabled() const { return m_enabled; }
+
+    // The caller excludes the identification transmission itself. Only real
+    // non-ID RF activity creates a new periodic/final identification obligation.
+    void observeRF(bool tx) {
+        if (!m_enabled)
+            return;
+        if (tx)
+            m_dirty = true;
+        if (m_previousRF && !tx)
+            m_pending = true;
+        m_previousRF = tx;
+    }
+    void noteVoiceEnd() {
+        if (!m_enabled)
+            return;
+        m_dirty = m_pending = true;
+    }
+    bool due(uint64_t nowMs) const {
+        return m_enabled && (m_startup || m_pending ||
+            (m_dirty && nowMs >= m_completedAt && nowMs - m_completedAt >= m_intervalMs));
+    }
+    const char* reason(uint64_t nowMs) const {
+        if (!due(nowMs))
+            return "";
+        if (m_startup)
+            return "startup";
+        if (m_pending)
+            return "voice-end";
+        return "periodic";
+    }
+    bool finalDue() const { return m_enabled && (m_startup || m_pending || m_dirty); }
+    void complete(uint64_t nowMs) {
+        if (!m_enabled)
+            return;
+        m_startup = m_pending = m_dirty = m_previousRF = false;
+        m_completedAt = nowMs;
+    }
+
+private:
+    bool m_enabled, m_startup, m_pending, m_dirty, m_previousRF;
+    uint64_t m_intervalMs, m_completedAt;
+};
+
+// Shared by the actual P25 reader/site updater and the CW quiesce path.
+// A pending flag prevents new work; this barrier drains work already in flight.
+class ActivityBarrier {
+public:
+    std::unique_lock<std::timed_mutex> enter() { return std::unique_lock<std::timed_mutex>(m_mutex); }
+    std::unique_lock<std::timed_mutex> quiesce(uint32_t milliseconds) {
+        std::unique_lock<std::timed_mutex> lock(m_mutex, std::defer_lock);
+        lock.try_lock_for(std::chrono::milliseconds(milliseconds));
+        return lock;
+    }
+private:
+    std::timed_mutex m_mutex;
+};
+
+// No blocking mutex acquisition may sit outside the identification budget.
+// Clock and wait callbacks keep this directly testable without real delays.
+template<typename Attempt, typename Now, typename Wait, typename Healthy>
+bool acquireUntil(Attempt attempt, uint64_t deadlineMs, Now now, Wait wait, Healthy healthy) {
+    uint64_t previous = now();
+    for (uint32_t tries = 0U; tries <= 10001U; ++tries) {
+        const uint64_t current = now();
+        if (current < previous || current > deadlineMs || !healthy())
+            return false;
+        previous = current;
+        if (attempt()) {
+            const uint64_t acquiredAt = now();
+            return acquiredAt >= current && acquiredAt <= deadlineMs && healthy();
+        }
+        if (current == deadlineMs)
+            return false;
+        wait();
+    }
+    return false;
+}
+
+class Transport {
+public:
+    virtual ~Transport() {}
+    virtual uint64_t nowMs() const = 0;
+    virtual bool prepareIdle() = 0;
+    // Must represent a fresh modem status showing no TX, not cached host state.
+    virtual bool idleReady() const = 0;
+    virtual bool send(const std::string& text) = 0;
+    virtual bool transmitting() const = 0;
+    virtual bool healthy() const = 0;
+    virtual void pump(uint32_t milliseconds) = 0;
+};
+
+enum class Result {
+    Completed, Disabled, PrepareFailed, SendFailed, IdleTimeout,
+    StartTimeout, CompletionTimeout, Fault
+};
+
+namespace detail {
+inline uint64_t deadline(uint64_t now, uint32_t milliseconds) {
+    const uint64_t maximum = std::numeric_limits<uint64_t>::max();
+    return now > maximum - milliseconds ? maximum : now + milliseconds;
+}
+
+// Absolute monotonic deadlines include work done in transport callbacks. The
+// finite pump allowance also prevents a broken/nonadvancing clock from spinning.
+class Transaction {
+public:
+    Transaction(Transport& transport, uint32_t totalTimeoutMs) : m_transport(transport),
+        m_lastTime(transport.nowMs()), m_begin(m_lastTime),
+        m_end(deadline(m_begin, totalTimeoutMs)),
+        m_pumps(uint64_t(totalTimeoutMs) / 20U + 8U) {}
+
+    uint64_t begin() const { return m_begin; }
+    uint64_t end() const { return m_end; }
+    bool time(uint64_t& now) {
+        now = m_transport.nowMs();
+        if (now < m_lastTime)
+            return false;
+        m_lastTime = now;
+        return true;
+    }
+    bool healthy() const { return m_transport.healthy(); }
+
+    template<typename Predicate>
+    Result wait(uint64_t until, Result timeout, Predicate ready) {
+        for (;;) {
+            if (!healthy())
+                return Result::Fault;
+            uint64_t now;
+            if (!time(now))
+                return Result::Fault;
+            if (now > until)
+                return timeout;
+            const bool observed = ready();
+            if (!healthy() || !time(now))
+                return Result::Fault;
+            if (now > until)
+                return timeout;
+            if (observed)
+                return Result::Completed;
+            if (now == until)
+                return timeout;
+            if (m_pumps == 0U)
+                return Result::Fault;
+            --m_pumps;
+            m_transport.pump(uint32_t(std::min<uint64_t>(20U, until - now)));
+        }
+    }
+
+private:
+    Transport& m_transport;
+    uint64_t m_lastTime, m_begin, m_end, m_pumps;
+};
+} // namespace detail
+
+inline Result transmit(Transport& transport, const std::string& text, bool enabled,
+    uint32_t idleTimeoutMs = 2000U, uint32_t startTimeoutMs = 2000U,
+    uint32_t totalTimeoutMs = 10000U) {
+    // In particular, do not read time/status or prepare a modem when disabled.
+    if (!enabled)
+        return Result::Disabled;
+    detail::Transaction transaction(transport, totalTimeoutMs);
+    if (!transaction.healthy())
+        return Result::Fault;
+    uint64_t now;
+    if (!transaction.time(now))
+        return Result::Fault;
+    if (now >= transaction.end())
+        return Result::IdleTimeout;
+
+    const uint64_t idleDeadline = std::min(transaction.end(),
+        detail::deadline(transaction.begin(), idleTimeoutMs));
+    const bool prepared = transport.prepareIdle();
+    if (!transaction.healthy())
+        return Result::Fault;
+    if (!prepared)
+        return Result::PrepareFailed;
+    Result result = transaction.wait(idleDeadline, Result::IdleTimeout,
+        [&transport]() { return transport.idleReady(); });
+    if (result != Result::Completed)
+        return result;
+
+    if (!transaction.time(now))
+        return Result::Fault;
+    if (now >= transaction.end())
+        return Result::IdleTimeout; // No budget remains for a new transmission.
+    const uint64_t startDeadline = std::min(transaction.end(),
+        detail::deadline(now, startTimeoutMs));
+    const bool sent = transport.send(text);
+    if (!transaction.healthy())
+        return Result::Fault;
+    if (!sent)
+        return Result::SendFailed;
+    result = transaction.wait(startDeadline, Result::StartTimeout,
+        [&transport]() { return transport.transmitting(); });
+    if (result != Result::Completed)
+        return result;
+    return transaction.wait(transaction.end(), Result::CompletionTimeout,
+        [&transport]() { return !transport.transmitting(); });
+}
+
+} // namespace identification
+#endif
