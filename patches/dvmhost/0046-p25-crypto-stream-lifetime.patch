+        crypto.setMI(mi.data());
+        crypto.generateKeystream();
+        REQUIRE(crypto.hasValidKeystream());
+        std::array<uint8_t,11> word{};
+        for (unsigned skip = 0; skip < vector.index % 9; ++skip)
+            transform(crypto, vector.algorithm, word.data(), vector.index);
+        word.fill(0);
+        transform(crypto, vector.algorithm, word.data(), vector.index);
+        const auto expected = bytes(vector.expected);
+        REQUIRE(std::memcmp(word.data(), expected.data(), word.size()) == 0);
+    }
+}
