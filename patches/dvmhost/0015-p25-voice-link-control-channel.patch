+TEST_CASE("Periodic voice link control advertises only its actual local group channel", "[p25][multisite][voice-lc]") {
+    // Exercise actual network DFSI and actual protected RF input paths. Decode
+    // the queued RF LDU1 with native interleaving/Hamming/Reed-Solomon checks;
+    // inspecting the LC object before encoding would miss the over-air defect.
+    for (const uint32_t channel : {81U, 125U}) {
+        for (const bool fromNetwork : {false, true}) {
+            for (const bool groupCall : {false, true}) {
+                for (const bool activeList : {false, true}) {
+                    DYNAMIC_SECTION("channel " << channel << ", network " << fromNetwork <<
+                        ", group " << groupCall << ", active list " << activeList) {
+                        SiteNetwork net;
+                        ControllerFixture voice(true, false, false, false, false, &net);
+                        voice.voiceMode(false, channel);
+                        voice.permitVoice("abcde:1");
+                        json::object request, reply;
+                        json::array active;
+                        if (activeList) {
+                            // A CC active list is not a TG-to-channel map. Its
+                            // unrelated TG must never be mapped to this carrier.
+                            for (const uint32_t group : {GROUP + 300U, GROUP}) {
+                                json::value value;
+                                value.set<uint32_t>(group);
+                                active.push_back(value);
+                            }
+                        }
+                        request["active"].set<json::array>(active);
+                        request = wireObject(request);
+                        REQUIRE(voice.rpc.dispatchRequest(RPC_ACTIVE_P25_TG, request, reply));
+                        REQUIRE(reply["status"].get<int>() == network::NetRPC::OK);
+                        const auto feed = [&](DUID::E duid) {
+                            if (fromNetwork) {
+                                net.incoming.push_back(net.encoded(duid, SOURCE, groupCall));
+                                MultiSiteTestAccess::process(*voice.controller);
+                            } else {
+                                REQUIRE(voice.voiceFrame(duid, GROUP, false, groupCall));
+                            }
+                        };
+                        if (!fromNetwork) feed(DUID::HDU);
+                        for (uint32_t i = 0U; i < 8U; ++i) {
+                            feed(DUID::LDU1);
+                            feed(DUID::LDU2);
+                        }
+                        uint32_t ldu1Count = 0U, updates = 0U;
+                        std::array<uint8_t, 1024U> frame{};
+                        while (voice.controller->getFrame(frame.data()) != 0U) {
+                            NID nid(0x293U);
+                            REQUIRE(nid.decode(frame.data() + 2U));
+                            if (nid.getDUID() != DUID::LDU1) continue;
+                            ++ldu1Count;
+                            LC decoded;
+                            // GROUP_UPDT's semantic decoder is upstream-stubbed,
+                            // so retain raw standardized bytes after real FEC.
+                            REQUIRE(decoded.decodeLDU1(frame.data() + 2U, true));
+                            if (decoded.getLCO() != LCO::GROUP_UPDT) continue;
+                            ++updates;
+                            REQUIRE(groupCall);
+                            REQUIRE(activeList);
+                            const ulong64_t payload = decoded.getRS();
+                            REQUIRE(((payload >> 48U) & 0xFFFFU) == ((2U << 12U) | channel));
+                            REQUIRE(((payload >> 32U) & 0xFFFFU) == GROUP);
+                            REQUIRE(((payload >> 16U) & 0x0FFFU) == 0U); // Unused B channel number.
+                            REQUIRE((payload & 0xFFFFU) == 0U); // Unused B TG; B channel ID is ignored.
+                        }
+                        REQUIRE(ldu1Count == 8U);
+                        if (groupCall && activeList) REQUIRE(updates >= 2U);
+                        else REQUIRE(updates == 0U); // No group LC substitution for private/idle lists.
+                    }
+                }
+            }
+        }
+    }
 }
 
