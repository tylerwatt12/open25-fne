+TEST_CASE("Explicit service masks occupy the standardized broadcast octets", "[p25][zero-capacity]") {
+    OSP_SYS_SRV_BCAST broadcast;
+    broadcast.setServices(SystemService::UNIT_REG,
+        SystemService::UNIT_REG | SystemService::GROUP_AFF | SystemService::GROUP_AFF_Q);
+    std::array<uint8_t, P25_TSBK_LENGTH_BYTES> raw{};
+    broadcast.encode(raw.data(), true, true);
+    REQUIRE((raw[0U] & 0x3FU) == TSBKO::OSP_SYS_SRV_BCAST);
+    const std::array<uint8_t, 8U> expected = {0U, 0U, 8U, 0U, 0U, 14U, 0U, 0U};
+    for (uint32_t i = 0U; i < expected.size(); i++)
+        REQUIRE(raw[2U + i] == expected[i]);
+    REQUIRE(edac::CRC::checkCCITT162(raw.data(), raw.size()));
+}
