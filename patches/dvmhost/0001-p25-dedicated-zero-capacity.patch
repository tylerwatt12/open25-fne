@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Offline controller tests. No modem port or network socket is opened. */
+#include "host/Host.h"
+#include "host/p25/Control.h"
+#include "host/modem/port/ModemNullPort.h"
+#include "common/lookups/AffiliationLookup.h"
+#include "common/edac/CRC.h"
+#include "common/p25/lc/tsbk/TSBKFactory.h"
+#include "common/Log.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <memory>
+#include <vector>
+
+using namespace p25;
+using namespace p25::defines;
+using namespace p25::lc;
+using namespace p25::lc::tsbk;
+
+namespace {
+constexpr uint32_t SOURCE = 1001U;
+constexpr uint32_t TARGET = 1002U;
+constexpr uint32_t GROUP = 101U;
+constexpr uint32_t VOICE_CHANNEL = 25U;
+constexpr uint32_t DENIED_SOURCE = 1003U;
+constexpr uint32_t UNKNOWN_SOURCE = 1004U;
+constexpr uint32_t DENIED_GROUP = 102U;
+constexpr uint32_t UNKNOWN_GROUP = 103U;
+
+// Exercise the real scheduler without wall-clock sleeps or a running Host.
+class OfflineScheduler : public packet::ControlSignaling {
+public:
+    explicit OfflineScheduler(Control* controller) : ControlSignaling(controller, false, false, false) {
+        m_ctrlTSDUMBF = false;
+    }
+    using ControlSignaling::writeRF_ControlData;
+};
+
+// Some broadcast decoders in this upstream revision are stubs. Use the shared
+// FEC/CRC decoder and inspect the standardized octets instead of those stubs.
+class WireBlock : public OSP_DENY_RSP {
+public:
+    std::array<uint8_t, 8U> payload(const uint8_t* frame) {
+        std::array<uint8_t, 8U> result{};
+        REQUIRE(TSBK::decode(frame, result.data(), false));
+        return result;
+    }
+};
+
+struct ControllerFixture {
+    ::lookups::ChannelLookup channels;
+    ::lookups::RadioIdLookup radios{"", 0U, false};
+    ::lookups::TalkgroupRulesLookup groups{"", 0U, false};
+    ::lookups::IdenTableLookup identities{"", 0U};
+    ::lookups::RSSIInterpolator rssi;
+    network::NetRPC rpc{"127.0.0.1", 48991U, 0U, "offline-test", false};
+    network::NetRPC* previousRPC = g_RPC;
+    modem::Modem modem{new modem::port::ModemNullPort(), true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U,
+        true, true, false, false, false, false};
+    std::unique_ptr<Control> controller;
+
+    explicit ControllerFixture(bool withCapacity = false, bool sndcp = false, bool strictACL = false) :
+        radios("", 0U, strictACL), groups("", 0U, strictACL) {
+        g_logDisplayLevel = 0U;
+        g_RPC = &rpc;
+        if (strictACL) {
+            radios.addEntry(SOURCE, true, "Allowed radio");
+            radios.addEntry(TARGET, true, "Allowed target");
+            radios.addEntry(DENIED_SOURCE, false, "Disabled radio");
+            groups.addEntry(GROUP, 1U, true);
+            groups.addEntry(DENIED_GROUP, 1U, false);
+        }
+        if (withCapacity) {
+            channels.setRFChData(VOICE_CHANNEL,
+                ::lookups::VoiceChData(2U, VOICE_CHANNEL, "", 0U, ""));
+            channels.addRFCh(VOICE_CHANNEL);
+        }
+        controller = std::make_unique<Control>(true, 0x293U, 1U, 16384U,
+            &modem, nullptr, 120U, 1U, true, &channels, &radios, &groups,
+            &identities, &rssi, false, false, false, false, false);
+        yaml::Node config;
+        const std::string configText = std::string(R"(
+protocols:
+    p25:
+        unitToUnitAvailCheck: false
+        verifyReg: true
+        verifyAff: true
+        inhibitUnauthorized: false
+        sndcpSupport: )") + (sndcp ? "true" : "false") + R"(
+        tduPreambleCount: 0
+        control:
+            enable: true
+            dedicated: true
+            ackRequests: false
+            disableTSDUMBF: true
+            redundantImmediate: false
+system:
+    config:
+        controlCh:
+            notifyEnable: false
+)";
+        REQUIRE(yaml::Parse(config, configText));
+        controller->setOptions(config, false, "N0TEST", ::lookups::VoiceChData(),
+            1U, 1U, 1U, 1U, 2U, 1U, false);
+        controller->setCCRunning(true);
+    }
+
+    ~ControllerFixture() {
+        controller.reset();
+        g_RPC = previousRPC;
+    }
+
+    template<typename Request> void receive(uint32_t source, uint32_t target = 0U) {
+        auto request = std::make_unique<Request>();
+        request->setSrcId(source);
+        request->setDstId(target);
+        std::array<uint8_t, P25_TSDU_FRAME_LENGTH_BYTES + 2U> frame{};
+        REQUIRE(controller->control()->process(frame.data(), frame.size(), std::move(request)));
+    }
+
+    std::vector<std::unique_ptr<TSBK>> drain() {
+        std::vector<std::unique_ptr<TSBK>> result;
+        std::array<uint8_t, 1024U> frame{};
+        uint32_t length;
+        while ((length = controller->getFrame(frame.data())) != 0U) {
+            REQUIRE(length >= P25_TSDU_FRAME_LENGTH_BYTES + 2U);
+            auto block = TSBKFactory::createTSBK(frame.data() + 2U);
+            REQUIRE(block != nullptr);
+            result.push_back(std::move(block));
+        }
+        return result;
+    }
+
+    void receiveRegistration(uint32_t source, uint32_t system = 1U) {
+        // IOSP_U_REG's decoder reads the inbound system ID; its encoder produces
+        // the outbound layout. Decode a raw request so the real handler sees 001.
+        auto request = std::make_unique<IOSP_U_REG>();
+        // Raw decode deliberately verifies its checksum as a real received block.
+        std::array<uint8_t, P25_TSBK_LENGTH_BYTES> raw{};
+        raw[0U] = TSBKO::IOSP_U_REG;
+        const uint64_t registration = (uint64_t(1U) << 36U) | (uint64_t(system) << 24U) | source;
+        for (uint32_t i = 0U; i < 8U; i++)
+            raw[2U + i] = uint8_t(registration >> ((7U - i) * 8U));
+        edac::CRC::addCCITT162(raw.data(), raw.size());
+        REQUIRE(request->decode(raw.data(), true));
+        REQUIRE(request->getSysId() == system);
+        std::array<uint8_t, P25_TSDU_FRAME_LENGTH_BYTES + 2U> frame{};
+        REQUIRE(controller->control()->process(frame.data(), frame.size(), std::move(request)));
+    }
+
+    void registerAndAffiliate() {
+        receiveRegistration(SOURCE);
+        REQUIRE(controller->affiliations()->isUnitReg(SOURCE));
+        drain();
+        receive<IOSP_GRP_AFF>(SOURCE, GROUP);
+        REQUIRE(controller->affiliations()->isGroupAff(SOURCE, GROUP));
+        drain();
+        controller->affiliations()->unitReg(TARGET);
+    }
+
+    void requireAccessResponse(uint8_t opcode, uint8_t response) {
+        auto replies = drain();
+        // Exactly one response also proves automatic radio inhibit was not sent.
+        REQUIRE(replies.size() == 1U);
+        REQUIRE(replies.front()->getLCO() == opcode);
+        const uint8_t* raw = replies.front()->getDecodedRaw();
+        REQUIRE(raw != nullptr);
+        REQUIRE(edac::CRC::checkCCITT162(raw, P25_TSBK_LENGTH_BYTES));
+        // These upstream IOSP decoders parse inbound request layouts, so inspect
+        // the response's actual transmitted bits rather than getResponse().
+        const uint8_t actual = opcode == TSBKO::IOSP_U_REG ? ((raw[2U] >> 4U) & 3U) : (raw[2U] & 3U);
+        REQUIRE(actual == response);
+        REQUIRE(controller->affiliations()->grantSize() == 0U);
+        REQUIRE(channels.rfChDataSize() == 0U);
+        REQUIRE(channels.rfChSize() == 0U);
+    }
+
+    void requireNoResources(uint8_t service) {
+        REQUIRE(controller->affiliations()->grantSize() == 0U);
+        REQUIRE(channels.rfChDataSize() == 0U);
+        REQUIRE(channels.rfChSize() == 0U);
+        auto responses = drain();
+        REQUIRE(responses.size() == 1U);
+        REQUIRE(responses.front()->getLCO() == TSBKO::OSP_DENY_RSP);
+        REQUIRE(responses.front()->getResponse() == ReasonCode::DENY_NO_RF_RSRC_AVAIL);
+        REQUIRE(responses.front()->getService() == service);
+    }
+};
+}
+
+TEST_CASE("An empty allocator preserves access state but never invents a channel", "[p25][zero-capacity]") {
+    ::lookups::ChannelLookup channels;
+    ::lookups::AffiliationLookup affiliations("offline", &channels, false);
+    affiliations.unitReg(SOURCE);
+    affiliations.groupAff(SOURCE, GROUP);
+    REQUIRE(affiliations.isUnitReg(SOURCE));
+    REQUIRE(affiliations.isGroupAff(SOURCE, GROUP));
+    for (bool group : {false, true}) {
+        for (bool network : {false, true}) {
+            REQUIRE_FALSE(affiliations.grantCh(GROUP, SOURCE, 1U, group, network));
+            REQUIRE(affiliations.grantSize() == 0U);
+            REQUIRE(affiliations.getGrantedRFChCnt() == 0U);
+            REQUIRE(channels.rfChDataSize() == 0U);
+            REQUIRE(channels.rfChSize() == 0U);
+        }
+    }
+    channels.setRFChData(VOICE_CHANNEL, ::lookups::VoiceChData(2U, VOICE_CHANNEL, "", 0U, ""));
+    REQUIRE(channels.addRFCh(VOICE_CHANNEL));
+    REQUIRE(affiliations.grantCh(GROUP, SOURCE, 1U, true, false));
+    REQUIRE(affiliations.getGrantedCh(GROUP) == VOICE_CHANNEL);
+    REQUIRE_FALSE(channels.isRFChAvailable());
+    REQUIRE(affiliations.releaseGrant(GROUP, false));
+    REQUIRE(channels.isRFChAvailable());
+    REQUIRE(affiliations.grantCh(TARGET, SOURCE, 1U, false, true));
+    affiliations.clock(1001U);
+    REQUIRE(affiliations.grantSize() == 0U);
+    REQUIRE(channels.rfChSize() == 1U);
+}
+
+TEST_CASE("Zero-capacity CC accepts access signaling and denies traffic on the wire", "[p25][zero-capacity]") {
+    ControllerFixture fixture(false, true);
+    fixture.registerAndAffiliate();
+    SECTION("group voice request") {
+        fixture.receive<IOSP_GRP_VCH>(SOURCE, GROUP);
+        fixture.requireNoResources(TSBKO::IOSP_GRP_VCH);
+    }
+    SECTION("individual voice request") {
+        fixture.receive<IOSP_UU_VCH>(SOURCE, TARGET);
+        fixture.requireNoResources(TSBKO::IOSP_UU_VCH);
+    }
+    SECTION("SNDCP request") {
+        fixture.receive<ISP_SNDCP_CH_REQ>(SOURCE);
+        fixture.requireNoResources(TSBKO::ISP_SNDCP_CH_REQ);
+    }
+}
+
+TEST_CASE("Network traffic cannot manufacture zero-capacity grants", "[p25][zero-capacity]") {
+    ControllerFixture fixture;
+    fixture.registerAndAffiliate();
+    bool group = true;
+    SECTION("group demand") { group = true; }
+    SECTION("individual demand") { group = false; }
+    std::unique_ptr<TSBK> request = group ? std::unique_ptr<TSBK>(new IOSP_GRP_VCH()) :
+        std::unique_ptr<TSBK>(new IOSP_UU_VCH());
+    request->setSrcId(SOURCE);
+    request->setDstId(group ? GROUP : TARGET);
+    request->setGrpVchId(2U);
+    request->setGrpVchNo(VOICE_CHANNEL);
+    request->setLastBlock(true);
+    std::array<uint8_t, P25_TSDU_FRAME_LENGTH_BYTES> frame{};
+    request->encode(frame.data());
+    lc::LC control;
+    data::LowSpeedData lsd;
+    DUID::E duid = DUID::TSDU;
+    REQUIRE(fixture.controller->control()->processNetwork(frame.data(), frame.size(), control, lsd, duid));
+    REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+    REQUIRE(fixture.channels.rfChDataSize() == 0U);
+    REQUIRE(fixture.drain().empty());
+}
+
+TEST_CASE("A configured traffic resource produces and recycles a real grant", "[p25][zero-capacity]") {
+    ControllerFixture fixture(true);
+    fixture.registerAndAffiliate();
+    fixture.receive<IOSP_GRP_VCH>(SOURCE, GROUP);
+    REQUIRE(fixture.controller->affiliations()->getGrantedCh(GROUP) == VOICE_CHANNEL);
+    REQUIRE(fixture.controller->affiliations()->grantSize() == 1U);
+    auto responses = fixture.drain();
+    REQUIRE_FALSE(responses.empty());
+    for (const auto& response : responses) {
+        REQUIRE(response->getLCO() == TSBKO::IOSP_GRP_VCH);
+        REQUIRE(response->getGrpVchNo() == VOICE_CHANNEL);
+    }
+    REQUIRE(fixture.controller->affiliations()->releaseGrant(GROUP, false));
+    REQUIRE(fixture.channels.rfChSize() == 1U);
+    fixture.controller->reset();
+    fixture.receive<IOSP_UU_VCH>(SOURCE, TARGET);
+    REQUIRE(fixture.controller->affiliations()->getGrantedCh(TARGET) == VOICE_CHANNEL);
+    REQUIRE_FALSE(fixture.controller->affiliations()->isGroup(TARGET));
+}
+
+TEST_CASE("Broadcast services describe zero inventory rather than temporary congestion", "[p25][zero-capacity]") {
+    bool capacity = false;
+    SECTION("zero inventory") { capacity = false; }
+    SECTION("real inventory entirely busy") { capacity = true; }
+    ControllerFixture fixture(capacity);
+    if (capacity) {
+        REQUIRE(fixture.controller->affiliations()->grantCh(GROUP, SOURCE, 10U, true, false));
+        REQUIRE_FALSE(fixture.channels.isRFChAvailable());
+    }
+    OfflineScheduler scheduler(fixture.controller.get());
+    std::array<uint8_t, 1024U> frame{};
+    WireBlock block;
+    scheduler.writeRF_ControlData(2U, 2U, false);
+    REQUIRE(fixture.controller->getFrame(frame.data()) > 0U);
+    auto rfss = block.payload(frame.data() + 2U);
+    REQUIRE(block.getLCO() == TSBKO::OSP_RFSS_STS_BCAST);
+    REQUIRE(rfss[7U] == (capacity ? uint8_t(ServiceClass::REG | ServiceClass::VOICE) : uint8_t(ServiceClass::REG)));
+
+    scheduler.writeRF_ControlData(2U, 6U, false);
+    REQUIRE(fixture.controller->getFrame(frame.data()) > 0U);
+    auto services = block.payload(frame.data() + 2U);
+    if (capacity) {
+        REQUIRE(block.getLCO() == TSBKO::OSP_SNDCP_CH_ANN);
+    } else {
+        REQUIRE(block.getLCO() == TSBKO::OSP_SYS_SRV_BCAST);
+        // Full TSBK octet 2 is reserved; 3..5 are available, 6..8
+        // supported and octet 9 is the request-priority field.
+        REQUIRE(services[0U] == 0U);
+        REQUIRE(services[7U] == 0U);
+        const uint32_t available = (uint32_t(services[1U]) << 16U) | (uint32_t(services[2U]) << 8U) | services[3U];
+        const uint32_t supported = (uint32_t(services[4U]) << 16U) | (uint32_t(services[5U]) << 8U) | services[6U];
+        const uint32_t accessServices = SystemService::UNIT_REG | SystemService::GROUP_AFF | SystemService::GROUP_AFF_Q;
+        REQUIRE(available == accessServices);
+        REQUIRE(supported == accessServices);
+        scheduler.setConvFallback(true);
+        REQUIRE(fixture.controller->getFrame(frame.data()) == 0U);
+        scheduler.writeRF_ControlData(2U, 2U, false);
+        REQUIRE(fixture.controller->getFrame(frame.data()) > 0U);
+        block.payload(frame.data() + 2U);
+        REQUIRE(block.getLCO() == TSBKO::OSP_RFSS_STS_BCAST);
+    }
+}
