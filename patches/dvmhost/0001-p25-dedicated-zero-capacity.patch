+TEST_CASE("Registration domain rejection and expiration preserve the empty-capacity invariant", "[p25][zero-capacity]") {
+    ControllerFixture fixture(false, false, true);
+    SECTION("wrong system registration") {
+        fixture.receiveRegistration(SOURCE, 2U);
+        fixture.requireAccessResponse(TSBKO::IOSP_U_REG, ResponseCode::DENY);
+        REQUIRE_FALSE(fixture.controller->affiliations()->isUnitReg(SOURCE));
+    }
+    SECTION("registration expiry removes affiliation and permits fresh access") {
+        fixture.registerAndAffiliate();
+        const uint32_t timeout = fixture.controller->affiliations()->unitRegTimeout(SOURCE);
+        REQUIRE(timeout > 0U);
+        fixture.controller->reset();
+        REQUIRE(fixture.controller->affiliations()->isUnitReg(SOURCE));
+        REQUIRE(fixture.controller->affiliations()->isGroupAff(SOURCE, GROUP));
+        fixture.controller->affiliations()->clock(timeout * 1000U + 1U);
+        REQUIRE_FALSE(fixture.controller->affiliations()->isUnitReg(SOURCE));
+        REQUIRE_FALSE(fixture.controller->affiliations()->isGroupAff(SOURCE, GROUP));
+        REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+        REQUIRE(fixture.channels.rfChDataSize() == 0U);
+        auto commands = fixture.drain();
+        REQUIRE_FALSE(commands.empty());
+        for (const auto& command : commands)
+            REQUIRE(command->getLCO() == TSBKO::OSP_U_REG_CMD);
+        fixture.receiveRegistration(SOURCE);
+        fixture.requireAccessResponse(TSBKO::IOSP_U_REG, ResponseCode::ACCEPT);
+        fixture.receive<IOSP_GRP_AFF>(SOURCE, GROUP);
+        fixture.requireAccessResponse(TSBKO::IOSP_GRP_AFF, ResponseCode::ACCEPT);
+        REQUIRE(fixture.controller->affiliations()->isGroupAff(SOURCE, GROUP));
+    }
+}
