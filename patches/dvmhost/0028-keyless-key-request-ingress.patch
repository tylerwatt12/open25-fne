+// SPDX-License-Identifier: GPL-2.0-only
+// Real FNE packet dispatcher with an authenticated peer; no socket is opened.
+#include "fne/HostFNE.h"
+#include "fne/FNEMain.h"
+#include "fne/network/TrafficNetwork.h"
+#include "common/p25/kmm/KMMModifyKey.h"
+#include "common/Log.h"
+#include <catch2/catch_test_macros.hpp>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <vector>
+#include <netinet/in.h>
+
+namespace network {
+struct KeyIngressTestAccess {
+    static void keys(TrafficNetwork& network, bool kmf, CryptoContainer* keys) {
+        network.m_kmfServicesEnabled = kmf;
+        network.m_cryptoLookup = keys;
+    }
+    static void peer(TrafficNetwork& network, uint32_t id, FNEPeerConnection* connection) {
+        if (connection) network.m_peers[id] = connection;
+        else network.m_peers.erase(id);
+    }
+    static void receive(TrafficNetwork& network, const std::vector<uint8_t>& payload) {
+        auto* request = new NetPacketRequest();
+        request->obj = &network;
+        request->length = int(payload.size());
+        request->buffer = new uint8_t[payload.size()];
+        std::memcpy(request->buffer, payload.data(), payload.size());
+        request->fneHeader.setFunction(NET_FUNC::KEY_REQ);
+        request->fneHeader.setPeerId(501U);
+        request->rtpHeader.setSSRC(501U);
+        auto* address = reinterpret_cast<sockaddr_in*>(&request->address);
+        address->sin_family = AF_INET;
+        address->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        request->pktRxTime = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+        TrafficNetwork::taskNetworkRx(request); // owns and frees request/buffer
+    }
+};
+}
+
+namespace {
+struct CountingKeys : CryptoContainer {
+    unsigned lookups = 0U;
+    CountingKeys(bool enabled) : CryptoContainer("", "", 0U, enabled) {}
+    EKCKeyItem find(uint32_t) override { ++lookups; return EKCKeyItem(); }
+};
+struct Fixture {
+    bool stopped = (g_killed = true);
+    HostFNE host{"unused-test-configuration"};
+    ::lookups::PeerListLookup peers{"", 0U, false};
+    CountingKeys keys;
+    network::TrafficNetwork network{&host,"127.0.0.1",49994U,100101001U,"unopened-test-secret","Unopened key ingress",false,false,false,false,
+        false,true,false,false,0U,false,false,false,5U,0U,1U};
+    network::FNEPeerConnection peer;
+    Fixture(bool keyless, bool kmf, bool enabled) : keys(enabled) {
+        g_logDisplayLevel = 0U;
+        network.setLookups(nullptr,nullptr,&peers,&keys,nullptr);
+        if (keyless) {
+            yaml::Node config;
+            REQUIRE(yaml::Parse(config,std::string(R"(
+p25System:
+    netId: 1
+    sysId: 1
+p25Sites:
+    - controlPeerId: 501
+      voicePeerIds: []
+      consolePeerIds: []
+      talkgroups: []
+)")));
+            network.setOptions(config,false);
+        }
+        network::KeyIngressTestAccess::keys(network,kmf,&keys);
+        peer.id(501U);
+        peer.connected(true);
+        peer.address("127.0.0.1");
+        network::KeyIngressTestAccess::peer(network,501U,&peer);
+    }
+    ~Fixture() { network::KeyIngressTestAccess::peer(network,501U,nullptr); }
+};
+std::vector<uint8_t> keyRequest() {
+    p25::kmm::KMMModifyKey frame;
+    frame.setSrcLLId(10001U);
+    frame.setDstLLId(10002U);
+    frame.setAlgId(p25::defines::ALGO_AES_256);
+    frame.setKId(7U);
+    std::vector<uint8_t> packet(11U + frame.fullLength());
+    frame.encode(packet.data() + 11U);
+    return packet;
+}
+}
+
+TEST_CASE("keyless or disabled KMF drops authenticated key requests before KMM parsing", "[keyless-ingress]") {
+    struct Policy { bool keyless, kmf, enabled; };
+    for (const auto policy : {Policy{true,true,true}, Policy{false,false,true}, Policy{false,true,false}}) {
+        Fixture fixture(policy.keyless,policy.kmf,policy.enabled);
+        // A well-formed request would reach find() if the ingress gate were absent.
+        network::KeyIngressTestAccess::receive(fixture.network,keyRequest());
+        REQUIRE(fixture.keys.lookups == 0U);
+        // Exact short allocations and forged lengths/counts; these
+        // must never reach the legacy pointer-only KMM decoder on this role.
+        for (size_t length = 1U; length <= 96U; ++length) {
+            std::vector<uint8_t> malformed(length,0xFFU);
+            if (length > 11U) malformed[11U] = p25::defines::KMM_MessageType::MODIFY_KEY_CMD;
+            network::KeyIngressTestAccess::receive(fixture.network,malformed);
+            REQUIRE(fixture.keys.lookups == 0U);
+        }
+    }
+}
+
+TEST_CASE("keyless gate preserves explicit enabled unmanaged KMF request path", "[keyless-ingress]") {
+    Fixture fixture(false,true,true);
+    network::KeyIngressTestAccess::receive(fixture.network,keyRequest());
+    REQUIRE(fixture.keys.lookups == 1U);
+}
