+// SPDX-License-Identifier: GPL-2.0-only
+// Real peer FrameQueue/Network::clock ingress over an in-memory UDP socket.
+#include "common/network/Network.h"
+#include "common/p25/kmm/KMMModifyKey.h"
+#include <catch2/catch_test_macros.hpp>
+#include <algorithm>
+#include <cstring>
+#include <vector>
+#include <netinet/in.h>
+
+namespace {
+class MemorySocket : public network::udp::Socket {
+public:
+    std::vector<uint8_t> incoming;
+    sockaddr_storage source{};
+    unsigned reads = 0U;
+    ssize_t read(uint8_t* out, uint32_t length, sockaddr_storage& address, uint32_t& addressLength) noexcept override {
+        if (incoming.empty()) return 0;
+        const size_t count = std::min(size_t(length), incoming.size());
+        std::memcpy(out,incoming.data(),count);
+        address = source;
+        addressLength = sizeof(sockaddr_in);
+        incoming.clear();
+        ++reads;
+        return ssize_t(count);
+    }
+    bool write(const uint8_t* data, uint32_t length, const sockaddr_storage&, uint32_t, ssize_t* written=nullptr) noexcept override {
+        incoming.assign(data,data+length);
+        if (written) *written=length;
+        return true;
+    }
+};
+class Peer : public network::Network {
+public:
+    MemorySocket* wire;
+    Peer() : Network("127.0.0.1",48993U,0U,12345U,"public-test",false,false,
+        false,true,false,false,false,false,false,false,false,false) {
+        delete m_frameQueue;
+        delete m_socket;
+        wire = new MemorySocket();
+        auto* source = reinterpret_cast<sockaddr_in*>(&m_addr);
+        source->sin_family=AF_INET;
+        source->sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+        source->sin_port=htons(48993U);
+        m_addrLen=sizeof(sockaddr_in);
+        wire->source=m_addr;
+        m_socket=wire;
+        m_frameQueue=new network::FrameQueue(m_socket,m_peerId,false);
+        m_enabled=true;
+        m_status=network::NET_STAT_RUNNING;
+    }
+    void receive(const std::vector<uint8_t>& payload) {
+        REQUIRE(m_frameQueue->write(payload.data(),uint32_t(payload.size()),1U,m_peerId,999U,
+            {network::NET_FUNC::KEY_RSP,network::NET_SUBFUNC::NOP},1U,m_addr,m_addrLen));
+        const unsigned before=wire->reads;
+        clock(0U);
+        REQUIRE(wire->reads==before+1U);
+        REQUIRE(wire->incoming.empty());
+    }
+};
+std::vector<uint8_t> reply() {
+    p25::kmm::KMMModifyKey frame;
+    frame.setAlgId(p25::defines::ALGO_AES_256);
+    frame.setKId(7U);
+    p25::kmm::KeysetItem keyset;
+    keyset.algId(p25::defines::ALGO_AES_256);
+    keyset.keyLength(32U);
+    p25::kmm::KeyItem key;
+    key.kId(7U);
+    uint8_t publicMaterial[32U];
+    std::memset(publicMaterial,0x42,sizeof(publicMaterial));
+    key.setKey(publicMaterial,sizeof(publicMaterial));
+    keyset.push_back(key);
+    frame.setKeysetItem(keyset);
+    std::vector<uint8_t> packet(11U+frame.fullLength());
+    frame.encode(packet.data()+11U);
+    return packet;
+}
+}
+
+TEST_CASE("peer with no key callback rejects malformed KEY_RSP before KMM parsing", "[keyless-ingress]") {
+    Peer peer;
+    for (size_t length=1U;length<=96U;++length) {
+        std::vector<uint8_t> malformed(length,0xFFU);
+        if(length>11U) malformed[11U]=p25::defines::KMM_MessageType::MODIFY_KEY_CMD;
+        peer.receive(malformed);
+    }
+    peer.receive(reply());
+}
+
+TEST_CASE("explicit key callback still receives a valid KEY_RSP", "[keyless-ingress]") {
+    Peer peer;
+    unsigned received=0U;
+    peer.setKeyResponseCallback([&](p25::kmm::KeyItem key,uint8_t algorithm,uint8_t length) {
+        REQUIRE(key.kId()==7U);
+        REQUIRE(algorithm==p25::defines::ALGO_AES_256);
+        REQUIRE(length==32U);
+        ++received;
+    });
+    peer.receive(reply());
+    REQUIRE(received==1U);
+}
