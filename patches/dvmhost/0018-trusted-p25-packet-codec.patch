+// SPDX-License-Identifier: GPL-2.0-only
+// Keyless P25 media transport. Neither vocoding nor traffic-key processing runs
+// in this Site-facing path; encrypted IMBE and its public metadata stay opaque.
+#include "HostBridge.h"
+#include "common/p25/dfsi/LC.h"
+#include "common/p25/dfsi/DFSIDefines.h"
+#include "common/Utils.h"
+#include <chrono>
+#include <cstring>
+
+namespace {
+const unsigned packetHeader = 64;
+const unsigned voiceOffsets[9] = {10,26,55,80,105,130,155,180,204};
+const unsigned dfsiOffsets[9] = {24,46,60,77,94,111,128,145,162};
+const unsigned dfsiLengths[9] = {22,14,17,17,17,17,17,17,16};
+uint16_t read16(const uint8_t* p) { return (uint16_t(p[0])<<8)|p[1]; }
+uint32_t read32(const uint8_t* p) { return (uint32_t(p[0])<<24)|(uint32_t(p[1])<<16)|(uint32_t(p[2])<<8)|p[3]; }
+uint64_t read64(const uint8_t* p) { return (uint64_t(read32(p))<<32)|read32(p+4); }
+void write16(uint8_t* p,uint16_t n) { p[0]=n>>8;p[1]=n; }
+void write32(uint8_t* p,uint32_t n) { p[0]=n>>24;p[1]=n>>16;p[2]=n>>8;p[3]=n; }
+void write64(uint8_t* p,uint64_t n) { write32(p,n>>32);write32(p+4,n); }
+}
+
+void HostBridge::writeOpaqueP25(uint32_t src,uint32_t dst,const uint8_t* imbe,uint8_t index,bool end)
+{
+    uint8_t packet[packetHeader+11]{};
+    std::memcpy(packet,"DV25",4);packet[4]=16;packet[6]=m_opaqueRxAlgorithm;packet[7]=index;
+    write16(packet+8,m_opaqueRxKey);write16(packet+10,end?1:0);
+    write32(packet+12,src);write32(packet+16,dst);write64(packet+24,++m_opaqueRxSequence);
+    std::memcpy(packet+32,m_opaqueRxToken,16);
+    if (m_opaqueRxAlgorithm==0x84) std::memcpy(packet+48,m_opaqueRxMI,9);
+    write16(packet+58,end?0:11);
+    if (!end) std::memcpy(packet+packetHeader,imbe,11);
+    sockaddr_storage address;uint32_t addressLength;
+    if (network::udp::Socket::lookup(m_udpSendAddress,m_udpSendPort,address,addressLength)==0)
+        m_udpAudioSocket->write(packet,end?packetHeader:packetHeader+11,address,addressLength);
+}
+
+void HostBridge::processOpaqueP25Network(uint8_t* buffer,uint32_t length)
+{
+    using namespace p25;
+    using namespace p25::defines;
+    using namespace p25::dfsi::defines;
+    if (length<24 || m_txMode!=TX_MODE_P25 || m_trafficFromUDP || buffer[4]!=LCO::GROUP) return;
+    uint32_t src=GET_UINT24(buffer,5);
+    uint32_t dst=GET_UINT24(buffer,8);
+    if (!src || src>0xfffffb || dst!=m_dstId || dst>65534) return;
+    auto duid=static_cast<DUID::E>(buffer[22]);
+    if (duid==DUID::TDU || duid==DUID::TDULC) {
+        if (buffer[14]&network::NET_CTRL_GRANT_DEMAND) return;
+        if (m_opaqueRxSequence) writeOpaqueP25(src,dst,nullptr,0,true);
+        m_opaqueRxSequence=0;m_opaqueRxAlgorithm=0;m_rxStreamId=0;m_callInProgress=false;
+        m_networkWatchdog.stop();m_network->resetP25();return;
+    }
+    if ((duid!=DUID::LDU1 && duid!=DUID::LDU2) || length<178) return;
+    uint32_t stream=m_network->getP25StreamId();
+    if (stream!=m_rxStreamId || !m_callInProgress) {
+        m_opaqueRxSequence=0;m_opaqueRxAlgorithm=0;m_opaqueRxKey=0;
+        std::memset(m_opaqueRxMI,0,9);std::memset(m_opaqueRxToken,0,16);
+        uint64_t now=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        write64(m_opaqueRxToken,now);write32(m_opaqueRxToken+8,stream);write32(m_opaqueRxToken+12,src);
+        m_rxStreamId=stream;m_callInProgress=true;
+    }
+    m_networkWatchdog.start();
+    // HDU metadata contains the current superframe's MI. Late entry without
+    // this metadata waits for LDU2's next MI rather than guessing clear audio.
+    if (duid==DUID::LDU1 && length>=193 && buffer[180]==FrameType::HDU_VALID) {
+        m_opaqueRxAlgorithm=buffer[181];m_opaqueRxKey=GET_UINT16(buffer,182);
+        std::memcpy(m_opaqueRxMI,buffer+184,9);
+    }
+    lc::LC control;control.setLCO(LCO::GROUP);control.setSrcId(src);control.setDstId(dst);
+    data::LowSpeedData lsd;
+    dfsi::LC dfsiLC(control,lsd);
+    uint8_t words[9][11]{};
+    const uint8_t first=duid==DUID::LDU1?DFSIFrameType::LDU1_VOICE1:DFSIFrameType::LDU2_VOICE10;
+    for (unsigned i=0;i<9;i++) {
+        if (length<dfsiOffsets[i]+dfsiLengths[i] || buffer[dfsiOffsets[i]]!=first+i) return;
+        dfsiLC.setFrameType(static_cast<DFSIFrameType::E>(first+i));
+        if (duid==DUID::LDU1) dfsiLC.decodeLDU1(buffer+dfsiOffsets[i],words[i]);
+        else dfsiLC.decodeLDU2(buffer+dfsiOffsets[i],words[i]);
+    }
+    const bool known=(m_opaqueRxAlgorithm==0x80 && m_opaqueRxKey==0) || (m_opaqueRxAlgorithm==0x84 && m_opaqueRxKey!=0);
+    if (known) for (unsigned i=0;i<9;i++) writeOpaqueP25(src,dst,words[i],uint8_t(i+(duid==DUID::LDU2?9:0)),false);
+    // The LDU2 encryption sync applies to the NEXT superframe, never the nine
+    // encrypted codewords just exported above.
+    if (duid==DUID::LDU2) {
+        m_opaqueRxAlgorithm=dfsiLC.control()->getAlgId();m_opaqueRxKey=dfsiLC.control()->getKId();
+        dfsiLC.control()->getMI(m_opaqueRxMI);
+    }
+}
+
+void HostBridge::processOpaqueP25UDP(const uint8_t* packet,uint32_t length)
+{
+    using namespace p25;
+    using namespace p25::defines;
+    if (length<packetHeader || std::memcmp(packet,"DV25",4) || packet[4]!=16 || packet[5] || length!=packetHeader+read16(packet+58)) return;
+    uint32_t src=read32(packet+12),dst=read32(packet+16);uint16_t flags=read16(packet+10),key=read16(packet+8);
+    uint64_t sequence=read64(packet+24);uint8_t algorithm=packet[6],index=packet[7];
+    if (!src || src>0xfffffb || dst!=m_dstId || (flags&~1U)) return;
+    if (flags&1) {
+        if (length==packetHeader && m_trafficFromUDP && std::memcmp(packet+32,m_opaqueTxToken,16)==0) callEnd(src,dst);
+        return;
+    }
+    if (length!=packetHeader+11 || !sequence || index>17 || !((algorithm==0x80 && key==0)||(algorithm==0x84 && key!=0))) return;
+    bool fresh=!m_trafficFromUDP || std::memcmp(packet+32,m_opaqueTxToken,16)!=0 || m_udpSrcId!=src;
+    if (fresh) {
+        if (index!=0) return;
+        if (m_trafficFromUDP) callEnd(m_udpSrcId,m_dstId);
+        m_callInProgress=false;m_networkWatchdog.stop();m_rxStreamId=0;m_opaqueRxSequence=0;
+        m_p25N=0;m_opaqueTxSequence=0;m_opaqueTxAlgorithm=algorithm;m_opaqueTxKey=key;
+        std::memcpy(m_opaqueTxToken,packet+32,16);
+    }
+    if (sequence<=m_opaqueTxSequence || algorithm!=m_opaqueTxAlgorithm || key!=m_opaqueTxKey) return;
+    if (index!=m_p25N) {
+        // A partial LDU is discarded on a network gap. Rejoin on a complete
+        // LDU boundary; never fill encrypted gaps with clear silence.
+        if (index!=0 && index!=9) return;
+        m_p25N=index;
+    }
+    if (index==0 || index==9) std::memset(index<9?m_netLDU1:m_netLDU2,0,225);
+    std::memcpy((index<9?m_netLDU1:m_netLDU2)+voiceOffsets[index%9],packet+packetHeader,11);
+    m_udpSrcId=src;m_udpDstId=dst;m_trafficFromUDP=true;m_opaqueTxSequence=sequence;
+    m_udpInactivity.received();m_udpDropTime.start();
+    if (index==8 || index==17) {
+        lc::LC control;control.setLCO(LCO::GROUP);control.setGroup(true);control.setPriority(4);
+        control.setSrcId(src);control.setDstId(dst);control.setAlgId(algorithm);control.setKId(key);control.setEncrypted(algorithm!=0x80);
+        uint8_t mi[9]{};if (algorithm!=0x80) std::memcpy(mi,packet+48,9);
+        if (index==17 && algorithm!=0x80) {
+            // LDU2 transports the next MI. Advancing its public LFSR needs no key.
+            p25::crypto::P25Crypto miSync;miSync.setMI(mi);miSync.generateNextMI();miSync.getMI(mi);
+        }
+        control.setMI(mi);data::LowSpeedData lsd;
+        uint8_t controlByte=network::NET_CTRL_SWITCH_OVER;
+        if (algorithm!=0x80) controlByte|=network::NET_CTRL_GRANT_ENCRYPT;
+        if (index==8) m_network->writeP25LDU1(control,lsd,m_netLDU1,FrameType::HDU_VALID,controlByte);
+        else m_network->writeP25LDU2(control,lsd,m_netLDU2,controlByte);
+        m_txStreamId=m_network->getP25StreamId();
+    }
+    m_p25N=(index+1)%18;
+}
