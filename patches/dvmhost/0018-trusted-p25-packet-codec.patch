+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace {
+constexpr size_t Header = 64;
+constexpr uint8_t Clear = 0x80, AES256 = 0x84;
+uint16_t u16(const uint8_t* p) { return (uint16_t(p[0]) << 8) | p[1]; }
+uint32_t u32(const uint8_t* p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3]; }
+uint64_t u64(const uint8_t* p) { return (uint64_t(u32(p)) << 32) | u32(p + 4); }
+void put16(uint8_t* p, uint16_t n) { p[0] = n >> 8; p[1] = n; }
+void put32(uint8_t* p, uint32_t n) { p[0] = n >> 24; p[1] = n >> 16; p[2] = n >> 8; p[3] = n; }
+using Key = std::array<uint8_t, 32>;
+struct Keys {
+    std::map<uint16_t, Key> values;
+    ~Keys() { for (auto& entry : values) OPENSSL_cleanse(entry.second.data(), entry.second.size()); }
+    bool load(const char* path) {
+        if (std::strcmp(path, "-") == 0) return true;
+#if !defined(_WIN32)
+        int fd = ::open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+        if (fd < 0) return false;
+        struct stat info{};
+        if (::fstat(fd, &info) || !S_ISREG(info.st_mode) || info.st_uid != ::geteuid() || (info.st_mode & 0077) || info.st_size > 65536) { ::close(fd); return false; }
+        std::string text;
+        char buffer[1024];
+        ssize_t count;
+        while ((count = ::read(fd, buffer, sizeof(buffer))) > 0) text.append(buffer, size_t(count));
+        ::close(fd);
+        OPENSSL_cleanse(buffer, sizeof(buffer));
+        if (count < 0) return false;
+        std::istringstream input(text);
+#else
+        std::ifstream input(path);
+        if (!input) return false;
+#endif
+        std::string line;
+        while (std::getline(input, line)) {
+            if (line.empty()) continue;
+            auto first = line.find(':'), second = line.find(':', first == std::string::npos ? first : first + 1);
+            if (first == std::string::npos || second == std::string::npos || line.size() - second - 1 != 64) return false;
+            std::string alg = line.substr(0, first), kid = line.substr(first + 1, second - first - 1);
+            if (alg != "132" || kid.empty() || kid.find_first_not_of("0123456789") != std::string::npos) return false;
+            unsigned long id;
+            try { id = std::stoul(kid); } catch (...) { return false; }
+            if (!id || id > 65535 || values.count(uint16_t(id))) return false;
+            Key key{};
+            for (size_t i = 0; i < key.size(); i++) {
+                auto digit = [](char c) -> int { if (c >= '0' && c <= '9') return c - '0'; if (c >= 'a' && c <= 'f') return c - 'a' + 10; if (c >= 'A' && c <= 'F') return c - 'A' + 10; return -1; };
+                int a = digit(line[second + 1 + 2*i]), b = digit(line[second + 2 + 2*i]);
+                if (a < 0 || b < 0) return false;
+                key[i] = uint8_t(a * 16 + b);
+            }
+            values[uint16_t(id)] = key;
+            OPENSSL_cleanse(key.data(), key.size());
+            if (!line.empty()) OPENSSL_cleanse(&line[0], line.size());
+            if (values.size() > 256) return false;
+        }
+#if !defined(_WIN32)
+        if (!text.empty()) OPENSSL_cleanse(&text[0], text.size());
+#endif
+        return true;
+    }
+};
+struct Call {
+    std::unique_ptr<vocoder::MBEEncoder> encoder;
+    std::unique_ptr<vocoder::MBEDecoder> decoder;
+    std::array<uint8_t,9> mi{};
+    uint64_t encodedSequence = 0, decodedSequence = 0, superframe = 0;
+    uint8_t algorithm = Clear;
+    uint16_t key = 0;
+    std::chrono::steady_clock::time_point seen = std::chrono::steady_clock::now();
+};
+void crypt(uint8_t* imbe, const Key& key, const uint8_t* mi, uint8_t index) {
+    p25::crypto::P25Crypto crypto;
+    crypto.setTEKAlgoId(AES256);
+    crypto.setKey(key.data(), 32);
+    crypto.setMI(mi);
+    crypto.generateKeystream();
+    uint8_t skipped[11]{};
+    auto duid = index < 9 ? p25::defines::DUID::LDU1 : p25::defines::DUID::LDU2;
+    for (unsigned i = 0; i < unsigned(index % 9); i++) crypto.cryptAES_IMBE(skipped, duid);
+    crypto.cryptAES_IMBE(imbe, duid);
+    crypto.clearKey();
+}
+std::vector<uint8_t> process(std::vector<uint8_t> request, const Keys& keys, std::map<std::string, Call>& calls) {
