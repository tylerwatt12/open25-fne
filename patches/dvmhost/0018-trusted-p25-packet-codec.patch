+    if (algorithm == AES256) crypt(imbe, keys.values.at(keyID), op == 1 ? call.mi.data() : request.data() + 48, index);
+    if (op == 2) {
+        if (!call.decoder) {
+            call.decoder = std::make_unique<vocoder::MBEDecoder>(vocoder::DECODE_88BIT_IMBE);
+            call.decoder->setGainAdjust(1.0f);
+            call.decoder->setAutoGain(false);
+        }
+        int16_t pcm[160]{};
+        call.decoder->decode(imbe, pcm);
+        response.resize(Header + 320);
+        for (size_t i = 0; i < 160; i++) { response[Header + i*2] = uint8_t(pcm[i]); response[Header + i*2+1] = uint8_t(uint16_t(pcm[i]) >> 8); }
+        OPENSSL_cleanse(pcm, sizeof(pcm));
+        call.decodedSequence = sequence;
+    } else {
+        response.insert(response.end(), imbe, imbe + 11);
+    }
+    OPENSSL_cleanse(imbe, sizeof(imbe));
+    response[5] = 0;
+    put16(response.data() + 58, uint16_t(response.size() - Header));
+    return response;
+}
+}
+
+int packetCodecMain(const char* keyFile) {
+    Keys keys;
+    if (!keys.load(keyFile)) { std::fprintf(stderr, "Packet codec requires an owner-only regular key file with valid AES-256 entries.\n"); return 2; }
+    std::map<std::string, Call> calls;
+    uint8_t prefix[4];
+    while (true) {
+        size_t n = std::fread(prefix, 1, 4, stdin);
+        if (!n && std::feof(stdin)) return 0;
+        if (n != 4) return 3;
+        uint32_t length = u32(prefix);
+        if (length < Header || length > Header + 320) return 3;
+        std::vector<uint8_t> request(length);
+        if (std::fread(request.data(), 1, length, stdin) != length) return 3;
+        auto response = process(std::move(request), keys, calls);
+        put32(prefix, uint32_t(response.size()));
+        if (std::fwrite(prefix, 1, 4, stdout) != 4 || std::fwrite(response.data(), 1, response.size(), stdout) != response.size() || std::fflush(stdout)) return 4;
+    }
+}
