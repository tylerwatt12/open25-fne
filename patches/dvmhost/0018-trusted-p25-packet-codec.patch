+// SPDX-License-Identifier: GPL-2.0-only
+// Local, length-framed codec interface. Traffic keys are read only from a
+// private runtime file; the wire format contains identifiers, never key bytes.
+#include "PacketCodec.h"
+#include "common/p25/Crypto.h"
+#include "common/p25/P25Defines.h"
+#include "vocoder/MBEEncoder.h"
+#include "vocoder/MBEDecoder.h"
+#include <openssl/crypto.h>
+#include <openssl/rand.h>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
