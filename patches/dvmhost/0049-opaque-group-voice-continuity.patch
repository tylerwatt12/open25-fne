+// SPDX-License-Identifier: GPL-2.0-only
+// Offline production-method regression. The only replaced boundaries are the
+// constructor (no devices/threads), outbound Socket::write, and unused TX end.
+// Compile this standalone file; it includes the unmodified production .cpp.
+#if defined(DVM_BRIDGE_OPAQUE_CONTINUITY_STANDALONE)
