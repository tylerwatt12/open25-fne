+// Native FullRate carrier -> CAI payload. Receiver-quality reports remain in the
+// carrier; CAI has no corresponding Et/Er/E1/E4/SF/status fields to transmit.
+#pragma once
+#include "common/p25/FullRate.h"
+#include "common/p25/Audio.h"
+#include "common/p25/P25Utils.h"
+#include "common/p25/data/LowSpeedData.h"
+#include "common/p25/lc/LC.h"
+#include "common/edac/Hamming.h"
+#include "common/edac/RS634717.h"
