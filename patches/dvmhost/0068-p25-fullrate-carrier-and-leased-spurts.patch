+                edac::RS634717 rs;bool ok=false;
+                try { ok=rs.decode24169(decoded.data()); } catch(...) { ok=false; }
+                m_next=ok?context(decoded.data(),decoded[9],uint16_t(decoded[10])<<8|decoded[11]):Context{};
+            }
+        }
+        return m_current.ready?Result::Ready:Result::Pending;
+    }
+private:
+    static Context context(const uint8_t* mi,uint8_t algorithm,uint16_t key) {
+        Context value;value.algorithm=algorithm;
+        if(algorithm==0x80) { value.ready=true;return value; } // Raw clear HDU remains in its own Header.
+        value.key=key;std::memcpy(value.mi.data(),mi,9);
