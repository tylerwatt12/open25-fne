+inline bool fullRateToCAI(uint8_t* data,const fullrate::Batch& batch,bool ldu2) {
+    if(data==nullptr||!fullrate::validBatch(batch,ldu2))return false;
+    Audio audio;
+    for(unsigned i=0;i<9;++i)audio.encode(data,batch.voice[i].bytes.data()+1,i);
+    data::LowSpeedData lsd;
+    lsd.setLSD1(batch.voice[8].bytes[14]);lsd.setLSD2(batch.voice[8].bytes[15]);lsd.encode(data);
+    if(ldu2) {
+        const unsigned start[6]={410,600,788,978,1168,1356},end[6]={452,640,830,1020,1208,1398};
+        for(unsigned i=0;i<6;++i) {
+            const uint8_t* symbols=batch.voice[i+2].bytes.data()+14;uint8_t raw[5]{};
+            for(unsigned word=0;word<4;++word) {
+                bool bits[10]{};
+                for(unsigned j=0;j<6;++j)bits[j]=READ_BIT(symbols,word*6+j);
+                edac::Hamming::encode1063(bits);
+                for(unsigned j=0;j<10;++j)WRITE_BIT(raw,word*10+j,bits[j]);
+            }
+            P25Utils::encode(raw,data,start[i],end[i]);
+        }
+    }
+    return true;
+}
