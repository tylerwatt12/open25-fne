+// SPDX-License-Identifier: GPL-2.0-only
+// Current private native carrier for TIA-102.BACA-B/B-2 FullRate blocks.
+// Exact citations and private policies: fullrate-source-policy.json in the
+// candidate evidence. No FEC, vocoding or traffic keys belong in this codec.
+#ifndef P25_FULL_RATE_H
+#define P25_FULL_RATE_H
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace p25 { namespace fullrate {
+constexpr uint8_t OpaqueOperation = 18U;
+constexpr uint16_t End = 1U, HeaderPresent = 2U;
+constexpr uint8_t Types[18] = {0xC2,0xC3,0xC4,0xC5,0xC6,0xC7,0xC8,0xC9,0x6A,0xCB,0xCC,0x6D,0x6E,0x6F,0x70,0x71,0x72,0x73};
+inline size_t voiceSize(uint8_t type) {
+    for (unsigned i=0;i<18;++i) if (Types[i]==type) return i==8||i==17?17:i>=11&&i<=16?18:14;
+    return 0;
+}
+inline unsigned index(uint8_t type) { for(unsigned i=0;i<18;++i)if(Types[i]==type)return i;return 18; }
+struct Voice {
+    std::array<uint8_t,18> bytes{};
+    size_t size() const { return voiceSize(bytes[0]); }
+};
+struct Header { std::array<uint8_t,18> bytes{}; };
+struct Batch {
+    bool headerPresent=false;
+    Header header;
+    std::array<Voice,9> voice;
+};
+inline bool validHeader(const uint8_t* data,size_t length) {
+    return data!=nullptr && length==18 && (data[17]&0x3FU)==0x10; // SF2 bits, VBB1, private reserved0.
+}
+inline bool parseVoice(const uint8_t* data,size_t length,Voice& out) {
+    if(data==nullptr||length<14||voiceSize(data[0])!=length||(data[13]&3))return false;
+    if(length==17&&(data[16]&0xF0))return false;
+    if(length==18&&(data[17]>80))return false;
+    Voice value;std::memcpy(value.bytes.data(),data,length);out=value;return true;
+}
+inline bool validBatch(const Batch& batch,bool ldu2) {
+    if(batch.headerPresent&&!validHeader(batch.header.bytes.data(),18))return false;
+    for(unsigned i=0;i<9;++i) {
+        const Voice& voice=batch.voice[i];Voice parsed;
+        if(voice.bytes[0]!=Types[i+(ldu2?9:0)]||!parseVoice(voice.bytes.data(),voice.size(),parsed))return false;
+    }
+    return true;
+}
+// FR25 + flags1 + count9 + optionalHeader18 + nine canonical voice blocks.
+inline size_t marshalBatch(const Batch& batch,bool ldu2,uint8_t* out,size_t capacity) {
+    const size_t length=6+(batch.headerPresent?18:0)+(ldu2?153:129);
+    if(out==nullptr||capacity<length||!validBatch(batch,ldu2))return 0;
+    std::memcpy(out,"FR25",4);out[4]=batch.headerPresent?1:0;out[5]=9;size_t pos=6;
+    if(batch.headerPresent){std::memcpy(out+pos,batch.header.bytes.data(),18);pos+=18;}
+    for(const Voice& voice:batch.voice){std::memcpy(out+pos,voice.bytes.data(),voice.size());pos+=voice.size();}
+    return pos;
+}
+inline bool parseBatch(const uint8_t* data,size_t length,bool ldu2,Batch& out) {
+    if(data==nullptr||length<6||std::memcmp(data,"FR25",4)||data[4]>1||data[5]!=9)return false;
+    if(length!=6+(data[4]?18:0)+(ldu2?153:129))return false;
+    Batch value;size_t pos=6;value.headerPresent=data[4]!=0;
+    if(value.headerPresent){if(!validHeader(data+pos,18))return false;std::memcpy(value.header.bytes.data(),data+pos,18);pos+=18;}
+    for(unsigned i=0;i<9;++i){size_t n=voiceSize(Types[i+(ldu2?9:0)]);
+        if(data[pos]!=Types[i+(ldu2?9:0)]||!parseVoice(data+pos,n,value.voice[i]))return false;pos+=n;}
+    out=value;return true;
+}
+inline size_t marshalMedia(const Voice& voice,const Header* header,uint8_t* out,size_t capacity) {
+    Voice parsed;const size_t n=voice.size(),length=n+(header?18:0);
+    if(out==nullptr||capacity<length||!parseVoice(voice.bytes.data(),n,parsed)||(header&&!validHeader(header->bytes.data(),18)))return 0;
+    if(header)std::memcpy(out,header->bytes.data(),18);std::memcpy(out+(header?18:0),voice.bytes.data(),n);return length;
+}
+inline bool parseMedia(const uint8_t* data,size_t length,bool hasHeader,Voice& voice,Header& header) {
+    const size_t offset=hasHeader?18:0;
+    if(length<offset+14||(hasHeader&&!validHeader(data,18)))return false;
+    Voice parsed;if(!parseVoice(data+offset,length-offset,parsed))return false;
+    Header h;if(hasHeader)std::memcpy(h.bytes.data(),data,18);voice=parsed;header=h;return true;
+}
+} }
