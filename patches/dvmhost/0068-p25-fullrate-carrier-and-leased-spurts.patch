+        value.ready=effective!=0;return value;
+    }
+    Context m_current,m_next;
+    uint64_t m_sequence=0;
+    uint8_t m_index=0,m_sf=0,m_fragments=0;
+    std::array<uint8_t,18> m_es{};
+};
+} }
