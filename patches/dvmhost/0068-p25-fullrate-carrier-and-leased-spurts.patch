+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef P25_FULL_RATE_GENERATE_H
+#define P25_FULL_RATE_GENERATE_H
+#include "common/p25/FullRate.h"
+#include "common/p25/Crypto.h"
+#include "common/edac/RS634717.h"
+namespace p25 { namespace fullrate {
+// Only for locally generated speech. Never use this to fabricate RF observations.
+// NID is a required explicit source-policy argument; no RF/default-NAC fallback.
+inline Header generatedHeader(const uint8_t* mi,uint8_t algorithm,uint16_t key,uint8_t manufacturer,uint16_t group,uint16_t nid)
+{
+    Header header;
+    std::memcpy(header.bytes.data(),mi,9);header.bytes[9]=algorithm;
+    header.bytes[10]=uint8_t(key>>8);header.bytes[11]=uint8_t(key);header.bytes[12]=manufacturer;
+    header.bytes[13]=uint8_t(group>>8);header.bytes[14]=uint8_t(group);
+    header.bytes[15]=uint8_t(nid>>8);header.bytes[16]=uint8_t(nid);header.bytes[17]=0x10;
+    return header;
+}
+inline Voice generatedVoice(const uint8_t* imbe,uint8_t index,uint8_t sf,const uint8_t* mi,uint8_t algorithm,uint16_t key)
+{
+    Voice voice;if(index>=18||mi==nullptr||imbe==nullptr)return voice;voice.bytes[0]=Types[index];
+    std::memcpy(voice.bytes.data()+1,imbe,11);voice.bytes[13]=uint8_t((sf&3U)<<2);
+    if(index>=11&&index<=16) {
+        p25::crypto::P25Crypto sync;sync.setMI(mi);sync.generateNextMI();
+        uint8_t rs[18]{};sync.getMI(rs);rs[9]=algorithm;rs[10]=uint8_t(key>>8);rs[11]=uint8_t(key);
+        edac::RS634717 fec;fec.encode24169(rs);
+        std::memcpy(voice.bytes.data()+14,rs+(index-11)*3,3); // Generated status0, not an RF observation.
+    }
+    return voice; // Generated quality/LSD statuses are explicitly error-free.
+}
+
+} }
