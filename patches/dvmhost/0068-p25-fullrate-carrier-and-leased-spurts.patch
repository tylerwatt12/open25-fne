+// The existing source threshold marks these recovered words Mute, without
+// examining encrypted pitch bits or replacing the exported ciphertext.
+void Voice::captureFullRate(const Audio::Result& audio,bool ldu2,uint8_t lsdStatus)
+{
+    if (!ldu2) m_rfSuperframe = uint8_t((m_rfSuperframe + 1U) & 3U);
+    m_rfFullRate=fullrate::Batch{};
+    m_rfFullRate.headerPresent=m_rfHeaderPending;
+    if(m_rfHeaderPending)m_rfFullRate.header=m_rfHeader;
+    for(unsigned i=0;i<9;++i) {
+        auto& b=m_rfFullRate.voice[i].bytes;b[0]=fullrate::Types[i+(ldu2?9:0)];
+        std::memcpy(b.data()+1,audio.words[i].data(),11);
+        const auto& report=audio.reports[i];
+        m_rfErrorRate=.95*m_rfErrorRate+.000365*report.total;
+        const unsigned er=unsigned(400*m_rfErrorRate);
+        b[12]=uint8_t((std::min(report.total,7U)<<5)|(std::min(er,7U)<<2)|(audio.errors>m_silenceThreshold?2U:0U));
+        b[13]=uint8_t((std::min(unsigned(report.vectorErrors[4]),1U)<<7)|(std::min(unsigned(report.vectorErrors[1]),7U)<<4)|(m_rfSuperframe<<2));
+        if(i==8){b[14]=m_rfLSD.getLSD1();b[15]=m_rfLSD.getLSD2();b[16]=lsdStatus;}
+        if(ldu2&&i>=2&&i<=7){std::memcpy(b.data()+14,m_rfES+(i-2)*3,3);b[17]=m_rfESStatus[i-2];}
+    }
 }
 
