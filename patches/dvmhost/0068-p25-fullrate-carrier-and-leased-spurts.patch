+// Public source synchronization only: no traffic key, cipher or inferred MI.
+// AAAD-B5.2/Figure5-1: LDU2 MI applies to the NEXT superframe, not FR17/18.
+class PublicSync {
+public:
+    struct Context {
+        uint8_t algorithm=0;
+        uint16_t key=0;
+        std::array<uint8_t,9> mi{};
+        bool ready=false;
+    };
+    enum class Result { Invalid, Pending, Ready };
+    void reset() { *this=PublicSync{}; }
+    const Context& current() const { return m_current; }
+    Result accept(const Voice& voice,const Header* header,uint64_t sequence) {
+        Voice parsed;
+        if(!sequence||!parseVoice(voice.bytes.data(),voice.size(),parsed)||
+            (header&&!validHeader(header->bytes.data(),18)))return Result::Invalid;
+        const unsigned n=index(voice.bytes[0]);
+        const uint8_t sf=(voice.bytes[13]>>2)&3U;
+        if(m_sequence) {
+            if(sequence<=m_sequence)return Result::Invalid;
+            // Replay order is independent of media position: a transport
+            // sequence may also count control packets or omit unexported voice.
+            const unsigned boundaries=(sf+4U-m_sf)&3U;
+            if(!boundaries&&n<=m_index) {
+                // Lose ambiguous media sync without losing the replay highwater.
+                m_current=Context{};m_next=Context{};m_fragments=0;
+                m_sequence=sequence;m_index=uint8_t(n);m_sf=sf;return Result::Invalid;
+            }
+            if(boundaries||n!=m_index+1U)m_fragments=0;
+            if(boundaries) {
+                m_current=boundaries==1U?m_next:Context{};
+                m_next=Context{};
+            }
+        }
+        m_sequence=sequence;m_index=uint8_t(n);m_sf=sf;
+        if(header) {
+            const auto& h=header->bytes;
+            m_current=context(h.data(),h[9],uint16_t(h[10])<<8|h[11]);
+            m_next=Context{};m_fragments=0;
+        }
+        if(n==11)m_fragments=0;
+        if(n>=11&&n<=16) {
+            std::memcpy(m_es.data()+(n-11)*3,voice.bytes.data()+14,3);
+            m_fragments|=uint8_t(1U<<(n-11));
