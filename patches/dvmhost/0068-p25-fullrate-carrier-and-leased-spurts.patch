+namespace p25 { namespace packet {
+inline bool fullRateESS(const fullrate::Batch& batch,lc::LC& control) {
+    if(!fullrate::validBatch(batch,true))return false;
+    uint8_t rs[18];
+    for(unsigned i=0;i<6;++i)std::memcpy(rs+i*3,batch.voice[i+2].bytes.data()+14,3);
+    edac::RS634717 fec;
+    try { if(!fec.decode24169(rs))return false; } catch(...) { return false; }
