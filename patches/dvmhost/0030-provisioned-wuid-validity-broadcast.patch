--- /dev/null
+++ b/tests/p25/WUIDValidity_Tests.cpp
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// TIA-102.AABC-E 6.2.19 / Figure 6.2.19-1, PDF189 / printed170:
+// octet2 is 4hours + field * 30minutes; 0xFF is infinity.
+// TIA-102.AABD-B 6.6.1-.3, PDF59-60 / printed54-55 ties the
+// broadcast to RFSS provisioning. Policy is exact representation, not rounding.
+#include "common/lookups/AffiliationLookup.h"
+#include "common/p25/lc/tsbk/OSP_SYS_SRV_BCAST.h"
+#include "common/edac/CRC.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <limits>
+
+using p25::lc::tsbk::OSP_SYS_SRV_BCAST;
+
+TEST_CASE("finite WUID validity uses the exact half-hour source definition", "[p25][wuid-validity]") {
+    struct Case { uint32_t seconds; uint8_t field; };
+    for (const auto value : {Case{4U*3600U,0x00U},Case{5U*3600U,0x02U},
+        Case{12U*3600U,0x10U},Case{24U*3600U,0x28U},Case{131U*3600U,0xFEU}}) {
+        CAPTURE(value.seconds,value.field);
+        OSP_SYS_SRV_BCAST message;
+        REQUIRE(message.setWUIDValiditySeconds(value.seconds));
+        std::array<uint8_t,12U> wire{};
+        message.encode(wire.data(),true,true);
+        REQUIRE(wire[2]==value.field);
+    }
+}
+
+TEST_CASE("nonrepresentable finite WUID validity is rejected without rounding or partial change", "[p25][wuid-validity]") {
+    OSP_SYS_SRV_BCAST message;
+    REQUIRE(message.setWUIDValiditySeconds(43200U));
+    for (const uint32_t seconds : {0U,1U,14399U,14401U,16199U,43199U,43201U,
+        471601U,473400U,std::numeric_limits<uint32_t>::max()}) {
+        CAPTURE(seconds);
+        REQUIRE_FALSE(message.setWUIDValiditySeconds(seconds));
+        REQUIRE(message.getWUIDValidity()==0x10U);
+    }
+    message.setWUIDValidity(0xFFU);
+    std::array<uint8_t,12U> wire{};
+    message.encode(wire.data(),true,true);
+    REQUIRE(wire[2]==0xFFU); // Infinity is an explicit field, not finite overflow.
+    REQUIRE_FALSE(message.setWUIDValiditySeconds(473400U));
+    REQUIRE(message.getWUIDValidity()==0xFFU);
+}
+
+TEST_CASE("actual native validity and advertised literal octets share one provisioned timeout", "[p25][wuid-validity]") {
+    ::lookups::ChannelLookup channels;
+    ::lookups::AffiliationLookup registrations("WUID offline test",&channels,false);
+    registrations.unitReg(1001U);
+    REQUIRE(registrations.unitRegTimeout(1001U)==43200U);
+    REQUIRE(registrations.unitRegTimeout(1001U)==::lookups::AffiliationLookup::defaultUnitRegTimeout());
+    OSP_SYS_SRV_BCAST message;
+    message.setLastBlock(true);
+    REQUIRE(message.setWUIDValiditySeconds(registrations.unitRegTimeout(1001U)));
+    message.setServices(0x000800U,0x000E00U);
+    std::array<uint8_t,12U> wire{};
+    message.encode(wire.data(),true,true);
+    // Literal header/field/masks/priority from the source figure. The CRC
+    // helper only checks existing framing; this is not an independent CRC test.
+    const std::array<uint8_t,10U> expected{{0xB8U,0x00U,0x10U,0x00U,0x08U,
+        0x00U,0x00U,0x0EU,0x00U,0x00U}};
+    for (size_t i=0U;i<expected.size();++i) REQUIRE(wire[i]==expected[i]);
+    REQUIRE(edac::CRC::checkCCITT162(wire.data(),wire.size()));
+}
