+/* Encode an exactly representable finite WUID validity. */
+
+bool OSP_SYS_SRV_BCAST::setWUIDValiditySeconds(uint32_t seconds)
+{
+    // TIA-102.AABC-E 6.2.19 / Figure 6.2.19-1, PDF 189 / printed 170.
+    const uint32_t minimum = 4U * 60U * 60U;
+    const uint32_t increment = 30U * 60U;
+    if (seconds < minimum || (seconds - minimum) % increment != 0U)
+        return false;
+    const uint32_t field = (seconds - minimum) / increment;
+    if (field >= 0xFFU) // 0xFF is infinity, not a finite 131.5 hours.
+        return false;
+    m_wuidValidity = uint8_t(field);
+    return true;
+}
