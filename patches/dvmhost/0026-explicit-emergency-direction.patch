+// AABC-E 6.1.6 Tables 6.1.6-1/2, E-3 Table 6.1.6-1; AABD-B 11.2.1.
+TEST_CASE("all defined emergency causes receive the FNE alarm acknowledgment", "[p25][emergency-direction]") {
+    for (uint8_t info1 : {0U, 1U, 2U, 4U, 8U, 0x80U}) {
+        for (uint8_t info2 : {0U, 1U, 0x80U}) {
+            CAPTURE(info1, info2);
+            Fixture f(true);
+            const uint64_t fields = (uint64_t(info1) << 56U) | (uint64_t(info2) << 48U) | (uint64_t(TG) << 24U) | RID;
+            REQUIRE(f.signal(TSBKO::ISP_EMERG_ALRM_REQ, fields));
+            auto replies = f.responses();
+            bool acknowledged = false;
+            for (const auto& reply : replies) {
+                REQUIRE((reply[0] & 0x3FU) != TSBKO::OSP_DENY_RSP);
+                if ((reply[0] & 0x3FU) == TSBKO::IOSP_ACK_RSP) {
+                    REQUIRE((reply[2] & 0x3FU) == TSBKO::ISP_EMERG_ALRM_REQ);
+                    acknowledged = true;
+                }
+            }
+            REQUIRE(acknowledged);
+            REQUIRE(f.controller->affiliations()->grantSize() == 0U);
+        }
+    }
+}
