diff --git a/tests/p25/EmergencyDirection_Tests.cpp b/tests/p25/EmergencyDirection_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/p25/EmergencyDirection_Tests.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Field fixtures follow AABC-E 6.1.6/6.2.5, with E-3's SI-1 amendment.
+// The same 0x27 opcode has different meanings on inbound/outbound CAI.
+#include "common/p25/lc/tsbk/TSBKFactory.h"
+#include "common/edac/CRC.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+
+using namespace p25::lc::tsbk;
+using namespace p25::defines;
+
+TEST_CASE("Emergency causes are decoded by inbound direction without a deny heuristic", "[p25][emergency-direction]") {
+    // Literal layout: opcode, MFID, SI-1, SI-2, reserved, group MSB/LSB,
+    // source MSB/middle/LSB, CRC. Values are not generated by its encoder.
+    for (uint8_t info1 : {0U, 1U, 2U, 4U, 8U, 0x10U, 0x20U, 0x40U, 0x80U, 0xFFU}) {
+        for (uint8_t info2 : {0U, 1U, 0x80U, 0xFFU}) {
+            CAPTURE(info1, info2);
+            std::array<uint8_t, 12> wire{0xA7U, 0U, info1, info2, 0U, 0x03U, 0xE9U, 0x12U, 0x34U, 0x56U, 0U, 0U};
+            edac::CRC::addCCITT162(wire.data(), wire.size());
+            auto decoded = TSBKFactory::createTSBK(wire.data(), TSBKFactory::Direction::Inbound, true);
+            auto* emergency = dynamic_cast<ISP_EMERG_ALRM_REQ*>(decoded.get());
+            REQUIRE(emergency != nullptr);
+            REQUIRE(emergency->getEmergency());
+            REQUIRE(emergency->getSrcId() == 0x123456U);
+            REQUIRE(emergency->getDstId() == 1001U);
+            REQUIRE(emergency->getSpecialInformation1() == info1);
+            REQUIRE(emergency->getSpecialInformation2() == info2);
+            std::array<uint8_t, 12> encoded{};
+            emergency->encode(encoded.data(), true, true);
+            REQUIRE(encoded == wire);
+        }
+    }
+}
+
+TEST_CASE("Outbound opcode 27 is a deny response including full individual address", "[p25][emergency-direction]") {
+    for (uint8_t reason : {0x10U, 0x11U, 0x31U, 0xFFU}) {
+        std::array<uint8_t, 12> wire{0xA7U, 0U, 0x83U, reason, 0x12U, 0x34U, 0x56U, 0x01U, 0x23U, 0x45U, 0U, 0U};
+        edac::CRC::addCCITT162(wire.data(), wire.size());
+        auto decoded = TSBKFactory::createTSBK(wire.data(), TSBKFactory::Direction::Outbound, true);
+        auto* denial = dynamic_cast<OSP_DENY_RSP*>(decoded.get());
+        REQUIRE(denial != nullptr);
+        REQUIRE_FALSE(denial->getEmergency());
+        REQUIRE(denial->getAIV());
+        REQUIRE(denial->getService() == 3U);
+        REQUIRE(denial->getResponse() == reason);
+        REQUIRE(denial->getDstId() == 0x123456U);
+        REQUIRE(denial->getSrcId() == 0x012345U);
+    }
+}
