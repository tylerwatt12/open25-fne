+// AABD-B normative AnnexA.1/Table18-1 PDF141/p136 assigns00001..FFFFE.
+// Every value in the former arbitrary BEE00..BEEFF exclusion is assignable.
+TEST_CASE("all assignable WACN subrange values retain configured identity", "[p25][wacn-address]") {
+    std::vector<uint32_t> networks{1U,0xBEDFFU,0xBEF00U,0xFFFFEU};
+    for(uint32_t value=0xBEE00U;value<=0xBEEFFU;++value) networks.push_back(value);
+    for(const auto wacn:networks) for(uint32_t system:{1U,0xABCU}) {
+        CAPTURE(wacn,system);
+        SiteData identity(wacn,system,1U,1U,0U,2U,25U,ServiceClass::VOICE,0);
+        REQUIRE(identity.netId()==wacn);
+        REQUIRE(identity.sysId()==system);
+        // AABC-E6.2.11.1/Fig6.2.11-1 PDF173/p154 exact identity fields.
+        TSBK::setSiteData(identity);
+        OSP_NET_STS_BCAST broadcast;
+        std::array<uint8_t,P25_TSBK_LENGTH_BYTES> raw{};
+        broadcast.encode(raw.data(),true,true);
+        REQUIRE(((uint32_t(raw[3])<<12U)|(uint32_t(raw[4])<<4U)|(raw[5]>>4U))==wacn);
+        REQUIRE(((uint32_t(raw[5]&15U)<<8U)|raw[6])==system);
+    }
+}
