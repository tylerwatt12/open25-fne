@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Open25 operating-policy tests; no RF resource or network socket is opened. */
+/* Modified by Open25 contributors on 2026-11-16: explicit WACN startup policy
+ * and identity-preserving replacement of upstream special cases. */
+#include "common/p25/P25Utils.h"
+#include <catch2/catch_test_macros.hpp>
+
+TEST_CASE("Open25 WACN operating policy blocks the complete BEE range", "[p25][wacn-operating-policy]") {
+    for (uint32_t wacn = 0xBEE00U; wacn <= 0xBEEFFU; ++wacn) {
+        CAPTURE(wacn);
+        REQUIRE(p25::P25Utils::isWACNBlocked(wacn));
+    }
+    for (const uint32_t wacn : {1U, 0xBB800U, 0xBEDFFU, 0xBEF00U, 0xFFFFEU}) {
+        CAPTURE(wacn);
+        REQUIRE_FALSE(p25::P25Utils::isWACNBlocked(wacn));
+    }
+}
