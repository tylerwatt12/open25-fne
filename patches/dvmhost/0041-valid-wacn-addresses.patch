+TEST_CASE("valid WACNs allow actual control registration affiliation and correlated grants", "[p25][wacn-address][capacity-permit]") {
+    std::vector<uint32_t> networks;
+    for(uint32_t value=0xBEE00U;value<=0xBEEFFU;++value) networks.push_back(value);
+    for(uint32_t value:{1U,0xBEDFFU,0xBEF00U,0xFFFFEU}) networks.push_back(value);
+    for(const auto wacn:networks) {
+        CAPTURE(wacn);
+        ControllerFixture fixture(true,false,true,false,true,nullptr,wacn);
+        // Literal home-system registration fields, through real CAI framing.
+        auto registration=ControllerFixture::rawBlock(TSBKO::IOSP_U_REG,
+            (uint64_t(wacn)<<36U)|(uint64_t(1U)<<24U)|SOURCE);
+        REQUIRE(fixture.receiveRaw(registration));
+        REQUIRE(fixture.controller->affiliations()->isUnitReg(SOURCE));
+        auto replies=fixture.drain();
+        REQUIRE(replies.size()==1U);
+        REQUIRE(replies[0]->getLCO()==TSBKO::IOSP_U_REG);
+        REQUIRE(((replies[0]->getDecodedRaw()[2]>>4U)&3U)==ResponseCode::ACCEPT);
+        auto affiliation=ControllerFixture::rawBlock(TSBKO::IOSP_GRP_AFF,
+            (uint64_t(1U)<<40U)|(uint64_t(GROUP)<<24U)|SOURCE);
+        REQUIRE(fixture.receiveRaw(affiliation));
+        REQUIRE(fixture.controller->affiliations()->isGroupAff(SOURCE,GROUP));
+        fixture.drain();
+        fixture.controller->setSupervisor(true);
+        fixture.channels.setRFChData(VOICE_CHANNEL,::lookups::VoiceChData(2U,VOICE_CHANNEL,"127.0.0.1",48993U,"offline-test"));
+        auto request=ControllerFixture::rawBlock(TSBKO::IOSP_GRP_VCH,(uint64_t(GROUP)<<24U)|SOURCE);
+        REQUIRE(fixture.receiveRaw(request));
+        REQUIRE(fixture.rpc.permits==1U);
+        REQUIRE(fixture.controller->affiliations()->isGranted(GROUP));
+        const auto granted=fixture.drain();
+        REQUIRE_FALSE(granted.empty());
+        for(const auto& grant:granted) {
+            REQUIRE(grant->getLCO()==TSBKO::IOSP_GRP_VCH);
+            const auto raw=grant->getDecodedRaw();
+            REQUIRE(raw!=nullptr);
+            REQUIRE((((uint32_t)raw[5]<<8U)|raw[6])==GROUP);
+            REQUIRE((((uint32_t)raw[7]<<16U)|((uint32_t)raw[8]<<8U)|raw[9])==SOURCE);
+        }
+    }
+}
