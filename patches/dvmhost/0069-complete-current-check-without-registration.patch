+
+// AABD-B 13.2.1 (PDF118/printed113) completes an issued CHECK on its
+// matching response. This observation is not unit registration (6.6.1,
+// PDF59/printed54) or group affiliation. Construct a test ACK for the
+// fixture subscriber and validate rejection when its CRC is damaged.
+TEST_CASE("a matching CHECK ACK completes without inventing registration", "[p25][radio-check][unregistered-check]") {
+    Fixture f(true); auto* signal=f.controller->control(); auto* units=f.controller->affiliations();
+    REQUIRE(units->unitDereg(RID));
+    Block reply{{0xA4U,0x00U,0x00U,0x80U,0xFFU,0xFFU,0xFCU,uint8_t(RID>>16U),uint8_t(RID>>8U),uint8_t(RID),0U,0U}}; edac::CRC::addCCITT162(reply.data(), reply.size());
+    REQUIRE_FALSE(units->isUnitReg(RID)); REQUIRE_FALSE(units->isGroupAff(RID,TG));
+    REQUIRE_FALSE(f.signal(reply)); // no current CHECK
+    REQUIRE(signal->requestRadioCheck(RID));
+    REQUIRE_FALSE(f.signal(reply)); // still queued, not issued
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Queued);
+    RadioCheckTestAccess::clock(*f.controller,0U); REQUIRE(f.responses().size()==1U);
+    for (const auto wrong : {0x0080FFFFFD002711ULL, // wrong return FNE
+                             0x0080FFFFFC002717ULL, // another allowed physical SU
+                             0x0080FFFFFC002715ULL, // disabled physical SU
+                             0x0080FFFFFC002716ULL, // application, not physical inventory
+                             0x0080FFFFFC004E1FULL, // unknown SU
+                             0x007FFFFFFC002711ULL, // command, not CHECK ACK
+                             0x00FFFFFFFC002711ULL, // unrelated INHIBIT ACK
+                             0x00FEFFFFFC002711ULL}) { // unrelated UNINHIBIT ACK
+        CAPTURE(wrong); REQUIRE_FALSE(f.signal(0x24U,wrong));
+        REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    }
+    f.signal(0x24U,0x0080FFFFFC002711ULL,0x90U);
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    Block badCRC=reply; badCRC.back()^=1U;
+    REQUIRE_FALSE(f.signal(badCRC));
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    REQUIRE(f.signal(reply));
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Available);
+    REQUIRE_FALSE(units->isUnitReg(RID)); REQUIRE_FALSE(units->isGroupAff(RID,TG));
+    REQUIRE_FALSE(units->isUnitReg(WUID_FNE));
+    REQUIRE_FALSE(f.signal(reply)); // completed/duplicate does not reopen it
+    RadioCheckTestAccess::clock(*f.controller,20000U);
+    REQUIRE(f.responses().empty()); REQUIRE(timeoutLogs()==0U);
+}
+
+TEST_CASE("unregistered CHECK ACK cannot revive expired withdrawn or revoked authority", "[p25][radio-check][unregistered-check]") {
+    Block reply{{0xA4U,0x00U,0x00U,0x80U,0xFFU,0xFFU,0xFCU,uint8_t(RID>>16U),uint8_t(RID>>8U),uint8_t(RID),0U,0U}}; edac::CRC::addCCITT162(reply.data(), reply.size());
+    for (unsigned mode=0U;mode<3U;++mode) {
+        CAPTURE(mode); Fixture f(true); auto* signal=f.controller->control(); auto* units=f.controller->affiliations();
+        REQUIRE(units->unitDereg(RID));
+        REQUIRE(signal->requestRadioCheck(RID));
+        RadioCheckTestAccess::clock(*f.controller,0U); f.responses();
+        if (mode==0U) {
+            for (unsigned i=0U;i<5U;++i) { RadioCheckTestAccess::clock(*f.controller,2000U); f.responses(); }
+            REQUIRE(signal->radioCheckState(RID)==CheckState::NoResponse);
+        } else {
+            if (mode==1U) { f.controller->setCCRunning(false); f.controller->setCCRunning(true); }
+            else f.radios.addEntry(RID,false,"revoked");
+            RadioCheckTestAccess::clock(*f.controller,0U);
+            REQUIRE(signal->radioCheckState(RID)==CheckState::Cancelled);
+        }
+        REQUIRE_FALSE(f.signal(reply));
+        REQUIRE_FALSE(units->isUnitReg(RID)); REQUIRE_FALSE(units->isGroupAff(RID,TG));
+        REQUIRE(f.responses().empty());
+    }
 }
 
