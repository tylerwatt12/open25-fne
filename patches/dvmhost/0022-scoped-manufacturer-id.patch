diff --git a/tests/p25/ScopedManufacturerID_Tests.cpp b/tests/p25/ScopedManufacturerID_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/p25/ScopedManufacturerID_Tests.cpp
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Protocol serialization only. No network socket or modem is opened.
+#include "common/network/Network.h"
+#include "common/p25/P25Defines.h"
+#include "common/p25/lc/LC.h"
+#include "common/p25/lc/tsbk/OSP_MOT_CC_BSI.h"
+#include "common/p25/lc/tsbk/OSP_NET_STS_BCAST.h"
+#include "common/p25/dfsi/LC.h"
+#include "common/p25/dfsi/DFSIDefines.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+
+namespace {
+using namespace p25;
+using namespace p25::defines;
+class ManufacturerNetwork : public network::Network {
+public:
+    ManufacturerNetwork() : Network("127.0.0.1", 49992U, 0U, 100101002U, "unopened-mf-id-test", true, false,
+        false, true, false, false, false, false, false, false, false, false) {}
+    using network::BaseNetwork::createP25_LDU1Message;
+    using network::BaseNetwork::createP25_LDU2Message;
+};
+lc::LC voice(uint8_t manufacturer) {
+    lc::LC control;
+    control.setMFId(manufacturer); control.setLCO(LCO::GROUP); control.setGroup(true);
+    control.setSrcId(10001U); control.setDstId(1001U);
+    control.setAlgId(ALGO_AES_256); control.setKId(7U); control.setEncrypted(true);
+    const uint8_t mi[9]{1, 2, 3, 4, 5, 6, 7, 8, 0}; control.setMI(mi);
+    return control;
+}
+}
+
+TEST_CASE("standard voice manufacturer survives RF header and accepted LDU2 state", "[p25][mfid]") {
+    for (const uint8_t manufacturer : {0U, 1U}) {
+        auto control = voice(manufacturer);
+        std::array<uint8_t, P25_LDU_FRAME_LENGTH_BYTES> frame{};
+        control.encodeHDU(frame.data()); lc::LC header;
+        REQUIRE(header.decodeHDU(frame.data()));
+        REQUIRE(header.getMFId() == manufacturer);
+        REQUIRE(header.getAlgId() == ALGO_AES_256); REQUIRE(header.getKId() == 7U);
+        control.encodeLDU1(frame.data()); lc::LC accepted;
+        REQUIRE(accepted.decodeLDU1(frame.data()));
+        REQUIRE(accepted.getMFId() == manufacturer);
+        REQUIRE(accepted.getSrcId() == 10001U); REQUIRE(accepted.getDstId() == 1001U);
+        control.encodeLDU2(frame.data());
+        REQUIRE(accepted.decodeLDU2(frame.data()));
+        // ESS does not contain another MFID. It must retain the accepted LC.
+        REQUIRE(accepted.getMFId() == manufacturer);
+        REQUIRE(accepted.getAlgId() == ALGO_AES_256); REQUIRE(accepted.getKId() == 7U);
+    }
+}
+
+TEST_CASE("FNE and DFSI agree on standard voice manufacturer", "[p25][mfid]") {
+    ManufacturerNetwork network;
+    for (const uint8_t manufacturer : {0U, 1U}) {
+        auto control = voice(manufacturer); data::LowSpeedData lsd;
+        std::array<uint8_t, P25_LDU_FRAME_LENGTH_BYTES> frame{};
+        uint32_t length = 0U;
+        auto ldu1 = network.createP25_LDU1Message(length, control, lsd, frame.data(), FrameType::HDU_VALID, 0U);
+        REQUIRE(length >= 178U); REQUIRE(ldu1[15U] == manufacturer);
+        // DFSI Voice3 starts at byte60; its byte2 is the repeated LC MFID.
+        REQUIRE(ldu1[62U] == manufacturer);
+        dfsi::LC parsed(control, lsd); uint8_t imbe[11]{};
+        const unsigned offsets[9]{24, 46, 60, 77, 94, 111, 128, 145, 162};
+        for (unsigned i = 0U; i < 9U; ++i) parsed.decodeLDU1(ldu1.get() + offsets[i], imbe);
+        REQUIRE(parsed.control()->getMFId() == manufacturer);
+        auto ldu2 = network.createP25_LDU2Message(length, control, lsd, frame.data(), 0U);
+        REQUIRE(length >= 178U); REQUIRE(ldu2[15U] == manufacturer);
+        for (unsigned i = 0U; i < 9U; ++i) parsed.decodeLDU2(ldu2.get() + offsets[i], imbe);
+        REQUIRE(parsed.control()->getMFId() == manufacturer);
+        REQUIRE(parsed.control()->getAlgId() == ALGO_AES_256); REQUIRE(parsed.control()->getKId() == 7U);
+    }
+}
+
+TEST_CASE("vendor BSI and standard control messages keep their own MFIDs", "[p25][mfid]") {
+    std::array<uint8_t, 12> bytes{};
+    lc::tsbk::OSP_MOT_CC_BSI bsi;
+    bsi.encode(bytes.data(), true, true); REQUIRE(bytes[1] == 0x90U);
+    lc::tsbk::OSP_NET_STS_BCAST status;
+    status.encode(bytes.data(), true, true); REQUIRE(bytes[1] == 0U);
+}
