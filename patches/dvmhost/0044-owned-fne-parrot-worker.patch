+        auto gate=std::make_shared<WorkerGate>(); auto* raw=f.get();
+        WorkerAccess::iteration(f->network,[gate,raw]{
+            std::unique_lock<std::mutex> lock(gate->mutex);
+            gate->entered=true; gate->changed.notify_all();
+            gate->changed.wait(lock,[&]{return gate->release;}); lock.unlock();
+            // This accesses the actual handler after close/destructor requested
+            // stop. Joining must retain that dependency until this returns.
+            const bool valid=!raw->network.p25TrafficHandler()->hasParrotFrames();
+            lock.lock(); gate->dependencyRead=valid; gate->changed.notify_all();
+        });
+        WorkerAccess::beforeJoin(f->network,[gate]{gate->signal(&WorkerGate::stopping);});
+        REQUIRE(f->network.open()); const bool entered=gate->wait(&WorkerGate::entered);
+        auto retire=std::async(std::launch::async,[&]{if(destroy)f.reset();else f->network.close();});
+        const bool stopping=gate->wait(&WorkerGate::stopping);
+        const bool blocked=retire.wait_for(std::chrono::milliseconds(0))==std::future_status::timeout;
+        gate->signal(&WorkerGate::release); retire.get(); // cleanup before assertions
+        REQUIRE(entered); REQUIRE(stopping); REQUIRE(blocked); REQUIRE(gate->dependencyRead);
+        if(!destroy) REQUIRE(WorkerAccess::joined(f->network));
+    }
+}
