+TEST_CASE("owned parrot worker preserves normal empty-playback timer retirement", "[fne-worker]") {
+    Fixture f; WorkerAccess::unbound(f.network); WorkerAccess::delay(f.network);
+    auto gate=std::make_shared<WorkerGate>();
+    WorkerAccess::iteration(f.network,[&f,gate]{
+        // Only the worker reads the timer while it runs; the preserved loop
+        // stops an expired playback timer when every protocol queue is empty.
+        if(!WorkerAccess::delayRunning(f.network)) gate->signal(&WorkerGate::entered);
+    });
+    REQUIRE(f.network.open()); const bool processed=gate->wait(&WorkerGate::entered);
+    f.network.close(); REQUIRE(processed); REQUIRE(WorkerAccess::joined(f.network));
+}
