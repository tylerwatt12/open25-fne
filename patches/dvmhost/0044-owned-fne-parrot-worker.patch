+// Owner-lifetime fixtures execute the actual FNE open/close and parrot loop.
+// Successful test sockets are unbound local UDP descriptors (port0), with no
+// peers or packet I/O. A bound loopback reservation makes failure deterministic.
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <future>
+#include <mutex>
+#include <thread>
+
+namespace network {
+struct ParrotWorkerTestAccess {
+    static void unbound(TrafficNetwork& n) {
+        // Test-only endpoint selection before any owner exists. No UDP bind or
+        // send is needed to exercise the actual successful-open lifecycle.
+        std::lock_guard<std::mutex> lock(n.m_lifecycleMutex);
+        n.m_port=0U; n.m_socket->close(); delete n.m_frameQueue; delete n.m_socket;
+        n.m_socket=new udp::Socket(n.m_address,n.m_port);
+        n.m_frameQueue=new FrameQueue(n.m_socket,n.m_peerId,n.m_debug);
+    }
+    static bool reopenSocket(TrafficNetwork& n) { const bool opened=n.m_socket->open(); n.m_socket->close(); return opened; }
+    static bool joined(TrafficNetwork& n) {
+        std::lock_guard<std::mutex> lock(n.m_lifecycleMutex);
+        return !n.m_open && !n.m_parrotThread.joinable();
+    }
+    static const void* socket(TrafficNetwork& n) { return n.m_socket; }
+    static void iteration(TrafficNetwork& n, std::function<void()> hook) { n.m_parrotIterationTestHook = std::move(hook); }
+    static void beforeJoin(TrafficNetwork& n, std::function<void()> hook) { n.m_parrotBeforeJoinTestHook = std::move(hook); }
+    static void delay(TrafficNetwork& n) { n.m_parrotDelayTimer.setTimeout(0U,1U); n.m_parrotDelayTimer.start(); }
+    static bool delayRunning(TrafficNetwork& n) { return n.m_parrotDelayTimer.isRunning(); }
+};
+}
+namespace {
+using WorkerAccess = network::ParrotWorkerTestAccess;
+struct WorkerGate {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool entered = false, release = false, stopping = false, dependencyRead = false;
+    bool wait(bool WorkerGate::*field) {
+        std::unique_lock<std::mutex> lock(mutex);
+        return changed.wait_for(lock,std::chrono::seconds(2),[&]{ return this->*field; });
+    }
+    void signal(bool WorkerGate::*field) {
+        std::lock_guard<std::mutex> lock(mutex);
+        this->*field = true; changed.notify_all();
+    }
+};
+void observeWorker(Fixture& f, const std::shared_ptr<WorkerGate>& gate) {
+    WorkerAccess::iteration(f.network,[gate]{gate->signal(&WorkerGate::entered);});
+}
