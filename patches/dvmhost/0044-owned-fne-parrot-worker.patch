+TEST_CASE("failed FNE opens start no worker and the same owner can reopen cleanly", "[fne-worker]") {
+    {
+        Fixture f; auto gate=std::make_shared<WorkerGate>(); observeWorker(f,gate);
+        yaml::Node invalid; REQUIRE(yaml::Parse(invalid,std::string("p25Sites: true\n")));
+        f.network.setOptions(invalid,false);
+        REQUIRE_FALSE(f.network.open()); REQUIRE(WorkerAccess::joined(f.network)); REQUIRE_FALSE(gate->entered);
+    }
+#if !defined(_WIN32)
+    ReservedLoopbackPort reserved;
+    Fixture f(reserved.port); auto gate=std::make_shared<WorkerGate>(); observeWorker(f,gate);
+    REQUIRE_FALSE(f.network.open()); REQUIRE(WorkerAccess::joined(f.network)); REQUIRE_FALSE(gate->entered);
+    // Socket::read uses this same no-argument open for error recovery. It must
+    // still name the configured occupied endpoint, rather than empty/port0.
+    REQUIRE_FALSE(WorkerAccess::reopenSocket(f.network));
+    f.network.close(); WorkerAccess::unbound(f.network);
+    for(unsigned n=0;n<16U;++n) {
+        gate=std::make_shared<WorkerGate>(); observeWorker(f,gate);
+        REQUIRE(f.network.open()); const bool entered=gate->wait(&WorkerGate::entered);
+        f.network.close(); REQUIRE(entered); REQUIRE(WorkerAccess::joined(f.network));
+    }
+#endif
+}
