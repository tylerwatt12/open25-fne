+      {"no_prior_native_alarm_unknown_assignable_group",0,1099,RID,0xA7,0,0x80,0},
+      {"lowest_assignable_group",0,1,RID,0xA7,0,0x80,0},
+      {"highest_assignable_group",0,0xFFFE,RID,0xA7,0,0x80,0},
+      {"all_remaining_option_bits_are_x",0,TG,RID,0xA7,0,0xFF,0},
+      {"aiv_missing",0,TG,RID,0x27,0,0x80,0xF0},
+      {"reason_queued",0,TG,RID,0xA7,0x10,0x80,0xF0},
+      {"reason_assignment",0,TG,RID,0xA7,0x20,0x80,0xF0},
+      {"vendor_defined_reason_not_emergency_cancel",0,TG,RID,0xA7,0x80,0x80,0xF0},
+      {"emergency_bit_missing",0,TG,RID,0xA7,0,0x7F,0xF0},
+      {"null_group",0,0,RID,0xA7,0,0x80,0x30},
+      {"All_Group",0,0xFFFF,RID,0xA7,0,0x80,0x30},
+      {"unregistered",5,TG,RID,0xA7,0,0x80,0x10},
+      {"disabled",6,TG,RID,0xA7,0,0x80,0x10},
+      {"unknown_SU",0,TG,19999,0xA7,0,0x80,0x10},
+      {"application_RID",0,TG,APP,0xA7,0,0x80,0x10}
