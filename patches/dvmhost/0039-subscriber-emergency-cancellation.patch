+        json::object o;o["case"].set<std::string>(c.name);o["accepted"].set<bool>(accepted);o["radio_id"].set<uint32_t>(c.source);o["talkgroup_id"].set<uint32_t>(c.group);o["mfid"].set<uint8_t>(mfid);o["deny_reason"].set<uint8_t>(c.denial);o["native_log"].set<std::string>(nativeLog().str());o["response_tsbk_hex"].set<std::string>(hex(output[0].data(),output[0].size()));json::value record;record.set<json::object>(o);observations.push_back(record);
