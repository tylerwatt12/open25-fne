+namespace {
+uint64_t cancel(uint32_t source=RID, uint32_t group=TG, uint8_t flags=0xA7U, uint8_t reason=0U, uint8_t options=0x80U) {
+    return (uint64_t(flags)<<56U)|(uint64_t(reason)<<48U)|(uint64_t(options)<<40U)|(uint64_t(group)<<24U)|source;
+}
+void reply(const Block& b,uint8_t opcode,uint8_t service,uint8_t reason,uint32_t target) {
+    REQUIRE(b[0]==uint8_t(0x80U|opcode)); REQUIRE((b[2]&0x3FU)==service);
+    REQUIRE((b[2]&0xC0U)==0U); REQUIRE(b[3]==reason);
+    for(size_t i=4U;i<=6U;++i) REQUIRE(b[i]==0U);
+    REQUIRE(b[7]==uint8_t(target>>16));REQUIRE(b[8]==uint8_t(target>>8));REQUIRE(b[9]==uint8_t(target));
+}
+struct ExtendedCancel {
+    Block header{{0x17U,0xFDU,0U,0U,0x27U,0x11U,0x81U,0x23U,0x84U,0U,0U,0U}};
+    Block body{{0U,0U,0U,0x10U,1U,0U,0x27U,0x13U,0U,0U,0U,0U}};
+    std::vector<uint8_t> frame() {
+        edac::CRC::addCCITT162(header.data(),header.size());edac::CRC::addCRC32(body.data(),body.size());
+        std::array<uint8_t,72U> plain{};std::array<uint8_t,25U> coded{};edac::Trellis trellis;
+        trellis.encode12(header.data(),coded.data());Utils::setBitRange(coded.data(),plain.data(),112U,196U);
+        trellis.encode12(body.data(),coded.data());Utils::setBitRange(coded.data(),plain.data(),308U,196U);
+        std::vector<uint8_t> frame(74U);frame[0]=modem::TAG_DATA;frame[1]=1U;
+        P25Utils::encode(plain.data(),frame.data()+2U,0U,576U);Sync::addP25Sync(frame.data()+2U);
+        NID nid(NAC);nid.encode(frame.data()+2U,DUID::PDU);return frame;
+    }
+};
+}
