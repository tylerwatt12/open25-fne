+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef __HOST_C4FM_TEST_H__
+#define __HOST_C4FM_TEST_H__
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace c4fmtest {
+
+// TIA-102.CAAA-F (September 2021), 1.4.4.3, PDF34/printed19 refers to
+// ITU-T O.153 (10/1992), 2.1, PDF3-4/printed1-2: nine stages,
+// stage5 XOR stage9 into stage1, output beginning with nine ones.
+// Output bits remain continuous across byte, packet and511-bit boundaries.
+class PRBS511 {
+public:
+    bool nextBit() {
+        const bool bit = ((m_state >> 8U) & 1U) != 0U;
+        const uint16_t feedback = ((m_state >> 4U) ^ (m_state >> 8U)) & 1U;
+        m_state = uint16_t(((m_state << 1U) | feedback) & 0x1FFU);
+        return bit;
+    }
+    void fill(uint8_t* bytes, size_t count) {
+        for (size_t i = 0U; i < count; ++i) {
+            bytes[i] = 0U;
+            for (unsigned bit = 0U; bit < 8U; ++bit)
+                bytes[i] = uint8_t((bytes[i] << 1U) | (nextBit() ? 1U : 0U));
+        }
+    }
+private:
+    uint16_t m_state = 0x1FFU;
+};
+
+int run(const std::string& configuration, uint32_t durationMs);
+
+}
+#endif
