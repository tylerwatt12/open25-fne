diff --git a/tests/C4FMTest_Tests.cpp b/tests/C4FMTest_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/C4FMTest_Tests.cpp
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "host/C4FMTest.h"
+#include "host/modem/Modem.h"
+#include "host/modem/port/ModemNullPort.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <algorithm>
+#include <string>
+#include <vector>
+
+TEST_CASE("PRBS511 matches the independent published nine-stage prefix", "[c4fm-test][prbs511]") {
+    //CCITT Q.295 BlueBook1988/Geneva1989, AnnexA/Table11/Q.295,
+    //PDF120/printed109. First38 stage9 outputs, transcribed from original.
+    const std::string expected="11111111100000111101111100010111001100";
+    c4fmtest::PRBS511 bits;
+    for (char bit:expected) REQUIRE(bits.nextBit()==(bit=='1'));
+    c4fmtest::PRBS511 bytes;
+    std::array<uint8_t,4U> prefix{};
+    bytes.fill(prefix.data(),prefix.size());
+    const std::array<uint8_t,4U> packed{0xFFU,0x83U,0xDFU,0x17U};
+    REQUIRE(prefix==packed);
+}
+
+TEST_CASE("PRBS511 retains all511 bits without byte or dibit padding", "[c4fm-test][prbs511]") {
+    c4fmtest::PRBS511 bits;
+    std::vector<bool> period;
+    unsigned ones=0U;
+    for (unsigned i=0U;i<511U;++i) {
+        const bool b=bits.nextBit(); period.push_back(b); if(b)++ones;
+    }
+    REQUIRE(ones==256U); //ITU-T O.153(10/1992),2.1
+    for(unsigned i=0U;i<511U;++i) REQUIRE(bits.nextBit()==period[i]);
+    //An odd511-bit period must cross, rather than reset at, byte boundaries.
+    c4fmtest::PRBS511 packets;
+    std::array<uint8_t,216U> first{},second{};
+    packets.fill(first.data(),first.size());
+    packets.fill(second.data(),second.size());
+    for(size_t i=0U;i<first.size()+second.size();++i) {
+        const uint8_t byte=i<first.size()?first[i]:second[i-first.size()];
+        for(unsigned b=0U;b<8U;++b)
+            REQUIRE(((byte>>(7U-b))&1U)==unsigned(period[(i*8U+b)%511U]));
+    }
+}
+
+namespace {
+class PatternModem final:public modem::Modem {
+public:
+    std::vector<uint8_t> packet;
+    bool shortWrite=false;
+    PatternModem():Modem(new modem::port::ModemNullPort(),true,false,false,false,
+        true,false,0U,0U,0U,3960U,2592U,1488U,true,true,false,false,false,false) {
+        m_protoVer=4U;m_p25Space=2592U;setModeParams(false,true,false);
+    }
+    int write(const uint8_t* bytes,uint32_t count,bool=false)override {
+        packet.assign(bytes,bytes+count);return int(count)-(shortWrite?1:0);
+    }
+};
+}
+TEST_CASE("Normal P25_DATA writer preserves unframed PRBS511 octets", "[c4fm-test][modem]") {
+    PatternModem modem;
+    std::array<uint8_t,218U> data{};data[0U]=modem::TAG_DATA;
+    c4fmtest::PRBS511 sequence;sequence.fill(data.data()+2U,216U);
+    REQUIRE(modem.writeP25Frame(data.data(),data.size()));
+    REQUIRE(modem.packet.size()==220U);
+    REQUIRE(modem.packet[0U]==0xFEU);
+    REQUIRE(modem.packet[1U]==220U);
+    REQUIRE(modem.packet[2U]==0x31U);
+    REQUIRE(modem.packet[3U]==0U); //reserved host byte, removed by firmware
+    REQUIRE(std::equal(data.begin()+2U,data.end(),modem.packet.begin()+4U));
+    REQUIRE(modem.getP25Space()==2592U-data.size());
+    modem.shortWrite=true;
+    REQUIRE_FALSE(modem.writeP25Frame(data.data(),data.size()));
+}
+
+namespace {
+class RFReceiptPort final:public modem::port::IModemPort {
+public:
+    std::vector<uint8_t> response,request;
+    size_t offset=0U;
+    bool shortWrite=false;
+    bool open()override{return true;}
+    void close()override{}
+    int read(uint8_t* out,uint32_t length)override{
+        const auto count=std::min<size_t>(length,response.size()-offset);
+        if(count)std::copy_n(response.data()+offset,count,out);
+        offset+=count;return int(count);
+    }
+    int write(const uint8_t* data,uint32_t length)override{
+        request.assign(data,data+length);return int(length)-(shortWrite?1:0);
+    }
+};
+class RFReceiptModem final:public modem::Modem {
+public:
+    RFReceiptModem(modem::port::IModemPort* port):Modem(port,true,false,false,false,
+        true,false,0U,0U,0U,3960U,2592U,1488U,true,true,false,false,false,false){m_protoVer=4U;}
+    bool apply(){return writeRFParams();}
+};
+}
+TEST_CASE("RF configuration needs its own complete receipt before transmission", "[c4fm-test][modem][rf-receipt]") {
+    auto* port=new RFReceiptPort;RFReceiptModem modem(port);
+    SECTION("matching literal ACK succeeds") {port->response={0xFEU,4U,0x70U,6U};REQUIRE(modem.apply());}
+    SECTION("matching literal NAK fails") {port->response={0xFEU,5U,0x7FU,6U,4U};REQUIRE_FALSE(modem.apply());}
+    SECTION("timeout fails") {REQUIRE_FALSE(modem.apply());}
+    SECTION("another command ACK cannot authorize RF") {port->response={0xFEU,4U,0x70U,2U};REQUIRE_FALSE(modem.apply());}
+    SECTION("unrelated ACK is skipped before matching ACK") {port->response={0xFEU,4U,0x70U,2U,0xFEU,4U,0x70U,6U};REQUIRE(modem.apply());}
+    SECTION("truncated ACK cannot authorize RF") {port->response={0xFEU,3U,0x70U};REQUIRE_FALSE(modem.apply());}
+    SECTION("partial command write fails even when ACK bytes exist") {port->response={0xFEU,4U,0x70U,6U};port->shortWrite=true;REQUIRE_FALSE(modem.apply());}
+    REQUIRE(port->request.size()==22U);
+    REQUIRE(port->request[0U]==0xFEU);
+    REQUIRE(port->request[1U]==22U);
+    REQUIRE(port->request[2U]==6U);
+}
+TEST_CASE("Null protocol4 acknowledges RF parameters without claiming RF activity", "[c4fm-test][modem][rf-receipt]") {
+    modem::port::ModemNullPort port;REQUIRE(port.open());
+    std::array<uint8_t,22U> request{};request[0U]=0xFEU;request[1U]=22U;request[2U]=6U;
+    REQUIRE(port.write(request.data(),request.size())==22);
+    std::array<uint8_t,4U> reply{};REQUIRE(port.read(reply.data(),reply.size())==4);
+    const std::array<uint8_t,4U> expected{0xFEU,4U,0x70U,6U};REQUIRE(reply==expected);
+}
