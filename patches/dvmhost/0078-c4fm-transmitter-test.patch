new file mode 100644
--- /dev/null
+++ b/src/host/C4FMTest.cpp
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "C4FMTest.h"
+#include "HostMain.h"
+#include "common/Log.h"
+#include "common/yaml/Yaml.h"
+#include "modem/Modem.h"
+#include "modem/port/ModemNullPort.h"
+#include "modem/port/UARTPort.h"
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+#include <thread>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+void event(const char* text) {
+    std::printf("C4FM_TEST %s\n", text);
+    std::fflush(stdout);
+}
+// No normal Host, network, call allocator, station ID or firmware calibration.
+class TestModem final : public modem::Modem {
+public:
+    TestModem(modem::port::IModemPort* port, yaml::Node input) :
+        Modem(port, true, input["rxInvert"].as<bool>(), input["txInvert"].as<bool>(),
+            input["pttInvert"].as<bool>(), true, false, 0U, 0U, 0U,
+            3960U, 2592U, 1488U, true, true, false, false, false, false) {
+        setModeParams(false, true, false);
+        const float rx = input["rxLevel"].as<float>();
+        const float tx = input["txLevel"].as<float>();
+        setLevels(rx, tx, tx, tx, tx);
+        setDCOffsetParams(input["txDCOffset"].as<int>(), input["rxDCOffset"].as<int>());
+        setRFParams(input["rxFrequencyHz"].as<uint32_t>(), input["txFrequencyHz"].as<uint32_t>(),
+            input["rxOffsetHz"].as<int>(), input["txOffsetHz"].as<int>(),
+            static_cast<uint8_t>(input["powerPercent"].as<uint32_t>()), 0, 0, 0, 0, 0, 0,
+            modem::ADF_GAIN_AUTO, false, 11U, 4U, 1U);
+        suppressCWResets(true);
+    }
+};
+}
+
+int c4fmtest::run(const std::string& configuration, uint32_t durationMs) {
+    if (durationMs == 0U) { event("failed duration is zero"); return 1; }
+    ::LogInitialise("", "", 0U, 1U, true);
+    yaml::Node config;
+    std::unique_ptr<TestModem> modem;
+    bool opened = false, failed = false, observedTX = false;
+    try {
+        if (!yaml::Parse(config, configuration.c_str()))
+            throw std::runtime_error("configuration could not be read");
+        auto input = config["c4fmTest"];
+        std::unique_ptr<modem::port::IModemPort> port;
+        const auto type = input["portType"].as<std::string>();
+        if (type == "uart") {
+            port.reset(new modem::port::UARTPort(input["device"].as<std::string>(),
+                static_cast<modem::port::SERIAL_SPEED>(input["baud"].as<uint32_t>()), true, false));
+        } else if (type == "null") {
+            port.reset(new modem::port::ModemNullPort());
+            event("software null modem; no physical RF observation");
+        } else throw std::runtime_error("test modem transport is not implemented");
+        modem.reset(new TestModem(port.release(), input));
+        opened = modem->open();
+        if (!opened) throw std::runtime_error("modem did not initialize");
+        if (!modem->boundedCWOperation(true)) throw std::runtime_error("bounded serial operation failed");
+        if (modem->getVersion() != 4U) throw std::runtime_error("modem protocol is not current");
+        auto last = Clock::now();
+        auto pump = [&] {
+            const auto now = Clock::now();
+            const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(now-last).count();
+            modem->clock(static_cast<uint32_t>(ms));
+            last += std::chrono::milliseconds(ms);
+            std::this_thread::sleep_for(std::chrono::milliseconds(1U));
+        };
+        const auto readyBy = Clock::now()+std::chrono::seconds(3U);
+        while (!modem->gotModemStatus() && !modem->hasError() && Clock::now()<readyBy && !g_killed) pump();
+        if (!modem->gotModemStatus() || modem->hasError()) throw std::runtime_error("modem readiness missing");
+        if (!modem->setState(modem::STATE_P25)) throw std::runtime_error("P25 mode write incomplete");
+        if (modem->hasTX()) throw std::runtime_error("modem was already transmitting");
+        event("ready");
+        PRBS511 sequence;
+        //216 RF octets =1728bits =180ms at9600bit/s. Tag/reserved octets
+        //are USB metadata, excluded by the existing P25 writer.
+        std::array<uint8_t,218U> packet{};
+        packet[0U] = modem::TAG_DATA;
+        const auto rejectBefore = modem->p25WriteRejectGeneration();
+        const auto startBy = Clock::now()+std::chrono::seconds(3U);
+        auto until = startBy, next = Clock::now();
+        unsigned prefill = 2U;
+        bool wroteData = false;
+        uint64_t txAfter = 0U;
+        while (!g_killed) {
+            pump();
+            const auto now = Clock::now();
+            if (modem->hasError() || modem->p25WriteRejectGeneration()!=rejectBefore)
+                throw std::runtime_error("modem communication or P25 data failed");
+            if (observedTX && !modem->hasTX())
+                throw std::runtime_error("transmit state ended before the requested stop");
+            if (!observedTX && wroteData && modem->statusGeneration()>txAfter && modem->hasTX()) {
+                observedTX = true;
+                until = now+std::chrono::milliseconds(durationMs);
+                event("transmitting");
+            }
+            if (observedTX && now>=until) break;
+            if (!observedTX && now>=startBy) throw std::runtime_error("transmit state not observed");
+            if (now>=next && modem->hasP25Space(packet.size())) {
+                sequence.fill(packet.data()+2U,packet.size()-2U);
+                if (!modem->writeP25Frame(packet.data(),packet.size()))
+                    throw std::runtime_error("P25 write incomplete");
+                if (!wroteData) { wroteData = true; txAfter = modem->statusGeneration(); }
+                if (prefill>0U) {
+                    --prefill;
+                    if (prefill==0U) next = now+std::chrono::milliseconds(180U);
+                } else next += std::chrono::milliseconds(180U);
+            }
+        }
+    } catch (const std::exception& error) {
+        std::fprintf(stderr,"C4FM test: %s\n",error.what());
+        std::string detail = error.what();
+        for (auto& c : detail) if (c == '\n' || c == '\r') c = ' ';
+        detail.resize(std::min<size_t>(detail.size(), 400U));
+        event((std::string("failed ") + detail).c_str());
+        failed = true;
+    } catch (...) {
+        event("failed transmit operation did not complete");
+        failed = true;
+    }
+    if (!opened || !modem) { event("stopped unconfirmed"); return 1; }
+    event("draining");
+    // The FIFO clear leaves only an already-shifting packet and firmware tail.
+    // Ordered serial round-trip plus a later status confirms modem-reported idle.
+    // Physical RF disappearance still requires an independent RF observation.
+    bool stopped = false;
+    try {
+        const uint8_t clear[] = {0xFEU,3U,uint8_t(modem::CMD_P25_CLEAR)};
+        const bool cleared = modem->write(clear,sizeof(clear))==int(sizeof(clear));
+        const auto barrierBefore = modem->serialBarrierGeneration();
+        const bool barrierSent = modem->requestSerialBarrier();
+        bool fenced = false;
+        uint64_t idleAfter = 0U;
+        const auto drainBy = Clock::now()+std::chrono::seconds(5U);
+        auto last = Clock::now();
+        while (Clock::now()<drainBy) {
+            const auto now = Clock::now();
+            const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(now-last).count();
+            modem->clock(static_cast<uint32_t>(ms));
+            last += std::chrono::milliseconds(ms);
+            if (!fenced && modem->serialBarrierGeneration()>barrierBefore) {
+                fenced = true;
+                idleAfter = modem->statusGeneration();
+            }
+            if (cleared && barrierSent && fenced && modem->statusGeneration()>idleAfter && !modem->hasTX()) {
+                stopped = true;
+                break;
+            }
+            if (modem->hasError()) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(1U));
+        }
+        modem->close();
+    } catch (...) {
+        stopped = false;
+    }
+    event(stopped ? "stopped confirmed" : "stopped unconfirmed");
+    return stopped && !failed && (observedTX || g_killed) ? 0 : 1;
+}
