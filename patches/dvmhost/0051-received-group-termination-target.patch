+// TIA-102.AABD-B November2014 3.5 PDF26/printed21 and AABF-D April2015
+// 7.3.8 PDF24/printed13: RFSS group CALL_TERM is addressed to FFFFFF.
+// These literal octets are derived from the verified LC field diagram, not an encoder oracle.
+TEST_CASE("Received group TDULC first keeps internal TG and emits RFSS all-unit termination", "[p25][received-group-termination]") {
+    ReceivedTerminationNetwork network;
+    ControllerFixture voice(true, false, false, false, false, &network);
+    voice.voiceMode(false); receivedTerminationPermit(voice, GROUP, "ab12:751");
+    REQUIRE(voice.voiceFrame(DUID::HDU)); REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice();
+    REQUIRE(voice.voiceFrame(DUID::TDULC, GROUP));
+    const std::array<uint8_t, 9U> expectedRF{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0xFFU, 0xFFU, 0xFFU}};
+    const std::array<uint8_t, 9U> expectedInternal{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0x65U}};
+    REQUIRE(receivedTerminationRF(*voice.controller) == expectedRF);
+    REQUIRE(network.destinations == std::vector<uint32_t>{GROUP});
+    REQUIRE(network.payloads == std::vector<std::array<uint8_t, 9U>>{expectedInternal});
+    REQUIRE(voice.rpc.releases == std::vector<uint32_t>{GROUP});
+    REQUIRE(voice.controller->getRFState() == RS_RF_LISTENING);
+    REQUIRE_FALSE(voice.voiceFrame(DUID::TDULC, GROUP)); // Duplicate end cannot repeat or release twice.
+    REQUIRE(voice.drainVoice().empty());
+    REQUIRE(network.destinations.size() == 1U); REQUIRE(voice.rpc.releases.size() == 1U);
+}
