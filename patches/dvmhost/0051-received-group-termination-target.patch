+TEST_CASE("Received private TDULC first retains the individual RF and internal target", "[p25][received-group-termination]") {
+    ReceivedTerminationNetwork network;
+    ControllerFixture voice(true, false, false, false, false, &network);
+    voice.voiceMode(false); receivedTerminationPermit(voice, TARGET, "ab12:752");
+    REQUIRE(voice.voiceFrame(DUID::HDU, TARGET, false, false));
+    REQUIRE(voice.voiceFrame(DUID::LDU1, TARGET, false, false)); voice.drainVoice();
+    REQUIRE(voice.voiceFrame(DUID::TDULC, TARGET, false, false));
+    const std::array<uint8_t, 9U> expected{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0U, 0x03U, 0xEAU}};
+    REQUIRE(receivedTerminationRF(*voice.controller) == expected);
+    REQUIRE(network.destinations == std::vector<uint32_t>{TARGET});
+    REQUIRE(network.payloads == std::vector<std::array<uint8_t, 9U>>{expected});
+    REQUIRE(voice.rpc.releases == std::vector<uint32_t>{TARGET});
+    REQUIRE(voice.controller->getRFState() == RS_RF_LISTENING);
+}
