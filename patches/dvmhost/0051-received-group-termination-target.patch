+namespace {
+class ReceivedTerminationNetwork : public SiteNetwork {
+public:
+    std::vector<uint32_t> destinations;
+    std::vector<std::array<uint8_t, 9U>> payloads;
+    bool writeP25TDULC(const LC& control, const uint8_t* frame) override {
+        destinations.push_back(control.getDstId());
+        lc::tdulc::LC_CALL_TERM decoded;
+        REQUIRE(decoded.decode(frame));
+        std::array<uint8_t, 9U> raw{};
+        std::copy(decoded.getDecodedRaw(), decoded.getDecodedRaw() + raw.size(), raw.begin());
+        payloads.push_back(raw);
+        return true;
+    }
+};
+void receivedTerminationPermit(ControllerFixture& fixture, uint32_t destination, const std::string& token) {
+    json::object request, reply;
+    setJSON<uint32_t>(request, "dstId", destination);
+    setJSON<uint32_t>(request, "srcId", SOURCE);
+    request["permitToken"].set<std::string>(token);
+    request = wireObject(request);
+    REQUIRE(fixture.rpc.dispatchRequest(RPC_PERMIT_P25_TG, request, reply));
+    REQUIRE(reply["status"].get<int>() == network::NetRPC::OK);
+}
+std::array<uint8_t, 9U> receivedTerminationRF(Control& controller) {
+    std::array<uint8_t, 1024U> frame{};
+    REQUIRE(controller.getFrame(frame.data()) == P25_TDULC_FRAME_LENGTH_BYTES + 2U);
+    NID nid(0x293U); REQUIRE(nid.decode(frame.data() + 2U)); REQUIRE(nid.getDUID() == DUID::TDULC);
+    lc::tdulc::LC_CALL_TERM decoded; REQUIRE(decoded.decode(frame.data() + 2U));
+    std::array<uint8_t, 9U> raw{};
+    std::copy(decoded.getDecodedRaw(), decoded.getDecodedRaw() + raw.size(), raw.begin());
+    REQUIRE(controller.getFrame(frame.data()) == 0U);
+    return raw;
+}
+}
