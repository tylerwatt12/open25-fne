+TEST_CASE("Received termination change is scoped to the trunking RFSS role", "[p25][received-group-termination]") {
+    ReceivedTerminationNetwork network;
+    ControllerFixture voice(true, false, false, false, false, &network);
+    voice.voiceMode(false); p25::CapacityPermitTestAccess::standaloneConventional(*voice.controller);
+    receivedTerminationPermit(voice, GROUP, "ab12:755");
+    REQUIRE(voice.voiceFrame(DUID::HDU)); REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice();
+    REQUIRE(voice.voiceFrame(DUID::TDULC, GROUP));
+    const std::array<uint8_t, 9U> prior{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0x65U}};
+    REQUIRE(receivedTerminationRF(*voice.controller) == prior);
+    REQUIRE(network.destinations == std::vector<uint32_t>{GROUP});
+    REQUIRE(network.payloads == std::vector<std::array<uint8_t, 9U>>{prior});
+    REQUIRE(voice.rpc.releases.empty());
+    REQUIRE(voice.controller->getRFState() == RS_RF_LISTENING);
+}
