+TEST_CASE("Received termination rejects orphan wrong-target and truncated inputs before effects", "[p25][received-group-termination]") {
+    for (bool active : {false, true}) {
+        ControllerFixture voice(true, false, false, false, false);
+        voice.voiceMode(false); voice.permitVoice("ab12:753");
+        if (active) { REQUIRE(voice.voiceFrame(DUID::HDU)); REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice(); }
+        const auto state = voice.controller->getRFState();
+        for (uint32_t destination : {0U, WUID_ALL, DENIED_GROUP, TARGET}) {
+            REQUIRE_FALSE(voice.voiceFrame(DUID::TDULC, destination));
+            REQUIRE(voice.controller->getRFState() == state);
+            REQUIRE(voice.rpc.releases.empty()); REQUIRE(voice.drainVoice().empty());
+        }
+        if (!active) REQUIRE_FALSE(voice.voiceFrame(DUID::TDULC, GROUP));
+        std::array<uint8_t, P25_TDULC_FRAME_LENGTH_BYTES + 2U> malformed{};
+        for (uint32_t i = 2U; i < malformed.size(); ++i) malformed[i] = uint8_t(0xA5U ^ (73U * i));
+        Sync::addP25Sync(malformed.data() + 2U); NID malformedNID(0x293U); malformedNID.encode(malformed.data() + 2U, DUID::TDULC);
+        P25Utils::addStatusBits(malformed.data() + 2U, P25_TDULC_FRAME_LENGTH_BITS, true, false);
+        REQUIRE_FALSE(voice.controller->processFrame(malformed.data(), malformed.size()));
+        REQUIRE(voice.controller->getRFState() == state);
+        REQUIRE(voice.rpc.releases.empty()); REQUIRE(voice.drainVoice().empty());
+        std::array<uint8_t, P25_TDULC_FRAME_LENGTH_BYTES + 2U> truncated{};
+        Sync::addP25Sync(truncated.data() + 2U); NID nid(0x293U); nid.encode(truncated.data() + 2U, DUID::TDULC);
+        for (uint32_t length : {0U, 16U, P25_TDULC_FRAME_LENGTH_BYTES + 1U}) {
+            REQUIRE_FALSE(voice.controller->processFrame(truncated.data(), length));
+            REQUIRE(voice.controller->getRFState() == state);
+            REQUIRE(voice.rpc.releases.empty()); REQUIRE(voice.drainVoice().empty());
+        }
+    }
+}
