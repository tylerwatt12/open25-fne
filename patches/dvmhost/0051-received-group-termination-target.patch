+TEST_CASE("Standalone non-termination TDULC remains separate from call ending", "[p25][received-group-termination]") {
+    for (bool active : {false, true}) {
+        ControllerFixture voice(true, false, false, false, false);
+        voice.voiceMode(false); voice.permitVoice("ab12:754");
+        if (active) { REQUIRE(voice.voiceFrame(DUID::HDU)); REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice(); }
+        const auto state = voice.controller->getRFState();
+        REQUIRE(voice.voiceFrame(DUID::TDULC, GROUP, true));
+        std::array<uint8_t, 1024U> frame{};
+        REQUIRE(voice.controller->getFrame(frame.data()) == P25_TDULC_FRAME_LENGTH_BYTES + 2U);
+        lc::tdulc::LC_GROUP decoded; REQUIRE(decoded.decode(frame.data() + 2U));
+        REQUIRE(decoded.getLCO() == LCO::GROUP); // Existing non-termination path remains separate.
+        REQUIRE(voice.controller->getFrame(frame.data()) == 0U);
+        REQUIRE(voice.controller->getRFState() == state); REQUIRE(voice.rpc.releases.empty());
+    }
+}
