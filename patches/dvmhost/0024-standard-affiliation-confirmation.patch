+// Inputs below are transcribed field octets, not generated by the message
+// encoder: AABC-E 6.1.8 / Figure 6.1.8-1, PDF 107, printed 88.
+// Expected state transitions come from AABD-B 6.7.3.1-.2, PDF 63-64,
+// printed 58-59; the shared framing/CRC helpers are not independent FEC tests.
+TEST_CASE("a query response confirms stored group identities without becoming an affiliation request", "[p25][subscriber-access][control-procedure]") {
+    Fixture f(true); f.apply(false,{},false,{});
+    const std::array<uint8_t,8> matching = {{0x00,0xFF,0xFE,0x03,0xE9,0x00,0x27,0x11}};
+    auto payload = matching;
+    bool accepted = false;
+    bool existing = true;
+    SECTION("matching WGID and AGID") { accepted = true; }
+    SECTION("different WGID") { payload[4] = 0xEA; }
+    SECTION("different AGID") { payload[2] = 0xFD; }
+    SECTION("no stored affiliation") { existing = false; }
+    if (existing) f.controller->affiliations()->groupAff(RID,TG);
+    uint64_t value=0U; for (auto octet:payload) value=(value<<8U)|octet;
+    REQUIRE(f.signal(0x29U,value)==accepted);
+    REQUIRE(f.controller->affiliations()->isGroupAff(RID,TG)==existing);
+    REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,1002U));
+    REQUIRE(f.controller->affiliations()->isUnitReg(RID));
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    auto replies=f.responses();
+    REQUIRE(replies.size()==(accepted ? 1U : 2U));
+    if (accepted) {
+        REQUIRE((replies[0][0]&0x3fU)==0x20U);
+        REQUIRE((replies[0][2]&0x3fU)==0x29U);
+    } else {
+        REQUIRE((replies[0][0]&0x3fU)==0x27U);
+        REQUIRE((replies[0][2]&0x3fU)==0x29U);
+        REQUIRE((replies[1][0]&0x3fU)==0x2DU);
+    }
+    for (const auto& reply:replies) {
+        // U_REG_CMD has target at octets 4-6 (AABC-E 6.2.20,
+        // Figure 6.2.20-1, PDF 192 / printed 173). ACK/DENY target
+        // this requesting SU at octets 7-9.
+        const unsigned targetOffset=(reply[0]&0x3fU)==0x2DU ? 4U : 7U;
+        REQUIRE(reply[targetOffset]==0x00U);
+        REQUIRE(reply[targetOffset+1U]==0x27U);
+        REQUIRE(reply[targetOffset+2U]==0x11U);
+    }
 }
