+// AABD-B 6.7.2.1, PDF 62 / printed 57 requires prior affiliation
+// removal on AFF_FAIL, AFF_DENY or AFF_REFUSED. Registration is separate.
+TEST_CASE("rejected affiliation withdraws the prior group without deregistering the unit", "[p25][subscriber-access][control-procedure]") {
+    Fixture f(true); f.apply(false,{},false,{});
+    REQUIRE(f.signal(0x28U,(uint64_t(1U)<<40U)|(uint64_t(1002U)<<24U)|RID));
+    REQUIRE(f.controller->affiliations()->isGroupAff(RID,1002U)); f.responses();
+    uint8_t response=0x02U; // AFF_DENY, AABC-E 6.2.8.1, PDF165 / printed146.
+    SECTION("new group denied by per-radio policy") { f.apply(true,{},false,{}); }
+    SECTION("new group disabled") { f.groups.addEntry(TG,1U,false); }
+    SECTION("unit refused") { f.radios.addEntry(RID,false,"Disabled subscriber"); response=0x03U; }
+    f.signal(0x28U,(uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|RID);
+    REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,1002U));
+    REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,TG));
+    REQUIRE(f.controller->affiliations()->grpAffSize()==0U);
+    REQUIRE(f.controller->affiliations()->isUnitReg(RID));
+    bool found=false;
+    for (const auto& reply:f.responses()) if ((reply[0]&0x3fU)==0x28U) {
+        REQUIRE((reply[2]&3U)==response); found=true;
+    }
+    REQUIRE(found);
+}
