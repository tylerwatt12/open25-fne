+TEST_CASE("denials restore the prior CC state and use the current request manufacturer", "[p25][subscriber-access]") {
+    Fixture f(true); f.apply(false,{},true,{});
+    REQUIRE(f.signal(TSBKO::IOSP_GRP_AFF,(uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|RID,0x90U));
+    f.responses(); REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    REQUIRE_FALSE(f.signal(TSBKO::IOSP_GRP_VCH,(uint64_t(4U)<<56U)|(uint64_t(TG)<<24U)|RID,0U));
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    auto replies=f.responses(); bool denied=false;
+    for (auto& reply:replies) if((reply[0]&0x3fU)==TSBKO::OSP_DENY_RSP) {
+        REQUIRE(reply[1]==0U); REQUIRE(reply[3]==ReasonCode::DENY_TGT_GROUP_NOT_AUTH); denied=true;
+    }
+    REQUIRE(denied);
+    // The next authorized operation is accepted without resetting the CC.
+    f.apply(false,{},false,{});
+    REQUIRE(f.signal(TSBKO::IOSP_GRP_AFF,(uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|RID));
+    REQUIRE(f.controller->affiliations()->isGroupAff(RID,TG));
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    REQUIRE_FALSE(f.signal(TSBKO::IOSP_GRP_VCH,(uint64_t(4U)<<56U)|(uint64_t(TG)<<24U)|APP));
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    REQUIRE(f.signal(TSBKO::IOSP_GRP_AFF,(uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|RID));
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+}
