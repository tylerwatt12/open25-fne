+
+/* Subscriber permissions use the applied local directory, including Site Trunking. */
+bool AccessControl::validateGroupAffiliation(uint32_t source, uint32_t group)
+{
+    if (!validateSrcId(source) || !validateTGId(group)) return false;
+    const auto rule = s_tidLookup->find(group);
+    return rule.isInvalid() || rule.config().subscriberAffiliationPermitted(source);
+}
+
+bool AccessControl::validateGroupTransmit(uint32_t source, uint32_t group)
+{
+    if (!validateGroupAffiliation(source, group)) return false;
+    const auto rule = s_tidLookup->find(group);
+    return rule.isInvalid() || rule.config().subscriberTransmitPermitted(source);
+}
