+TEST_CASE("RF cannot impersonate application disabled unknown or unconfigured identities", "[p25][subscriber-access]") {
+    for (uint32_t source : {APP, OTHER, 10006U, 19999U}) {
+        CAPTURE(source);
+        Fixture cc(true); cc.apply(false, {}, false, {});
+        cc.signal(TSBKO::IOSP_U_REG, (uint64_t(1U)<<36U)|(uint64_t(1U)<<24U)|source);
+        cc.signal(TSBKO::IOSP_GRP_AFF, (uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|source);
+        cc.signal(TSBKO::IOSP_GRP_VCH, (uint64_t(4U)<<56U)|(uint64_t(TG)<<24U)|source);
+        REQUIRE_FALSE(cc.controller->affiliations()->isUnitReg(source));
+        REQUIRE_FALSE(cc.controller->affiliations()->isGroupAff(source,TG));
+        REQUIRE(cc.controller->affiliations()->grantSize()==0U);
+        auto replies=cc.responses(); unsigned denied=0U;
+        for (auto& reply:replies) {
+            const auto opcode=reply[0]&0x3fU;
+            if (opcode==TSBKO::OSP_DENY_RSP) { REQUIRE(reply[3]==ReasonCode::DENY_REQ_UNIT_NOT_VALID); ++denied; }
+            if (opcode==TSBKO::IOSP_U_REG) { REQUIRE(((reply[2]>>4U)&3U)==ResponseCode::REFUSED); ++denied; }
+            if (opcode==TSBKO::IOSP_GRP_AFF) { REQUIRE((reply[2]&3U)==ResponseCode::REFUSED); ++denied; }
+        }
+        REQUIRE(denied==3U);
+        Fixture vc(false); vc.apply(false,{},false,{});
+        REQUIRE(vc.voice(DUID::HDU,source)); vc.drainVoice();
+        REQUIRE_FALSE(vc.voice(DUID::LDU1,source)); REQUIRE(vc.drainVoice()==0U);
+    }
+}
