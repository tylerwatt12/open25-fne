+constexpr uint32_t RID = 10001U, OTHER = 10005U, APP = 10002U, TG = 1001U, NAC = 0x293U;
+using Block = std::array<uint8_t, P25_TSBK_LENGTH_BYTES>;
+::lookups::TalkgroupRuleGroupVoice policy(bool affRestricted, const std::vector<uint32_t>& aff,
+    bool txRestricted, const std::vector<uint32_t>& tx) {
+    std::ostringstream text;
+    text << "name: TEST\nsource:\n    tgid: 1001\n    slot: 1\nconfig:\n    active: true\n    subscriber_access:\n        affiliation:\n            restricted: " << (affRestricted ? "true" : "false") << "\n            radio_ids:";
+    if (aff.empty()) text << " []\n";
+    else { text << "\n"; for (auto id : aff) text << "                - " << id << "\n"; }
+    text << "        transmit:\n            restricted: " << (txRestricted ? "true" : "false") << "\n            radio_ids:";
+    if (tx.empty()) text << " []\n";
+    else { text << "\n"; for (auto id : tx) text << "                - " << id << "\n"; }
+    yaml::Node node; REQUIRE(yaml::Parse(node, text.str()));
+    return ::lookups::TalkgroupRuleGroupVoice(node);
+}
+struct Fixture {
+    ::lookups::ChannelLookup channels;
+    ::lookups::RadioIdLookup radios{"", 0U, true};
+    ::lookups::TalkgroupRulesLookup groups{"", 0U, true};
+    ::lookups::IdenTableLookup identities{"", 0U};
+    ::lookups::RSSIInterpolator rssi;
+    modem::Modem modem{new modem::port::ModemNullPort(), true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U, true, true, false, false, false, false};
+    network::NetRPC rpc{"127.0.0.1", 48991U, 0U, "unopened-subscriber-test", false};
+    network::NetRPC* oldRPC = g_RPC;
+    std::unique_ptr<Control> controller;
+    explicit Fixture(bool cc, bool physicalInventory = true) {
+        g_logDisplayLevel = 0U; g_RPC = &rpc;
+        radios.addEntry(RID, true, "Subscriber"); radios.addEntry(OTHER, false, "Disabled"); radios.addEntry(APP, true, "Console"); radios.addEntry(10006U, true, "Not physical");
+        groups.addEntry(TG, 1U, true); groups.addEntry(1002U, 1U, true);
+        controller = std::make_unique<Control>(true, NAC, 1U, 16384U, &modem, nullptr, 120U, 1U, true,
+            &channels, &radios, &groups, &identities, &rssi, false, false, false, false, false);
+        yaml::Node config; std::string mode = cc ? "true" : "false";
+        const std::string inventory = physicalInventory ? "        dispatchSubscribers:\n            - 10001\n            - 10005\n" : "        dispatchSubscribers: []\n";
+        REQUIRE(yaml::Parse(config, std::string("protocols:\n    p25:\n        managedSite: true\n") + inventory + "        verifyReg: false\n        verifyAff: false\n        inhibitUnauthorized: false\n        tduPreambleCount: 0\n        control:\n            enable: " + mode + "\n            dedicated: " + mode + "\n            ackRequests: false\n            disableTSDUMBF: true\n            redundantImmediate: false\nsystem:\n    config:\n        controlCh:\n            notifyEnable: false\n"));
+        controller->setOptions(config, false, "N0TEST", ::lookups::VoiceChData(), 1U, 1U, 1U, 1U, 2U, 25U, false);
+        controller->configureIdentification(false); controller->setCCRunning(cc); controller->setZoneConnected(false);
+        controller->affiliations()->unitReg(RID);
+    }
+    ~Fixture() { controller.reset(); g_RPC = oldRPC; }
+    void apply(bool ar, std::vector<uint32_t> a, bool tr, std::vector<uint32_t> t) { groups.addEntry(policy(ar, a, tr, t)); }
+    bool signal(uint8_t opcode, uint64_t value, uint8_t manufacturer = 0U) {
+        Block raw{}; raw[0] = 0x80U | opcode; raw[1] = manufacturer;
+        for (unsigned i = 0U; i < 8U; ++i) raw[2U+i] = uint8_t(value >> ((7U-i)*8U));
+        edac::CRC::addCCITT162(raw.data(), raw.size());
+        std::array<uint8_t, P25_TSDU_FRAME_LENGTH_BYTES+2U> frame{}; frame[0] = modem::TAG_DATA; frame[1] = 1U;
+        Sync::addP25Sync(frame.data()+2U); NID nid(NAC); nid.encode(frame.data()+2U, DUID::TSDU);
+        std::array<uint8_t, P25_TSBK_FEC_LENGTH_BYTES> encoded{}; edac::Trellis trellis;
+        trellis.encode12(raw.data(), encoded.data()); P25Utils::encode(encoded.data(), frame.data()+2U, 114U, 318U);
+        P25Utils::addStatusBits(frame.data()+2U, P25_TSDU_FRAME_LENGTH_BITS, false, false);
+        return controller->processFrame(frame.data(), frame.size());
+    }
+    std::vector<Block> responses() {
+        std::array<uint8_t, 1024> frame{}; std::vector<Block> blocks;
+        while (controller->getFrame(frame.data()) != 0U) {
+            NID nid(NAC); if (!nid.decode(frame.data()+2U) || nid.getDUID()!=DUID::TSDU) continue;
+            std::array<uint8_t, P25_TSBK_FEC_LENGTH_BYTES> coded{}; Block raw{}; edac::Trellis trellis;
+            P25Utils::decode(frame.data()+2U, coded.data(), 114U, 318U); REQUIRE(trellis.decode12(coded.data(), raw.data()));
+            REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size())); blocks.push_back(raw);
+        }
+        return blocks;
+    }
+    bool voice(DUID::E duid, uint32_t source = RID) {
+        const unsigned size = duid==DUID::HDU ? P25_HDU_FRAME_LENGTH_BYTES : P25_LDU_FRAME_LENGTH_BYTES;
+        std::vector<uint8_t> frame(size+2U); frame[0]=modem::TAG_DATA; frame[1]=1U;
+        lc::LC value; value.setSrcId(source); value.setDstId(TG); value.setLCO(LCO::GROUP); value.setGroup(true);
+        value.setAlgId(ALGO_UNENCRYPT); value.setKId(0U);
+        if (duid!=DUID::HDU) { Audio audio; for (unsigned i=0U;i<9U;++i) audio.encode(frame.data()+2U,NULL_IMBE,i); }
+        if (duid==DUID::HDU) value.encodeHDU(frame.data()+2U);
+        if (duid==DUID::LDU1) value.encodeLDU1(frame.data()+2U);
+        if (duid==DUID::LDU2) value.encodeLDU2(frame.data()+2U);
+        Sync::addP25Sync(frame.data()+2U); NID nid(NAC); nid.encode(frame.data()+2U,duid);
+        P25Utils::addStatusBits(frame.data()+2U,size*8U,true,false);
+        return controller->processFrame(frame.data(),frame.size());
+    }
+    unsigned drainVoice() { unsigned count=0U; std::array<uint8_t,1024> frame{}; while(controller->getFrame(frame.data())) ++count; return count; }
+};
+}
