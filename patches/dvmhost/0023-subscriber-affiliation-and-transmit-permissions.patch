+        REQUIRE(denied); REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,TG));
+        f.signal(TSBKO::IOSP_GRP_VCH,(uint64_t(4U)<<56U)|(uint64_t(TG)<<24U)|RID);
+        replies=f.responses(); denied=false;
+        for(auto& r:replies) if((r[0]&0x3fU)==TSBKO::OSP_DENY_RSP) { REQUIRE(r[3]==ReasonCode::DENY_TGT_GROUP_NOT_AUTH); denied=true; }
+        REQUIRE(denied); REQUIRE(f.controller->affiliations()->grantSize()==0U);
+    }
+    SECTION("affiliation accepted while transmit denied") {
+        Fixture f(true); f.apply(true,{RID,APP},true,{APP});
+        f.signal(TSBKO::IOSP_GRP_AFF,(uint64_t(1U)<<40U)|(uint64_t(TG)<<24U)|RID);
