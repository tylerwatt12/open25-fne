+        f.signal(TSBKO::IOSP_GRP_VCH,(uint64_t(0x84U)<<56U)|(uint64_t(TG)<<24U)|RID);
+        auto replies=f.responses(); bool denied=false;
+        for(auto& r:replies) if((r[0]&0x3fU)==TSBKO::OSP_DENY_RSP) { REQUIRE(r[3]==ReasonCode::DENY_TGT_GROUP_NOT_AUTH); denied=true; }
+        REQUIRE(denied); REQUIRE(f.controller->affiliations()->isUnitReg(RID)); REQUIRE(f.controller->affiliations()->grantSize()==0U);
+    }
