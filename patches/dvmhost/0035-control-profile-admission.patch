+// SPDX-License-Identifier: GPL-2.0-only
+// BAAC-D 2.3/PDF14 printed4; AABB-B5.1/PDF20-21 printed12-13.
+// Literal header fields choose the profile; CRC supplies framing integrity.
+#include "common/p25/lc/tsbk/TSBKFactory.h"
+#include "common/p25/lc/tsbk/ISP_EMERG_ALRM_REQ.h"
+#include "common/p25/lc/tsbk/IOSP_GRP_VCH.h"
+#include "common/p25/lc/tsbk/OSP_DVM_LC_CALL_TERM.h"
+#include "common/edac/CRC.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+
+namespace {
+using namespace p25;
+using namespace p25::lc;
+using namespace p25::lc::tsbk;
+using namespace p25::defines;
+std::array<uint8_t,12U> packet(uint8_t mfid,uint8_t opcode,bool protect=false) {
+    std::array<uint8_t,12U> raw{{uint8_t(0x80U|opcode|(protect?0x40U:0U)),mfid,0U,0U,0U,3U,0xE9U,0U,0x27U,0x11U}};
+    edac::CRC::addCCITT162(raw.data(),raw.size()); return raw;
+}
+}
+
+TEST_CASE("only recognized manufacturer profiles can select a standard control handler", "[p25][control-profile][mfid]") {
+    for (unsigned mfid=0; mfid<256U; ++mfid) {
+        CAPTURE(mfid);
+        // Existing explicitly supported Motorola-compatible standard profile
+        // remains accepted. Neither arbitrary vendor nor DVM internal profile
+        // is an alias for standard radio-originated emergency/call arguments.
+        const bool allowed=mfid==0U || mfid==1U || mfid==0x90U;
+        for (uint8_t opcode : {0x27U,0x00U}) {
+            auto raw=packet(uint8_t(mfid),opcode);
+            auto decoded=TSBKFactory::createTSBK(raw.data(),TSBKFactory::Direction::Inbound,true);
+            REQUIRE(bool(decoded)==allowed);
+            if(decoded) REQUIRE(decoded->getMFId()==mfid);
+        }
+    }
+}
+
+TEST_CASE("protected arguments never become a plaintext operational message", "[p25][control-profile][mfid]") {
+    for (uint8_t mfid : {0U,1U,0x90U}) {
+        for (uint8_t opcode : {0x00U,0x18U,0x1CU,0x24U,0x27U,0x28U,0x2CU}) {
+            CAPTURE(mfid,opcode);
+            auto raw=packet(mfid,opcode,true);
+            for (auto direction : {TSBKFactory::Direction::Inbound,TSBKFactory::Direction::Outbound})
+                REQUIRE_FALSE(TSBKFactory::createTSBK(raw.data(),direction,true));
+        }
+        auto raw=packet(mfid,0x27U,true); ISP_EMERG_ALRM_REQ alarm;
+        REQUIRE_FALSE(alarm.decode(raw.data(),true));
+        raw=packet(mfid,0x00U,true); IOSP_GRP_VCH call;
+        REQUIRE_FALSE(call.decode(raw.data(),true));
+    }
+}
+
+TEST_CASE("internal DVM call termination keeps its explicit outbound role", "[p25][control-profile][mfid]") {
+    auto raw=packet(0x9CU,LCO::CALL_TERM);
+    auto decoded=TSBKFactory::createTSBK(raw.data(),TSBKFactory::Direction::Outbound,true);
+    REQUIRE(dynamic_cast<OSP_DVM_LC_CALL_TERM*>(decoded.get())!=nullptr);
+    REQUIRE_FALSE(TSBKFactory::createTSBK(raw.data(),TSBKFactory::Direction::Inbound,true));
+}
