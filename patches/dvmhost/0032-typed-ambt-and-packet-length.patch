diff --git a/src/host/p25/packet/AMBTIngress.h b/src/host/p25/packet/AMBTIngress.h
new file mode 100644
--- /dev/null
+++ b/src/host/p25/packet/AMBTIngress.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// AABC-E6.1 ISP extended formats; implicit home identity is required before
+// conversion to concrete local handlers. This never invokes a wire encoder.
+#ifndef P25_AMBT_INGRESS_H
+#define P25_AMBT_INGRESS_H
+#include "common/p25/lc/tsbk/TSBKFactory.h"
+namespace p25 { namespace packet { namespace ambt {
+static inline std::unique_ptr<lc::TSBK> localMessage(const lc::AMBT& source, uint32_t wacn, uint32_t system)
+{
+    using namespace lc; using namespace lc::tsbk; using namespace defines;
+    if (source.getNetId() != wacn || source.getSysId() != system) return nullptr;
+    std::unique_ptr<TSBK> message;
+    switch (source.getLCO()) {
+    case TSBKO::IOSP_STS_UPDT: {
+        const auto* typed = dynamic_cast<const MBT_IOSP_STS_UPDT*>(&source);
+        if (typed == nullptr) return nullptr;
+        auto value = std::make_unique<IOSP_STS_UPDT>(); value->setStatus(typed->getStatus()); message = std::move(value); break;
+    }
+    case TSBKO::IOSP_MSG_UPDT: {
+        const auto* typed = dynamic_cast<const MBT_IOSP_MSG_UPDT*>(&source);
+        if (typed == nullptr) return nullptr;
+        auto value = std::make_unique<IOSP_MSG_UPDT>(); value->setMessage(typed->getMessage()); message = std::move(value); break;
+    }
+    case TSBKO::IOSP_CALL_ALRT:
+        if (dynamic_cast<const MBT_IOSP_CALL_ALRT*>(&source) == nullptr) return nullptr;
+        message = std::make_unique<IOSP_CALL_ALRT>(); break;
+    case TSBKO::IOSP_ACK_RSP:
+        if (dynamic_cast<const MBT_IOSP_ACK_RSP*>(&source) == nullptr) return nullptr;
+        message = std::make_unique<IOSP_ACK_RSP>(); message->setService(source.getService());
+        message->setAIV(false); message->setEX(false); break;
+    case TSBKO::IOSP_GRP_AFF:
+        if (dynamic_cast<const MBT_IOSP_GRP_AFF*>(&source) == nullptr) return nullptr;
+        message = std::make_unique<IOSP_GRP_AFF>(); message->setEmergency(source.getEmergency()); break;
+    case TSBKO::ISP_CAN_SRV_REQ:
+        if (dynamic_cast<const MBT_ISP_CAN_SRV_REQ*>(&source) == nullptr) return nullptr;
+        message = std::make_unique<ISP_CAN_SRV_REQ>(); message->setService(source.getService());
+        message->setAIV(source.getAIV()); message->setResponse(source.getResponse()); break;
+    case TSBKO::IOSP_EXT_FNCT: {
+        const auto* typed = dynamic_cast<const MBT_IOSP_EXT_FNCT*>(&source);
+        if (typed == nullptr) return nullptr;
+        const uint32_t function = typed->getExtendedFunction();
+        if (function != 0x0080U && function != 0x00FDU && function != 0x00FEU && function != 0x00FFU) return nullptr;
+        auto value = std::make_unique<IOSP_EXT_FNCT>(); value->setExtendedFunction(function);
+        // Ordinary codec names srcId=Argument and dstId=actual responding SU.
+        value->setSrcId(typed->getArgument()); value->setDstId(source.getSrcId());
+        value->setMFId(source.getMFId()); return value;
+    }
+    default: return nullptr; // Authentication/vendor procedures are unavailable.
+    }
+    message->setMFId(source.getMFId()); message->setSrcId(source.getSrcId()); message->setDstId(source.getDstId());
+    return message;
+}
+}}}
+#endif
