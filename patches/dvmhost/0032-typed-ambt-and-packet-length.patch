diff --git a/tests/p25/PacketLengthBoundary_Tests.cpp b/tests/p25/PacketLengthBoundary_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/p25/PacketLengthBoundary_Tests.cpp
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// BAAA-B5.2/5.3: fixed16/12-byte block payloads, finalCRC4, secondary headers.
+// Expected boundary counts/pads below are explicit requirements-derived values.
+#include "common/p25/data/Assembler.h"
+#include "common/p25/data/DataHeader.h"
+#include "common/p25/data/DataBlock.h"
+#include "common/p25/P25Defines.h"
+#include "common/Utils.h"
+#include "common/edac/CRC.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <memory>
+#include <vector>
+using namespace p25; using namespace p25::defines;
+namespace {
+struct Row { uint8_t format,sap; uint32_t user,count,pad; };
+const Row rows[]={
+ {0x16,0,0,1,12},{0x16,0,1,1,11},{0x16,0,11,1,1},{0x16,0,12,1,0},{0x16,0,13,2,15},{0x16,0,27,2,1},{0x16,0,28,2,0},{0x16,0,29,3,15},{0x16,0,44,3,0},{0x16,0,652,41,0},
+ {0x15,0,0,1,8},{0x15,0,1,1,7},{0x15,0,7,1,1},{0x15,0,8,1,0},{0x15,0,9,2,11},{0x15,0,19,2,1},{0x15,0,20,2,0},{0x15,0,21,3,11},{0x15,0,32,3,0},{0x15,0,488,41,0},
+ {0x16,0x1F,0,1,8},{0x16,0x1F,1,1,7},{0x16,0x1F,8,1,0},{0x16,0x1F,9,2,15},{0x16,0x1F,24,2,0},
+ {0x15,0x1F,0,2,8},{0x15,0x1F,1,2,7},{0x15,0x1F,8,2,0},{0x15,0x1F,9,3,11},{0x15,0x1F,20,3,0},
+ {0x16,0x01,0,2,15},{0x16,0x01,1,2,14},{0x16,0x01,15,2,0},{0x16,0x01,16,3,15},{0x16,0x01,31,3,0},
+ {0x15,0x01,0,2,7},{0x15,0x01,1,2,6},{0x15,0x01,7,2,0},{0x15,0x01,8,3,11},{0x15,0x01,19,3,0}
+};
+}
+TEST_CASE("packet lengths round up at every sub-block and exact-block boundary without source overread", "[p25][packet-length]") {
+ for(const auto& row:rows) {
+  CAPTURE(unsigned(row.format),unsigned(row.sap),row.user);
+  data::DataHeader h; h.setFormat(row.format); h.setAckNeeded(row.format==0x16); h.setSAP(row.sap); h.setEXSAP(PDUSAP::USER_DATA); h.setSrcLLId(123U);
+  REQUIRE(h.calculateLength(row.user)); REQUIRE(h.getBlocksToFollow()==row.count); REQUIRE(h.getPadLength()==row.pad);
+  const uint32_t secondary=row.sap==0x1F?(row.format==0x16?4U:12U):(row.sap==0x01?13U:0U);
+  REQUIRE(h.getPacketLength()==row.user+secondary);
+  std::unique_ptr<uint8_t[]> user(new uint8_t[row.user]); for(unsigned i=0;i<row.user;++i) user[i]=uint8_t(1+i%251);
+  data::Assembler tx; uint32_t bits=0; auto wire=tx.assemble(h,row.sap==0x1F,row.sap==0x01,user.get(),&bits); REQUIRE(wire);
+  REQUIRE(bits==112U+(row.count+1U)*196U);
+  data::Assembler rx; std::array<uint8_t,25> block{};
+  for(unsigned n=0;n<=row.count;++n) { Utils::getBitRange(wire.get(),block.data(),112U+n*196U,196U); REQUIRE(rx.disassemble(block.data(),block.size(),n==0U)); }
+  REQUIRE(rx.getComplete()); REQUIRE_FALSE(rx.getPacketCRCFailed()); REQUIRE(rx.getUserDataLength()==row.user);
+  std::vector<uint8_t> recovered(758); if(row.user!=0U) rx.getUserData(recovered.data()); for(unsigned i=0;i<row.user;++i) REQUIRE(recovered[i]==user[i]);
+ }
+}
+TEST_CASE("invalid packet sizes and secondary contracts fail before assembler callbacks", "[p25][packet-length]") {
+ for(auto fmt:{PDUFormatType::CONFIRMED,PDUFormatType::UNCONFIRMED}) {
+  data::DataHeader h; h.setFormat(fmt); h.setSAP(PDUSAP::USER_DATA);
+  REQUIRE_FALSE(h.calculateLength(fmt==PDUFormatType::CONFIRMED?653U:489U)); REQUIRE(h.getBlocksToFollow()==0U); REQUIRE(h.getPacketLength()==0U);
+  REQUIRE_FALSE(h.calculateLength(0xFFFFFFFFU)); REQUIRE(h.getPacketLength()==0U);
+  data::Assembler a; unsigned writes=0; a.setBlockWriter([&](const void*,uint8_t,const uint8_t*,uint32_t,bool){++writes;}); uint8_t dummy=0; uint32_t bits=99; REQUIRE_FALSE(a.assemble(h,false,false,&dummy,&bits)); REQUIRE(bits==0U); REQUIRE(writes==0U);
+  REQUIRE(data::DataHeader::calculatePadLength(fmt,fmt==PDUFormatType::CONFIRMED?12U:8U)==0U);
+  h.setSAP(PDUSAP::EXT_ADDR); REQUIRE(h.calculateLength(1U)); REQUIRE_FALSE(a.assemble(h,false,false,&dummy,&bits)); REQUIRE(bits==0U); REQUIRE(writes==0U);
+ }
+ data::DataHeader response; response.setFormat(PDUFormatType::RSP); REQUIRE(response.calculateLength(0U));
+ data::Assembler a; uint32_t bits=0; REQUIRE(a.assemble(response,false,false,nullptr,&bits)); REQUIRE(bits==308U);
+}
