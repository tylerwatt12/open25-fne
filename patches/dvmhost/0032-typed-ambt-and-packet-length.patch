diff --git a/tests/p25/AMBTLayouts_Tests.cpp b/tests/p25/AMBTLayouts_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/p25/AMBTLayouts_Tests.cpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Literal wire layouts from AABC-E figures6.1.1-2/4-2/5-2/7-2/9-2/11-2/15-2.
+// Header/body CRCs were generated independently by polynomial long division.
+#include "common/p25/lc/tsbk/TSBKFactory.h"
+#include "host/p25/packet/AMBTIngress.h"
+#include "common/edac/CRC.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <vector>
+#include <string>
+using namespace p25; using namespace p25::defines; using namespace p25::lc; using namespace p25::lc::tsbk;
+namespace {
+std::vector<uint8_t> bytes(const char* h) { std::vector<uint8_t> b; for(size_t n=0;h[n];n+=2) b.push_back(uint8_t(std::stoul(std::string(h+n,2),nullptr,16))); return b; }
+struct Wire { const char* header; const char* body; uint8_t opcode; uint32_t target; };
+const Wire vectors[] = {
+ {"17FD001234568118C3D4127B","ABCDE7896543210019753E47",0x18,0x654321},
+ {"17FD00123456811CBEEF3786","ABCDE7896543210019753E47",0x1C,0x654321},
+ {"17FD00123456811FABCD9670","E789654321000000D4637F80",0x1F,0x654321},
+ {"17FD00123456812018AB38DA","CDE7896543210000C431254E",0x20,0x654321},
+ {"17FD001234568128ABCDD645","E789A1B2800000009F0BEF96",0x28,0xA1B2},
+ {"17FD00123456812384102ABC","00ABCDE789654321F73F7DD3",0x23,0x654321},
+ {"17FD001234568124ABCDA324","E789008065432100E07B8FE5",0x24,0}
+};
+std::unique_ptr<AMBT> decode(const std::vector<uint8_t>& h, const std::vector<uint8_t>& b) {
+ data::DataHeader header; if(!header.decode(h.data(),true)) return nullptr;
+ // This is an actually received unconfirmed12-byte AMBT body. Mutating a
+ // header format must reach factory admission, not reinterpret the fixture as
+ // an18-byte confirmed block before the factory can reject it.
+ data::DataBlock blocks[2]; blocks[0].setFormat(PDUFormatType::AMBT); blocks[0].setData(b.data());
+ return TSBKFactory::createAMBT(header,blocks);
+}
+}
+TEST_CASE("AMBT literal layouts preserve full fields and produce actual concrete local types", "[p25][ambt-layout]") {
+ for(const auto& wire:vectors) {
+  CAPTURE(unsigned(wire.opcode)); auto h=bytes(wire.header), b=bytes(wire.body);
+  REQUIRE(edac::CRC::checkCCITT162(h.data(),h.size())); REQUIRE(edac::CRC::checkCRC32(b.data(),b.size()));
+  auto message=decode(h,b); REQUIRE(message); REQUIRE(message->getLCO()==wire.opcode);
+  REQUIRE(message->getNetId()==0xABCDE); REQUIRE(message->getSysId()==0x789); REQUIRE(message->getSrcId()==0x123456);
+  if(wire.opcode!=0x24) REQUIRE(message->getDstId()==wire.target);
+  auto local=packet::ambt::localMessage(*message,0xABCDE,0x789); REQUIRE(local);
+  REQUIRE(dynamic_cast<AMBT*>(local.get())==nullptr); REQUIRE(local->getMFId()==0U);
+  REQUIRE_FALSE(packet::ambt::localMessage(*message,0xABCDF,0x789)); REQUIRE_FALSE(packet::ambt::localMessage(*message,0xABCDE,0x788));
+  if(wire.opcode==0x18) { REQUIRE(dynamic_cast<IOSP_STS_UPDT*>(local.get())); REQUIRE(dynamic_cast<IOSP_STS_UPDT*>(local.get())->getStatus()==0xC3D4); }
+  if(wire.opcode==0x1C) { REQUIRE(dynamic_cast<IOSP_MSG_UPDT*>(local.get())); REQUIRE(dynamic_cast<IOSP_MSG_UPDT*>(local.get())->getMessage()==0xBEEF); }
+  if(wire.opcode==0x28) REQUIRE(local->getEmergency());
+  if(wire.opcode==0x23) { REQUIRE(local->getAIV()); REQUIRE(local->getService()==4U); REQUIRE(local->getResponse()==0x10U); }
+  if(wire.opcode==0x20) REQUIRE(local->getService()==0x18U);
+  if(wire.opcode==0x24) { REQUIRE(local->getSrcId()==0x654321); REQUIRE(local->getDstId()==0x123456); REQUIRE(dynamic_cast<IOSP_EXT_FNCT*>(local.get())->getExtendedFunction()==0x0080U); }
+  std::array<uint8_t,12> raw; raw.fill(0xA5); local->setLastBlock(true); local->encode(raw.data(),true,true);
+  REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size())); REQUIRE(raw[0]==(0x80U|wire.opcode));
+  if(wire.opcode==0x18) { REQUIRE(raw[2]==0xC3); REQUIRE(raw[3]==0xD4); }
+  if(wire.opcode==0x1C) { REQUIRE(raw[2]==0xBE); REQUIRE(raw[3]==0xEF); }
+  if(wire.opcode==0x24) { const auto expected=bytes("A4000080654321123456"); for(unsigned i=0;i<10;++i) REQUIRE(raw[i]==expected[i]); }
+  // MFID01 is the same standard message profile, not an unknown vendor alias.
+  h[2]=1U; edac::CRC::addCCITT162(h.data(),h.size()); message=decode(h,b); REQUIRE(message);
+  local=packet::ambt::localMessage(*message,0xABCDE,0x789); REQUIRE(local); REQUIRE(local->getMFId()==1U);
+ }
+}
+TEST_CASE("AMBT direct parsed ingress cannot bypass header body integrity or profile bounds", "[p25][ambt-layout]") {
+ data::DataHeader::setWarnCRC(true);
+ for(const auto& wire:vectors) {
+  const auto h=bytes(wire.header), b=bytes(wire.body);
+  for(unsigned bit=0;bit<96;++bit) { auto bad=h; bad[bit/8]^=0x80U>>(bit%8); REQUIRE_FALSE(decode(bad,b)); }
+  for(unsigned bit=0;bit<96;++bit) { auto bad=b; bad[bit/8]^=0x80U>>(bit%8); REQUIRE_FALSE(decode(h,bad)); }
+  for(auto mutation:std::vector<std::pair<unsigned,uint8_t>>{{0,0x37},{0,0x97},{1,0xFF},{2,0xAA},{2,0x90},{6,0x80},{6,0x82},{6,0xFF},{7,uint8_t(0xC0U|wire.opcode)}}) {
+   auto bad=h; bad[mutation.first]=mutation.second; edac::CRC::addCCITT162(bad.data(),bad.size()); REQUIRE_FALSE(decode(bad,b));
+  }
+ }
+ data::DataHeader::setWarnCRC(false);
+ MBT_IOSP_STS_UPDT wrong; wrong.setLCO(TSBKO::IOSP_MSG_UPDT); REQUIRE_FALSE(packet::ambt::localMessage(wrong,0U,0U));
+ const uint8_t dummy=0; REQUIRE_FALSE(wrong.decode(&dummy,true));
+}
