+TEST_CASE("packet CRC follows and protects padding with independent polynomial fixtures", "[p25][packet-length]") {
+ // BAAA-B5.3.1/5.3.3 PDF38-39/printed24-25. These bodies were derived by
+ // MSB-first polynomial long division (0x104C11DB7, final complement), not CRC.cpp.
+ struct Vector { uint8_t format; unsigned user; const char* body; };
+ const Vector vectors[]={
+  {0x16,0,"000000000000000000000000FFFFFFFF"},
+  {0x16,1,"010000000000000000000000F8091CF9"},
+  {0x16,12,"0102030405060708090A0B0C3C183E49"},
+  {0x16,28,"0102030405060708090A0B0C0D0E0F101112131415161718191A1B1C754815AA"},
+  {0x15,0,"0000000000000000FFFFFFFF"},
+  {0x15,1,"0100000000000000A45E2335"},
+  {0x15,8,"010203040506070882F0C97E"},
+  {0x15,20,"0102030405060708090A0B0C0D0E0F10111213143E889BD2"}
+ };
+ for(const auto& v:vectors) {
+  CAPTURE(unsigned(v.format),v.user);
+  data::DataHeader h;h.setFormat(v.format);h.setAckNeeded(v.format==0x16);h.setSAP(PDUSAP::USER_DATA);REQUIRE(h.calculateLength(v.user));
+  std::vector<uint8_t> user(v.user);for(unsigned i=0;i<v.user;++i)user[i]=uint8_t(i+1);
+  data::Assembler tx;uint32_t bits=0;auto wire=tx.assemble(h,false,false,v.user?user.data():nullptr,&bits);REQUIRE(wire);
+  std::vector<uint8_t> expected;for(unsigned i=0;v.body[i];i+=2)expected.push_back(uint8_t(std::stoul(std::string(v.body+i,2),nullptr,16)));
+  std::vector<uint8_t> actual;std::array<uint8_t,25> coded{};
+  for(unsigned n=0;n<h.getBlocksToFollow();++n){Utils::getBitRange(wire.get(),coded.data(),308U+n*196U,196U);data::DataBlock b;REQUIRE(b.decode(coded.data(),h));std::array<uint8_t,16> raw{};auto size=b.getData(raw.data());actual.insert(actual.end(),raw.begin(),raw.begin()+size);}
+  REQUIRE(actual==expected);
+  if(v.user==1U) {
+   // Re-encode a pad-bit change, including its confirmed block CRC9. Packet
+   // CRC must still reject it: the CRC protects padding as well as user bytes.
+   actual[1]^=1;data::DataBlock b;b.setFormat(h);b.setSerialNo(0);b.setData(actual.data());b.encode(coded.data());
+   data::Assembler rx;std::array<uint8_t,25> header{};Utils::getBitRange(wire.get(),header.data(),112,196);REQUIRE(rx.disassemble(header.data(),header.size(),true));REQUIRE(rx.disassemble(coded.data(),coded.size(),false));REQUIRE(rx.getComplete());REQUIRE(rx.getPacketCRCFailed());
+  }
+ }
+}
