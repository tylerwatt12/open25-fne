+struct StatusQueryTestAccess {
+    static void clock(Control& c) { c.control()->clockStatusQueries(); }
+    static void expire(Control& c, uint32_t target) {
+        auto* signal=c.control(); std::lock_guard<std::mutex> lock(signal->m_statusQueryMutex);
+        signal->m_statusQueries.at(target).deadline = std::chrono::steady_clock::now();
+    }
+    static void addSubscriber(Control& c,uint32_t target) { c.m_dispatchSubscribers.insert(target); c.affiliations()->unitReg(target); }
+    static size_t count(Control& c) { std::lock_guard<std::mutex> lock(c.control()->m_statusQueryMutex); return c.control()->m_statusQueries.size(); }
+    static std::unique_lock<std::mutex> holdQueue() { return std::unique_lock<std::mutex>(Control::s_queueLock); }
+    static bool statusMutexHeld(Control& c) { auto& mutex=c.control()->m_statusQueryMutex; if(!mutex.try_lock())return true; mutex.unlock();return false; }
+    static bool ownerActive(Control& c,uint32_t target) { auto* signal=c.control();std::lock_guard<std::mutex> lock(signal->m_statusQueryMutex);return signal->m_statusQueries.at(target).owner->active.load(); }
+    static void expireQueued(Control& c,uint32_t target) {
+        std::lock_guard<std::mutex> queueLock(Control::s_queueLock);
+        for(auto* queue:{&c.m_txImmQueue,&c.m_txQueue}) {
+            std::lock_guard<std::mutex> lock(queue->m_mutex);
+            for(auto& frame:queue->m_frames) if(frame.owner&&frame.owner->destination==target)
+                frame.expiresAt=std::chrono::steady_clock::now();
+        }
+    }
+    static void redundant(Control& c) { c.control()->m_redundantImmediate=true; }
+};
+}
