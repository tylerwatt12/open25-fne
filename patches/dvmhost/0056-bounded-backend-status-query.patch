+TEST_CASE("queued status query expiry prevents RF handoff without servicing the protocol clock", "[p25][status-query][status-query-expiry]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    REQUIRE(signal->requestStatusQuery(RID,0U));StatusQueryTestAccess::clock(*f.controller);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);
+    REQUIRE(f.controller->peekFrameLength()>0U);
+    StatusQueryTestAccess::expireQueued(*f.controller,RID);
+    // No protocol clock call: expiry is enforced by the real native queue pop.
+    std::array<uint8_t,1024> output{};
+    REQUIRE(f.controller->getFrame(output.data())==0U);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);
+    REQUIRE_FALSE(StatusQueryTestAccess::ownerActive(*f.controller,RID));
+    REQUIRE_FALSE(f.signal(0x19U,0x0102FFFFFC002711ULL));
+    REQUIRE(f.controller->peekFrameLength()==0U);
+    StatusQueryTestAccess::clock(*f.controller);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Cancelled);
+    REQUIRE(f.responses().empty());
+}
