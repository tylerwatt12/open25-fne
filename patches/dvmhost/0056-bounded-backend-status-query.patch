+TEST_CASE("status query emits standard literal local query only on the protocol owner", "[p25][status-query]") {
+    Fixture f(true); auto* signal=f.controller->control();
+    signal->setLastMFId(0x90U); StatusQueryTestAccess::redundant(*f.controller);
+    REQUIRE(signal->requestStatusQuery(RID,0U));
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Queued);
+    REQUIRE_FALSE(signal->requestStatusQuery(RID,0U));
+    REQUIRE(f.responses().empty());
+    StatusQueryTestAccess::clock(*f.controller);
+    auto blocks=f.responses(); REQUIRE(blocks.size()==1U);
+    const std::array<uint8_t,10U> expected{{0x9AU,0x00U,0x00U,0x00U,0x00U,0x27U,0x11U,0xFFU,0xFFU,0xFCU}};
+    for(size_t i=0;i<expected.size();++i) REQUIRE(blocks[0][i]==expected[i]);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);
+    for(unsigned i=0;i<10U;++i)StatusQueryTestAccess::clock(*f.controller);
+    REQUIRE(f.responses().empty()); // no optional repeats/redundancy
+    StatusQueryTestAccess::expire(*f.controller,RID);StatusQueryTestAccess::clock(*f.controller);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::NoResponse);
+    REQUIRE(timeoutLogs()==1U);
+    StatusQueryTestAccess::clock(*f.controller);REQUIRE(timeoutLogs()==1U);
+    REQUIRE(f.controller->affiliations()->isUnitReg(RID));
+}
+TEST_CASE("only solicited issued standard status query responses complete with full status", "[p25][status-query]") {
+    for(const auto status:{0U,0x0102U,0xFFFFU}) {
+        Fixture f(true); auto* signal=f.controller->control();
+        const uint64_t reply=(uint64_t(status)<<48U)|0xFFFFFC002711ULL;
+        REQUIRE_FALSE(f.signal(0x19U,reply)); // unsolicited
+        REQUIRE(signal->requestStatusQuery(RID,0U));
+        REQUIRE_FALSE(f.signal(0x19U,reply)); // accepted not issued
+        StatusQueryTestAccess::clock(*f.controller);f.responses();
+        for(const auto wrong:{0x0102002712002711ULL,0x0102FFFFFC002717ULL,0x0102FFFFFC002715ULL,0x0102FFFFFC004E1FULL}) {
+            REQUIRE_FALSE(f.signal(0x19U,wrong)); REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);
+        }
+        f.signal(0x18U,reply);REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);f.responses(); // update != query response
+        REQUIRE_FALSE(f.signal(0x19U,reply,0x90U));
+        REQUIRE_FALSE(f.signal(0x19U,reply,0xA4U));
+        REQUIRE(signal->statusQueryState(RID)==QueryState::Awaiting);
+        REQUIRE(f.signal(0x19U,reply,1U));
+        REQUIRE(signal->statusQueryState(RID)==QueryState::Reported);
+        std::ostringstream expected;expected<<"status = $"<<std::uppercase<<std::hex<<std::setfill('0')<<std::setw(4)<<status;
+        REQUIRE(diagnosticLog().str().find(expected.str())!=std::string::npos);
+        REQUIRE_FALSE(f.signal(0x19U,reply)); // terminal duplicate
+        REQUIRE_FALSE(signal->requestStatusQuery(RID,0U)); // original response window stays fenced
+    }
+}
+TEST_CASE("status query admission and completion require current registered physical control ownership", "[p25][status-query]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    for(const auto invalid:{0U,0xFFFFFCU,0xFFFFFFU}) REQUIRE_FALSE(signal->requestStatusQuery(invalid,0U));
+    for(const auto unavailable:{OTHER,APP,10006U,SECOND_SU}) {
+        REQUIRE(signal->requestStatusQuery(unavailable,0U));StatusQueryTestAccess::clock(*f.controller);
+        REQUIRE(signal->statusQueryState(unavailable)==QueryState::Cancelled);
+    }
+    REQUIRE(signal->requestStatusQuery(RID,0U)); StatusQueryTestAccess::clock(*f.controller);f.responses();
+    f.controller->affiliations()->unitDereg(RID);
+    REQUIRE_FALSE(f.signal(0x19U,0x0102FFFFFC002711ULL));
+    StatusQueryTestAccess::clock(*f.controller);REQUIRE(signal->statusQueryState(RID)==QueryState::Cancelled);
+    Fixture conventional(false);REQUIRE(conventional.controller->control()->requestStatusQuery(RID,0U));
+    StatusQueryTestAccess::clock(*conventional.controller);
+    REQUIRE(conventional.controller->control()->statusQueryState(RID)==QueryState::Cancelled);
+}
+TEST_CASE("cancelled expired or reset status queries cannot leave owned RF frames or resume", "[p25][status-query]") {
+    SECTION("queued first admission expiry") {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE(signal->requestStatusQuery(RID,0U));
+        StatusQueryTestAccess::expire(*f.controller,RID);StatusQueryTestAccess::clock(*f.controller);
+        REQUIRE(signal->statusQueryState(RID)==QueryState::Cancelled);REQUIRE(f.responses().empty());
+    }
+    SECTION("REST deadline expires before owner gets work") {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE_FALSE(signal->requestStatusQuery(RID,1U));
+        StatusQueryTestAccess::clock(*f.controller);REQUIRE(f.responses().empty());
+        REQUIRE(signal->statusQueryState(RID)==QueryState::Cancelled);
+    }
+    SECTION("stop withdraws queued frames") {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE(signal->requestStatusQuery(RID,0U));
+        StatusQueryTestAccess::clock(*f.controller);f.controller->setCCRunning(false);f.controller->setCCRunning(true);
+        REQUIRE(f.responses().empty());REQUIRE(signal->statusQueryState(RID)==QueryState::Cancelled);
+        StatusQueryTestAccess::clock(*f.controller);REQUIRE(f.responses().empty());
+    }
+    SECTION("reply deadline rejects before next protocol tick") {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE(signal->requestStatusQuery(RID,0U));
+        StatusQueryTestAccess::clock(*f.controller);f.responses();StatusQueryTestAccess::expire(*f.controller,RID);
+        REQUIRE_FALSE(f.signal(0x19U,0x0102FFFFFC002711ULL));
+        StatusQueryTestAccess::clock(*f.controller);REQUIRE(signal->statusQueryState(RID)==QueryState::NoResponse);
+    }
+    SECTION("matched response retracts undrained query") {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE(signal->requestStatusQuery(RID,0U));
+        StatusQueryTestAccess::clock(*f.controller);REQUIRE(f.signal(0x19U,0x0102FFFFFC002711ULL));
+        REQUIRE(f.responses().empty());
+    }
+}
