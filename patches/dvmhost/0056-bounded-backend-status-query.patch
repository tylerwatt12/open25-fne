+TEST_CASE("queue lock stalls cannot admit status queries after their first enqueue deadline", "[p25][status-query][status-query-deadline]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    auto queue=StatusQueryTestAccess::holdQueue();
+    auto request=std::async(std::launch::async,[&]{return signal->requestStatusQuery(RID,750U);});
+    const auto queuedBy=std::chrono::steady_clock::now()+std::chrono::milliseconds(500);
+    while(signal->statusQueryState(RID)!=QueryState::Queued&&std::chrono::steady_clock::now()<queuedBy)std::this_thread::yield();
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Queued);
+    std::promise<void> started;auto entered=started.get_future();
+    auto clock=std::async(std::launch::async,[&]{started.set_value();StatusQueryTestAccess::clock(*f.controller);});
+    entered.wait();
+    const auto ownedBy=std::chrono::steady_clock::now()+std::chrono::milliseconds(250);
+    while(!StatusQueryTestAccess::statusMutexHeld(*f.controller)&&std::chrono::steady_clock::now()<ownedBy)std::this_thread::yield();
+    const bool ownerBlocked=StatusQueryTestAccess::statusMutexHeld(*f.controller);
+    std::this_thread::sleep_for(std::chrono::milliseconds(800));
+    queue.unlock();clock.get();
+    REQUIRE(ownerBlocked); // fixture actually held the clock at queue commit
+    CHECK_FALSE(request.get());
+    CHECK(signal->statusQueryState(RID)==QueryState::Cancelled);
+    CHECK_FALSE(StatusQueryTestAccess::ownerActive(*f.controller,RID));
+    const auto emitted=f.responses();
+    CHECK(emitted.empty()); // actual serialized native RF queue, no modem opens
+    CHECK(f.controller->peekFrameLength()==0U);
+}
