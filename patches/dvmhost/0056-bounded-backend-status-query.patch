+namespace p25 { namespace lc { namespace tsbk {
+class ISP_STS_Q_RSP : public IOSP_STS_UPDT {
+public:
+    ISP_STS_Q_RSP() { m_lco = defines::TSBKO::ISP_STS_Q_RSP; }
+    std::string toString(bool = false) override { return "TSBKO, ISP_STS_Q_RSP (Status Query Response)"; }
+};
+class OSP_STS_Q : public IOSP_STS_UPDT {
+public:
+    OSP_STS_Q() { m_lco = defines::TSBKO::OSP_STS_Q; }
+    void encode(uint8_t* data, bool rawTSBK = false, bool noTrellis = false) override {
+        setStatus(0U); // octets2-3 are reserved in STS_Q, emitted zero
+        IOSP_STS_UPDT::encode(data, rawTSBK, noTrellis);
+    }
+    std::string toString(bool = false) override { return "TSBKO, OSP_STS_Q (Status Query)"; }
+};
+}}}
