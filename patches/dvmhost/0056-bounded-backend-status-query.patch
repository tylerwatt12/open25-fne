+TEST_CASE("status query bounds active requests and retains every unexpired response fence", "[p25][status-query]") {
+    SECTION("sixteen pending mailboxes") {
+        Fixture f(true);auto* signal=f.controller->control();
+        for(uint32_t i=0U;i<16U;++i)REQUIRE(signal->requestStatusQuery(11000U+i,0U));
+        REQUIRE_FALSE(signal->requestStatusQuery(11016U,0U));
+        REQUIRE(StatusQueryTestAccess::count(*f.controller)==16U);
+    }
+    SECTION("128 completed requests still fence their response windows") {
+        Fixture f(true);auto* signal=f.controller->control();
+        for(uint32_t i=0U;i<128U;++i) {
+            const auto target=11000U+i;
+            f.radios.addEntry(target,true,"Capacity subscriber");StatusQueryTestAccess::addSubscriber(*f.controller,target);
+            REQUIRE(signal->requestStatusQuery(target,0U));StatusQueryTestAccess::clock(*f.controller);
+            REQUIRE(f.responses().size()==1U);
+            REQUIRE(f.signal(0x19U,0x0102FFFFFC000000ULL|target));
+            REQUIRE(signal->statusQueryState(target)==QueryState::Reported);
+        }
+        REQUIRE(StatusQueryTestAccess::count(*f.controller)==128U);
+        // No expired slot: rejecting a new target must retain all old fences.
+        REQUIRE_FALSE(signal->requestStatusQuery(12000U,0U));
+        for(uint32_t i=0U;i<128U;++i)REQUIRE_FALSE(signal->requestStatusQuery(11000U+i,0U));
+        StatusQueryTestAccess::expire(*f.controller,11000U);
+        REQUIRE(signal->requestStatusQuery(12000U,0U));
+        REQUIRE(StatusQueryTestAccess::count(*f.controller)==128U);
+        REQUIRE(signal->statusQueryState(11000U)==QueryState::None);
+        for(uint32_t i=1U;i<128U;++i)REQUIRE(signal->statusQueryState(11000U+i)==QueryState::Reported);
+    }
+}
