diff --git a/src/host/p25/packet/ControlSignaling.Status.cpp b/src/host/p25/packet/ControlSignaling.Status.cpp
new file mode 100644
--- /dev/null
+++ b/src/host/p25/packet/ControlSignaling.Status.cpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// AABD-B10.4.2/10.4.4-5; AABC-E6.1.14/6.2.17. See status-query-backend.md.
+#include "p25/packet/ControlSignaling.h"
+#include "common/p25/lc/tsbk/StatusQuery.h"
+#include "p25/lookups/P25AffiliationLookup.h"
+#include "common/Log.h"
+using namespace p25;
+using namespace p25::packet;
+using namespace p25::defines;
+namespace {
+bool active(ControlSignaling::StatusQueryState state) {
+    return state == ControlSignaling::StatusQueryState::Queued || state == ControlSignaling::StatusQueryState::Awaiting;
+}
+}
+bool ControlSignaling::statusQueryTargetAvailable(uint32_t target) const {
+    return m_p25->m_enableControl && m_p25->m_dedicatedControl && m_p25->m_ccRunning &&
+        !m_p25->m_ccHalted && !m_p25->identificationActive() && m_p25->physicalSubscriberPermitted(target) &&
+        m_p25->m_affiliations->isUnitReg(target) && !isInhibited(target) && m_p25->m_modem != nullptr &&
+        !m_p25->m_modem->hasError() && !m_p25->m_modem->hasLockout();
+}
+bool ControlSignaling::requestStatusQuery(uint32_t target, uint32_t waitMs) {
+    std::unique_lock<std::mutex> lock(m_statusQueryMutex);
+    // REST validates only the address domain. All control/registration/policy
+    // admission runs on the protocol owner before a successful return.
+    if (target == 0U || target >= WUID_FNE) return false;
+    auto old = m_statusQueries.find(target);
+    if (old != m_statusQueries.end() && (active(old->second.state) || std::chrono::steady_clock::now() < old->second.deadline)) return false;
+    if (std::count_if(m_statusQueries.begin(),m_statusQueries.end(),[](const auto& row){return active(row.second.state);}) >= 16) return false;
+    if (old == m_statusQueries.end() && m_statusQueries.size() >= 128U) {
+        const auto now = std::chrono::steady_clock::now();
+        auto retired = std::find_if(m_statusQueries.begin(),m_statusQueries.end(),[&](const auto& row){
+            return !active(row.second.state) && now >= row.second.deadline;
+        });
+        if (retired == m_statusQueries.end()) return false;
+        m_statusQueries.erase(retired);
+    }
+    StatusQuery request; request.serial = ++m_statusQuerySerial;
+    request.deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(waitMs ? std::min(waitMs,750U) : 750U);
+    request.owner = std::make_shared<TxFrameOwner>(target,true,WUID_FNE,target,request.deadline,std::chrono::seconds(10));
+    m_statusQueries[target] = request;
+    if (waitMs == 0U) return true; // test/mailbox admission, never RF evidence
+    const auto serial = request.serial;
+    m_statusQueryChanged.wait_until(lock,request.deadline,[&]{
+        auto current = m_statusQueries.find(target);
+        return current == m_statusQueries.end() || current->second.serial != serial || current->second.state != StatusQueryState::Queued;
+    });
+    auto current = m_statusQueries.find(target);
+    if (current == m_statusQueries.end() || current->second.serial != serial) return false;
+    if (current->second.state == StatusQueryState::Queued) {
+        current->second.state = StatusQueryState::Cancelled; current->second.owner->active.store(false);
+    }
+    return current->second.state == StatusQueryState::Awaiting || current->second.state == StatusQueryState::Reported;
+}
+ControlSignaling::StatusQueryState ControlSignaling::statusQueryState(uint32_t target) {
+    std::lock_guard<std::mutex> lock(m_statusQueryMutex); auto found = m_statusQueries.find(target);
+    return found == m_statusQueries.end() ? StatusQueryState::None : found->second.state;
+}
+void ControlSignaling::cancelStatusQueries() {
+    std::lock_guard<std::mutex> lock(m_statusQueryMutex);
+    for (auto& row : m_statusQueries) if (active(row.second.state)) {
+        row.second.state = StatusQueryState::Cancelled; row.second.owner->active.store(false);
+    }
+    m_statusQueryChanged.notify_all();
+}
+void ControlSignaling::clockStatusQueries() {
+    std::lock_guard<std::mutex> lock(m_statusQueryMutex);
+    for (auto& row : m_statusQueries) {
+        auto& request = row.second; if (!active(request.state)) continue;
+        if (!request.owner->active.load() || !statusQueryTargetAvailable(row.first)) {
+            request.state = StatusQueryState::Cancelled; request.owner->active.store(false); continue;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= request.deadline) {
+            const bool issued = request.state == StatusQueryState::Awaiting;
+            request.state = issued ? StatusQueryState::NoResponse : StatusQueryState::Cancelled;
+            request.owner->active.store(false);
+            if (issued) LogInfoEx(LOG_HOST,"P25 Status Query, no response, arg = %u, tgt = %u, attempts = 1",WUID_FNE,row.first);
+            continue;
+        }
+        if (request.state == StatusQueryState::Awaiting) continue;
+        lc::tsbk::OSP_STS_Q query; query.setMFId(MFG_STANDARD); query.setSrcId(WUID_FNE); query.setDstId(row.first);
+        if (!writeRF_TSDU_SBF(&query,true,true,true,false,request.owner)) {
+            request.state = StatusQueryState::Cancelled; request.owner->active.store(false); continue;
+        }
+        request.state = StatusQueryState::Awaiting;
+        // Project policy: one query, ten-second response deadline. Optional
+        // signaling repetitions are not enabled; this is not CHECK's Nmax.
+        request.deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    }
+    m_statusQueryChanged.notify_all();
+}
+bool ControlSignaling::acceptStatusQueryResponse(uint32_t source, uint32_t target, uint8_t mfid) {
+    std::lock_guard<std::mutex> lock(m_statusQueryMutex); auto found = m_statusQueries.find(source);
+    if (found == m_statusQueries.end()) return false;
+    auto& request = found->second;
+    if (request.state != StatusQueryState::Awaiting || !request.owner->active.load() ||
+        std::chrono::steady_clock::now() >= request.deadline || target != WUID_FNE ||
+        (mfid != MFG_STANDARD && mfid != MFG_STANDARD_ALT) || !statusQueryTargetAvailable(source)) return false;
+    request.state = StatusQueryState::Reported; request.owner->active.store(false);
+    m_statusQueryChanged.notify_all(); return true;
+}
