+// SPDX-License-Identifier: GPL-2.0-only
+// Current paired protocol4 is a product serial contract, not a CAI packet.
+#include "host/modem/port/ModemNullPort.h"
+#include "host/modem/Modem.h"
+#include "common/Log.h"
+#include <catch2/catch_test_macros.hpp>
+#include <algorithm>
+#include <vector>
+
+namespace {
+using modem::port::ModemNullPort;
+std::vector<uint8_t> readAll(ModemNullPort& port) {
+    std::vector<uint8_t> result;
+    uint8_t pair[2];
+    for (;;) { const int n=port.read(pair,sizeof(pair)); if(n==0)break; REQUIRE(n>0);result.insert(result.end(),pair,pair+n); }
+    return result;
+}
+std::vector<uint8_t> send(ModemNullPort& port,const std::vector<uint8_t>& wire) {
+    REQUIRE(port.write(wire.data(),wire.size())==int(wire.size()));return readAll(port);
+}
+void p25Config(ModemNullPort& port,bool enabled=true) {
+    std::vector<uint8_t> wire(24,0);wire[0]=0xFE;wire[1]=24;wire[2]=2;wire[4]=enabled?8:0;
+    REQUIRE(send(port,wire)==std::vector<uint8_t>{0xFE,4,0x70,2});
+}
+class ClockedNullModem:public modem::Modem {
+public:
+    ModemNullPort* port;
+    ClockedNullModem():ClockedNullModem(new ModemNullPort()){}
+    explicit ClockedNullModem(ModemNullPort* p):Modem(p,true,false,false,false,false,false,0,0,0,8192,8192,8192,true,true,false,false,false,false),port(p) {
+        m_protoVer=4;m_p25Enabled=true;m_boundedCWOperation.store(true);p25Config(*port);
+    }
+    bool poll(){return getStatus();}
+    uint32_t credits()const{return m_p25Space;}
+    bool pending()const{return m_p25StatusPending;}
+};
+}
+
+TEST_CASE("Null modem reports current public protocol4 identity without physical UID", "[p25][null-protocol4]") {
+    g_logDisplayLevel=0;ModemNullPort port;REQUIRE(port.open());
+    auto version=send(port,{0xFE,3,0});
+    REQUIRE(version.size()==42); // 21-byte public header +21-byte Null class label
+    REQUIRE(std::vector<uint8_t>(version.begin(),version.begin()+5)==std::vector<uint8_t>{0xFE,42,0,4,15});
+    REQUIRE(std::all_of(version.begin()+5,version.begin()+21,[](uint8_t v){return v==0;}));
+    REQUIRE(std::string(version.begin()+21,version.end())=="Null Modem Controller");
+}
+
+TEST_CASE("Null status is exact12-byte requested P25 block-credit current contract", "[p25][null-protocol4]") {
+    ModemNullPort port;REQUIRE(port.open());p25Config(port);
+    REQUIRE(send(port,{0xFE,4,3,2})==std::vector<uint8_t>{0xFE,4,0x70,3});
+    const std::vector<uint8_t> expected{0xFE,12,1,0x88,2,0,0,0,0,0,32,0};
+    REQUIRE(send(port,{0xFE,3,1})==expected);
+    p25Config(port,false);
+    REQUIRE(send(port,{0xFE,3,1})==std::vector<uint8_t>{0xFE,12,1,0x80,0,0,0,0,0,0,0,0});
+}
+
+TEST_CASE("Null P25 FIFO resize is atomic bounded and advertises conservative16-byte credits", "[p25][null-protocol4]") {
+    ModemNullPort port;REQUIRE(port.open());p25Config(port);
+    for(unsigned size:{0U,15U,16U,511U,512U,522U}) {
+        CAPTURE(size);REQUIRE(send(port,{0xFE,9,15,0,0,uint8_t(size>>8),uint8_t(size),0,0})==std::vector<uint8_t>{0xFE,4,0x70,15});
+        const auto status=send(port,{0xFE,3,1});REQUIRE(status.size()==12);REQUIRE(status[10]==size/16);
+    }
+    REQUIRE(send(port,{0xFE,9,15,0,0,2,11,0,0})==std::vector<uint8_t>{0xFE,5,0x7F,15,2}); //523 exceeds522
+    REQUIRE(send(port,{0xFE,3,1})[10]==32);
+    REQUIRE(send(port,{0xFE,4,3,2})==std::vector<uint8_t>{0xFE,4,0x70,3});
+    REQUIRE(send(port,{0xFE,9,15,0,0,0,0,0,0})==std::vector<uint8_t>{0xFE,5,0x7F,15,11}); // active mode
+    REQUIRE(send(port,{0xFE,3,1})[10]==32);
+}
+
+TEST_CASE("Null modem rejects malformed serial requests before reading or changing current state", "[p25][null-protocol4][null-bounds]") {
+    ModemNullPort port;REQUIRE(port.open());p25Config(port);
+    const uint8_t tiny=0;REQUIRE(port.write(nullptr,0)==0);REQUIRE(port.write(&tiny,1)==0);
+    for(const auto& bad:std::vector<std::vector<uint8_t>>{{0xFE,2},{0xFE,4,1},{0xFE,4,1,0},{0xFE,3,2},{0xFE,3,3},{0xFD,0,3},{0xFD,0,4,1},{0x00,3,1}}) {
+        CAPTURE(bad.size());REQUIRE(port.write(bad.data(),bad.size())==0);REQUIRE(readAll(port).empty());
+    }
+    REQUIRE(send(port,{0xFE,3,1})==std::vector<uint8_t>{0xFE,12,1,0x88,0,0,0,0,0,0,32,0});
+    REQUIRE(port.write(std::vector<uint8_t>{0xFE,3,1}.data(),3)==3);port.close();REQUIRE(port.open());REQUIRE(readAll(port).empty());
+}
+
+TEST_CASE("Actual Modem consumes Null status and preserves pending-write credit ownership", "[p25][null-protocol4]") {
+    ClockedNullModem instance;REQUIRE(instance.open());REQUIRE(instance.poll());REQUIRE(instance.pending());instance.clock(0);
+    REQUIRE(instance.gotModemStatus());REQUIRE_FALSE(instance.pending());REQUIRE(instance.credits()==512);
+    std::vector<uint8_t> voice(218,0);voice[0]=modem::TAG_DATA;
+    REQUIRE(instance.poll());REQUIRE(instance.writeP25Frame(voice.data(),voice.size()));instance.clock(0);
+    REQUIRE(instance.credits()==294); // requested snapshot minus218 accepted later FIFO bytes
+    REQUIRE(instance.writeP25Frame(voice.data(),voice.size()));REQUIRE(instance.credits()==76);REQUIRE_FALSE(instance.writeP25Frame(voice.data(),voice.size()));
+    for(unsigned second=0;second<10;++second){instance.clock(1000);REQUIRE_FALSE(instance.hasError());REQUIRE(instance.gotModemStatus());}
+    REQUIRE(instance.credits()==512); // Null sink consumed data; a fresh requested poll replenished
+}
