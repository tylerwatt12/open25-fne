+TEST_CASE("RFSS check records state and emits exactly five standard requests before one terminal outcome", "[p25][radio-check]") {
+    Fixture f(true); auto* signal=f.controller->control();
+    signal->setLastMFId(0x90U);
+    RadioCheckTestAccess::redundantImmediate(*f.controller);
+    REQUIRE(signal->requestRadioCheck(RID));
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Queued);
+    REQUIRE_FALSE(signal->requestRadioCheck(RID));
+    REQUIRE(f.responses().empty()); // REST enqueue cannot transmit.
+    const std::array<uint8_t,10U> expected{{0xA4U,0x00U,0x00U,0x00U,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U}};
+    RadioCheckTestAccess::clock(*f.controller,0U);
+    for (unsigned attempt=0U;attempt<5U;++attempt) {
+        auto blocks=f.responses(); REQUIRE(blocks.size()==1U);
+        for (size_t i=0U;i<expected.size();++i) REQUIRE(blocks[0][i]==expected[i]);
+        REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+        REQUIRE(timeoutLogs()==0U);
+        RadioCheckTestAccess::clock(*f.controller,1999U);
+        REQUIRE(f.responses().empty()); REQUIRE(timeoutLogs()==0U);
+        RadioCheckTestAccess::clock(*f.controller,1U);
+    }
+    REQUIRE(signal->radioCheckState(RID)==CheckState::NoResponse);
+    REQUIRE(timeoutLogs()==1U);
+    REQUIRE(diagnosticLog().str().find("P25 Radio Check, no response, arg = 16777212, tgt = 10001, attempts = 5")!=std::string::npos);
+    REQUIRE(f.controller->affiliations()->isUnitReg(RID)); // no optional detach/removal policy
+    for (unsigned i=0;i<20U;++i) RadioCheckTestAccess::clock(*f.controller,10000U);
+    REQUIRE(f.responses().empty()); REQUIRE(timeoutLogs()==1U);
+}
