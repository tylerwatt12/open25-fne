+TEST_CASE("only an issued matching standard target response completes a requested check", "[p25][radio-check][wuid-refresh]") {
+    Fixture f(true); auto* signal=f.controller->control(); auto* units=f.controller->affiliations();
+    units->unitReg(SECOND_SU); units->unitReg(WUID_FNE);
+    f.age(1000U);
+    // Full five-byte ExtendedFunction: class00 operand80 argumentFFFFFC;
+    // final address002711 is the responding SU, never the argument.
+    constexpr uint64_t reply=0x0080FFFFFC002711ULL;
+    REQUIRE_FALSE(f.signal(0x24U,reply)); // no pending transaction
+    REQUIRE(signal->requestRadioCheck(RID));
+    REQUIRE_FALSE(f.signal(0x24U,reply)); // queued, not issued
+    RadioCheckTestAccess::clock(*f.controller,0U); f.responses();
+    for (const auto wrong : {0x0080002712002711ULL, // wrong requestor
+                             0x0080FFFFFC002717ULL, // different valid physical SU
+                             0x0080FFFFFC002715ULL, // disabled SU
+                             0x0080FFFFFC004E1FULL}) { // unknown SU
+        CAPTURE(wrong); REQUIRE_FALSE(f.signal(0x24U,wrong));
+        REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+        REQUIRE(units->unitRegTimer(RID)==1U);
+    }
+    f.signal(0x24U,0x007FFFFFFC002711ULL); // inbound command is not CHECK_ACK
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    f.signal(0x24U,0x00FFFFFFFC002711ULL); // unrelated INHIBIT_ACK is not a check response
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    f.signal(0x24U,0x00FEFFFFFC002711ULL); // unrelated UNINHIBIT_ACK
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    f.signal(0x24U,reply,0x90U); // wrong vendor profile cannot complete standard check
+    REQUIRE(signal->radioCheckState(RID)==CheckState::UnderCheck);
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    REQUIRE(f.signal(0x24U,reply));
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Available);
+    REQUIRE(units->unitRegTimer(RID)==0U);
+    REQUIRE(units->unitRegTimer(SECOND_SU)==1U);
+    REQUIRE(units->unitRegTimer(WUID_FNE)==1U);
+    f.responses();
+    RadioCheckTestAccess::clock(*f.controller,20000U);
+    REQUIRE(f.responses().empty()); REQUIRE(timeoutLogs()==0U);
+    f.age(1000U);
+    REQUIRE_FALSE(f.signal(0x24U,reply)); // duplicate/unsolicited does not refresh again
+    REQUIRE(units->unitRegTimer(RID)==1U);
+}
