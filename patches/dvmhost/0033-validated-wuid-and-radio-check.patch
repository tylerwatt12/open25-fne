+    }
+    Fixture fresh(true); REQUIRE(fresh.controller->control()->radioCheckState(RID)==CheckState::None);
+    RadioCheckTestAccess::clock(*fresh.controller,20000U); REQUIRE(fresh.responses().empty());
+}
