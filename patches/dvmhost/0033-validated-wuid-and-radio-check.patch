+// The RFSS retry count is AABD-B 13.2.1 / Table 17-1 (Nmax=5).
+// Two-second spacing/final wait is project policy, not TRFSS_RSP or TACK.
+namespace {
+constexpr uint32_t RADIO_CHECK_ATTEMPTS = 5U;
+constexpr uint32_t RADIO_CHECK_WAIT_MS = 2000U;
+bool activeRadioCheck(ControlSignaling::RadioCheckState state) {
+    return state == ControlSignaling::RadioCheckState::Queued || state == ControlSignaling::RadioCheckState::UnderCheck;
+}
+}
+
+bool ControlSignaling::requestRadioCheck(uint32_t dstId, uint32_t waitMs)
+{
+    if (!m_p25->physicalSubscriberPermitted(dstId)) return false;
+    std::unique_lock<std::mutex> lock(m_radioCheckMutex);
+    const auto old = m_radioChecks.find(dstId);
+    if (old != m_radioChecks.end() && activeRadioCheck(old->second.state)) return false;
+    if (std::count_if(m_radioChecks.begin(), m_radioChecks.end(), [](const auto& item) {
+        return activeRadioCheck(item.second.state);
+    }) >= 16) return false;
+    // Retain bounded local outcomes only. A new process never replays checks.
+    if (old == m_radioChecks.end() && m_radioChecks.size() >= 128U) {
+        const auto retired = std::find_if(m_radioChecks.begin(), m_radioChecks.end(), [](const auto& item) {
+            return !activeRadioCheck(item.second.state);
+        });
+        if (retired != m_radioChecks.end()) m_radioChecks.erase(retired);
+    }
+    RadioCheck request; request.serial = ++m_radioCheckSerial;
+    m_radioChecks[dstId] = request;
+    if (waitMs == 0U) return true;
+    const auto serial = request.serial;
+    m_radioCheckChanged.wait_for(lock, std::chrono::milliseconds(std::min(waitMs, 750U)), [&] {
+        const auto current = m_radioChecks.find(dstId);
+        return current == m_radioChecks.end() || current->second.serial != serial ||
+            current->second.state != RadioCheckState::Queued;
+    });
+    const auto current = m_radioChecks.find(dstId);
+    if (current == m_radioChecks.end() || current->second.serial != serial) return false;
+    if (current->second.state == RadioCheckState::Queued) current->second.state = RadioCheckState::Cancelled;
+    // A REST success means the clock owner really enqueued at least one
+    // command. Timed-out queued requests cannot execute after the response.
+    return current->second.attempts != 0U;
+}
+
+ControlSignaling::RadioCheckState ControlSignaling::radioCheckState(uint32_t dstId)
+{
+    std::lock_guard<std::mutex> lock(m_radioCheckMutex);
+    const auto found = m_radioChecks.find(dstId);
+    return found == m_radioChecks.end() ? RadioCheckState::None : found->second.state;
+}
+
+void ControlSignaling::cancelRadioChecks()
+{
+    std::lock_guard<std::mutex> lock(m_radioCheckMutex);
+    for (auto& entry : m_radioChecks) {
+        if (activeRadioCheck(entry.second.state)) entry.second.state = RadioCheckState::Cancelled;
+    }
+    m_radioCheckChanged.notify_all();
+}
+
+void ControlSignaling::clockRadioChecks(uint32_t ms)
+{
+    std::lock_guard<std::mutex> lock(m_radioCheckMutex);
+    for (auto& entry : m_radioChecks) {
+        auto& check = entry.second;
+        if (!activeRadioCheck(check.state)) continue;
+        // Withdraw on CC stop, reset, loss of local RF availability or policy
+        // revocation. Resuming a channel cannot resume an earlier command.
+        if (!m_p25->m_enableControl || !m_p25->m_dedicatedControl || !m_p25->m_ccRunning ||
+            m_p25->m_ccHalted || m_p25->identificationActive() ||
+            !m_p25->physicalSubscriberPermitted(entry.first) || m_p25->m_modem == nullptr ||
+            m_p25->m_modem->hasError() || m_p25->m_modem->hasLockout()) {
+            check.state = RadioCheckState::Cancelled;
+            continue;
+        }
+        if (check.state == RadioCheckState::UnderCheck) {
+            if (ms < check.remainingMs) { check.remainingMs -= ms; continue; }
+            if (check.attempts == RADIO_CHECK_ATTEMPTS) {
+                check.state = RadioCheckState::NoResponse;
+                LogInfoEx(LOG_HOST, "P25 Radio Check, no response, arg = %u, tgt = %u, attempts = %u",
+                    check.requestor, entry.first, check.attempts);
+                continue;
+            }
+        }
+        if (!writeRF_TSDU_Ext_Func(check.function, check.requestor, entry.first)) {
+            check.state = RadioCheckState::Cancelled;
+            continue;
+        }
+        ++check.attempts;
+        check.remainingMs = RADIO_CHECK_WAIT_MS;
+        check.state = RadioCheckState::UnderCheck;
+        // A stalled clock emits at most one retry per tick, never a burst of
+        // expired attempts. Each actual enqueue receives its full reply wait.
+    }
+    m_radioCheckChanged.notify_all();
+}
+
+bool ControlSignaling::acceptRadioCheckResponse(uint32_t function, uint32_t argument, uint32_t source, uint8_t mfid)
+{
+    std::lock_guard<std::mutex> lock(m_radioCheckMutex);
+    const auto found = m_radioChecks.find(source);
+    if (found == m_radioChecks.end()) return false;
+    auto& check = found->second;
+    if (check.state != RadioCheckState::UnderCheck || check.attempts == 0U ||
+        mfid != MFG_STANDARD || function != ExtendedFunctions::CHECK_ACK ||
+        check.function != ExtendedFunctions::CHECK || argument != check.requestor) return false;
+    check.state = RadioCheckState::Available;
+    return true;
+}
+
+void ControlSignaling::markValidatedWUID(uint32_t source)
+{
+    if (s_wuidTransaction.owner == this && m_p25->physicalSubscriberPermitted(source) &&
+        m_p25->m_affiliations->isUnitReg(source)) s_wuidTransaction.source = source;
+}
+
+void ControlSignaling::refreshAcknowledgedWUID()
+{
+    const auto transaction = s_wuidTransaction;
+    if (transaction.owner == this && transaction.source != 0U &&
+        m_p25->physicalSubscriberPermitted(transaction.source) && m_p25->m_affiliations->isUnitReg(transaction.source))
+        m_p25->m_affiliations->touchUnitReg(transaction.source);
 }
 
