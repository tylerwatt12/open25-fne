+struct RadioCheckTestAccess {
+    static void clock(Control& c, uint32_t ms) { c.control()->clockRadioChecks(ms); }
+    static void withValidatedRFContext(Control& c, uint32_t source, const std::function<void()>& body) {
+        auto* signal=c.control(); const auto old=signal->s_wuidTransaction;
+        signal->s_wuidTransaction={signal,0U}; signal->markValidatedWUID(source);
+        body(); signal->s_wuidTransaction=old;
+    }
+    static void redundantImmediate(Control& c) { c.control()->m_redundantImmediate = true; }
+    static void expireRFTimeout(Control& c) { c.m_rfTimeout.start(); c.m_rfTimeout.clock(121000U); }
+};
