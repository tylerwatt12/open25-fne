+    REQUIRE(signal->requestRadioCheck(RID)); RadioCheckTestAccess::clock(*f.controller,0U);
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Cancelled);
+    REQUIRE(f.responses().empty()); REQUIRE(timeoutLogs()==0U);
+    f.controller->affiliations()->groupAff(RID,TG);
+    REQUIRE(f.signal(0x29U,0x00FFFE03E9002711ULL));
+    REQUIRE(f.responses().empty());
+    REQUIRE(f.controller->affiliations()->unitRegTimer(RID)==1U);
+}
+
+TEST_CASE("another native writer thread cannot refresh an in-flight RF transaction", "[p25][radio-check][wuid-refresh]") {
+    Fixture f(true); auto* units=f.controller->affiliations(); auto* signal=f.controller->control();
+    units->groupAff(RID,TG); units->unitReg(SECOND_SU); f.age(1000U);
+    REQUIRE(signal->requestRadioCheck(SECOND_SU));
+    RadioCheckTestAccess::withValidatedRFContext(*f.controller,RID,[&] {
+        // Model the RF reader's validated handler paused before its response.
+        // The real clock owner runs independently and commits a CHECK packet.
+        auto clock=std::async(std::launch::async,[&] { RadioCheckTestAccess::clock(*f.controller,0U); });
+        clock.get(); REQUIRE(f.responses().size()==1U);
+        REQUIRE(units->unitRegTimer(RID)==1U); REQUIRE(units->unitRegTimer(SECOND_SU)==1U);
+        // A real same-thread query/ACK still refreshes the actual source.
+        REQUIRE(f.signal(0x29U,0x00FFFE03E9002711ULL));
+        REQUIRE(units->unitRegTimer(RID)==0U); REQUIRE(units->unitRegTimer(SECOND_SU)==1U);
+    });
+}
