+TEST_CASE("withdrawal reset revocation and reconstruction cannot replay checks", "[p25][radio-check]") {
+    for (unsigned mode=0U;mode<4U;++mode) {
+        CAPTURE(mode); Fixture f(true); auto* signal=f.controller->control();
+        REQUIRE(signal->requestRadioCheck(RID)); RadioCheckTestAccess::clock(*f.controller,0U); f.responses();
+        if (mode==0U) { f.controller->setCCRunning(false); f.controller->setCCRunning(true); }
+        if (mode==1U) { f.controller->setCCHalted(true); f.controller->setCCHalted(false); }
+        if (mode==2U) f.controller->reset();
+        if (mode==3U) f.radios.addEntry(RID,false,"revoked");
+        RadioCheckTestAccess::clock(*f.controller,20000U);
+        REQUIRE(signal->radioCheckState(RID)==CheckState::Cancelled);
