+struct P25AdmissionOrderTestAccess {
+    using ReadHook=std::function<UInt8Array(int&,sockaddr_storage&,uint32_t&,frame::RTPHeader&,frame::RTPFNEHeader&)>;
+    static void start(TrafficNetwork& n) {n.m_status=NET_STAT_MST_RUNNING;n.m_threadPool.start();}
+    static void stop(TrafficNetwork& n) {n.m_threadPool.stop();n.m_threadPool.wait();}
+    static void peer(TrafficNetwork& n,uint32_t id,FNEPeerConnection* p) {if(p)n.m_peers[id]=p;else n.m_peers.erase(id);}
+    static void read(TrafficNetwork& n,ReadHook f) {n.m_readPacketTestHook=std::move(f);}
+    static void hooks(TrafficNetwork& n,std::function<void(uint16_t,uint32_t)> before,
+        std::function<void(uint16_t,uint32_t)> sink,std::function<void()> task={}) {
+        n.m_p25BeforeForwardTestHook=std::move(before);n.m_p25QueueSinkTestHook=std::move(sink);n.m_taskStartedTestHook=std::move(task);
+    }
+};
+}
+struct HostTrafficReaderTestAccess {
+    static void network(HostFNE& host,network::TrafficNetwork* n) {host.m_network=n;}
+    static bool start(HostFNE& host) {return host.startTrafficReader();}
+    static void stop(HostFNE& host) {host.stopTrafficReader();}
+    static bool joined(HostFNE& host) {return !host.m_trafficReader.joinable();}
+    static void hooks(HostFNE& host,std::function<std::thread()> start,std::function<void()> join={}) {
+        host.m_trafficReaderStartTestHook=std::move(start);host.m_beforeTrafficReaderJoinTestHook=std::move(join);
+    }
+};
+namespace {
+using AdmissionAccess=network::P25AdmissionOrderTestAccess;
+struct AdmissionGate {
+    std::mutex mutex;std::condition_variable changed;
+    bool entered=false,released=false,expired=false,stopping=false;
+    std::thread::id taskThread;
+    unsigned reads=0U;std::vector<uint16_t> queued;
+    void block() {
+        std::unique_lock<std::mutex> lock(mutex);entered=true;taskThread=std::this_thread::get_id();changed.notify_all();
+        if(!changed.wait_for(lock,std::chrono::seconds(2),[&]{return released;}))expired=true;
+    }
+    bool wait(bool AdmissionGate::*field) {
+        std::unique_lock<std::mutex> lock(mutex);return changed.wait_for(lock,std::chrono::seconds(2),[&]{return this->*field;});
+    }
+    bool waitQueued() {
+        std::unique_lock<std::mutex> lock(mutex);return changed.wait_for(lock,std::chrono::seconds(2),[&]{return !queued.empty();});
+    }
+    void release() {std::lock_guard<std::mutex> lock(mutex);released=true;changed.notify_all();}
+};
