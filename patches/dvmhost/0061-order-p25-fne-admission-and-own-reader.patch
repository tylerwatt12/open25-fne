+TEST_CASE("P25 processNetwork completes earlier voice before reading later voice or End", "[fne-admission-inline]") {
+    const std::vector<uint16_t> expected{0U,1U,2U,3U,RTP_END_OF_CALL_SEQ};AdmissionFixture f(expected);
+    f.f.network.processNetwork();const bool first=f.gate->waitQueued();std::thread::id reader;
+    auto receive=std::async(std::launch::async,[&]{reader=std::this_thread::get_id();for(unsigned i=0;i<4;++i)f.f.network.processNetwork();});
+    const bool entered=f.gate->wait(&AdmissionGate::entered);
+    const bool held=receive.wait_for(std::chrono::milliseconds(100))==std::future_status::timeout;
+    unsigned reads;bool sameThread;
+    {std::lock_guard<std::mutex> lock(f.gate->mutex);reads=f.gate->reads;sameThread=f.gate->taskThread==reader;}
