+// Normative periodic update: AABD-B November2014 §12.3 PDF115 / printed110.
+// AABC-E-2019 §6.2.9 PDF168–169 / printed149–150 and §6.2.29 PDF209–210 /
+// printed190–191 define the two FDMA messages. Disabling is an explicit Site setting.
+TEST_CASE("Band Plan broadcast switch covers UHF and 700/800 and MBF padding", "[p25][band-plan-broadcast]") {
+    for (const uint32_t base : {443437500U,851006250U}) {
+        for (const bool mbf : {false,true}) {
+            LRAFixture fixture(1U);
+            fixture.identities.add(2U,base);
+            fixture.identities.add(3U,base+1000000U);
+            LRAScheduler scheduler(fixture.controller.get());
+            scheduler.multiblock(mbf);
+            // Native default is enabled: obtain a whole MBF or one single block.
+            for(unsigned i=0U;i<(mbf?3U:1U);++i) scheduler.writeRF_ControlData(1U,0U,false);
+            const auto enabled=fixture.drain();REQUIRE(enabled.size()==(mbf?3U:1U));
+            for(const auto& raw:enabled) REQUIRE((raw[0]&0x3fU)==(base>600000000U?0x3dU:0x34U));
+            scheduler.advertisements(false);
+            // Two blocks plus a padding slot cover the scheduler's extra IDEN path.
+            if (mbf) {
+                scheduler.queueRF_TSBK_Ctrl(TSBKO::OSP_IDEN_UP);
+                scheduler.queueRF_TSBK_Ctrl(TSBKO::OSP_IDEN_UP);
+                scheduler.writeRF_ControlData(1U,5U,false);
+            } else {
+                scheduler.writeRF_ControlData(1U,0U,false);
+            }
+            const auto disabled=fixture.drain();REQUIRE(disabled.size()==(mbf?3U:1U));
+            for(const auto& raw:disabled) REQUIRE((raw[0]&0x3fU)==0x3aU);
+            scheduler.advertisements(true);
+            for(unsigned i=0U;i<(mbf?3U:1U);++i) scheduler.writeRF_ControlData(1U,0U,false);
+            const auto restored=fixture.drain();REQUIRE(restored.size()==(mbf?3U:1U));
+            for(const auto& raw:restored) REQUIRE((raw[0]&0x3fU)==(base>600000000U?0x3dU:0x34U));
+            REQUIRE(fixture.identities.list().size()==2U);
+            REQUIRE(fixture.controller->affiliations()->grantSize()==0U);
+        }
+    }
+}
