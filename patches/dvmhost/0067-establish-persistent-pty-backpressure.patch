--- a/tests/CWIDUART_Tests.cpp
+++ b/tests/CWIDUART_Tests.cpp
@@ -224,13 +224,32 @@
     LocalPTY pty;
     PTYUART uart(pty.takeSlave());
     REQUIRE(uart.boundedIO(true));
-    REQUIRE(fillOutput(uart) > 0U);
+    // Keep output paused so the kernel cannot free room between setup and write.
+    REQUIRE(::tcflow(uart.descriptor(), TCOOFF) == 0);
