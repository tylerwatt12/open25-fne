+    const int written = uart.write(marker.data(), marker.size());
     const auto elapsed = Clock::now() - start;
+    REQUIRE(::tcflow(uart.descriptor(), TCOON) == 0);
+    REQUIRE(written == 0);
     REQUIRE(elapsed >= std::chrono::milliseconds(15));
     REQUIRE(elapsed < std::chrono::milliseconds(200));
+    if (queued != 0U) readExactMaster(pty, queued);
+    REQUIRE(uart.write(marker.data(), marker.size()) == int(marker.size()));
+    const auto received = readExactMaster(pty, marker.size());
