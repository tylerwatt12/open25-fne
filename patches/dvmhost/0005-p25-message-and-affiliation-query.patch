+TEST_CASE("A group-affiliation-query response applies RID and TG policy independently", "[p25][live-signaling]") {
+    constexpr uint32_t radio = 10001U, group = 1001U;
+    ControllerFixture fixture(false, false, true);
+    fixture.radios.eraseEntry(group); // TG 1001 must not need a RID 1001 whitelist entry.
+    fixture.radios.addEntry(radio, true, "Test subscriber");
+    fixture.groups.addEntry(group, 1U, true);
+    fixture.controller->affiliations()->unitReg(radio);
+    uint32_t source = radio, target = group;
+    bool accepted = true, needsRegistration = false;
+    uint8_t reason = ReasonCode::DENY_TGT_GROUP_NOT_VALID;
+    SECTION("valid different RID and TG") {}
+    SECTION("disabled RID") {
+        fixture.radios.addEntry(radio, false, "Disabled subscriber");
+        accepted = false; reason = ReasonCode::DENY_REQ_UNIT_NOT_VALID;
+    }
+    SECTION("unknown RID") {
+        source = 10002U;
+        accepted = false; reason = ReasonCode::DENY_REQ_UNIT_NOT_VALID;
+    }
+    SECTION("null RID absent from strict ACL") {
+        source = 0U;
+        accepted = false; reason = ReasonCode::DENY_REQ_UNIT_NOT_VALID;
+    }
+    SECTION("stock all-call RID still requires registration") {
+        source = 0xFFFFFFU;
+        accepted = false; needsRegistration = true; reason = ReasonCode::DENY_REQ_UNIT_NOT_AUTH;
+    }
+    SECTION("unregistered RID") {
+        fixture.controller->affiliations()->unitDereg(radio);
+        accepted = false; needsRegistration = true; reason = ReasonCode::DENY_REQ_UNIT_NOT_AUTH;
+    }
+    SECTION("disabled TG") {
+        fixture.groups.addEntry(group, 1U, false);
+        accepted = false;
+    }
+    SECTION("unknown TG") { target = 1099U; accepted = false; }
+    SECTION("nonpreferred TG") {
+        fixture.groups.addEntry(group, 1U, true, false, true);
+        accepted = false;
+    }
+    SECTION("null TG preserves stock normal-affiliation exception") { target = 0U; }
+    SECTION("unconfigured all-system group is not an ordinary allowed TG") { target = 0xFFFFU; accepted = false; }
+    REQUIRE_FALSE(fixture.radios.find(group).radioEnabled());
+    const auto response = ControllerFixture::rawBlock(TSBKO::ISP_GRP_AFF_Q_RSP,
+        (uint64_t(target) << 24U) | source);
+    REQUIRE(fixture.receiveRaw(response) == accepted);
+    REQUIRE(fixture.controller->affiliations()->isGroupAff(source, target) == accepted);
+    REQUIRE(fixture.controller->affiliations()->grpAffSize() == (accepted ? 1U : 0U));
+    REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+    REQUIRE(fixture.channels.rfChDataSize() == 0U);
+    auto replies = fixture.drain();
+    if (accepted) {
+        REQUIRE(replies.empty());
+    } else {
+        REQUIRE(replies.size() == (needsRegistration ? 2U : 1U));
+        REQUIRE(replies.front()->getLCO() == TSBKO::OSP_DENY_RSP);
+        REQUIRE(replies.front()->getResponse() == reason);
+        REQUIRE(replies.front()->getService() == TSBKO::ISP_GRP_AFF_Q_RSP);
+        const uint8_t* raw = replies.front()->getDecodedRaw();
+        REQUIRE(edac::CRC::checkCCITT162(raw, P25_TSBK_LENGTH_BYTES));
+        REQUIRE((raw[2U] & 0x3FU) == TSBKO::ISP_GRP_AFF_Q_RSP);
+        REQUIRE(raw[3U] == reason);
+        if (needsRegistration)
+            REQUIRE(replies.back()->getLCO() == TSBKO::OSP_U_REG_CMD);
+    }
+}
