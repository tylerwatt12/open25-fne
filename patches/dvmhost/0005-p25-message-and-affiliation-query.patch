+TEST_CASE("A real message request emits an ACK for message service to the requesting radio", "[p25][live-signaling]") {
+    ControllerFixture fixture(false, false, true, true);
+    fixture.radios.addEntry(10001U, true, "Test subscriber");
+    const auto request = ControllerFixture::rawBlock(TSBKO::IOSP_MSG_UPDT,
+        (uint64_t(1U) << 48U) | (uint64_t(0xFFFFFCU) << 24U) | 10001U);
+    REQUIRE(fixture.receiveRaw(request));
+    ControllerFixture::TaggedFrame frame{};
+    REQUIRE(fixture.controller->getFrame(frame.data()) == frame.size());
+    std::array<uint8_t, P25_TSBK_FEC_LENGTH_BYTES> coded{};
+    P25Utils::decode(frame.data() + 2U, coded.data(), 114U, 318U);
+    ControllerFixture::RawBlock response{};
+    edac::Trellis trellis;
+    REQUIRE(trellis.decode12(coded.data(), response.data()));
+    REQUIRE(edac::CRC::checkCCITT162(response.data(), response.size()));
+    REQUIRE((response[0U] & 0x3FU) == TSBKO::IOSP_ACK_RSP);
+    REQUIRE(response[1U] == MFG_STANDARD);
+    REQUIRE(response[2U] == (0x80U | TSBKO::IOSP_MSG_UPDT)); // AIV=1, EX=0, service=0x1C
+    for (size_t i = 3U; i < 7U; ++i)
+        REQUIRE(response[i] == 0U);
+    REQUIRE(response[7U] == 0U);
+    REQUIRE(response[8U] == uint8_t(10001U >> 8U));
+    REQUIRE(response[9U] == uint8_t(10001U));
+    REQUIRE(fixture.drain().empty());
+    REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+    REQUIRE(fixture.channels.rfChDataSize() == 0U);
+
+    // Optional delta proof is deliberately separate from M1's frozen exporter.
+    // Include the actual dequeued response frame, suitable for an independent framer.
+    if (const char* path = std::getenv("DVM_P25_SIGNALING_DELTA_EXPORT")) {
+        auto hex = [](const uint8_t* bytes, size_t length) {
+            static const char* digits = "0123456789ABCDEF";
+            std::string result;
+            for (size_t i = 0U; i < length; ++i) {
+                result.push_back(digits[bytes[i] >> 4U]);
+                result.push_back(digits[bytes[i] & 15U]);
+            }
+            return result;
+        };
+        fixture.radios.eraseEntry(1001U);
+        fixture.groups.addEntry(1001U, 1U, true);
+        fixture.controller->affiliations()->unitReg(10001U);
+        const auto queryResponse = ControllerFixture::rawBlock(TSBKO::ISP_GRP_AFF_Q_RSP,
+            (uint64_t(1001U) << 24U) | 10001U);
+        REQUIRE(fixture.receiveRaw(queryResponse));
+        REQUIRE(fixture.controller->affiliations()->isGroupAff(10001U, 1001U));
+        std::ofstream output(path, std::ios::trunc);
+        REQUIRE(output.good());
+        output << "{\n  \"schema\": \"dvm-p25-signaling-delta-v1\",\n"
+            << "  \"message_code\": 1,\n  \"radio_id\": 10001,\n"
+            << "  \"message_request_tsbk_hex\": \"" << hex(request.data(), request.size()) << "\",\n"
+            << "  \"message_ack_tsbk_hex\": \"" << hex(response.data(), response.size()) << "\",\n"
+            << "  \"message_ack_tagged_frame_hex\": \"" << hex(frame.data(), frame.size()) << "\",\n"
+            << "  \"gaq_response_tsbk_hex\": \"" << hex(queryResponse.data(), queryResponse.size()) << "\",\n"
+            << "  \"gaq_group_id\": 1001,\n  \"gaq_radio_1001_enabled\": false,\n"
+            << "  \"gaq_affiliation_accepted\": true\n}\n";
+        REQUIRE(output.good());
+    }
+}
