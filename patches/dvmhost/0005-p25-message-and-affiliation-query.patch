+TEST_CASE("Message update preserves the complete standardized 16-bit value", "[p25][live-signaling]") {
+    // TIA-102.AABC-B 2.3.21 and 6.1.11.1: octets 2-3 are Message,
+    // followed by a 24-bit target and 24-bit source address.
+    for (uint16_t message : {0x0000U, 0x0001U, 0x00FFU, 0x0100U, 0x1234U, 0xEFFFU, 0xFFFFU}) {
+        CAPTURE(message);
+        const auto raw = ControllerFixture::rawBlock(TSBKO::IOSP_MSG_UPDT,
+            (uint64_t(message) << 48U) | (uint64_t(0xFFFFFCU) << 24U) | 10001U);
+        IOSP_MSG_UPDT decoded;
+        REQUIRE(decoded.decode(raw.data(), true));
+        REQUIRE(decoded.getMessage() == message);
+        REQUIRE(decoded.getSrcId() == 10001U);
+        REQUIRE(decoded.getDstId() == 0xFFFFFCU);
+        ControllerFixture::RawBlock encoded{};
+        decoded.encode(encoded.data(), true, true);
+        REQUIRE(edac::CRC::checkCCITT162(encoded.data(), encoded.size()));
+        REQUIRE(encoded[2U] == uint8_t(message >> 8U));
+        REQUIRE(encoded[3U] == uint8_t(message));
+        REQUIRE(encoded == raw);
+        IOSP_MSG_UPDT copied(decoded);
+        REQUIRE(copied.getMessage() == message);
+    }
+}
