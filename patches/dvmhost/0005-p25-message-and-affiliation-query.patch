+TEST_CASE("Message acknowledgment remains explicitly configurable and enforces the RID ACL", "[p25][live-signaling]") {
+    bool enabled = true;
+    bool permitted = true;
+    SECTION("ACK disabled") { enabled = false; }
+    SECTION("unknown radio") { permitted = false; }
+    ControllerFixture fixture(false, false, true, enabled);
+    if (permitted)
+        fixture.radios.addEntry(10001U, true, "Test subscriber");
+    const auto request = ControllerFixture::rawBlock(TSBKO::IOSP_MSG_UPDT,
+        (uint64_t(1U) << 48U) | (uint64_t(0xFFFFFCU) << 24U) | 10001U);
+    REQUIRE(fixture.receiveRaw(request) == permitted);
+    auto replies = fixture.drain();
+    if (permitted) {
+        REQUIRE(replies.empty());
+    } else {
+        REQUIRE(replies.size() == 1U);
+        REQUIRE(replies.front()->getLCO() == TSBKO::OSP_DENY_RSP);
+        REQUIRE(replies.front()->getResponse() == ReasonCode::DENY_REQ_UNIT_NOT_VALID);
+        REQUIRE(replies.front()->getService() == TSBKO::IOSP_MSG_UPDT);
+    }
+}
