+// A received packet is ordered within its own stream, never the current TX ID.
+bool Control::matchesNetworkOwner(const NetworkReceiveOwner& owner, const network::P25PacketMetadata& received,
+    uint32_t source, uint32_t destination, uint8_t manufacturer, bool group, bool terminal, bool sourceZeroTerminal) const
+{
+    if (owner.received.streamId == 0U || received.streamId != owner.received.streamId ||
+        destination != owner.destination || manufacturer != owner.manufacturer || group != owner.group ||
+        (source != owner.source && !(terminal && sourceZeroTerminal && group && source == 0U))) return false;
+    const uint32_t timeDelta = received.timestamp - owner.received.timestamp;
+    if (timeDelta >= 0x80000000U) return false;
+    if (terminal && received.sequence == RTP_END_OF_CALL_SEQ) return true;
+    const uint16_t sequenceDelta = uint16_t(received.sequence - owner.received.sequence);
+    return sequenceDelta != 0U && sequenceDelta < 0x8000U;
+}
+
+bool Control::permitsNetworkVoice(const network::P25PacketMetadata& received, uint32_t source,
+    uint32_t destination, uint8_t manufacturer, bool group) const
+{
+    if (received.streamId == 0U || std::find(m_retiredNetworkVoiceStreams.begin(),
+        m_retiredNetworkVoiceStreams.end(), received.streamId) != m_retiredNetworkVoiceStreams.end()) return false;
+    if (m_networkVoiceOwner.received.streamId == 0U) return true;
+    return matchesNetworkOwner(m_networkVoiceOwner, received, source, destination, manufacturer, group, false);
+}
+
+void Control::acceptNetworkVoice(const network::P25PacketMetadata& received, uint32_t source,
+    uint32_t destination, uint8_t manufacturer, bool group)
+{
+    if (m_receivedNetworkTailOwner.received.streamId != 0U) {
+        m_receivedNetworkTailOwner = NetworkReceiveOwner{};
+        m_tailOnIdle = false;
+        if (m_netState == RS_NET_IDLE) m_voice->m_hadVoice = false;
+    }
+    m_networkVoiceOwner = NetworkReceiveOwner{received, source, destination, manufacturer, group};
+}
+
+void Control::retireNetworkVoiceReceive()
+{
+    const uint32_t stream = m_networkVoiceOwner.received.streamId;
+    if (stream != 0U) {
+        if (std::find(m_retiredNetworkVoiceStreams.begin(), m_retiredNetworkVoiceStreams.end(), stream) ==
+            m_retiredNetworkVoiceStreams.end()) m_retiredNetworkVoiceStreams.push_back(stream);
+        while (m_retiredNetworkVoiceStreams.size() > 64U) m_retiredNetworkVoiceStreams.pop_front();
+        if (m_network != nullptr) m_network->retireP25Receive(stream);
+    }
+    m_networkVoiceOwner = NetworkReceiveOwner{};
+}
+
+void Control::resetNetworkReceive()
+{
+    m_receivedNetworkTailOwner = NetworkReceiveOwner{};
+    retireNetworkVoiceReceive();
+    if (m_network != nullptr) m_network->resetP25();
+}
