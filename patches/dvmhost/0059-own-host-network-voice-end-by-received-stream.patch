+    wire.ingest(sender.wire->outgoing.back());MultiSiteTestAccess::process(*receiver.controller);
+    CHECK(MultiSiteTestAccess::networkState(*receiver.controller)==RS_NET_IDLE);CHECK_FALSE(MultiSiteTestAccess::permitted(*receiver.controller));
