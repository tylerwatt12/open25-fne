+constexpr uint32_t STREAM_A=0x10101U,STREAM_B=0x20202U;
+
+void hostOwnerRecordWire(const char* name,const std::vector<uint8_t>& packet) {
+    const char* path=std::getenv("DVM_HOST_END_REVIEW_CAPTURE");
+    if(path==nullptr)return;
+    std::ofstream file(std::string(path)+"/"+name,std::ios::binary);
+    REQUIRE(file.good());file.write(reinterpret_cast<const char*>(packet.data()),packet.size());
+    REQUIRE(file.good());
+}
+void hostOwnerSnapshot(const char* phase,ControllerFixture& voice,HostOwnerWire& network,const std::vector<DUID::E>& frames) {
+    std::cout<<"HOST_END_OWNER {\"phase\":\""<<phase<<"\",\"network_state\":"<<int(MultiSiteTestAccess::networkState(*voice.controller))
+        <<",\"permitted\":"<<(MultiSiteTestAccess::permitted(*voice.controller)?"true":"false")
+        <<",\"source\":"<<MultiSiteTestAccess::networkSource(*voice.controller)
+        <<",\"destination\":"<<MultiSiteTestAccess::networkDestination(*voice.controller)
+        <<",\"receive_filter\":"<<network.receivedFilter()<<",\"queued_bytes\":"<<network.chargedBytes()
+        <<",\"release_count\":"<<voice.rpc.releases.size()<<",\"reads\":[";
+    bool first=true;for(const auto& packet:network.reads){if(!first)std::cout<<",";first=false;
+        std::cout<<"{\"stream\":"<<packet.streamId<<",\"sequence\":"<<packet.sequence<<",\"timestamp\":"<<packet.timestamp<<"}";}
+    std::cout<<"],\"rf_duids\":[";first=true;for(const auto duid:frames){if(!first)std::cout<<",";first=false;std::cout<<int(duid);}
+    std::cout<<"]}"<<std::endl;
+}
+void hostOwnerStart(ControllerFixture& voice,HostOwnerWire& network,SiteNetwork& serializer,
+    uint32_t stream,uint32_t timestamp,const std::string& token) {
+    voice.permitVoice(token);
+    auto packet=network.at(serializer.encoded(DUID::LDU1),stream,0U,timestamp);
+    hostOwnerRecordWire(stream==STREAM_A?"a-voice.bin":"b-voice.bin",packet);
+    network.ingest(packet);
+    REQUIRE(network.receivedFilter()==stream);
+    REQUIRE(network.chargedBytes()>0U);
+    MultiSiteTestAccess::process(*voice.controller);
+    REQUIRE(network.reads.back().streamId==stream);
+    REQUIRE(network.reads.back().sequence==0U);
+    REQUIRE(network.reads.back().timestamp==timestamp);
+    // Native Host commits a complete first LDU1/LDU2 pair, not LDU1 alone.
+    auto ldu2=network.at(serializer.encoded(DUID::LDU2),stream,1U,timestamp+180U);
+    hostOwnerRecordWire(stream==STREAM_A?"a-ldu2.bin":"b-ldu2.bin",ldu2);
+    network.ingest(ldu2);MultiSiteTestAccess::process(*voice.controller);
+    REQUIRE(network.reads.back().streamId==stream);
+    REQUIRE(network.reads.back().sequence==1U);
+    REQUIRE(network.reads.back().timestamp==timestamp+180U);
+    REQUIRE(MultiSiteTestAccess::networkState(*voice.controller)==RS_NET_AUDIO);
+    REQUIRE(MultiSiteTestAccess::networkSource(*voice.controller)==SOURCE);
+    REQUIRE(MultiSiteTestAccess::networkDestination(*voice.controller)==GROUP);
+    REQUIRE(MultiSiteTestAccess::permitted(*voice.controller));
+    auto output=voice.drainVoice();
+    REQUIRE(std::count(output.begin(),output.end(),DUID::LDU1)==1U);
+    // voiceMode config requests exactly two TDU preamble units.
+    REQUIRE(std::count(output.begin(),output.end(),DUID::TDU)==2U);
+    hostOwnerSnapshot(stream==STREAM_A?"A-started":"B-started",voice,network,output);
+}
