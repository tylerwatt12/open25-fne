+        const auto currentTX=sender.getP25StreamId();CapacityPermitTestAccess::expireCallTerm(*radio.controller);radio.controller->clock();
+        const auto end=decodeHostDatagram(sender.wire->outgoing.back());CHECK(end.received.streamId==ownerA);CHECK(end.body[22U]==DUID::TDU);CHECK(sender.getP25StreamId()==currentTX);
+        wire.ingest(sender.wire->outgoing.back());MultiSiteTestAccess::process(*receiver.controller);
+        CHECK(MultiSiteTestAccess::receiveOwner(*receiver.controller)==b0.received.streamId);CHECK(MultiSiteTestAccess::permitted(*receiver.controller));CHECK(receiver.drainVoice().empty());
+        REQUIRE(radio.voiceFrame(DUID::LDU1,GROUP,false,group));const auto next=decodeHostDatagram(sender.wire->outgoing.back());
+        CHECK(next.received.streamId==currentTX);CHECK(next.received.sequence==uint16_t(b1.received.sequence+1U));
