+TEST_CASE("Incomplete network setup releases its permit without inventing identification", "[p25][host-end-owner-fix][network-setup-no-id]") {
+    for(const auto first:{DUID::LDU1,DUID::LDU2})for(const bool end:{false,true}) {
+        DYNAMIC_SECTION("first "<<int(first)<<" end "<<end) {
+            HostOwnerWire wire;SiteNetwork serializer;ControllerFixture voice(true,false,false,false,false,&wire);voice.voiceMode(true);voice.permitVoice("ab12:9401");
+            REQUIRE_FALSE(voice.controller->identificationPending());
+            wire.ingest(wire.at(serializer.encoded(first),STREAM_A,0U,0x1000U));MultiSiteTestAccess::process(*voice.controller);
+            REQUIRE(MultiSiteTestAccess::networkState(*voice.controller)==RS_NET_IDLE);REQUIRE(voice.drainVoice().empty());
+            REQUIRE_FALSE(voice.controller->identificationPending());
+            if(end){wire.ingest(wire.at(serializer.encoded(DUID::TDU),STREAM_A,RTP_END_OF_CALL_SEQ,0x1168U));MultiSiteTestAccess::process(*voice.controller);}
+            else MultiSiteTestAccess::timeoutNetwork(*voice.controller);
+            CHECK_FALSE(MultiSiteTestAccess::permitted(*voice.controller));CHECK(MultiSiteTestAccess::receiveOwner(*voice.controller)==0U);
+            CHECK(voice.rpc.releases==std::vector<uint32_t>{GROUP});CHECK(voice.drainVoice().empty());
+            CHECK_FALSE(voice.controller->identificationPending());CHECK_FALSE(voice.controller->consumeIdentificationEnd());
+        }
+    }
+}
