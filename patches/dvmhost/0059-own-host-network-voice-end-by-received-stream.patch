+class HostOwnerWire : public OpaqueWireNetwork {
+public:
+    std::vector<network::P25PacketMetadata> reads;
+    HostOwnerWire() : OpaqueWireNetwork(12345U, false) {}
+    UInt8Array readP25(bool& ret, uint32_t& length, network::P25PacketMetadata* received=nullptr) override {
+        network::P25PacketMetadata metadata;
+        auto result=network::BaseNetwork::readP25(ret,length,&metadata);
+        if(ret)reads.push_back(metadata);
+        if(received!=nullptr)*received=metadata;
+        return result;
+    }
+    std::vector<uint8_t> at(const std::vector<uint8_t>& body,uint32_t stream,uint16_t sequence,uint32_t timestamp) {
+        auto result=frame(body.data(),body.size(),stream,sequence);
+        network::frame::RTPHeader header;
+        REQUIRE(header.decode(result.data()));
+        REQUIRE(header.getSequence()==sequence);
+        header.setTimestamp(timestamp);header.encode(result.data());
+        network::frame::RTPHeader decoded;
+        REQUIRE(decoded.decode(result.data()));
+        REQUIRE(decoded.getTimestamp()==timestamp);
+        REQUIRE(decoded.getSequence()==sequence);
+        return result;
+    }
