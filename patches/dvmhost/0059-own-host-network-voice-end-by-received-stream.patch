+TEST_CASE("Actual group TDULC signaling MFID is separate from voice header MFID", "[p25][host-end-owner-fix][actual-group-tdulc]") {
+    OpaqueWireNetwork sender;ControllerFixture radio(true,false,false,false,false,&sender);radio.voiceMode(false);radio.permitVoice("ab12:9301");
+    REQUIRE(radio.voiceFrame(DUID::HDU,GROUP,false,true,SOURCE,MFG_STANDARD_ALT));
+    REQUIRE(radio.voiceFrame(DUID::LDU1,GROUP,false,true,SOURCE,MFG_STANDARD_ALT));
+    REQUIRE(radio.voiceFrame(DUID::LDU2,GROUP,false,true,SOURCE,MFG_STANDARD_ALT));
+    REQUIRE(sender.wire->outgoing.size()==2U);const auto voiceHeader=decodeHostDatagram(sender.wire->outgoing[0]);REQUIRE(voiceHeader.body[15U]==MFG_STANDARD_ALT);
+    HostOwnerWire wire;ControllerFixture receiver(true,false,false,false,false,&wire);receiver.voiceMode(false);receiver.permitVoice("ab12:9302");
+    for(const auto& p:sender.wire->outgoing){wire.ingest(p);MultiSiteTestAccess::process(*receiver.controller);}receiver.drainVoice();
+    // The inherited network routing target is GROUP. Existing separate RF-tail
+    // tests enforce the RFSS broadcast termination address on over-air output.
+    REQUIRE(radio.voiceFrame(DUID::TDULC,GROUP,false,true,SOURCE,MFG_STANDARD_ALT));
