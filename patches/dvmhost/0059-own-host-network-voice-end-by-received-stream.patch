+        REQUIRE(sender.writeP25TDUOnStream(term,lsd,ownerA));CHECK(sender.getP25StreamId()==currentTX);CHECK(sender.receivedFilter()==rx);CHECK(sender.chargedBytes()==bytes);
+    }
