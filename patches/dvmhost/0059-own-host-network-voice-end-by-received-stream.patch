+TEST_CASE("A completed network voice call still creates its identification obligation", "[p25][host-end-owner-fix][network-voice-id]") {
+    HostOwnerWire wire;SiteNetwork serializer;ControllerFixture voice(true,false,false,false,false,&wire);voice.voiceMode(true);
+    hostOwnerStart(voice,wire,serializer,STREAM_A,0x1000U,"ab12:9411");
+    REQUIRE_FALSE(voice.controller->identificationPending());
+    wire.ingest(wire.at(serializer.encoded(DUID::TDU),STREAM_A,RTP_END_OF_CALL_SEQ,0x1168U));MultiSiteTestAccess::process(*voice.controller);
+    CHECK_FALSE(MultiSiteTestAccess::permitted(*voice.controller));CHECK(voice.controller->identificationPending());
+    CHECK(voice.controller->consumeIdentificationEnd());CHECK_FALSE(voice.controller->consumeIdentificationEnd());
+    const auto end=voice.drainVoice();CHECK(std::count(end.begin(),end.end(),DUID::TDU)==1U);
+    CHECK(voice.controller->writeRF_VoiceEnd(false));CHECK_FALSE(voice.drainTail().empty());
+    CHECK_FALSE(voice.controller->consumeIdentificationEnd());
+}
