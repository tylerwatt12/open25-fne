+struct DecodedHostDatagram {std::vector<uint8_t> body;network::P25PacketMetadata received;};
+DecodedHostDatagram decodeHostDatagram(const std::vector<uint8_t>& packet) {
+    OpaqueWireSocket socket;socket.incoming.push_back(packet);network::FrameQueue queue(&socket,12345U,false);
+    int length=0;sockaddr_storage address{};uint32_t addressLength=0U;network::frame::RTPHeader rtp;network::frame::RTPFNEHeader fne;
+    auto body=queue.read(length,address,addressLength,&rtp,&fne);REQUIRE(body!=nullptr);REQUIRE(length>=24);
+    return {std::vector<uint8_t>(body.get(),body.get()+length),{fne.getStreamId(),rtp.getSequence(),rtp.getTimestamp()}};
+}
