+// Ordinary call completion is distinct from an explicit immediate withdrawal.
+// AABD-B §3.5 and BAAA-B §7.2.3: finish accepted voice before the terminal tail.
+TEST_CASE("Ordinary rejected-frame fallback cannot overtake the final accepted RF LDU", "[p25][rf-release-tail]") {
+    for (bool duplicateTerminator : {true, false}) {
+        ControllerFixture voice(true, false, false, false, false);
+        voice.voiceMode(false); voice.permitVoice("ab12:701");
+        REQUIRE(voice.voiceFrame(DUID::HDU));
+        REQUIRE(voice.voiceFrame(DUID::LDU1));
+        REQUIRE(voice.voiceFrame(DUID::LDU2));
+        voice.drainVoice(); // Earlier units have already crossed the modem boundary.
+        REQUIRE(voice.voiceFrame(DUID::LDU1)); // Keep this last accepted unit queued.
+        REQUIRE(voice.voiceFrame(DUID::TDU));
+        if (duplicateTerminator) {
+            REQUIRE_FALSE(voice.voiceFrame(DUID::TDU)); // Orphan/repeated end.
+        } else {
+            std::array<uint8_t, P25_TDU_FRAME_LENGTH_BYTES + 2U> rejected{};
+            REQUIRE_FALSE(voice.controller->processFrame(rejected.data(), rejected.size()));
+        }
+        // Exact ordinary reader fallback in Host.P25.cpp after processFrame(false).
+        REQUIRE(voice.controller->writeRF_VoiceEnd());
+        std::vector<DUID::E> units;
+        std::array<uint8_t, 1024U> frame{};
+        uint32_t length;
+        while ((length = voice.controller->getFrame(frame.data())) != 0U) {
+            NID nid(0x293U);
+            if (!nid.decode(frame.data() + 2U)) {
+                REQUIRE(std::all_of(frame.begin() + 2U, frame.begin() + length,
+                    [](uint8_t value) { return value == 0U; }));
+                continue; // Existing raw zero tail is not a voice data unit.
+            }
+            units.push_back(nid.getDUID());
+        }
+        REQUIRE(units == std::vector<DUID::E>{DUID::LDU1, DUID::TDU, DUID::TDU, DUID::TDULC});
+    }
+}
+
+TEST_CASE("Explicit immediate voice ending remains an explicit queue override", "[p25][rf-release-tail][dispatch-preemption]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode(false); voice.permitVoice("ab12:702");
+    REQUIRE(voice.voiceFrame(DUID::HDU));
+    REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice();
+    REQUIRE(voice.voiceFrame(DUID::LDU2));
+    REQUIRE(voice.voiceFrame(DUID::TDU));
+    REQUIRE(voice.controller->writeRF_VoiceEnd(true));
+    std::array<uint8_t, 1024U> frame{}; bool immediate = false;
+    REQUIRE(voice.controller->getFrame(frame.data(), &immediate) > 0U);
+    REQUIRE(immediate);
+    NID nid(0x293U); REQUIRE(nid.decode(frame.data() + 2U));
+    REQUIRE(nid.getDUID() == DUID::TDU);
+}
