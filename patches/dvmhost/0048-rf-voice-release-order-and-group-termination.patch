+// AABD-B §3.5/PDF26; AABF-D §7.3.8/PDF24. Compare the literal protected-LC
+// information bytes from the actual outbound writer, not a local encoder oracle.
+TEST_CASE("RFSS outbound group call termination addresses all subscriber units", "[p25][group-call-termination]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode(false); voice.permitVoice("ab12:703");
+    OfflineScheduler scheduler(voice.controller.get());
+    scheduler.writeRF_TDULC_ChanRelease(true, SOURCE, GROUP);
+    std::array<uint8_t, 1024U> frame{};
+    REQUIRE(voice.controller->getFrame(frame.data()) == P25_TDULC_FRAME_LENGTH_BYTES + 2U);
+    NID nid(0x293U); REQUIRE(nid.decode(frame.data() + 2U)); REQUIRE(nid.getDUID() == DUID::TDULC);
+    lc::tdulc::LC_CALL_TERM term; REQUIRE(term.decode(frame.data() + 2U));
+    const std::array<uint8_t, 9U> expected{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0xFFU, 0xFFU, 0xFFU}};
+    REQUIRE(std::equal(expected.begin(), expected.end(), term.getDecodedRaw()));
+    REQUIRE(term.getDstId() == WUID_ALL);
+    REQUIRE(voice.controller->getFrame(frame.data()) == 0U);
+    REQUIRE(voice.rpc.releases == std::vector<uint32_t>{GROUP}); // Internal grant remains the real TG.
+}
