+TEST_CASE("RFSS private call termination retains its selected individual target", "[p25][group-call-termination]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode(false);
+    OfflineScheduler scheduler(voice.controller.get());
+    scheduler.writeRF_TDULC_ChanRelease(false, SOURCE, TARGET);
+    std::array<uint8_t, 1024U> frame{};
+    REQUIRE(voice.controller->getFrame(frame.data()) == P25_TDULC_FRAME_LENGTH_BYTES + 2U);
+    lc::tdulc::LC_CALL_TERM term; REQUIRE(term.decode(frame.data() + 2U));
+    const std::array<uint8_t, 9U> expected{{0x4FU, 0U, 0U, 0U, 0U, 0U, 0U, 0x03U, 0xEAU}};
+    REQUIRE(std::equal(expected.begin(), expected.end(), term.getDecodedRaw()));
+    REQUIRE(term.getDstId() == TARGET);
+    REQUIRE(voice.rpc.releases.empty());
+}
+
+TEST_CASE("Outbound group termination address does not alter inbound session matching", "[p25][group-call-termination]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode(false); voice.permitVoice("ab12:704");
+    REQUIRE(voice.voiceFrame(DUID::HDU)); REQUIRE(voice.voiceFrame(DUID::LDU1)); voice.drainVoice();
+    REQUIRE_FALSE(voice.voiceFrame(DUID::TDULC, WUID_ALL));
+    REQUIRE(voice.controller->getRFState() == RS_RF_AUDIO);
+    REQUIRE(voice.rpc.releases.empty());
+    REQUIRE(voice.voiceFrame(DUID::TDULC, GROUP));
+    REQUIRE(voice.controller->getRFState() == RS_RF_LISTENING);
+    REQUIRE(voice.rpc.releases == std::vector<uint32_t>{GROUP});
+}
