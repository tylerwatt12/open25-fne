+TEST_CASE("full bounded queue preserves unrelated records and failure cancels older unsent CHECK attempts", "[p25][radio-check][check-withdrawal]") {
+    Fixture f(true,true,128U); auto* signal=f.controller->control();
+    REQUIRE(signal->requestRadioCheck(RID)); RadioCheckTestAccess::clock(*f.controller,0U); //49 bytes with prefix
+    REQUIRE(RadioCheckTestAccess::enqueue(*f.controller,marker(1,62U),true)); //64 bytes with prefix
+    REQUIRE_FALSE(RadioCheckTestAccess::enqueue(*f.controller,marker(2,62U),true));
+    RadioCheckTestAccess::clock(*f.controller,2000U); // retry cannot fit in remaining15 bytes
+    REQUIRE(signal->radioCheckState(RID)==CheckState::Cancelled);
+    REQUIRE(rawFrames(*f.controller)==std::vector<std::vector<uint8_t>>{marker(1,62U)});
+    REQUIRE(timeoutLogs()==0U);
+    REQUIRE_FALSE(signal->requestRadioCheck(RID,1U));
+    RadioCheckTestAccess::clock(*f.controller,20000U); REQUIRE(rawFrames(*f.controller).empty());
+}
