@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Private P25 transmit records. The payload is the unchanged modem frame;
+// cancellation ownership exists only inside the host process.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace p25 {
+struct TxFrameOwner {
+    explicit TxFrameOwner(uint32_t destination) : destination(destination) {}
+    const uint32_t destination;
+    std::atomic<bool> active{true};
+};
+using TxFrameOwnership = std::shared_ptr<TxFrameOwner>;
+
+class TxFrameQueue {
+public:
+    explicit TxFrameQueue(uint32_t capacity) : m_capacity(capacity) {}
+    bool push(const uint8_t* data, uint32_t length, const TxFrameOwnership& owner = {}) {
+        // A frame needs modem tag/reserved octets and a nonempty CAI body.
+        // Account the original two-octet length prefix in the payload budget.
+        if (data == nullptr || length <= 2U || length > 0xFFFFU) return false;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (length + 2U > m_capacity - m_used || (owner && !owner->active.load())) return false;
+        m_frames.push_back(Frame{std::vector<uint8_t>(data, data + length), owner});
+        m_used += length + 2U;
+        return true;
+    }
+    uint32_t pop(uint8_t* data) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        discardInactive();
+        if (m_frames.empty()) return 0U;
+        const auto length = uint32_t(m_frames.front().data.size());
+        // The active load in discardInactive is the handoff commit point.
+        // A frame already handed to the modem cannot subsequently be unsent.
+        ::memcpy(data, m_frames.front().data.data(), length);
+        m_frames.pop_front(); m_used -= length + 2U;
+        return length;
+    }
+    uint32_t frontLength() {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        discardInactive();
+        return m_frames.empty() ? 0U : uint32_t(m_frames.front().data.size());
+    }
+    bool isEmpty() { return frontLength() == 0U; }
+    uint32_t freeSpace() const {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_capacity - m_used;
+    }
+    uint32_t capacity() const { return m_capacity; }
+    void clear() {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_frames.clear(); m_used = 0U;
+    }
+    void discard(const std::function<bool(const TxFrameOwnership&)>& cancelled) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        for (auto it = m_frames.begin(); it != m_frames.end();) {
+            if (it->owner && cancelled(it->owner)) {
+                m_used -= uint32_t(it->data.size()) + 2U;
+                it = m_frames.erase(it);
+            } else ++it;
+        }
+    }
+private:
+    struct Frame { std::vector<uint8_t> data; TxFrameOwnership owner; };
+    void discardInactive() {
+        while (!m_frames.empty() && m_frames.front().owner && !m_frames.front().owner->active.load()) {
+            m_used -= uint32_t(m_frames.front().data.size()) + 2U;
+            m_frames.pop_front();
+        }
+    }
+    const uint32_t m_capacity;
+    uint32_t m_used = 0U;
+    mutable std::mutex m_mutex;
+    std::deque<Frame> m_frames;
+};
+}
