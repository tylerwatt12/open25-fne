+TEST_CASE("frame records reject empty tag-only and overlong input with precise bounded prefix accounting", "[p25][check-withdrawal]") {
+    TxFrameQueue queue(64U); const auto bytes=marker(1,62U); std::array<uint8_t,65536U> output{};
+    for(uint32_t length:{0U,1U,2U,65536U}) REQUIRE_FALSE(queue.push(bytes.data(),length));
+    REQUIRE(queue.push(bytes.data(),62U)); REQUIRE(queue.freeSpace()==0U);
+    REQUIRE_FALSE(queue.push(bytes.data(),3U)); REQUIRE(queue.pop(output.data())==62U);
+    REQUIRE(std::equal(bytes.begin(),bytes.end(),output.begin())); REQUIRE(queue.freeSpace()==64U);
+    const std::array<uint8_t,3U> tiny{{1U,2U,3U}};
+    for(unsigned i=0U;i<12U;++i) REQUIRE(queue.push(tiny.data(),tiny.size()));
+    REQUIRE(queue.freeSpace()==4U); REQUIRE_FALSE(queue.push(tiny.data(),tiny.size()));
+    for(unsigned i=0U;i<12U;++i) REQUIRE(queue.pop(output.data())==3U);
+    REQUIRE(queue.pop(output.data())==0U);
+}
