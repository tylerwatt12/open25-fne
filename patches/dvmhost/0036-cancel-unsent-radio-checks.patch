+TEST_CASE("concurrent peek get and CHECK cancellation preserve every unrelated frame in order", "[p25][check-withdrawal]") {
+    Fixture f(true); auto* signal=f.controller->control(); std::atomic<bool> produced{false};
+    std::vector<std::vector<uint8_t>> received;
+    auto producer=std::async(std::launch::async,[&] {
+        bool okay=true;
+        for(unsigned i=1U;i<=250U;++i) {
+            okay=RadioCheckTestAccess::enqueue(*f.controller,marker(i),true)&&okay;
+            if(i%5U==0U && signal->requestRadioCheck(RID)) RadioCheckTestAccess::clock(*f.controller,0U);
+        }
+        produced.store(true); return okay;
+    });
+    auto consumer=std::async(std::launch::async,[&] {
+        std::array<uint8_t,65536U> frame{};
+        while(!produced.load() || f.controller->peekFrameLength()!=0U) {
+            f.controller->peekFrameLength();
+            if(const auto length=f.controller->getFrame(frame.data())) received.emplace_back(frame.begin(),frame.begin()+length);
+            else std::this_thread::yield();
+        }
+    });
+    auto canceller=std::async(std::launch::async,[&] {
+        while(!produced.load()) { signal->cancelRadioChecks(); std::this_thread::yield(); }
+        signal->cancelRadioChecks();
+    });
+    REQUIRE(producer.get()); consumer.get(); canceller.get();
+    std::vector<std::vector<uint8_t>> normal;
+    for(const auto& frame:received) if(frame.size()==13U) normal.push_back(frame);
+    REQUIRE(normal.size()==250U);
+    for(unsigned i=1U;i<=250U;++i) REQUIRE(normal[i-1U]==marker(i));
+    REQUIRE(rawFrames(*f.controller).empty());
+}
