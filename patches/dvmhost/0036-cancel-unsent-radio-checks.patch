+namespace {
+// Opaque transport markers prove byte/order preservation. They are deliberately
+// not P25 message/FEC fixtures; CHECK records use the actual encoder/queue.
+std::vector<uint8_t> marker(unsigned sequence,size_t length=13U) {
+    std::vector<uint8_t> data(length,0xA5U); data[0]=modem::TAG_DATA; data[1]=0U;
+    data[2]=0x5AU; data[3]=uint8_t(sequence>>8U); data[4]=uint8_t(sequence); return data;
+}
+std::vector<std::vector<uint8_t>> rawFrames(Control& c) {
+    std::vector<std::vector<uint8_t>> frames; std::array<uint8_t,65536U> bytes{};
+    while (const auto size=c.getFrame(bytes.data())) frames.emplace_back(bytes.begin(),bytes.begin()+size);
+    return frames;
+}
+bool checkFrame(const std::vector<uint8_t>& bytes) {
+    if(bytes.size()!=P25_TSDU_FRAME_LENGTH_BYTES+2U)return false;
+    std::array<uint8_t,P25_TSBK_FEC_LENGTH_BYTES> coded{}; Block raw{}; edac::Trellis trellis;
+    P25Utils::decode(bytes.data()+2U,coded.data(),114U,318U);
+    REQUIRE(trellis.decode12(coded.data(),raw.data()));
+    REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size()));
+    return (raw[0]&0x3FU)==0x24U && raw[2]==0U && raw[3]==0U;
+}
+}
