+TEST_CASE("ACK cancels all queued retries without an RF echo and a new generation cannot revive them", "[p25][radio-check][check-withdrawal]") {
+    Fixture f(true); auto* signal=f.controller->control();
+    REQUIRE(signal->requestRadioCheck(RID));
+    RadioCheckTestAccess::clock(*f.controller,0U); RadioCheckTestAccess::clock(*f.controller,2000U);
+    REQUIRE(f.signal(0x24U,0x0080FFFFFC002711ULL));
+    REQUIRE(rawFrames(*f.controller).empty());
+    REQUIRE(f.controller->affiliations()->unitRegTimer(RID)==0U);
+    REQUIRE(signal->requestRadioCheck(RID)); RadioCheckTestAccess::clock(*f.controller,0U);
+    auto frames=rawFrames(*f.controller); REQUIRE(frames.size()==1U); REQUIRE(checkFrame(frames[0]));
+    RadioCheckTestAccess::clock(*f.controller,2000U); // unsent retry
+    f.controller->reset(); f.controller->setCCRunning(true);
+    REQUIRE(rawFrames(*f.controller).empty()); REQUIRE(timeoutLogs()==0U);
+    REQUIRE(checkFrame(frames[0])); // previously handed-off bytes cannot be unsent
+}
