+TEST_CASE("CHECK cancellation removes unsent records before first getFrame and preserves other queue order", "[p25][radio-check][check-withdrawal]") {
+    for(unsigned mode=0U;mode<5U;++mode) {
+        CAPTURE(mode); Fixture f(true); auto* signal=f.controller->control();
+        REQUIRE(signal->requestRadioCheck(RID)); RadioCheckTestAccess::clock(*f.controller,0U);
+        REQUIRE(f.controller->peekFrameLength()==P25_TSDU_FRAME_LENGTH_BYTES+2U);
+        REQUIRE(RadioCheckTestAccess::enqueue(*f.controller,marker(1),true));
+        REQUIRE(RadioCheckTestAccess::enqueue(*f.controller,marker(2),true));
+        REQUIRE(RadioCheckTestAccess::enqueue(*f.controller,marker(3),false));
+        if(mode==0U) { f.controller->setCCRunning(false); f.controller->setCCRunning(true); }
+        if(mode==1U) { f.controller->setCCHalted(true); f.controller->setCCHalted(false); }
+        if(mode==2U) REQUIRE(f.signal(0x24U,0x0080FFFFFC002711ULL));
+        if(mode==3U) for(unsigned i=0U;i<5U;++i) RadioCheckTestAccess::clock(*f.controller,2000U);
+        if(mode==4U) {
+            f.radios.addEntry(RID,false,"revoked");
+            REQUIRE(f.controller->peekFrameLength()==13U); // revoke before scheduler tick
+            f.radios.addEntry(RID,true,"enabled again");
+        }
+        REQUIRE(f.controller->peekFrameLength()==13U);
+        const auto frames=rawFrames(*f.controller);
+        REQUIRE(frames==std::vector<std::vector<uint8_t>>{marker(1),marker(2),marker(3)});
+        if(mode==2U) {
+            REQUIRE(signal->radioCheckState(RID)==CheckState::Available);
+            REQUIRE(diagnosticLog().str().find("(Extended Function Response)")!=std::string::npos);
+        }
+        RadioCheckTestAccess::clock(*f.controller,20000U);
+        REQUIRE(rawFrames(*f.controller).empty());
+        REQUIRE(timeoutLogs()==(mode==3U?1U:0U));
+    }
+}
