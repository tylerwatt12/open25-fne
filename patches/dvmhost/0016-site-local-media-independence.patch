+// Physical subscriber kinds are provisioned by the Site service. A console or
+// mobile login can never become RF demand merely by using its own numeric ID.
+bool Control::dispatchRFInterest(uint32_t destination) const
+{
+    if (m_affiliations == nullptr) return false;
+    const auto affiliations = m_affiliations->grpAffTable();
+    for (const auto& entry : affiliations) {
+        if (entry.second != destination || m_dispatchSubscribers.count(entry.first) == 0U) continue;
+        const auto radio = m_ridLookup->find(entry.first);
+        if (!radio.radioDefault() && radio.radioEnabled()) return true;
+    }
+    return false;
+}
