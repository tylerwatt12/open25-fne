+TEST_CASE("managed Site-local dispatch survives Zone loss but requires its local media master", "[dispatch-grant][site-trunking][local-media]") {
+    Fixture f; p25::DispatchGrantTestAccess::managed(*f.control);
+    REQUIRE_FALSE(f.control->externalNetworkAvailable()); REQUIRE(f.control->localMediaAvailable());
+    const auto grant=f.run(f.request()); REQUIRE(grant.accepted); REQUIRE(grant.issued);
+    REQUIRE(f.rpc.permits==1U); REQUIRE_FALSE(f.control->zoneConnected());
+    auto release=f.request(p25::DispatchAction::Release); release.epoch=grant.epoch; REQUIRE(f.run(release).accepted);
+    f.network.running(false);
+    const auto unavailable=f.run(f.request(p25::DispatchAction::Grant,LEASE2));
+    REQUIRE_FALSE(unavailable.accepted); REQUIRE_FALSE(unavailable.issued);
+}
