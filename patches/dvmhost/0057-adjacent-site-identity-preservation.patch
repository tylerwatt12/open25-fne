diff --git a/tests/p25/NeighborIdentity_Tests.cpp b/tests/p25/NeighborIdentity_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/p25/NeighborIdentity_Tests.cpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Source-derived literal layout: TIA-102.AABC-E (April 2019), 6.2.2.1,
+// Figure 6.2.2-1, PDF154/printed135, p25_89a3b878eee70a14.
+// Body fields are independently specified below. CRC96BA was calculated with
+// Python binascii.crc_hqx(body, 0) ^ 0xFFFF, outside the native implementation.
+#include "common/p25/lc/tsbk/OSP_ADJ_STS_BCAST.h"
+#include "common/p25/SiteData.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+
+using namespace p25;
+using namespace p25::lc;
+using namespace p25::lc::tsbk;
+
+TEST_CASE("Adjacent Site identity belongs to the neighbor", "[p25][neighbor-identity]") {
+    const std::array<uint8_t, 12> wire{0xBC,0x00,0xA5,0x3A,0xBC,0x02,0x11,0x53,0x45,0x7F,0x96,0xBA};
+    struct RestoreSite { SiteData previous; ~RestoreSite() { TSBK::setSiteData(previous); } } restore{TSBK::getSiteData()};
+    TSBK::setSiteData(SiteData(1U,0x123U,1U,1U,0x22U,1U,1U,0U,0));
+    OSP_ADJ_STS_BCAST received;
+    REQUIRE(received.decode(wire.data(), true));
+    REQUIRE(received.getAdjSiteLRA() == 0xA5U);
+    REQUIRE(received.getAdjSiteCFVA() == 3U);
+    REQUIRE(received.getAdjSiteSysId() == 0xABCU);
+    REQUIRE(received.getAdjSiteRFSSId() == 2U);
+    REQUIRE(received.getAdjSiteId() == 0x11U);
+    REQUIRE(received.getAdjSiteChnId() == 5U);
+    REQUIRE(received.getAdjSiteChnNo() == 0x345U);
+    REQUIRE(received.getAdjSiteSvcClass() == 0x7FU);
+    std::array<uint8_t,12> result{};
+    received.encode(result.data(), true, true);
+    REQUIRE(result == wire);
+    SiteData cached;
+    cached.setAdjSite(received.getAdjSiteLRA(),received.getAdjSiteCFVA(),received.getAdjSiteSysId(),received.getAdjSiteRFSSId(),received.getAdjSiteId(),received.getAdjSiteChnId(),received.getAdjSiteChnNo(),received.getAdjSiteSvcClass());
+    SiteData copied;
+    copied = cached;
+    REQUIRE(copied.lra() == 0xA5U);
+    REQUIRE(copied.adjCFVA() == 3U);
+    REQUIRE(copied.sysId() == 0xABCU);
+    OSP_ADJ_STS_BCAST broadcast;
+    broadcast.setLastBlock(true);
+    broadcast.setAdjSiteLRA(copied.lra());
+    broadcast.setAdjSiteCFVA(copied.adjCFVA());
+    broadcast.setAdjSiteSysId(copied.sysId());
+    broadcast.setAdjSiteRFSSId(copied.rfssId());
+    broadcast.setAdjSiteId(copied.siteId());
+    broadcast.setAdjSiteChnId(copied.channelId());
+    broadcast.setAdjSiteChnNo(copied.channelNo());
+    broadcast.setAdjSiteSvcClass(copied.serviceClass());
+    broadcast.encode(result.data(), true, true);
+    REQUIRE(result == wire);
+    for (unsigned lra = 0; lra < 256; ++lra) {
+        for (unsigned flags = 0; flags < 16; ++flags) {
+            broadcast.setAdjSiteLRA(lra);
+            broadcast.setAdjSiteCFVA(flags);
+            broadcast.encode(result.data(), true, true);
+            REQUIRE(result[2] == lra);
+            REQUIRE((result[3] >> 4) == flags);
+            REQUIRE((result[3] & 15U) == 0xAU);
+            OSP_ADJ_STS_BCAST decoded;
+            REQUIRE(decoded.decode(result.data(), true));
+            REQUIRE(decoded.getAdjSiteLRA() == lra);
+            REQUIRE(decoded.getAdjSiteCFVA() == flags);
+        }
+    }
+}
