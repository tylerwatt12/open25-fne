+++ b/tests/crypto/P25_TDEA_Test.cpp
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// AAAD-B-2015 B.1/B.4, PDF45-47/printed35-37, p25_6b7b5e252ef69091;
+// documents/tia-library/8.3_TIA-102.AAAD-B_Final Published Document_2015_12_02.pdf.
+// Plaintext A.4 PDF42/printed32; independent expected ciphertext from B.4.
+#include "common/p25/Crypto.h"
+#include "common/p25/TDEAKey.h"
+#include <catch2/catch_test_macros.hpp>
+#include <array>
+#include <cstring>
+#include <vector>
+namespace {
+std::vector<uint8_t> hex(const char* s) {
+    std::vector<uint8_t> out;
+    auto n=[](char c){return c<='9'?c-'0':c-'A'+10;};
+    for(size_t i=0;s[i];i+=2)out.push_back(uint8_t(n(s[i])*16+n(s[i+1])));
+    return out;
+}
+using Crypto=p25::crypto::P25Crypto;
+const auto key=hex("0123456789ABCDEF23456789ABCDEF01456789ABCDEF0123");
+const auto mi=hex("1234567890ABCDEF00");
+void setup(Crypto& c,const std::vector<uint8_t>& k=key) {
+    c.setTEKAlgoId(0x83);c.setKey(k.data(),uint8_t(k.size()));c.setMI(mi.data());c.generateKeystream();
+}
+}
+TEST_CASE("Three-key TDEA matches every published FDMA voice word", "[p25][tdea]") {
+    struct Row {const char* plain;const char* cipher;};
+    const Row rows[]={
+        {"0CEE42226F6101AB31EF14","D56308F6C6C8AE9C6C4E2F"},
+        {"0CEF400078A701A8FDA9AD","E25F76F0920AD6D3AEA4A9"},
+        {"10EF4020E8A501AC5516EC","B5842FF8EBF607BA10A717"},
+        {"18F68212A84601BCF72A1F","93EFEA79C7F6367DDD7502"},
+        {"80DD87B18C800002097BBA","0F6D8C48A17C4F27CC275A"},
+        {"34F0AC16F04C00B3BE61E5","59EBB8D27708A499D58ADF"},
+        {"34E97460B7030022F0693A","686B09EA39CDF949510755"},
+        {"30DE25C408610067AE870B","C2C4FFCCB829F0AEB82F44"},
+        {"3CD286DE30A40008D7A2B4","C6A879D099E3477D747404"},
+        {"04E343E6F61F02E0C18BAB","A65BC5BA8319C32CC00C3E"},
+        {"0CEB08E9945B02522A9AD0","D0305F5CE2C0CB5A73139C"},
+        {"A0FC5D90952F88832A3CD3","C022B79FBEE32493B6617C"},
+        {"8CD91CA671ED000109FC56","638C60A00DF816366D4428"},
+        {"98DA2BA287C40000CEC96D","92086AE1456E7FDBD71352"},
+        {"30DC36C0DC9D0049B1915A","340D51ACEA2419925F6783"},
+        {"0CCFC141129F0552E6E775","A34297F1C7B8E23B3E3180"},
+        {"0CEB4839E526002B4DDDDC","D05E9F4A1A4A82D7601DBF"},
+        {"0CEE02E689DD00B3AAF185","4A4EC01628291A92E532EA"},
+    };
+    Crypto c;setup(c);REQUIRE(c.hasValidKeystream());
+    for(unsigned i=0;i<18;i++) {
+        auto word=hex(rows[i].plain);
+        c.cryptDES_IMBE(word.data(),i<9?p25::defines::DUID::LDU1:p25::defines::DUID::LDU2);
+        REQUIRE(word==hex(rows[i].cipher));
+    }
+    setup(c);
+    for(unsigned i=0;i<18;i++) {
+        auto word=hex(rows[i].cipher);
+        c.cryptDES_IMBE(word.data(),i<9?p25::defines::DUID::LDU1:p25::defines::DUID::LDU2);
+        REQUIRE(word==hex(rows[i].plain));
+    }
+}
+TEST_CASE("TDEA rejects malformed and nonindependent key bundles", "[p25][tdea]") {
+    Crypto c;
+    for(unsigned size=0;size<=255;size++) {
+        setup(c);REQUIRE(c.hasValidKeystream());
+        std::vector<uint8_t> k(size,0x5A);
+        if(size==24) k=key;
+        c.setKey(k.data(),uint8_t(k.size()));REQUIRE_FALSE(c.hasValidKeystream());
+        c.generateKeystream();REQUIRE(c.hasValidKeystream()==(size==24));
+    }
+    for(unsigned first=0;first<3;first++)for(unsigned second=first+1;second<3;second++) {
+        for(bool parityOnly:{false,true}) {
+            auto k=key;
+            for(unsigned i=0;i<8;i++) k[second*8+i]=k[first*8+i]^(parityOnly?1:0);
+            REQUIRE_FALSE(p25::crypto::validTDEAKey(k.data(),k.size()));
+            setup(c,k);REQUIRE_FALSE(c.hasValidKeystream());
+        }
+    }
+    for(unsigned trailing:{0,1,255}) {
+        setup(c);uint8_t nullMI[9]{};nullMI[8]=trailing;c.setMI(nullMI);
+        c.generateKeystream();REQUIRE_FALSE(c.hasValidKeystream());
+    }
+    auto parity=key;for(auto& octet:parity)octet^=1;
+    setup(c,parity);REQUIRE(c.hasValidKeystream());
+    auto word=hex("0CEE42226F6101AB31EF14");c.cryptDES_IMBE(word.data(),p25::defines::DUID::LDU1);
+    REQUIRE(word==hex("D56308F6C6C8AE9C6C4E2F"));
+    c.setKey(nullptr,24);c.generateKeystream();REQUIRE_FALSE(c.hasValidKeystream());
+}
