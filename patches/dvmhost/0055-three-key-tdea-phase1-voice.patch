diff --git a/src/common/p25/TDEAKey.h b/src/common/p25/TDEAKey.h
new file mode 100644
--- /dev/null
+++ b/src/common/p25/TDEAKey.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef P25_TDEA_KEY_H
+#define P25_TDEA_KEY_H
+#include <cstddef>
+#include <cstdint>
+namespace p25 { namespace crypto {
+// AAAD-B-2015 B.1, PDF45/printed35: ALGID83 is keying option1.
+// DES parity occupies each octet's low bit and does not change the key.
+inline bool validTDEAKey(const uint8_t* key, size_t size) {
+    if (key == nullptr || size != 24U) return false;
+    for (size_t first = 0; first < 3; ++first) {
+        for (size_t second = first + 1; second < 3; ++second) {
+            uint8_t difference = 0;
+            for (size_t i = 0; i < 8; ++i)
+                difference |= (key[first*8+i] ^ key[second*8+i]) & 0xFEU;
+            if (difference == 0) return false;
+        }
+    }
+    return true;
+}
+} }
+#endif
