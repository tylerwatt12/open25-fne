+        return reply["status"].get<int>();
+    };
+    REQUIRE(send(GROUP, "abc:1") == network::NetRPC::OK);
+    REQUIRE(send(GROUP + 1U, "abc:2") == network::NetRPC::OK);
+    REQUIRE(send(0U, "abc:1") == network::NetRPC::BAD_REQUEST);
+    REQUIRE(send(GROUP, "abc:1") == network::NetRPC::BAD_REQUEST);
+    REQUIRE(send(GROUP + 1U, "abc:2") == network::NetRPC::OK); // active duplicate only
+    REQUIRE(send(0U, "abc:2") == network::NetRPC::OK);
+    REQUIRE(send(GROUP + 1U, "abc:2") == network::NetRPC::BAD_REQUEST); // cannot resurrect a cleared permit
+    REQUIRE(send(GROUP, "def:1") == network::NetRPC::OK);
+    REQUIRE(send(GROUP + 1U, "abc:3") == network::NetRPC::BAD_REQUEST); // retired process session
+    REQUIRE(send(0U, "def:1") == network::NetRPC::OK);
+}
