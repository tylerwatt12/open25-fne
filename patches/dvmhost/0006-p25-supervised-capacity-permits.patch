+namespace {
+class MemoryRPC : public network::NetRPC {
+public:
+    std::function<void(uint16_t, const sockaddr_storage&)> onWrite;
+    MemoryRPC() : NetRPC("127.0.0.1", 48991U, 0U, "offline-test", false) {}
+    using NetRPC::dispatchReply;
+protected:
+    bool writeRequest(const uint8_t* data, uint32_t, sockaddr_storage& address, uint32_t) override {
+        network::frame::RPCHeader header;
+        REQUIRE(header.decode(data));
+        if (onWrite) onWrite(header.getFunction() | RPC_REPLY_FUNC, address);
+        return true;
+    }
+};
+}
