+/* Require a correlated positive VC permit before emitting a supervised grant. */
+
+bool ControlSignaling::permitTrafficChannel(const ::lookups::VoiceChData& channel, uint32_t dstId,
+    uint32_t srcId, uint32_t chNo, bool dataPermit, std::unique_lock<std::recursive_mutex>& grantGuard)
+{
+    if (!m_p25->m_authoritative || !m_p25->m_supervisor)
+        return true;
+
+    auto* allocations = m_p25->m_affiliations;
+    grantGuard = allocations->lockGrants();
+    const uint64_t epoch = allocations->grantEpoch(dstId);
+    if (!allocations->ownsGrant(dstId, srcId, chNo, epoch))
+        return false;
+
+    if (g_RPC == nullptr || !channel.isValidCh() || channel.address().empty() ||
+        channel.port() == 0U || channel.chNo() == m_p25->m_siteData.channelNo()) {
+        allocations->releaseGrant(dstId, false);
+        return false;
+    }
+
+    // Per-process entropy plus a monotonic sequence also separates restarts.
+    static const uint64_t nonce = (uint64_t(std::random_device{}()) << 32U) | std::random_device{}();
+    static std::atomic<uint64_t> nextToken{0U};
+    std::ostringstream tokenText;
+    tokenText << std::hex << nonce << ':' << ++nextToken;
+    const std::string token = tokenText.str();
+    allocations->setGrantPermitToken(dstId, epoch, token);
+    auto accepted = std::make_shared<std::atomic<bool>>(false);
+    json::object request;
+    request["dstId"].set<uint32_t>(dstId);
+    request["permitToken"].set<std::string>(token);
+    if (dataPermit) {
+        const int state = modem::DVM_STATE::STATE_P25;
+        const bool permit = true;
+        request["state"].set<int>(state);
+        request["dataPermit"].set<bool>(permit);
+    }
+    grantGuard.unlock(); // never hold the allocation lock across an RPC wait
+    const bool replied = g_RPC->req(RPC_PERMIT_P25_TG, request,
+        [accepted, token, dstId](json::object& response, json::object&) {
+            accepted->store(response["status"].is<int>() && response["status"].get<int>() == network::NetRPC::OK &&
+                response["dstId"].is<int>() && response["dstId"].get<uint32_t>() == dstId &&
+                response["permitToken"].is<std::string>() && response["permitToken"].get<std::string>() == token);
+        }, channel.address(), channel.port(), true);
+    grantGuard.lock();
+    if (replied && accepted->load() && allocations->ownsGrant(dstId, srcId, chNo, epoch))
+        return true; // keep the guard until the RF grant has been enqueued
+
+    // Only this epoch can be rolled back. A late cleanup must not revoke a
+    // different allocation that has already taken over this physical VC.
+    if (allocations->ownsGrant(dstId, srcId, chNo, epoch))
+        allocations->releaseGrant(dstId, false);
+    json::object clear;
+    const uint32_t clearedDestination = 0U;
+    clear["dstId"].set<uint32_t>(clearedDestination);
+    clear["permitToken"].set<std::string>(token);
+    g_RPC->req(RPC_PERMIT_P25_TG, clear, nullptr, channel.address(), channel.port());
+    return false;
+}
