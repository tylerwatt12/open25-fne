+
+bool AffiliationLookup::ownsGrant(uint32_t dstId, uint32_t srcId, uint32_t chNo, uint64_t epoch)
+{
+    auto lock = lockGrants();
+    return epoch != 0U && grantEpoch(dstId) == epoch && isGranted(dstId) &&
+        getGrantedSrcId(dstId) == srcId && getGrantedCh(dstId) == chNo;
