+TEST_CASE("Native RPC publishes completion after callback and rejects wrong peers and late replies", "[network][capacity-permit]") {
+    MemoryRPC rpc;
+    json::object request; setJSON<int>(request, "dstId", 101);
+    unsigned called = 0U;
+    SECTION("callback is complete before blocking return") {
+        rpc.onWrite = [&](uint16_t func, const sockaddr_storage& peer) {
+            json::object response; setJSON<int>(response, "status", 200);
+            REQUIRE(rpc.dispatchReply(func, response, peer));
+        };
+        REQUIRE(rpc.req(RPC_PERMIT_P25_TG, request, [&](json::object&, json::object&) { ++called; }, "127.0.0.1", 48993U, true));
+        REQUIRE(called == 1U);
+    }
+    SECTION("wrong peer cannot complete request") {
+        rpc.onWrite = [&](uint16_t func, const sockaddr_storage& peer) {
+            sockaddr_storage other; uint32_t length;
+            REQUIRE(network::udp::Socket::lookup("127.0.0.1", 48994U, other, length) == 0);
+            json::object response;
+            REQUIRE_FALSE(rpc.dispatchReply(func, response, other));
+            REQUIRE(rpc.dispatchReply(func, response, peer));
+        };
+        REQUIRE(rpc.req(RPC_PERMIT_P25_TG, request, [&](json::object&, json::object&) { ++called; }, "127.0.0.1", 48993U, true));
+        REQUIRE(called == 1U);
+    }
+    SECTION("timed out callback is removed before a late response") {
+        uint16_t savedFunction = 0U; sockaddr_storage savedPeer{};
+        rpc.onWrite = [&](uint16_t func, const sockaddr_storage& peer) { savedFunction = func; savedPeer = peer; };
+        const auto start = std::chrono::steady_clock::now();
+        REQUIRE_FALSE(rpc.req(RPC_PERMIT_P25_TG, request, [&](json::object&, json::object&) { ++called; }, "127.0.0.1", 48993U, true));
+        REQUIRE(std::chrono::steady_clock::now() - start < std::chrono::seconds(2));
+        json::object response;
+        REQUIRE_FALSE(rpc.dispatchReply(savedFunction, response, savedPeer));
+        REQUIRE(called == 0U);
+    }
+}
