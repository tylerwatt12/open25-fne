+TEST_CASE("Blocking native RPC waits for callback completion and refuses in-flight replacement", "[network][capacity-permit]") {
+    MemoryRPC rpc;
+    json::object request; setJSON<int>(request, "dstId", 101);
+    std::promise<void> entered, release;
+    auto released = release.get_future().share();
+    std::thread responder;
+    std::atomic<bool> responderStored{false};
+    bool nestedRejected = false;
+    rpc.onWrite = [&](uint16_t func, const sockaddr_storage& peer) {
+        nestedRejected = !rpc.req(RPC_PERMIT_P25_TG, request, nullptr, "127.0.0.1", 48993U, true);
+        responder = std::thread([&, func, peer]() {
+            while (!responderStored.load()) std::this_thread::yield();
+            json::object response;
+            rpc.dispatchReply(func, response, peer);
+        });
+        responderStored.store(true);
+    };
+    auto result = std::async(std::launch::async, [&]() {
+        return rpc.req(RPC_PERMIT_P25_TG, request, [&](json::object&, json::object&) {
+            entered.set_value();
+            released.wait();
+        }, "127.0.0.1", 48993U, true);
+    });
+    auto started = entered.get_future();
+    const bool callbackEntered = started.wait_for(std::chrono::seconds(1)) == std::future_status::ready;
+    const bool completedTooSoon = result.wait_for(std::chrono::milliseconds(10)) == std::future_status::ready;
+    const bool duringCallbackRejected = !rpc.req(RPC_PERMIT_P25_TG, request, nullptr, "127.0.0.1", 48993U, true);
+    release.set_value();
+    if (responder.joinable()) responder.join();
+    const bool accepted = result.get();
+    CHECK(callbackEntered);
+    CHECK_FALSE(completedTooSoon);
+    CHECK(nestedRejected);
+    CHECK(duringCallbackRejected);
+    REQUIRE(accepted);
+}
