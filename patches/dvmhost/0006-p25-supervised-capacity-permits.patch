+enum class PermitMode { Accepted, Rejected, MissingStatus, BadStatusType, MissingEcho, WrongDestination, StaleToken, Timeout, Late };
+class PermitRPC : public network::NetRPC {
+public:
+    PermitMode mode = PermitMode::Accepted;
+    unsigned permits = 0;
+    std::function<void()> beforeReply;
+    RPCType late;
+    json::object lateRequest;
+    std::function<bool(uint16_t, json::object&, json::object&)> nativeHandler;
+    using NetRPC::dispatchRequest;
+    PermitRPC() : NetRPC("127.0.0.1", 48991U, 0U, "offline-test", false) {}
+    bool req(uint16_t func, const json::object& request, RPCType callback, std::string, uint16_t, bool blocking = false) override {
+        if (func != RPC_PERMIT_P25_TG || request.at("dstId").get<uint32_t>() == 0U)
+            return true; // asynchronous unpermit after rollback
+        ++permits;
+        REQUIRE(blocking);
+        REQUIRE(callback != nullptr);
+        if (beforeReply) beforeReply();
+        if (mode == PermitMode::Timeout) return false;
+        if (mode == PermitMode::Late) { late = callback; lateRequest = request; return false; }
+        json::object response;
+        if (nativeHandler) {
+            json::object copied = wireObject(request);
+            REQUIRE(nativeHandler(func, copied, response));
+            json::object ignored;
+            response = wireObject(response);
+            callback(response, ignored);
+            return true;
+        }
+        if (mode != PermitMode::MissingStatus) setJSON<int>(response, "status", mode == PermitMode::Rejected ? BAD_REQUEST : OK);
+        if (mode == PermitMode::BadStatusType) response["status"].set<std::string>("200");
+        if (mode != PermitMode::MissingEcho) {
+            response["dstId"] = request.at("dstId");
+            response["permitToken"] = request.at("permitToken");
+        }
+        if (mode == PermitMode::WrongDestination) setJSON<uint32_t>(response, "dstId", 999U);
+        if (mode == PermitMode::StaleToken) response["permitToken"].set<std::string>("old-process:1");
+        json::object ignored;
+        response = wireObject(response);
+        callback(response, ignored);
+        return true;
+    }
+    void deliverLate() {
+        json::object response;
+        setJSON<int>(response, "status", OK);
+        response["dstId"] = lateRequest.at("dstId");
+        response["permitToken"] = lateRequest.at("permitToken");
+        json::object ignored;
+        REQUIRE(late != nullptr);
+        response = wireObject(response);
+        late(response, ignored);
+    }
+};
