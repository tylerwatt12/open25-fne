+                    REQUIRE(fixture.controller->affiliations()->isGranted(destination));
+                    REQUIRE(fixture.channels.rfChSize() == 0U);
+                    const uint8_t expected = service == 0 ? TSBKO::IOSP_GRP_VCH : service == 1 ? TSBKO::IOSP_UU_VCH : TSBKO::OSP_SNDCP_CH_GNT;
+                    for (const auto& frame : frames) REQUIRE(frame->getLCO() == expected);
+                    REQUIRE(fixture.controller->affiliations()->releaseGrant(destination, false));
+                    REQUIRE(fixture.channels.rfChSize() == 1U);
+                } else {
+                    REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+                    REQUIRE(fixture.channels.rfChSize() == 1U);
+                    for (const auto& frame : frames) REQUIRE(frame->getLCO() == TSBKO::OSP_DENY_RSP);
+                    if (mode == PermitMode::Late) {
+                        fixture.rpc.deliverLate(); // owned callback is safe after the grant stack returned
+                        REQUIRE(fixture.drain().empty());
+                        REQUIRE(fixture.controller->affiliations()->grantSize() == 0U);
+                    }
+                }
+            }
+        }
+    }
