+/* Writes an outbound request. Tests override this without opening a socket. */
+
+bool NetRPC::writeRequest(const uint8_t* data, uint32_t length, sockaddr_storage& address, uint32_t addrLen)
+{
+    return m_frameQueue->write(data, length, address, addrLen);
+}
+
+/* Dispatches a registered request outside the handler-registry lock. */
+
+bool NetRPC::dispatchRequest(uint16_t func, json::object& request, json::object& response)
+{
+    RPCType handler;
+    {
+        std::lock_guard<std::mutex> lock(m_handlerMutex);
+        auto found = m_handlers.find(func);
+        if (found != m_handlers.end())
+            handler = found->second;
+    }
+    if (!handler)
+        return false;
+    handler(request, response);
+    return true;
+}
+
+/* Dispatches one peer-matched response, publishing completion after the callback. */
+
+bool NetRPC::dispatchReply(uint16_t func, json::object& response, const sockaddr_storage& address)
+{
+    std::shared_ptr<PendingReply> pending;
+    {
+        std::lock_guard<std::mutex> lock(m_handlerMutex);
+        auto found = m_pendingReplies.find(func);
+        if (found == m_pendingReplies.end() || !udp::Socket::match(found->second->address, address))
+            return false;
+        pending = found->second;
+        if (pending->claimed.exchange(true))
+            return false;
+    }
+    if (pending->cancelled.load() || std::chrono::steady_clock::now() >= pending->deadline)
+        return false;
+    if (pending->callback) {
+        json::object ignored;
+        pending->callback(response, ignored);
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_handlerMutex);
+        auto found = m_pendingReplies.find(func);
+        if (found != m_pendingReplies.end() && found->second == pending)
+            m_pendingReplies.erase(found);
+    }
+    pending->completed.store(true);
+    return true;
+}
