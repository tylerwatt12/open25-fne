+             PermitMode::BadStatusType, PermitMode::MissingEcho, PermitMode::WrongDestination,
+             PermitMode::StaleToken, PermitMode::Timeout, PermitMode::Late}) {
+            DYNAMIC_SECTION("service " << service << " reply " << int(mode)) {
