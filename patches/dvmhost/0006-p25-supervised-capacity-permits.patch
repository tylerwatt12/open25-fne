+                fixture.registerAndAffiliate();
+                fixture.controller->setSupervisor(true);
+                fixture.channels.setRFChData(VOICE_CHANNEL, ::lookups::VoiceChData(2U, VOICE_CHANNEL, "127.0.0.1", 48993U, "offline-test"));
+                fixture.rpc.mode = mode;
+                fixture.rpc.beforeReply = [&]() { REQUIRE(fixture.controller->peekFrameLength() == 0U); };
+                if (service == 0) fixture.receive<IOSP_GRP_VCH>(SOURCE, GROUP);
+                if (service == 1) fixture.receive<IOSP_UU_VCH>(SOURCE, TARGET);
+                if (service == 2) fixture.receive<ISP_SNDCP_CH_REQ>(SOURCE);
+                REQUIRE(fixture.rpc.permits == 1U);
