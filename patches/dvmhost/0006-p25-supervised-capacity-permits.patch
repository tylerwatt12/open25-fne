+json::object wireObject(const json::object& object) {
+    json::value decoded;
+    const std::string encoded = json::value(object).serialize();
+    REQUIRE(json::parse(decoded, encoded).empty());
+    REQUIRE(decoded.is<json::object>());
+    return decoded.get<json::object>();
