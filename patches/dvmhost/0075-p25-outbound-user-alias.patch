+fullrate::Batch voice(const lc::LC& value, bool ldu2=false) {
+    uint8_t mi[9U]{}; value.getMI(mi); fullrate::Batch result;
+    for(unsigned i=0;i<9U;++i)
+        result.voice[i]=fullrate::generatedVoice(NULL_IMBE,uint8_t(i+(ldu2?9U:0U)),0U,mi,value.getAlgId(),value.getKId());
+    if(ldu2) {
+        uint8_t ess[18U]{}; std::copy_n(mi,9U,ess); ess[9]=value.getAlgId();
+        ess[10]=uint8_t(value.getKId()>>8U); ess[11]=uint8_t(value.getKId());
+        edac::RS634717 fec; fec.encode24169(ess);
+        for(unsigned i=0;i<6U;++i) std::copy_n(ess+i*3U,3U,result.voice[i+2U].bytes.data()+14U);
+    }
+    return result;
+}
+std::vector<uint8_t> rfFrame(lc::LC value, DUID::E duid) {
+    const auto n=duid==DUID::HDU?P25_HDU_FRAME_LENGTH_BYTES:P25_LDU_FRAME_LENGTH_BYTES;
+    std::vector<uint8_t> bytes(n+2U); bytes[0]=modem::TAG_DATA; bytes[1]=1U;
+    if(duid!=DUID::HDU) { Audio audio; for(unsigned i=0;i<9U;++i) audio.encode(bytes.data()+2U,NULL_IMBE,i); }
+    if(duid==DUID::HDU) value.encodeHDU(bytes.data()+2U);
+    else if(duid==DUID::LDU1) value.encodeLDU1(bytes.data()+2U);
+    else value.encodeLDU2(bytes.data()+2U);
+    Sync::addP25Sync(bytes.data()+2U); NID nid(0x293U); nid.encode(bytes.data()+2U,duid);
+    P25Utils::addStatusBits(bytes.data()+2U,n*8U,true,false); return bytes;
+}
+std::string hex(const uint8_t* bytes,size_t length) {
+    static const char digits[]="0123456789abcdef"; std::string out;
+    for(size_t i=0;i<length;++i) { out+=digits[bytes[i]>>4U]; out+=digits[bytes[i]&15U]; }
+    return out;
+}
