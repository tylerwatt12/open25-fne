+namespace {
+bool csvRecord(const std::string& line, std::vector<std::string>& fields)
+{
+    std::string field;
+    bool quoted = false;
+    for (size_t i = 0U; i < line.size(); ++i) {
+        const char c = line[i];
+        if (c == '"') {
+            if (quoted && i + 1U < line.size() && line[i + 1U] == '"') {
+                field += '"'; ++i;
+            } else quoted = !quoted;
+        } else if (c == ',' && !quoted) {
+            fields.push_back(field); field.clear();
+        } else if (c != '\r' || quoted) field += c;
+    }
+    fields.push_back(field);
+    return !quoted;
+}
+
+std::string csvField(const std::string& value)
+{
+    if (value.find_first_of(",\"\r\n") == std::string::npos) return value;
+    std::string encoded = "\"";
+    for (char c : value) { encoded += c; if (c == '"') encoded += '"'; }
+    return encoded + '"';
+}
+}
+
