+TEST_CASE("managed alias CSV preserves comma quote space and radio flags", "[p25][user-alias][alias-table]")
+{
+    CSVFile file;
+    {
+        std::ofstream out(file.name);
+        out << "# RID,Enabled,Alias,IP Address,\n"
+            << "10001,1,\"Engine, 12\",192.0.2.1,\n"
+            << "10002,0,\"Desk \"\"A\"\"\",192.0.2.2,\n"
+            << "10003,1,\" Leading\",,\n"
+            << "10004,1,,,\n";
+    }
+    lookups::RadioIdLookup radios(file.name, 0U, true);
+    REQUIRE(radios.read());
+    REQUIRE(radios.find(10001U).radioAlias() == "Engine, 12");
+    REQUIRE(radios.find(10002U).radioAlias() == "Desk \"A\"");
+    REQUIRE_FALSE(radios.find(10002U).radioEnabled());
+    REQUIRE(radios.find(10003U).radioAlias() == " Leading");
+    REQUIRE(radios.find(10004U).radioAlias().empty());
+    REQUIRE(radios.find(10001U).radioIPAddress() == "192.0.2.1");
+    radios.commit(true);
+    lookups::RadioIdLookup again(file.name, 0U, true);
+    REQUIRE(again.read());
+    REQUIRE(again.find(10001U).radioAlias() == "Engine, 12");
+    REQUIRE(again.find(10002U).radioAlias() == "Desk \"A\"");
+    REQUIRE(again.find(10002U).radioIPAddress() == "192.0.2.2");
+    REQUIRE(again.find(10004U).radioAlias().empty());
+}
