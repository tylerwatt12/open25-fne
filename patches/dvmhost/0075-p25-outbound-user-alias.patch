+struct UserAliasTestAccess {
+    static lc::LC select(Control& c, const lc::LC& user, bool commit = true,
+        uint32_t network = 1U, uint32_t system = 1U) {
+        auto next = c.m_voice->m_netUserAlias; lc::LC out;
+        REQUIRE(c.m_voice->selectUserAliasLC(user,next,out,network,system));
+        if (commit) c.m_voice->m_netUserAlias = next;
+        return out;
+    }
+    static bool selected(Control& c, const lc::LC& user, uint32_t system = 1U, uint32_t network = 1U) {
+        auto next = c.m_voice->m_netUserAlias; lc::LC out;
+        const bool ok=c.m_voice->selectUserAliasLC(user,next,out,network,system);
+        c.m_voice->m_netUserAlias=next; return ok;
+    }
+    static void configure(Control& c, bool maintenance = false) {
+        c.m_managedSite=true; c.m_allowExplicitSourceId=true;
+        c.m_enableControl=maintenance; c.m_dedicatedControl=false; c.m_voiceOnControl=false;
+    }
+    static void active(Control& c) { c.m_activeTG={1001U}; }
+    static void enroll(Control& c,uint32_t source) { c.m_dispatchSubscribers.insert(source); }
+    static void reset(Control& c) { c.m_voice->resetRF(); c.m_voice->resetNet(); }
+    static void seed(Control& c, const lc::LC& control) {
+        c.m_netState=RS_NET_AUDIO; c.m_voice->m_netLC=control;
+    }
+    static bool write(Control& c, const lc::LC& control, const fullrate::Batch& voice, bool ldu2 = false) {
+        if (ldu2) {
+            c.m_voice->m_netControl2=control; c.m_voice->m_netFullRate2=voice;
+            return c.m_voice->writeNet_LDU2();
+        }
+        c.m_voice->m_netControl1=control; c.m_voice->m_netFullRate1=voice;
+        return c.m_voice->writeNet_LDU1();
+    }
+    static lc::LC context(Control& c) { return c.m_voice->m_netLC; }
+    static void fill(Control& c) {
+        std::array<uint8_t,218U> bytes{};
+        while(c.addFrame(bytes.data(),bytes.size(),true)) {}
