+        if (!lc::LC::isValidUserAlias(alias)) {
+            if (!alias.empty() && !next.warned) {
+                LogWarning(LOG_P25, "User Alias omitted for RID %u: name requires 1 to 14 printable ASCII characters", user.getSrcId());
+                next.warned = true;
+            }
+            next.alias.clear();
+            return false;
+        }
+        next.alias = alias;
+    }
+
+    const bool sourceExtension = (opcode == LCO::GROUP && user.getExplicitId()) ||
+        opcode == LCO::PRIVATE_EXT || opcode == LCO::EXPLICIT_SOURCE_ID;
+    const bool rfssRequired = (m_p25->m_enableControl && !m_p25->m_dedicatedControl) || m_p25->m_voiceOnControl;
+    if (sourceExtension && (!m_p25->m_allowExplicitSourceId || rfssRequired)) {
+        if (!next.warned) {
+            LogWarning(LOG_P25, "User Alias omitted for RID %u: extended source requires dedicated traffic channel and explicit source identity", user.getSrcId());
+            next.warned = true;
+        }
+        return false;
+    }
+
+    output = user;
+    output.setServiceOptions(user.getServiceOptions());
+    output.setProtect(false);
+    output.setNetId(netId);
+    output.setSysId(sysId);
+
+    if (next.slot == 0U) {
+        output.setLCO(user.getGroup() ? LCO::GROUP : (sourceExtension ? LCO::PRIVATE_EXT : LCO::PRIVATE));
+        output.setExplicitId(sourceExtension);
+    } else if (sourceExtension && next.slot == 1U) {
+        // The extension immediately follows its voice-user LC.
+        output.setMFId(MFG_STANDARD);
+        output.setLCO(LCO::EXPLICIT_SOURCE_ID);
+    } else {
+        bool maintenance = false;
+        if (!sourceExtension && next.slot == 2U) {
+            if (rfssRequired) {
+                output.setMFId(MFG_STANDARD);
+                output.setLCO(LCO::RFSS_STS_BCAST);
+                maintenance = true;
+            } else if (user.getGroup()) {
+                std::lock_guard<std::mutex> lock(m_p25->s_activeTGLock);
+                if (!m_p25->m_activeTG.empty()) {
+                    output.setMFId(MFG_STANDARD);
+                    output.setLCO(LCO::GROUP_UPDT);
+                    output.setGrpVchNo(m_p25->m_siteData.channelNo());
+                    output.setDstIdB(0U);
+                    output.setGrpVchNoB(0U);
+                    maintenance = true;
+                }
+            }
+        }
+        if (!maintenance) {
+            static const uint8_t opcodes[4U] = {LCO::HARRIS_USER_ALIAS_PA_ODD, LCO::HARRIS_USER_ALIAS_PB_ODD,
+                LCO::HARRIS_USER_ALIAS_PA_EVEN, LCO::HARRIS_USER_ALIAS_PB_EVEN};
+            output.setMFId(MFG_HARRIS); // AABF-D-2 requires explicit MFID $A4.
+            output.setLCO(opcodes[next.part]);
+            output.setUserAlias(next.alias);
+            next.part = uint8_t((next.part + 1U) & 3U);
+        }
+    }
+    next.slot = uint8_t((next.slot + 1U) % 3U);
+    return true;
+}
