+// Site-owned display metadata. This is a table receipt, not an RF acknowledgment.
+void RESTAPI::restAPI_PutP25Aliases(const HTTPPayload& request, HTTPPayload& reply, const RequestMatch&)
+{
+    if (!validateAuth(request, reply)) return;
+    if (m_ridLookup == nullptr) { errorPayload(reply, "Radio directory is unavailable", HTTPPayload::SERVICE_UNAVAILABLE); return; }
+    if (request.content.size() > 4U * 1024U * 1024U) { errorPayload(reply, "Alias directory exceeds 4 MiB"); return; }
+    json::object req;
+    if (!parseRequestBody(request, reply, req)) return;
+    if (req.size() != 1U || !req["aliases"].is<json::array>()) { errorPayload(reply, "aliases must be the complete name array"); return; }
+    std::unordered_map<uint32_t, std::string> aliases;
+    for (const auto& value : req["aliases"].get<json::array>()) {
+        if (!value.is<json::object>()) { errorPayload(reply, "each alias must be an object"); return; }
+        auto row = value.get<json::object>();
+        uint32_t id = 0U;
+        if (row.size() != 2U || !inhibitRadioId(row["rid"], id) || !row["alias"].is<std::string>()) {
+            errorPayload(reply, "each alias requires rid and alias"); return;
+        }
+        auto name = row["alias"].get<std::string>();
+        if (!p25::lc::LC::isValidUserAlias(name)) { errorPayload(reply, "User Alias requires 1-14 printable ASCII characters"); return; }
+        aliases[id] = name;
+    }
+    m_ridLookup->replaceAliases(aliases);
+    json::object response; setResponseDefaultStatus(response);
+    reply.payload(response);
 }
 
