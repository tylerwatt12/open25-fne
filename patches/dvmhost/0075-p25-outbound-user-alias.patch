+            if(observed.getLCO()==LCO::GROUP) REQUIRE(observed.getExplicitId());
+            if(observed.getLCO()==LCO::EXPLICIT_SOURCE_ID) { REQUIRE(observed.getNetId()==identity); REQUIRE(observed.getSysId()==identity); }
+            auto ldu2=rfFrame(value,DUID::LDU2); REQUIRE(f.control->processFrame(ldu2.data(),ldu2.size())); f.drain();
+        }
+    }
+}
+TEST_CASE("RF caller handover cannot reuse a previous source extension", "[p25][user-alias]") {
+    Fixture f; UserAliasTestAccess::enroll(*f.control,10002U); f.radios.addEntry(10002U,true,"SECOND");
+    auto old=user(); old.setExplicitId(true);
+    auto next=old; next.setSrcId(10002U);
+    auto oldExtension=old; oldExtension.setLCO(LCO::EXPLICIT_SOURCE_ID);
+    auto nextExtension=next; nextExtension.setLCO(LCO::EXPLICIT_SOURCE_ID);
+    auto hdu=rfFrame(old,DUID::HDU); REQUIRE(f.control->processFrame(hdu.data(),hdu.size()));
+    const std::vector<lc::LC> incoming{old,oldExtension,old,next,next,nextExtension,next};
+    const uint8_t expected[]={0,9,0x32,0,0,9,0x32};
+    for(unsigned i=0;i<incoming.size();++i) {
+        auto bytes=rfFrame(incoming[i],DUID::LDU1); REQUIRE(f.control->processFrame(bytes.data(),bytes.size()));
+        const auto sent=f.frame(DUID::LDU1); lc::LC observed; REQUIRE(observed.decodeLDU1(sent.data()+2U));
+        REQUIRE(observed.getLCO()==expected[i]);
+        if(i==5U) { REQUIRE(observed.getNetId()==1U); REQUIRE(observed.getSysId()==1U); }
+        auto ldu2=rfFrame(incoming[i],DUID::LDU2); REQUIRE(f.control->processFrame(ldu2.data(),ldu2.size())); f.drain();
+    }
+    UserAliasTestAccess::reset(*f.control); auto ordinaryPrivate=user(false); ordinaryPrivate.setExplicitId(true);
+    REQUIRE(UserAliasTestAccess::select(*f.control,ordinaryPrivate).getLCO()==LCO::PRIVATE);
+    REQUIRE(UserAliasTestAccess::select(*f.control,ordinaryPrivate).getLCO()==0x32U);
+}
