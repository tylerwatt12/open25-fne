+    lc::LC value; value.setMFId(MFG_STANDARD); value.setLCO(group?LCO::GROUP:LCO::PRIVATE);
+    value.setGroup(group); value.setSrcId(Source); value.setDstId(Group);
+    value.setNetId(1U); value.setSysId(1U);
+    value.setServiceOptions(algorithm==ALGO_UNENCRYPT?4U:0x44U);
+    value.setAlgId(algorithm); value.setKId(algorithm==ALGO_UNENCRYPT?0U:123U);
+    const uint8_t mi[9U]={1,2,3,4,5,6,7,8,9}; value.setMI(mi); return value;
