+struct CSVFile {
+    char name[64] = "/tmp/p25-user-alias-XXXXXX";
+    CSVFile() { const int fd = mkstemp(name); REQUIRE(fd >= 0); close(fd); }
+    ~CSVFile() { std::remove(name); }
+};
+
+restapi::http::RequestAssembler::Result parse(restapi::http::RequestAssembler& parser, const std::string& wire)
+{
+    size_t at = 0U;
+    while (at < wire.size() && parser.result() == restapi::http::RequestAssembler::More) {
+        size_t used = 0U;
+        parser.append(wire.data() + at, std::min(size_t(8192U), wire.size() - at), used);
+        at += used;
+    }
+    return parser.result();
+}
