+namespace p25 {
+struct UserAliasTableTestAccess {
+    static restapi::http::HTTPPayload put(RESTAPI& api, const std::string& body, bool authorized = true)
+    {
+        api.m_authTokens["alias-fixture"] = 1U;
+        restapi::http::HTTPPayload request, reply;
+        request.content = body;
+        request.headers.add("Content-Type", "application/json");
+        request.headers.add("RemoteHost", "alias-fixture");
+        if (authorized) request.headers.add("X-DVM-Auth-Token", "1");
+        restapi::RequestMatch match(std::smatch{}, body);
+        api.restAPI_PutP25Aliases(request, reply, match);
+        return reply;
+    }
+};
+}
+
+namespace {
+unsigned status(const restapi::http::HTTPPayload& response)
+{
+    json::value decoded;
+    REQUIRE(json::parse(decoded, response.content).empty());
+    return static_cast<unsigned>(decoded.get<json::object>()["status"].get<double>());
+}
