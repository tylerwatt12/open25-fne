+    const auto label=kind+"-"+std::to_string(index); const auto filename=label+".rf.bin";
+    std::ofstream binary(std::string(dir)+"/"+filename,std::ios::binary); REQUIRE(binary.good());
+    binary.write(reinterpret_cast<const char*>(frame.data()+2U),216U); REQUIRE(binary.good());
+    static bool first=true; const auto mode=first?std::ios::trunc:std::ios::app;
+    std::ofstream tsv(std::string(dir)+"/frames.tsv",mode); REQUIRE(tsv.good());
+    tsv<<label<<'\t'<<hex(expected.data(),expected.size())<<'\t'<<hex(frame.data()+2U,216U)<<'\n';
+    json::object info; info["case"].set<std::string>(label); info["file"].set<std::string>(filename);
+    info["source_rid"].set<uint32_t>(Source); info["talkgroup"].set<uint32_t>(Group);
+    info["alias"].set<std::string>("123456789abcde"); info["expected_lc_hex"].set<std::string>(hex(expected.data(),9U));
+    const bool observed=false; const uint32_t nac=0x293U, algorithm=secure?ALGO_AES_256:ALGO_UNENCRYPT;
+    info["actual_rf_transmission"].set<bool>(observed); info["actual_usb_device"].set<bool>(observed);
