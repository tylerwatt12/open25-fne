+TEST_CASE("User Alias matches independent published ASCII LC examples and null padding", "[p25][user-alias]") {
+    lc::LC value; value.setMFId(MFG_HARRIS); REQUIRE(value.setUserAlias("123456789abcde"));
+    value.setLCO(0x32U); REQUIRE(raw(value)==AliasA);
+    value.setLCO(0x33U); REQUIRE(raw(value)==AliasB);
+    auto evenA=AliasA,evenB=AliasB; evenA[0]=0x34; evenB[0]=0x35;
+    value.setLCO(0x34U); REQUIRE(raw(value)==evenA);
+    value.setLCO(0x35U); REQUIRE(raw(value)==evenB);
+    REQUIRE(value.setUserAlias("A,\"B")); value.setLCO(0x32U);
+    const RawLC padded{{0x32,0xA4,0x41,0x2C,0x22,0x42,0,0,0}};
+    REQUIRE(raw(value)==padded);
+    for(const auto& invalid : {std::string(),std::string(15U,'x'),std::string("a\nb"),std::string("\x80")}) {
+        REQUIRE_FALSE(value.setUserAlias(invalid)); REQUIRE(value.getUserAlias().empty());
+    }
+}
+TEST_CASE("User Alias receiver completes matching conveyances only and copies partial state safely", "[p25][user-alias]") {
+    lc::LC value; REQUIRE(value.decodeLC(AliasA.data())); REQUIRE(value.getUserAlias().empty());
+    lc::LC copy=value; REQUIRE(copy.decodeLC(AliasB.data())); REQUIRE(copy.getUserAlias()=="123456789abcde");
+    REQUIRE(value.getUserAlias().empty());
+    auto wrong=AliasB; wrong[0]=0x35U;
+    REQUIRE(value.decodeLC(wrong.data())); REQUIRE(value.getUserAlias().empty());
+    // A1 odd, B2 even with missing A2, B3 odd with missing A3 cannot combine.
+    REQUIRE(value.decodeLC(AliasB.data())); REQUIRE(value.getUserAlias().empty());
+    lc::LC orphan; REQUIRE(orphan.decodeLC(AliasB.data())); REQUIRE(orphan.getUserAlias().empty());
+    auto protectedA=AliasA; protectedA[0]|=0x80U;
+    REQUIRE(orphan.decodeLC(protectedA.data())); REQUIRE(orphan.decodeLC(AliasB.data())); REQUIRE(orphan.getUserAlias().empty());
+    REQUIRE(orphan.decodeLC(AliasA.data())); auto protectedB=AliasB; protectedB[0]|=0x80U;
+    REQUIRE(orphan.decodeLC(protectedB.data())); REQUIRE(orphan.decodeLC(AliasB.data())); REQUIRE(orphan.getUserAlias().empty());
