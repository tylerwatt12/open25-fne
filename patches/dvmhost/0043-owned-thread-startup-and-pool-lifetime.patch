diff --git a/tests/ThreadPoolLifetime_Tests.cpp b/tests/ThreadPoolLifetime_Tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/ThreadPoolLifetime_Tests.cpp
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "common/ThreadPool.h"
+#include <catch2/catch_test_macros.hpp>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace {
+using namespace std::chrono;
+struct Held {
+    std::mutex mutex;
+    std::condition_variable changed;
+    unsigned entered = 0U;
+    bool release = false;
+    void run() {
+        std::unique_lock<std::mutex> lock(mutex);
+        ++entered;
+        changed.notify_all();
+        changed.wait(lock, [&] { return release; });
+    }
+    void await(unsigned count) {
+        std::unique_lock<std::mutex> lock(mutex);
+        if (!changed.wait_for(lock, seconds(5), [&] { return entered == count; })) std::abort();
+    }
+    void open() {
+        { std::lock_guard<std::mutex> lock(mutex); release = true; }
+        changed.notify_all();
+    }
+};
+struct TrackedTask : ThreadPoolTask {
+    std::atomic<unsigned>& destroyed;
+    template<class F> TrackedTask(std::atomic<unsigned>& count, F callback) : ThreadPoolTask(callback), destroyed(count) {}
+    ~TrackedTask() override { ++destroyed; }
+};
+struct RawArgument {
+    std::atomic<unsigned>& freed;
+    std::atomic<unsigned>& executed;
+    RawArgument(std::atomic<unsigned>& f, std::atomic<unsigned>& e) : freed(f), executed(e) {}
+    ~RawArgument() { ++freed; }
+};
+ThreadPoolTask* rawTask(RawArgument* argument) {
+    return new_pooltask([](RawArgument* value) {
+        ++value->executed;
+        delete value;
+    }, argument);
+}
+}
+
+TEST_CASE("pool stop drains every accepted task and reopen never replays old work", "[thread-pool-lifetime]") {
+    std::atomic<unsigned> freed{0U}, executed{0U};
+    unsigned accepted = 0U;
+    ThreadPool pool(4U, "lifetime");
+    for (unsigned generation = 0; generation < 20U; ++generation) {
+        pool.start();
+        pool.start(); // Idempotent healthy start.
+        for (unsigned index = 0; index < 32U; ++index) {
+            auto* argument = new RawArgument(freed, executed);
+            auto* task = rawTask(argument);
+            const bool added = pool.enqueue(task);
+            if (!added) { delete task; delete argument; }
+            REQUIRE(added);
+            ++accepted;
+        }
+        pool.stop();
+        pool.wait();
+        pool.wait(); // No stale native handle may be joined a second time.
+        REQUIRE(executed == accepted);
+        REQUIRE(freed == accepted + generation);
+        auto* argument = new RawArgument(freed, executed);
+        auto* task = rawTask(argument);
+        const bool stopped = pool.enqueue(task);
+        if (!stopped) { delete task; delete argument; }
+        REQUIRE_FALSE(stopped);
+        REQUIRE(freed == accepted + generation + 1U);
+    }
+}
+
+TEST_CASE("pool queue limit and stopped admission preserve rejected task ownership", "[thread-pool-lifetime]") {
+    Held held;
+    std::atomic<unsigned> destroyed{0U}, queuedRan{0U};
+    ThreadPool pool;
+    pool.start();
+    bool admitted = true;
+    for (unsigned index = 0; index < 4U; ++index) {
+        auto* task = new TrackedTask(destroyed, [&] { held.run(); });
+        if (!pool.enqueue(task)) { delete task; admitted = false; }
+    }
+    if (!admitted) std::abort();
+    held.await(4U);
+    pool.setMaxQueuedTasks(2U);
+    for (unsigned index = 0; index < 2U; ++index) {
+        auto* task = new TrackedTask(destroyed, [&] { ++queuedRan; });
+        if (!pool.enqueue(task)) { delete task; std::abort(); }
+    }
+    auto* fullTask = new TrackedTask(destroyed, [&] { ++queuedRan; });
+    const bool full = pool.enqueue(fullTask);
+    const unsigned beforeCallerDelete = destroyed;
+    if (!full) delete fullTask;
+    pool.stop();
+    auto* stoppedTask = new TrackedTask(destroyed, [&] { ++queuedRan; });
+    const bool stopped = pool.enqueue(stoppedTask);
+    if (!stopped) delete stoppedTask;
+    auto waiter = std::async(std::launch::async, [&] { pool.wait(); });
+    const bool waiting = waiter.wait_for(milliseconds(0)) != std::future_status::ready;
+    held.open();
+    waiter.get();
+    REQUIRE_FALSE(full);
+    REQUIRE_FALSE(stopped);
+    REQUIRE(beforeCallerDelete == 0U);
+    REQUIRE(waiting);
+    REQUIRE(queuedRan == 2U);
+    REQUIRE(destroyed == 8U);
+}
+
+TEST_CASE("pool destruction joins held workers and executes raw-argument cleanup", "[thread-pool-lifetime]") {
+    Held held;
+    std::atomic<unsigned> freed{0U}, executed{0U};
+    auto pool = std::unique_ptr<ThreadPool>(new ThreadPool());
+    pool->start();
+    for (unsigned index = 0; index < 4U; ++index) {
+        auto* task = new_pooltask([&] { held.run(); });
+        if (!pool->enqueue(task)) { delete task; std::abort(); }
+    }
+    held.await(4U);
+    for (unsigned index = 0; index < 8U; ++index) {
+        auto* argument = new RawArgument(freed, executed);
+        auto* task = rawTask(argument);
+        if (!pool->enqueue(task)) { delete task; delete argument; std::abort(); }
+    }
+    std::promise<void> destroying;
+    auto began = destroying.get_future();
+    auto destroyer = std::async(std::launch::async, [&] { destroying.set_value(); pool.reset(); });
+    began.get();
+    const bool waited = destroyer.wait_for(milliseconds(0)) != std::future_status::ready;
+    const unsigned pendingFreed = freed;
+    held.open();
+    destroyer.get();
+    REQUIRE(waited);
+    REQUIRE(pendingFreed == 0U);
+    REQUIRE(executed == 8U);
+    REQUIRE(freed == 8U);
+}
+
+TEST_CASE("configured worker count applies at the next fresh pool start", "[thread-pool-lifetime]") {
+    Held held;
+    ThreadPool pool(1U);
+    REQUIRE(pool.getMaxWorkerCnt() == 4U);
+    pool.setMaxWorkerCnt(7U);
+    REQUIRE(pool.getMaxWorkerCnt() == 7U);
+    pool.setMaxQueuedTasks(9U);
+    REQUIRE(pool.getMaxQueuedTasks() == 9U);
+    pool.start();
+    for (unsigned index = 0; index < 7U; ++index) {
+        auto* task = new_pooltask([&] { held.run(); });
+        if (!pool.enqueue(task)) { delete task; std::abort(); }
+    }
+    held.await(7U);
+    held.open();
+    pool.stop(); pool.wait();
+    pool.setMaxWorkerCnt(0U);
+    REQUIRE(pool.getMaxWorkerCnt() == 4U);
+}
+
+TEST_CASE("concurrent pool lifecycle admission and queue limits retain exact ownership", "[thread-pool-lifetime]") {
+    std::atomic<unsigned> accepted{0U}, created{0U}, freed{0U}, executed{0U};
+    ThreadPool pool;
+    pool.start();
+    std::vector<std::future<void>> publishers;
+    for (unsigned publisher = 0; publisher < 4U; ++publisher) {
+        publishers.emplace_back(std::async(std::launch::async, [&] {
+            for (unsigned index = 0; index < 256U; ++index) {
+                auto* argument = new RawArgument(freed, executed);
+                ++created;
+                auto* task = rawTask(argument);
+                if (pool.enqueue(task)) ++accepted;
+                else { delete task; delete argument; }
+            }
+        }));
+    }
+    auto settings = std::async(std::launch::async, [&] {
+        for (unsigned index = 0; index < 256U; ++index) {
+            pool.setMaxQueuedTasks(index % 17U);
+            (void)pool.getMaxQueuedTasks();
+            pool.setMaxWorkerCnt(4U + index % 3U);
+            (void)pool.getMaxWorkerCnt();
+        }
+    });
+    auto stopStart = std::async(std::launch::async, [&] {
+        for (unsigned index = 0; index < 16U; ++index) { pool.stop(); pool.start(); }
+    });
+    auto waitStart = std::async(std::launch::async, [&] {
+        for (unsigned index = 0; index < 16U; ++index) { pool.wait(); pool.start(); }
+    });
+    for (auto& publisher : publishers) publisher.get();
+    settings.get(); stopStart.get(); waitStart.get();
+    pool.stop(); pool.wait();
+    REQUIRE(created == 1024U);
+    REQUIRE(executed == accepted);
+    REQUIRE(freed == created);
+}
