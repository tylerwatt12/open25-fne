--- /dev/null
+++ b/tests/ThreadStartup_Tests.cpp
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Exercise real Thread startup without starting a host, transport or device.
+#include "common/Thread.h"
+#include <catch2/catch_test_macros.hpp>
+
+#if !defined(_WIN32)
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+struct ThreadStartupTestAccess {
+    static bool start(void* obj, void* (*routine)(void*), thread_t* record,
+        int (*create)(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*)) {
+        return Thread::runAsThreadPOSIX(obj, routine, record, create);
+    }
+    static bool publicationHeld(void* (*entry)(void*), void* argument) {
+        if (entry != Thread::publishedThreadEntry) return false;
+        auto* startup = static_cast<Thread::Startup*>(argument);
+        if (startup->publication.try_lock()) {
+            startup->publication.unlock();
+            return false;
+        }
+        return true;
+    }
+};
+
+namespace {
+using namespace std::chrono;
+struct Result {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool done = false;
+    bool validHandle = false;
+    bool validRecord = false;
+    bool freeRecord = true;
+    thread_t* expected = nullptr;
+    pthread_t self{};
+    unsigned calls = 0;
+    int sentinel = 73;
+};
+void* finish(void* argument) {
+    auto* record = static_cast<thread_t*>(argument);
+    auto* result = static_cast<Result*>(record->obj);
+    const bool valid = ::pthread_equal(record->thread, ::pthread_self()) != 0;
+    const bool same = result->expected == nullptr || result->expected == record;
+    const bool release = result->freeRecord;
+    if (release) delete record;
+    {
+        std::lock_guard<std::mutex> lock(result->mutex);
+        result->self = ::pthread_self();
+        result->validHandle = valid;
+        result->validRecord = same;
+        ++result->calls;
+        result->done = true;
+    }
+    result->changed.notify_all();
+    return &result->sentinel;
+}
+void awaitResult(Result& result) {
+    std::unique_lock<std::mutex> lock(result.mutex);
+    // A broken test must fail instead of leaving a live joinable thread behind.
+    if (!result.changed.wait_for(lock, seconds(5), [&] { return result.done; })) std::abort();
+}
+struct Delay {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool childEntered = false;
+    bool gateHeld = false;
+    bool allowOutput = false;
+    bool outputPublished = false;
+    pthread_t child{};
+};
+thread_local Delay* currentDelay = nullptr;
+struct DelayedEntry {
+    void* (*entry)(void*);
+    void* argument;
+    Delay* state;
+};
+void* delayedChild(void* argument) {
+    std::unique_ptr<DelayedEntry> packet(static_cast<DelayedEntry*>(argument));
+    const bool held = ThreadStartupTestAccess::publicationHeld(packet->entry, packet->argument);
+    {
+        std::lock_guard<std::mutex> lock(packet->state->mutex);
+        packet->state->gateHeld = held;
+        packet->state->childEntered = true;
+    }
+    packet->state->changed.notify_all();
+    auto routine = packet->entry;
+    auto data = packet->argument;
+    packet.reset();
+    return routine(data);
+}
+int delayedCreate(pthread_t* output, const pthread_attr_t* attributes, void* (*entry)(void*), void* argument) {
+    Delay& state = *currentDelay;
+    auto packet = std::unique_ptr<DelayedEntry>(new DelayedEntry{entry, argument, &state});
+    pthread_t child{};
+    const int error = ::pthread_create(&child, attributes, delayedChild, packet.get());
+    if (error != 0) return error;
+    packet.release();
+    std::unique_lock<std::mutex> lock(state.mutex);
+    state.child = child;
+    if (!state.changed.wait_for(lock, seconds(5), [&] { return state.allowOutput; })) std::abort();
+    // Deliberately model an implementation publishing its output only after
+    // the real child has begun. The caller cannot touch/free that output yet.
+    *output = child;
+    state.outputPublished = true;
+    return 0;
+}
+int failedCreate(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*) {
+    errno = ENOENT; // pthread_create reports its own error, not this errno.
+    return EAGAIN;
+}
+}
+
+TEST_CASE("POSIX startup holds callback ownership until delayed output publication", "[thread-startup]") {
+    for (bool supplied : {false, true}) {
+        Delay delay;
+        Result result;
+        thread_t* record = supplied ? new thread_t() : nullptr;
+        result.expected = record;
+        auto creator = std::async(std::launch::async, [&] {
+            currentDelay = &delay;
+            return ThreadStartupTestAccess::start(&result, finish, record, delayedCreate);
+        });
+        bool entered, held, unpublished, untouched;
+        {
+            std::unique_lock<std::mutex> lock(delay.mutex);
+            entered = delay.changed.wait_for(lock, seconds(5), [&] { return delay.childEntered; });
+            held = delay.gateHeld;
+            unpublished = !delay.outputPublished;
+            {
+                std::lock_guard<std::mutex> resultLock(result.mutex);
+                untouched = !result.done;
+            }
+            if (entered && !held) {
+                // A preserved old direct-callback body must finish/free first,
+                // forcing its late output write instead of relying on scheduling.
+                lock.unlock();
+                awaitResult(result);
+                lock.lock();
+            }
+            // Always release and join before assertions can unwind the fixture.
+            delay.allowOutput = true;
+        }
+        delay.changed.notify_all();
+        const bool created = creator.get();
+        awaitResult(result);
+        void* returned = nullptr;
+        const int joined = ::pthread_join(delay.child, &returned);
+        REQUIRE(entered);
+        REQUIRE(held);
+        REQUIRE(unpublished);
+        REQUIRE(untouched);
+        REQUIRE(created);
+        REQUIRE(joined == 0);
+        REQUIRE(returned == &result.sentinel);
+        REQUIRE(result.validHandle);
+        REQUIRE(result.validRecord);
+        REQUIRE(result.calls == 1U);
+    }
+}
+
+TEST_CASE("real fast callbacks can immediately free their fully published record", "[thread-startup]") {
+    for (unsigned index = 0; index < 256U; ++index) {
+        Result result;
+        thread_t* record = index % 2U ? new thread_t() : nullptr;
+        result.expected = record;
+        REQUIRE(Thread::runAsThread(&result, finish, record));
+        awaitResult(result);
+        void* returned = nullptr;
+        REQUIRE(::pthread_join(result.self, &returned) == 0);
+        REQUIRE(returned == &result.sentinel);
+        REQUIRE(result.validHandle);
+        REQUIRE(result.validRecord);
+        REQUIRE(result.calls == 1U);
+    }
+}
+
+TEST_CASE("supplied startup record remains caller owned when creation fails", "[thread-startup]") {
+    Result result;
+    thread_t record{};
+    REQUIRE_FALSE(ThreadStartupTestAccess::start(&result, finish, &record, failedCreate));
+    REQUIRE(record.obj == &result);
+    REQUIRE(errno == ENOENT);
+    REQUIRE(result.calls == 0U);
+    record.obj = nullptr; // Still valid caller storage; must never have been deleted.
+}
+
+TEST_CASE("failed implicit startup records are reclaimed without invoking callbacks", "[thread-startup]") {
+    Result result;
+    for (unsigned index = 0; index < 64U; ++index)
+        REQUIRE_FALSE(ThreadStartupTestAccess::start(&result, finish, nullptr, failedCreate));
+    REQUIRE(result.calls == 0U);
+}
+
+TEST_CASE("successful callback may retain a supplied record for the caller", "[thread-startup]") {
+    Result result;
+    result.freeRecord = false;
+    thread_t record{};
+    result.expected = &record;
+    REQUIRE(Thread::runAsThread(&result, finish, &record));
+    awaitResult(result);
+    void* returned = nullptr;
+    REQUIRE(::pthread_join(record.thread, &returned) == 0);
+    REQUIRE(record.obj == &result);
+    REQUIRE(returned == &result.sentinel);
+    REQUIRE(result.validHandle);
+    REQUIRE(result.validRecord);
+}
+
+TEST_CASE("independent concurrent startup publishers release exactly their own records", "[thread-startup]") {
+    std::vector<std::future<bool>> publishers;
+    for (unsigned publisher = 0; publisher < 8U; ++publisher) {
+        publishers.emplace_back(std::async(std::launch::async, [] {
+            for (unsigned count = 0; count < 32U; ++count) {
+                Result result;
+                if (!Thread::runAsThread(&result, finish)) return false;
+                awaitResult(result);
+                void* returned = nullptr;
+                if (::pthread_join(result.self, &returned) != 0 || returned != &result.sentinel ||
+                    !result.validHandle || !result.validRecord || result.calls != 1U) return false;
+            }
+            return true;
+        }));
+    }
+    for (auto& publisher : publishers) REQUIRE(publisher.get());
+}
+#endif // !defined(_WIN32)
