+++ b/src/bridge/UDPInactivity.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// UDP activity is a receipt timestamp, not a timer clocked by another thread.
+#ifndef __UDP_INACTIVITY_H__
+#define __UDP_INACTIVITY_H__
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+class UDPInactivity {
+public:
+    using Clock = std::chrono::steady_clock;
+    void received(Clock::time_point now = Clock::now())
+    {
+        m_last.store(stamp(now), std::memory_order_release);
+    }
+    void clear() { m_last.store(-1, std::memory_order_release); }
+    bool expired(std::chrono::milliseconds quiet, Clock::time_point now = Clock::now()) const
+    {
+        const int64_t last = m_last.load(std::memory_order_acquire);
+        const int64_t current = stamp(now);
+        return last >= 0 && current >= last && current - last >=
+            std::chrono::duration_cast<std::chrono::nanoseconds>(quiet).count();
+    }
+private:
+    static int64_t stamp(Clock::time_point now)
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(now.time_since_epoch()).count();
+    }
+    std::atomic<int64_t> m_last{-1};
+};
+#endif
--- /dev/null
+++ b/tests/BridgeUDPInactivity_Tests.cpp
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "bridge/UDPInactivity.h"
+#include <catch2/catch_test_macros.hpp>
+#include <chrono>
+
+namespace {
+using namespace std::chrono;
+UDPInactivity::Clock::time_point at(int64_t ms)
+{
+    return UDPInactivity::Clock::time_point(milliseconds(ms));
+}
+}
+
+TEST_CASE("A delayed UDP watchdog cannot expire freshly received PCM", "[bridge-udp]")
+{
+    UDPInactivity activity;
+    activity.received(at(0));
+    // The watchdog sleeps for 500 ms while PCM continues on another thread.
+    for (int ms = 20; ms <= 500; ms += 20) activity.received(at(ms));
+    REQUIRE_FALSE(activity.expired(milliseconds(180), at(500)));
+    REQUIRE_FALSE(activity.expired(milliseconds(180), at(679)));
+    REQUIRE(activity.expired(milliseconds(180), at(680)));
+}
+
+TEST_CASE("Continuous PCM survives repeated delayed watchdog checks", "[bridge-udp]")
+{
+    UDPInactivity activity;
+    for (int ms = 0; ms <= 30000; ms += 20) {
+        activity.received(at(ms));
+        // Deliberately sparse checks model a descheduled watchdog.
+        if (ms % 1460 == 0) REQUIRE_FALSE(activity.expired(milliseconds(180), at(ms + 19)));
+    }
+    REQUIRE_FALSE(activity.expired(milliseconds(180), at(30179)));
+    REQUIRE(activity.expired(milliseconds(180), at(30180)));
+}
+
+TEST_CASE("A locked recheck observes PCM that arrived after a timeout candidate", "[bridge-udp]")
+{
+    UDPInactivity activity;
+    activity.received(at(1000));
+    REQUIRE(activity.expired(milliseconds(180), at(1200)));
+    activity.received(at(1201));
+    REQUIRE_FALSE(activity.expired(milliseconds(180), at(1202)));
+    activity.clear();
+    REQUIRE_FALSE(activity.expired(milliseconds(180), at(2000)));
+    activity.received(at(2001));
+    REQUIRE(activity.expired(milliseconds(180), at(2181)));
+}
