+TEST_CASE("dispatch drain preserves a committed lease until its caller releases", "[dispatch-grant][idle-identification]") {
+    Fixture f;
+    f.control->configureIdentification(true);
+    const auto granted = f.run(f.request());
+    REQUIRE(granted.accepted); REQUIRE(f.drain() > 0U);
+    REQUIRE_FALSE(f.control->beginIdentificationDrain(true)); // The accepted caller won the quiet race.
+    REQUIRE_FALSE(f.control->identificationUnavailable());
+    REQUIRE(f.control->beginIdentificationDrain()); // A periodic withdrawal stops subsequent calls.
+    REQUIRE_FALSE(f.control->tryBeginIdentification());
+    REQUIRE_FALSE(f.control->identificationActive());
+    f.control->clock(); // Watchdog must retain the existing lease during Draining.
+    REQUIRE(f.control->affiliations()->ownsGrant(TG, RID, VC, granted.epoch));
+    auto renew = f.request(p25::DispatchAction::Renew); renew.epoch = granted.epoch;
+    REQUIRE(f.run(renew).accepted); REQUIRE(f.rpc.permits == 2U);
+    REQUIRE(f.drain() == 0U);
+    auto next = f.request(p25::DispatchAction::Grant, LEASE2); next.dstId = TG2;
+    REQUIRE_FALSE(f.run(next).accepted); REQUIRE(f.rpc.permits == 2U);
+    REQUIRE(f.control->affiliations()->ownsGrant(TG, RID, VC, granted.epoch));
+    auto release = f.request(p25::DispatchAction::Release); release.epoch = granted.epoch;
+    REQUIRE(f.run(release).accepted);
+    REQUIRE(f.control->identificationIdle());
+    REQUIRE(f.control->tryBeginIdentification());
+    REQUIRE(f.control->identificationActive());
+}
