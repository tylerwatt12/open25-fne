+/* Retry one conditional retirement without blocking RF or permit ownership. */
+void Control::retryPermitReleases()
+{
+    if (g_RPC == nullptr || m_authoritative || std::chrono::steady_clock::now() < m_nextPermitRelease)
+        return;
+    const auto barrier = m_permitReleases;
+    std::string token;
+    uint32_t destination = 0U;
+    {
+        std::lock_guard<std::mutex> releases(barrier->mutex);
+        if (barrier->pending.empty())
+            return;
+        token = barrier->pending.begin()->first;
+        destination = barrier->pending.begin()->second;
+    }
+    m_nextPermitRelease = std::chrono::steady_clock::now() + std::chrono::milliseconds(500U);
+    json::object request;
+    request["dstId"].set<uint32_t>(destination);
+    request["permitToken"].set<std::string>(token);
+    g_RPC->req(RPC_RELEASE_P25_TG, request, [barrier, token, destination](json::object& response, json::object&) {
+        if (!response["status"].is<int>() || response["status"].get<int>() != network::NetRPC::OK ||
+            !response["dstId"].is<int>() || response["dstId"].get<uint32_t>() != destination ||
+            !response["permitToken"].is<std::string>() || response["permitToken"].get<std::string>() != token ||
+            !response["allocationRetired"].is<bool>() || !response["allocationRetired"].get<bool>())
+            return;
+        std::lock_guard<std::mutex> releases(barrier->mutex);
+        barrier->pending.erase(token);
+    }, m_controlChData.address(), m_controlChData.port());
+}
