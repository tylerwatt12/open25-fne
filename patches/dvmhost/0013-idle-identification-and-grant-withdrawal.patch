+/* Retry only a correlated withdrawal response, never malformed/ACL/timeouts. */
+bool ControlSignaling::permitAvailableTrafficChannel(::lookups::VoiceChData& channel, uint32_t dstId,
+    uint32_t srcId, uint32_t& chNo, bool grp, bool net, bool dataPermit,
+    std::unique_lock<std::recursive_mutex>& grantGuard)
+{
+    std::set<uint32_t> attempted;
+    // Native RPC has its own 200ms deadline. Bound the entire candidate walk
+    // to this window plus at most one final in-flight RPC; never loop on a VC.
+    const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(400U);
+    while (chNo != 0U && attempted.insert(chNo).second) {
+        bool unavailable = false;
+        if (permitTrafficChannel(channel, dstId, srcId, chNo, dataPermit, grantGuard, &unavailable))
+            return true;
+        if (!unavailable || std::chrono::steady_clock::now() >= until)
+            return false;
+        if (grantGuard.owns_lock())
+            grantGuard.unlock();
+        auto* allocations = m_p25->m_affiliations;
+        if (!allocations->grantCh(dstId, srcId, GRANT_TIMER_TIMEOUT, grp, net))
+            return false;
+        chNo = allocations->getGrantedCh(dstId);
+        channel = allocations->rfCh()->getRFChData(chNo);
+        if (attempted.count(chNo) != 0U) {
+            // The remaining free pool contains only candidates already tried.
+            auto guard = allocations->lockGrants();
+            const uint64_t epoch = allocations->grantEpoch(dstId);
+            if (allocations->ownsGrant(dstId, srcId, chNo, epoch))
+                allocations->releaseGrant(dstId, false);
+            return false;
+        }
+    }
+    return false;
+}
