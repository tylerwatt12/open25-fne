+++ b/tests/NetworkInitialConnection_Tests.cpp
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// The open path resolves a loopback address only. No socket or RF is opened.
+#include "common/network/Network.h"
+#include <catch2/catch_test_macros.hpp>
+namespace {
+class InitialConnectionPeer : public network::Network {
+public:
+    InitialConnectionPeer() : Network("127.0.0.1",48993U,0U,12345U,"local-test",false,false,
+        false,true,false,false,false,false,false,false,false,false) {}
+    bool readyToAttempt() const { return m_retryTimer.isRunning() && m_retryTimer.hasExpired(); }
+    unsigned retrySeconds() const { return m_retryTimer.getTimeout(); }
+    void pass(unsigned ms) { m_retryTimer.clock(ms); }
+};
+}
+TEST_CASE("First FNE connection is immediate and reconnect keeps its backoff", "[network-initial-connection]") {
+    InitialConnectionPeer peer;
+    peer.enable(true);
+    REQUIRE(peer.open());
+    REQUIRE(peer.readyToAttempt());
+    REQUIRE(peer.retrySeconds()==10U);
+    peer.close();
+    REQUIRE(peer.open());
+    REQUIRE_FALSE(peer.readyToAttempt());
+    REQUIRE(peer.retrySeconds()==10U);
+    peer.pass(9999U);
+    REQUIRE_FALSE(peer.readyToAttempt());
+    peer.pass(1U);
+    REQUIRE(peer.readyToAttempt());
+    peer.close();
+}
+TEST_CASE("Disabled open does not consume the initial connection", "[network-initial-connection]") {
+    InitialConnectionPeer peer;
+    REQUIRE_FALSE(peer.open());
+    peer.enable(true);
+    REQUIRE(peer.open());
+    REQUIRE(peer.readyToAttempt());
+    peer.close();
+}
