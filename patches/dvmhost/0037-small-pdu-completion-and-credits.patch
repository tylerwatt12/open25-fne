+// SPDX-License-Identifier: GPL-2.0-only
+// Protocol4 lengths and FIFO credits are pinned implementation contracts;
+// packet RF lengths derive from BAAA-B7.2/7.2.4, documented in the plan.
+#include "PacketTransportFixture.h"
