+// SPDX-License-Identifier: GPL-2.0-only
+// Memory-only serial endpoint: actual Modem parser/writer methods run unchanged.
+#pragma once
+#include "host/modem/Modem.h"
+#include <algorithm>
+#include <deque>
+#include <vector>
+namespace packettest {
+struct MemoryPort : modem::port::IModemPort {
+    std::deque<uint8_t> input;
+    std::vector<std::vector<uint8_t>> output;
+    bool open() override { return true; }
+    void close() override {}
+    int read(uint8_t* p,uint32_t n) override {unsigned i=0;while(i<n&&!input.empty()){p[i++]=input.front();input.pop_front();}return int(i);}
+    int write(const uint8_t* p,uint32_t n) override {output.emplace_back(p,p+n);return int(n);}
+};
+class OfflineModem : public modem::Modem {
+public:
+    MemoryPort* memory;
+    OfflineModem():OfflineModem(new MemoryPort()){}
+    explicit OfflineModem(MemoryPort* p):Modem(p,true,false,false,false,false,false,0,0,0,8192,8192,8192,true,true,false,false,false,false),memory(p) {m_protoVer=4U;m_p25Enabled=true;}
+    bool poll(){return getStatus();}
+    bool pending()const{return m_p25StatusPending;}
+    uint64_t afterRequest()const{return m_p25StatusWrites;}
+    uint32_t credits()const{return m_p25Space;}
+    void boundedTimeout(){m_boundedCWOperation.store(true);clock(8000U);}
+    bool timeoutRunning()const{return m_inactivityTimer.isRunning();}
+    void receive(const std::vector<uint8_t>& wire){memory->input.insert(memory->input.end(),wire.begin(),wire.end());clock(0);}
+};
+}
