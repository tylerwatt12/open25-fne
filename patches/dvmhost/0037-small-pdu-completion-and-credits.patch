+using packettest::OfflineModem;
+namespace {
+std::vector<uint8_t> status(uint8_t blocks=32){return {0xFE,12,1,0x89,2,0,0,0,0,0,blocks,0};}
+void ready(OfflineModem& m){REQUIRE(m.poll());m.receive(status());REQUIRE(m.credits()==512);}
+}
+TEST_CASE("protocol4 P25 writer preserves exact source and declared wire lengths", "[p25][pdu-transport]") {
+ g_logDisplayLevel=0;
+ for(unsigned n:{20U,218U,251U,252U,256U,257U,497U}) {
+  CAPTURE(n);OfflineModem m;ready(m);std::unique_ptr<uint8_t[]> source(new uint8_t[n]);for(unsigned i=0;i<n;++i)source[i]=uint8_t(i);source[0]=modem::TAG_DATA;
+  const auto before=m.credits();REQUIRE(m.hasP25Space(n));REQUIRE(m.writeP25Frame(source.get(),n));const auto& wire=m.memory->output.back();const unsigned header=n<252?3:4;
+  REQUIRE(wire.size()==n+header-1);REQUIRE(wire[0]==(n<252?0xFE:0xFD));REQUIRE((n<252?wire[1]:unsigned(wire[1])*256+wire[2])==wire.size());REQUIRE(wire[header-1]==0x31);
+  REQUIRE(std::equal(wire.begin()+header,wire.end(),source.get()+1));REQUIRE(m.credits()==before-n-(n>256?1:0));
+ }
+ OfflineModem m;ready(m);const uint8_t tiny=0;for(unsigned n:{0U,1U,2U,515U,0xFFFFFFFFU}){REQUIRE_FALSE(m.hasP25Space(n));REQUIRE_FALSE(m.writeP25Frame(&tiny,n));}REQUIRE(m.memory->output.size()==1);
+}
+TEST_CASE("one pending status conservatively accounts later P25 records", "[p25][pdu-transport]") {
+ OfflineModem m;ready(m);REQUIRE(m.poll());const auto requests=m.memory->output.size();REQUIRE(m.pending());REQUIRE(m.poll());REQUIRE(m.memory->output.size()==requests);
+ std::vector<uint8_t> voice(218,0);voice[0]=modem::TAG_DATA;REQUIRE(m.writeP25Frame(voice.data(),voice.size()));REQUIRE(m.writeP25Frame(voice.data(),voice.size()));REQUIRE_FALSE(m.writeP25Frame(voice.data(),voice.size()));REQUIRE(m.credits()==76);REQUIRE(m.afterRequest()==436);
+ m.receive(status());REQUIRE_FALSE(m.pending());REQUIRE(m.credits()==76); // delayed empty-FIFO snapshot cannot double-credit
+ m.receive(status());REQUIRE(m.credits()==76); // unsolicited reply cannot replenish
+ REQUIRE(m.poll());m.receive(status(19));REQUIRE(m.credits()==304); // fresh reply after one actual216-byte RF record dequeues
+ REQUIRE(m.writeP25Frame(voice.data(),voice.size()));REQUIRE(m.credits()==86);
+ REQUIRE(m.poll());m.close();REQUIRE_FALSE(m.pending());REQUIRE(m.credits()==0);m.receive(status());REQUIRE(m.credits()==0); // retired epoch
+}
