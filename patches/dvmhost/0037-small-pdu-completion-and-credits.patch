+std::array<uint8_t,25> coded(const std::vector<uint8_t>& raw){std::array<uint8_t,25> v{};for(unsigned n=0;n<196;++n){unsigned logical=112+n,at=logical+2*(logical/70);if(raw[at/8]&(0x80U>>(at%8)))v[n/8]|=0x80U>>(n%8);}return v;}
