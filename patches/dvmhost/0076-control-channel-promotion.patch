+    f.modem.transmitting(false); f.drain();
+    f.modem.quiesceReady();
+    p25::DispatchGrantTestAccess::quiesceClock(*f.control); // request the ordinary native serial barrier
+    REQUIRE_FALSE(f.control->controlQuiesceState().idle);
+    f.modem.barrierReply(); p25::DispatchGrantTestAccess::quiesceClock(*f.control);
+    f.modem.freshStatus(); p25::DispatchGrantTestAccess::quiesceClock(*f.control);
+    REQUIRE_FALSE(f.control->controlQuiesceState().idle);
+    REQUIRE_FALSE(f.control->controlQuiesceState().idle); // HTTP/status reads never advance hardware proof
+    f.modem.freshStatus(); p25::DispatchGrantTestAccess::quiesceClock(*f.control);
+    REQUIRE(f.control->controlQuiesceState().idle);
+    f.control->setControlQuiesce(false); reply.clear();
+    other = request(TG2, "a:2");
+    p25::DispatchGrantTestAccess::permit(*f.control, other, reply);
+    REQUIRE(reply["status"].get<int>() == network::NetRPC::OK);
