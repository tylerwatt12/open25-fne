+TEST_CASE("quiesce fences new commands and waits for the actual pending procedure", "[p25][control-promotion]") {
+    Fixture f;
+    REQUIRE(f.control->control()->requestRadioCheck(10001U, 0U));
+    const auto state = f.control->setControlQuiesce(true);
+    REQUIRE_FALSE(state.idle); REQUIRE(state.pendingOperations == 1U);
+    REQUIRE_FALSE(f.control->control()->requestRadioCheck(10005U, 0U));
+    REQUIRE_FALSE(f.control->control()->requestStatusQuery(10001U, 0U));
+    REQUIRE_FALSE(f.control->control()->requestMessageUpdate(10001U, 0U, 0U));
+    REQUIRE_FALSE(f.control->control()->writeRF_TSDU_Call_Alrt(p25::defines::WUID_FNE, 10001U));
+    REQUIRE_FALSE(f.control->control()->writeRF_TSDU_Grp_Aff_Q(10001U));
+    REQUIRE_FALSE(f.control->control()->writeRF_TSDU_U_Reg_Cmd(10001U));
+    REQUIRE(f.control->control()->requestInhibitCommand(10001U, true, 0U).status == 503U);
+    REQUIRE(f.control->control()->radioCheckState(10001U) == p25::packet::ControlSignaling::RadioCheckState::Queued);
+    f.control->control()->cancelRadioChecks();
+    REQUIRE(f.control->control()->radioCheckState(10001U) == p25::packet::ControlSignaling::RadioCheckState::Cancelled);
+    REQUIRE(f.control->controlQuiesceState().idle);
+    REQUIRE(f.control->control()->updateInhibitPolicy({}, {}, false, 0U).status == 202U);
+    REQUIRE_FALSE(f.control->controlQuiesceState().idle);
+}
