+// Retained terminal outcomes and blocked-radio protection are not pending
+// transactions. Read each existing procedure owner under its normal lock.
+uint32_t ControlSignaling::pendingControlOperations()
+{
+    uint32_t pending = 0U;
+    {
+        std::lock_guard<std::mutex> lock(m_radioCheckMutex);
+        for (const auto& item : m_radioChecks)
+            if (item.second.state == RadioCheckState::Queued || item.second.state == RadioCheckState::UnderCheck) ++pending;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_statusQueryMutex);
+        const auto now = std::chrono::steady_clock::now();
+        for (const auto& item : m_statusQueries) {
+            const auto& query = item.second;
+            if (query.state == StatusQueryState::Queued || query.state == StatusQueryState::Awaiting ||
+                (query.state == StatusQueryState::Reported && query.owner && query.owner->active.load() && now < query.deadline)) ++pending;
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_messageUpdateMutex);
+        for (const auto& item : m_messageUpdates)
+            if (item.second.state == MessageUpdateState::Queued || item.second.state == MessageUpdateState::Awaiting) ++pending;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_inhibitMutex);
+        pending += uint32_t(m_inhibitOperations.size() + m_inhibitCompleting);
+        for (const auto& item : m_inhibitions)
+            if (item.second.procedure == "queued" || item.second.procedure == "awaiting" || item.second.wake) ++pending;
+    }
+    return pending;
+}
