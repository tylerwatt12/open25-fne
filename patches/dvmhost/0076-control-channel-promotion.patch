+// AABC-E6.2.16 Fig6.2.16-1, PDF182/printed163; 2.3.32 PDF40/printed21.
+// AABD-B12.7 PDF117/printed112. Exact editions/paths in plan26.
+// Expected octets below are derived directly from the original PDF diagram,
+// independently of the production SCCB encoder; CRC is checked after trellis.
+TEST_CASE("configured backup channels advertise complete identities with backup service class", "[p25][control-promotion]") {
+    Fixture f(true, R"(
+        backupControlChannels:
+            - channelId: 0
+              channelNo: "000"
+            - channelId: 15
+              channelNo: "FFF"
+            - channelId: 3
+              channelNo: "123"
+)");
+    const auto next = [&] {
+        p25::DispatchGrantTestAccess::broadcast(*f.control, 8U);
+        std::array<uint8_t, p25::defines::P25_TSDU_FRAME_LENGTH_BYTES + 2U> frame{};
+        REQUIRE(f.control->getFrame(frame.data()) == frame.size());
+        std::array<uint8_t, p25::defines::P25_TSBK_FEC_LENGTH_BYTES> coded{};
+        p25::P25Utils::decode(frame.data() + 2U, coded.data(), 114U, 318U);
+        std::array<uint8_t, p25::defines::P25_TSBK_LENGTH_BYTES> raw{};
+        edac::Trellis trellis; REQUIRE(trellis.decode12(coded.data(), raw.data()));
+        REQUIRE(edac::CRC::checkCCITT162(raw.data(), raw.size()));
+        REQUIRE((raw[0] & 0x3FU) == 0x39U); REQUIRE(raw[1] == 0U);
+        REQUIRE(raw[2] == 1U); REQUIRE(raw[3] == 1U);
+        REQUIRE(raw[6] == 4U); REQUIRE(raw[9] == 4U);
+        REQUIRE(f.control->getFrame(frame.data()) == 0U);
+        return raw;
+    };
+    const auto first = next();
+    REQUIRE(first[4] == 0U); REQUIRE(first[5] == 0U);
+    REQUIRE(first[7] == 0xFFU); REQUIRE(first[8] == 0xFFU);
+    const auto last = next();
+    REQUIRE(last[4] == 0x31U); REQUIRE(last[5] == 0x23U);
+    REQUIRE(last[7] == 0x31U); REQUIRE(last[8] == 0x23U); // odd final entry repeats, AABC-E6.2.16
+    REQUIRE(next() == first);
+}
