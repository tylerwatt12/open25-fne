+// Explicit Site operation only. The allocation/permit owners serialize this
+// admission fence; an HTTP caller never decides that a displayed status is idle.
+ControlQuiesceState Control::setControlQuiesce(bool enabled)
+{
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    auto grants = m_affiliations->lockGrants();
+    if (m_controlQuiesced.exchange(enabled) != enabled) {
+        m_quiesceBarrierRequested = m_quiesceBarrierPassed = m_quiesceBarrierFailed = m_quiesceHardwareIdle = false;
+        m_quiesceQuietSamples = 0U;
+    }
+    return controlQuiesceState();
+}
+
+ControlQuiesceState Control::controlQuiesceState()
+{
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    auto grants = m_affiliations->lockGrants();
+    ControlQuiesceState result;
+    result.quiesced = m_controlQuiesced.load();
+    result.grants = m_affiliations->grantSize();
+    result.dispatchLeases = uint32_t(m_dispatchLeases.size());
+    result.pendingOperations = m_control->pendingControlOperations();
+    {
+        std::lock_guard<std::mutex> queue(m_dispatchQueueMutex);
+        result.pendingDispatch = uint32_t(m_dispatchQueue.size());
+    }
+    {
+        std::lock_guard<std::mutex> pending(m_rfAdmissionMutex);
+        for (const auto& item : m_rfAdmissions) {
+            const auto& state = item.second.state;
+            if (state == "pending" || state == "approved" || state == "committing") ++result.pendingRF;
+        }
+    }
+    result.permitActive = m_permittedDstId.load() != 0U || !m_permitToken.empty();
+    result.radioBusy = isBusy() || identificationActive() || m_txImmQueue.hasOwnedFrames() || m_txQueue.hasOwnedFrames();
+    // A dedicated control carrier continuously queues status broadcasts. Those
+    // are not traffic calls. Voice workers must also drain actual RF/media tails.
+    if (!m_dedicatedControl) {
+        result.radioBusy = result.radioBusy || m_tailOnIdle || !m_txImmQueue.isEmpty() || !m_txQueue.isEmpty() ||
+            !m_pendingSiteFrames.empty() || (m_modem != nullptr && m_modem->hasTX()) ||
+            (result.quiesced && !m_quiesceHardwareIdle);
+    }
+    result.idle = result.grants == 0U && result.dispatchLeases == 0U &&
+        result.pendingDispatch == 0U && result.pendingRF == 0U && result.pendingOperations == 0U &&
+        !result.permitActive && !result.radioBusy;
+    return result;
+}
+
+// The protocol clock owns modem requests and readiness. A serial version-reply
+// barrier fences the final queued write, followed by two fresh quiet status
+// observations, just as the existing station-identification drain does.
+void Control::clockControlQuiesce()
+{
+    if (m_authoritative || !m_controlQuiesced.load()) return;
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    if (m_modem == nullptr || m_modem->hasError() || m_modem->hasLockout() ||
+        isBusy() || identificationActive() || m_permittedDstId.load() != 0U ||
+        !m_permitToken.empty() || m_tailOnIdle || !m_txImmQueue.isEmpty() || !m_txQueue.isEmpty() ||
+        !m_pendingSiteFrames.empty() || m_modem->hasTX()) {
+        m_quiesceBarrierRequested = m_quiesceBarrierPassed = m_quiesceBarrierFailed = m_quiesceHardwareIdle = false;
+        m_quiesceQuietSamples = 0U;
+        return;
+    }
+    if (!m_quiesceBarrierRequested) {
+        m_quiesceBarrierGeneration = m_modem->serialBarrierGeneration();
+        m_quiesceBarrierRequested = true;
+        m_quiesceBarrierFailed = !m_modem->requestSerialBarrier();
+        return;
+    }
+    if (m_quiesceBarrierFailed) return;
+    if (m_modem->serialBarrierGeneration() <= m_quiesceBarrierGeneration) return;
+    if (!m_quiesceBarrierPassed) {
+        m_quiesceBarrierPassed = true;
+        m_quiesceStatusGeneration = m_modem->statusGeneration();
+        return;
+    }
+    const auto generation = m_modem->statusGeneration();
+    if (generation == m_quiesceStatusGeneration) return;
+    m_quiesceStatusGeneration = generation;
+    if (m_modem->getState() != modem::STATE_P25) {
+        m_quiesceQuietSamples = 0U;
+        m_quiesceHardwareIdle = false;
+        return;
+    }
+    if (m_quiesceQuietSamples < 2U) ++m_quiesceQuietSamples;
+    m_quiesceHardwareIdle = m_quiesceQuietSamples == 2U;
+}
