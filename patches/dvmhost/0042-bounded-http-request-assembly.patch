+    result=run({"POST /x HTTP/1.0\r\nContent-Len",""});check(!result.timeout&&result.requests.empty()&&result.retired,"header EOF dispatched/leaked");
+    result=run({"GET /after HTTP/1.0\r\n\r\n"});verify(result,1U,"200 OK");
+    result=run({"GET /peer HTTP/1.0\r\nRemoteHost: forged\r\nrEmOtEhOsT: still-forged\r\n\r\n"});verify(result,1U,"200 OK");check(result.requests[0].headers.find("RemoteHost")=="127.0.0.1","incoming header overrode socket peer identity");
+}
