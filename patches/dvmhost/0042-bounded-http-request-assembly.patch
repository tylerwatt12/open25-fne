+        std::string normalized=m_header.substr(0U,end)+"\r\n";
+        size_t at=end+2U,count=0U,cl=0U,te=0U,hosts=0U;
+        std::string lengthValue,transferValue;
+        bool expect=false;
+        while (at<m_header.size()-2U) {
+            const size_t next=m_header.find("\r\n",at);
+            if (next==std::string::npos || ++count>HeaderCountLimit) { fail(HeaderTooLarge); return; }
+            std::string name,value;
+            if (!field(m_header.substr(at,next-at),name,value)) { fail(BadRequest); return; }
+            if (name=="content-length") { ++cl; lengthValue=value; }
+            if (name=="transfer-encoding") { ++te; transferValue=lower(value); }
+            if (name=="expect") expect=true;
+            if (name=="host") {
