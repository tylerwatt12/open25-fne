+                pos=comma+1U;
+            }
+            if (last!="chunked" || chunked!=1U) { fail(BadRequest); return; }
+            if (codings!=1U) { fail(UnsupportedTransfer); return; }
+        }
+        size_t body=0U;
+        if (cl) {
+            if (lengthValue.empty() || !std::all_of(lengthValue.begin(),lengthValue.end(),[](unsigned char c){return c>='0'&&c<='9';})) { fail(BadRequest); return; }
