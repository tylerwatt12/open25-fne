+template<class Stream,class Connection,class Start,class Shutdown,class StartClient>
+WireResult exchange(Stream& client,asio::io_context& io,asio::ip::tcp::socket serverSocket,const std::vector<std::string>& fragments,bool persistent,bool large,Start start,Shutdown shutdown,StartClient startClient)
+{
+    WireHandler handler;handler.largeReply=large;
+    ServerConnectionManager<std::shared_ptr<Connection>> manager;
+    serverSocket.set_option(asio::socket_base::send_buffer_size(4096));
