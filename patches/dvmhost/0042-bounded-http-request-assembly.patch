+// SPDX-License-Identifier: GPL-2.0-only
+// Literal wire inputs: independent framing expectations, no production encoder.
+#include "common/restapi/http/RequestAssembler.h"
+#include "common/restapi/http/ServerConnectionManager.h"
+#include "common/restapi/http/ServerConnection.h"
+#include "common/restapi/http/SecureServerConnection.h"
+#include "common/restapi/http/HTTPServer.h"
+#include "common/restapi/http/SecureHTTPServer.h"
+#include <atomic>
+#include <future>
+#include <thread>
+#include <chrono>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+#if defined(ENABLE_SSL)
+#include <openssl/rsa.h>
+#include <openssl/x509.h>
+#endif
+#if !defined(HTTP_ASSEMBLER_STANDALONE)
+#include <catch2/catch_test_macros.hpp>
+#endif
+
+namespace restapi { namespace http {
+struct HTTPServerTestAccess {
+    template<class Server> static asio::ip::tcp::endpoint endpoint(Server& server) {return server.m_acceptor.local_endpoint();}
+    template<class Server> static void forceStop(Server& server) {server.m_ioService.stop();}
+#if defined(ENABLE_SSL)
+    template<class Server> static asio::ssl::context& context(Server& server) {return server.m_context;}
+#endif
+};
+} }
+
+namespace {
+using namespace restapi::http;
+using namespace std::string_literals;
+size_t checks = 0U;
+void check(bool value, const char* text) { ++checks; if (!value) throw std::runtime_error(text); }
+
+RequestAssembler::Result feed(RequestAssembler& parser, const std::string& wire, size_t fragment)
+{
+    size_t at = 0U;
+    while (at < wire.size() && parser.result() == RequestAssembler::More) {
+        const size_t count = std::min(fragment, wire.size() - at);
+        // Exact-sized independent allocations expose speculative reads to ASan.
+        std::unique_ptr<char[]> bytes(new char[count]);
+        std::copy(wire.begin() + at, wire.begin() + at + count, bytes.get());
+        size_t used = 0U;
+        parser.append(bytes.get(), count, used);
+        check(used <= count, "consumed beyond supplied bytes");
+        check(used != 0U, "incremental parser made no progress");
+        at += used;
+    }
+    return parser.result();
+}
+void goodSplits(const std::string& wire, const std::string& body)
+{
+    for (size_t split = 0U; split <= wire.size(); ++split) {
+        RequestAssembler p;
+        size_t first = 0U, second = 0U;
+        std::unique_ptr<char[]> a(new char[split]);
+        std::copy(wire.begin(), wire.begin() + split, a.get());
+        p.append(a.get(), split, first);
+        check(first == split, "valid first fragment consumption");
+        if (split != wire.size()) check(p.result() == RequestAssembler::More, "handler-ready before full message");
+        std::unique_ptr<char[]> b(new char[wire.size()-split]);
+        std::copy(wire.begin()+split, wire.end(), b.get());
+        p.append(b.get(), wire.size()-split, second);
+        check(p.result() == RequestAssembler::Complete, "valid split rejected");
+        check(first+second == wire.size(), "valid total consumption");
+        check(p.request().content == body && p.request().contentLength == body.size(), "body not byte-exact");
+        size_t used = 55U;
+        check(p.append("next",4U,used)==RequestAssembler::Complete && used==0U, "completed parser consumed next message");
+    }
+}
