+        if (te) m_state=ChunkSize;
+        else if (body!=0U) { m_request.content.reserve(body); m_remaining=body; m_state=Fixed; }
+        else finish();
+    }
+
+    bool chunkExtensions(size_t at)
+    {
+        while (at<m_line.size()) {
+            while (at<m_line.size() && ows(m_line[at])) ++at;
+            if (at==m_line.size() || m_line[at++]!=';') return false;
+            while (at<m_line.size() && ows(m_line[at])) ++at;
+            const size_t begin=at;
+            while (at<m_line.size() && token(static_cast<unsigned char>(m_line[at]))) ++at;
+            if (at==begin) return false;
+            while (at<m_line.size() && ows(m_line[at])) ++at;
+            if (at==m_line.size() || m_line[at]!='=') continue;
+            ++at;while (at<m_line.size() && ows(m_line[at])) ++at;
+            if (at==m_line.size()) return false;
+            if (m_line[at]=='"') {
+                ++at;bool closed=false;
+                while (at<m_line.size()) {
+                    const unsigned char ch=m_line[at++];
+                    if (ch=='"') { closed=true;break; }
+                    if (ch=='\\') {
+                        if (at==m_line.size()) return false;
+                        const unsigned char escaped=m_line[at++];
+                        if ((escaped<32U && escaped!='\t') || escaped==127U) return false;
+                    } else if ((ch<32U && ch!='\t') || ch==127U) return false;
+                }
+                if (!closed) return false;
+            } else {
+                const size_t beginValue=at;
+                while (at<m_line.size() && token(static_cast<unsigned char>(m_line[at]))) ++at;
+                if (at==beginValue) return false;
+            }
+        }
+        return true;
+    }
+
+    void parseChunkSize()
+    {
+        size_t at=0U,size=0U;
+        while (at<m_line.size()) {
+            const unsigned char ch=m_line[at];size_t digit;
+            if (ch>='0'&&ch<='9') digit=ch-'0';
+            else if (ch>='a'&&ch<='f') digit=ch-'a'+10U;
+            else if (ch>='A'&&ch<='F') digit=ch-'A'+10U;
+            else break;
+            if (size>(BodyLimit-digit)/16U) { fail(BodyTooLarge); return; }
+            size=size*16U+digit;++at;
+        }
+        if (at==0U || (at<m_line.size() && !chunkExtensions(at))) { fail(BadRequest); return; }
