+// SPDX-License-Identifier: BSL-1.0
+// Bounded request framing shared by the existing TCP and TLS REST transports.
+#if !defined(__REST_HTTP__REQUEST_ASSEMBLER_H__)
+#define __REST_HTTP__REQUEST_ASSEMBLER_H__
+
+#include "common/restapi/http/HTTPLexer.h"
+#include "common/restapi/http/HTTPPayload.h"
+
+#include <algorithm>
+#include <cctype>
+#include <string>
