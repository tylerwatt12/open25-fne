+class RequestAssembler {
+public:
+    enum { HeaderLimit = 16 * 1024, HeaderCountLimit = 128, BodyLimit = 64 * 1024,
+        MetadataLimit = 16 * 1024, ChunkLineLimit = 1024 };
+    enum Result { More, Complete, BadRequest, HeaderTooLarge, BodyTooLarge,
+        UnsupportedTransfer, UnsupportedExpectation };
+
+    RequestAssembler() : m_lexer(false) { reset(); }
+
+    void reset()
+    {
+        m_lexer.reset(); m_request = HTTPPayload(); m_header.clear(); m_line.clear();
+        m_state = Headers; m_result = More; m_remaining = 0U; m_metadata = 0U;
+        m_trailers = 0U; m_lineCR = false; m_input = false;
+    }
+
+    HTTPPayload& request() { return m_request; }
+    const HTTPPayload& request() const { return m_request; }
+    Result result() const { return m_result; }
+    bool hasInput() const { return m_input; }
+
+    // consumed always describes this supplied span, including only one message.
+    Result append(const char* data, size_t length, size_t& consumed)
+    {
+        consumed = 0U;
+        if (m_result != More) return m_result;
+        if (data == nullptr && length != 0U) return fail(BadRequest);
+        while (consumed < length && m_result == More) {
+            m_input = true;
+            if (m_state == Fixed || m_state == ChunkData) {
+                const size_t count = std::min(m_remaining, length - consumed);
+                m_request.content.append(data + consumed, count);
+                consumed += count; m_remaining -= count;
+                if (m_remaining == 0U) {
+                    if (m_state == Fixed) finish();
+                    else m_state = ChunkCR;
+                }
+                continue;
+            }
+            const char ch = data[consumed++];
+            if (m_state == Headers) {
+                if (m_header.size() >= HeaderLimit) return fail(HeaderTooLarge);
+                m_header.push_back(ch);
+                if (m_header.size() >= 4U && m_header.compare(m_header.size()-4U,4U,"\r\n\r\n") == 0)
+                    parseHeader();
+            } else {
+                if (++m_metadata > MetadataLimit) return fail(BodyTooLarge);
+                if (m_state == ChunkCR) {
+                    if (ch != '\r') return fail(BadRequest);
+                    m_state = ChunkLF;
+                } else if (m_state == ChunkLF) {
+                    if (ch != '\n') return fail(BadRequest);
+                    m_state = ChunkSize;
+                } else if (m_lineCR) {
+                    if (ch != '\n') return fail(BadRequest);
+                    m_lineCR = false;
+                    if (m_state == ChunkSize) parseChunkSize();
+                    else parseTrailer();
+                    m_line.clear();
+                } else if (ch == '\r') {
+                    m_lineCR = true;
+                } else {
+                    if (ch == '\n' || m_line.size() >= ChunkLineLimit) return fail(BadRequest);
+                    m_line.push_back(ch);
+                }
+            }
+        }
+        return m_result;
+    }
+
+    // EOF is never a body delimiter for requests. Empty idle EOF is harmless.
+    Result eof() { return m_result == More && m_input ? fail(BadRequest) : m_result; }
+
+private:
+    enum State { Headers, Fixed, ChunkSize, ChunkData, ChunkCR, ChunkLF, Trailers, Done, Failed };
+    HTTPLexer m_lexer;
+    HTTPPayload m_request;
+    std::string m_header, m_line;
+    State m_state;
+    Result m_result;
+    size_t m_remaining, m_metadata, m_trailers;
+    bool m_lineCR, m_input;
+
+    Result fail(Result value) { m_state = Failed; return m_result = value; }
+    void finish() { m_request.contentLength = m_request.content.size(); m_state = Done; m_result = Complete; }
+    static bool ows(char ch) { return ch == ' ' || ch == '\t'; }
+    static std::string trim(const std::string& text)
