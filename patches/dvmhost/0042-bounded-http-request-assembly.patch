+    }
+    static bool field(const std::string& line, std::string& name, std::string& value)
+    {
+        const size_t colon=line.find(':');
+        if (colon==std::string::npos || colon==0U) return false;
+        for (size_t i=0U;i<colon;++i) if (!token(static_cast<unsigned char>(line[i]))) return false;
