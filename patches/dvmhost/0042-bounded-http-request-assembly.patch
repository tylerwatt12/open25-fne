+        send();
+        if(large){readerDelay.expires_after(std::chrono::milliseconds(60));readerDelay.async_wait([&](asio::error_code ec){if(!ec){check(handler.requests.size()==1U,"pipelined handler ran before prior write completion");read();}});}
