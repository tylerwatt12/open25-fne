+    std::function<void()> read;
+    read=[&]{client.async_read_some(asio::buffer(buffer),[&](asio::error_code ec,size_t n){
+        result.replies.append(buffer.data(),n);
+        if(ec){deadline.cancel();delay.cancel();readerDelay.cancel();manager.stopAll();}
+        else read();
+    });};
+    size_t next=0U;
+    std::function<void()> send;
+    send=[&]{
