+    asio::ip::tcp::socket client(io),server(io);client.connect(listener.local_endpoint());listener.accept(server);listener.close();
+    using Connection=ServerConnection<WireHandler>;
+    return exchange<asio::ip::tcp::socket,Connection>(client,io,std::move(server),fragments,persistent,large,
+        [&](asio::ip::tcp::socket socket,ServerConnectionManager<std::shared_ptr<Connection>>& manager,WireHandler& handler){return std::make_shared<Connection>(std::move(socket),manager,handler,persistent);},
+        [&]{asio::error_code ignored;client.shutdown(asio::ip::tcp::socket::shutdown_send,ignored);},
+        [&](std::function<void()> ready){ready();});
+}
