+            fd_set fds;
+            FD_ZERO(&fds);
+            FD_SET(m_fd, &fds);
+            struct timeval timeout = {0, waiting ? static_cast<suseconds_t>(remaining) : 0};
+            const int ready = ::select(m_fd + 1, NULL, &fds, NULL, &timeout);
+            if (ready < 0 && errno != EINTR)
