+// Fill the real slave output queue without calling the API under test.
+size_t fillOutput(PTYUART& uart) {
+    std::array<uint8_t, 4096U> filler{};
+    size_t total = 0U;
+    for (unsigned i = 0U; i < 4096U; ++i) {
+        const ssize_t count = ::write(uart.descriptor(), filler.data(), filler.size());
+        if (count > 0) { total += size_t(count); continue; }
+        REQUIRE(count == -1);
+        REQUIRE((errno == EAGAIN || errno == EWOULDBLOCK));
+        fd_set fds; FD_ZERO(&fds); FD_SET(uart.descriptor(), &fds);
+        struct timeval timeout = {0, 0};
+        if (::select(uart.descriptor() + 1, nullptr, &fds, nullptr, &timeout) == 0)
+            return total;
+    }
+    FAIL("Could not fill bounded local PTY output queue");
+    return 0U;
+}
+
+std::vector<uint8_t> readExactMaster(LocalPTY& pty, size_t length) {
+    const int flags = ::fcntl(pty.master, F_GETFL, 0);
+    REQUIRE(flags != -1);
+    REQUIRE(::fcntl(pty.master, F_SETFL, flags | O_NONBLOCK) == 0);
+    std::vector<uint8_t> bytes(length);
+    size_t offset = 0U;
+    const auto deadline = Clock::now() + std::chrono::milliseconds(500);
+    while (offset < length && Clock::now() < deadline) {
+        const ssize_t count = ::read(pty.master, bytes.data() + offset, length - offset);
+        if (count > 0) offset += size_t(count);
+        else if (count == -1 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        else break;
+    }
+    REQUIRE(offset == length);
+    return bytes;
+}
