+TEST_CASE("Bounded UART waits for a transiently busy real PTY and writes once it recovers", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    REQUIRE(uart.boundedIO(true));
+    const size_t queued = fillOutput(uart);
+    REQUIRE(queued > 0U);
+    const std::array<uint8_t, 7U> marker{{0xFEU, 7U, 3U, 1U, 2U, 3U, 4U}};
+    auto drainer = std::async(std::launch::async, [&]() {
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        return readExactMaster(pty, queued);
+    });
+    const auto start = Clock::now();
+    const int written = uart.write(marker.data(), marker.size());
+    const auto elapsed = Clock::now() - start;
+    drainer.get();
+    REQUIRE(written == int(marker.size()));
+    REQUIRE(elapsed < std::chrono::milliseconds(200));
+    const auto received = readExactMaster(pty, marker.size());
+    REQUIRE(std::equal(marker.begin(), marker.end(), received.begin()));
+}
+
+TEST_CASE("Bounded UART returns zero when real PTY backpressure lasts past its single budget", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    REQUIRE(uart.boundedIO(true));
+    REQUIRE(fillOutput(uart) > 0U);
+    const std::array<uint8_t, 3U> marker{{0xFEU, 3U, 0U}};
+    const auto start = Clock::now();
+    REQUIRE(uart.write(marker.data(), marker.size()) == 0);
+    const auto elapsed = Clock::now() - start;
+    REQUIRE(elapsed >= std::chrono::milliseconds(15));
+    REQUIRE(elapsed < std::chrono::milliseconds(200));
+}
+
+TEST_CASE("Bounded UART returns its first partial write without duplicating a frame prefix", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    REQUIRE(uart.boundedIO(true));
+    std::vector<uint8_t> payload(1U << 20U);
+    for (size_t i = 0U; i < payload.size(); ++i) payload[i] = uint8_t(i % 251U);
+    const int written = uart.write(payload.data(), payload.size());
+    REQUIRE(written > 0);
+    REQUIRE(written < int(payload.size()));
+    const auto received = readExactMaster(pty, size_t(written));
+    REQUIRE(std::equal(received.begin(), received.end(), payload.begin()));
+    uint8_t extra = 0U;
+    REQUIRE(::read(pty.master, &extra, 1U) == -1);
+    REQUIRE((errno == EAGAIN || errno == EWOULDBLOCK));
+}
