+// SPDX-License-Identifier: GPL-2.0-only
+// Offline actual-method checks; the included fixture replaces device/thread
+// construction and captures UDP output. No modem, network peer or RF is used.
+#if defined(DVM_BRIDGE_OPAQUE_LIVENESS_STANDALONE)
+#define DVM_BRIDGE_OPAQUE_CONTINUITY_STANDALONE
+#include "BridgeOpaqueContinuity_Tests.cpp"
+
+namespace {
+class ChangingPeer : public TestPeer {
+public:
+    void stream(uint32_t value) { m_p25StreamId=value; }
+};
+struct LiveFixture {
+    std::string conf="offline-liveness";
+    ChangingPeer peer;
+    CapturingSocket output;
+    HostBridge bridge{conf};
+    LiveFixture() { bridge.m_network=&peer;bridge.m_udpAudioSocket=&output; }
+    uint32_t receivedStream=0x12345678,packetTime=0;uint16_t packetSequence=0;
+    network::P25PacketMetadata metadata(){packetTime+=1440;return {receivedStream,packetSequence++,packetTime};}
+    void stream(uint32_t value){receivedStream=value;packetSequence=0;}
+    void send(DUID::E duid,unsigned marker,uint8_t algorithm=0x80,uint16_t key=0) {
+        uint32_t n=0;auto p=peer.packet(n,LCO::GROUP,duid,marker,true,0,algorithm,key);
+        bridge.processOpaqueP25Network(p.get(),n,metadata());
+    }
+};
+}
+
+TEST_CASE("A replacement native stream terminates its previous opaque owner", "[opaque-receive-transition]") {
+    LiveFixture f;f.send(DUID::LDU1,1);
+    REQUIRE(f.output.packets.size()==9);
+    auto old=f.output.packets.front();
+    f.stream(0x87654321);
+    f.send(DUID::LDU1,2);
+    REQUIRE(f.output.packets.size()==19);
+    const auto& end=f.output.packets[9];
+    REQUIRE(end.size()==64);REQUIRE(read16(end.data()+10)==1);
+    REQUIRE(read64(end.data()+24)==10);
+    REQUIRE(std::memcmp(end.data()+32,old.data()+32,16)==0);
+    const auto& voice=f.output.packets[10];
+    REQUIRE(voice.size()==75);REQUIRE(read64(voice.data()+24)==1);
+    REQUIRE(std::memcmp(voice.data()+32,old.data()+32,16)!=0);
+}
+
+TEST_CASE("A terminator from a different source cannot retire the opaque receiver", "[opaque-receive-transition]") {
+    LiveFixture f;f.send(DUID::LDU1,1);
+    uint32_t n=0;auto p=f.peer.packet(n,LCO::GROUP,DUID::TDU,2);
+    p[5]=0;p[6]=0x27;p[7]=0x12; // A different valid source:10002.
+    f.bridge.processOpaqueP25Network(p.get(),n,f.metadata());
+    REQUIRE(f.output.packets.size()==9);
+    REQUIRE(f.bridge.m_callInProgress);
+    f.send(DUID::TDU,3);
+    REQUIRE(f.output.packets.size()==10);
+    REQUIRE(read16(f.output.packets.back().data()+10)==1);
+}
+
+TEST_CASE("Receive RTP counters wrap without accepting old or ambiguous packets", "[opaque-receive-transition]") {
+    LiveFixture f;
+    uint32_t n=0;auto packet=f.peer.packet(n,LCO::GROUP,DUID::LDU1,1);
+    f.bridge.processOpaqueP25Network(packet.get(),n,{101U,65534U,0xfffffff0U});
+    REQUIRE(f.output.packets.size()==9);
+    f.bridge.processOpaqueP25Network(packet.get(),n,{101U,0U,0x00000590U});
+    REQUIRE(f.output.packets.size()==18);
+    auto last=f.bridge.m_opaqueRxLastFrame;
+    for(auto stale:{network::P25PacketMetadata{101U,65534U,0xfffffff0U},
+                    network::P25PacketMetadata{101U,0x8000U,0x00000b30U},
+                    network::P25PacketMetadata{101U,1U,0x80000590U}}) {
+        f.bridge.processOpaqueP25Network(packet.get(),n,stale);
+        REQUIRE(f.output.packets.size()==18);
+        REQUIRE(f.bridge.m_opaqueRxLastFrame==last);
+    }
+    f.bridge.processOpaqueP25Network(packet.get(),n,{101U,1U,0x00000b30U});
+    REQUIRE(f.output.packets.size()==27);
+}
+
+#if !defined(DVM_OPAQUE_LIVENESS_NEGATIVE_ONLY)
