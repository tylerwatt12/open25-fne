+    auto at=f.bridge.m_opaqueRxLastFrame;
+    f.bridge.clockOpaqueP25Receive(at+std::chrono::milliseconds(99));
+    REQUIRE(f.output.packets.size()==9);
+    for(unsigned i=1;i<=2;i++) {
+        f.bridge.clockOpaqueP25Receive(at+std::chrono::milliseconds(100*i));
+        const auto& p=f.output.packets.back();
+        REQUIRE(p.size()==64);REQUIRE(p[4]==17);REQUIRE(p[7]==0);
+        REQUIRE(read16(p.data()+10)==0);REQUIRE(read16(p.data()+58)==0);
+        REQUIRE(read32(p.data()+20)==1500-100*i);
+        REQUIRE(read64(p.data()+24)==i);REQUIRE(read64(p.data()+48)==9);
+        REQUIRE(std::memcmp(p.data()+32,first.data()+32,16)==0);
+    }
+    f.send(DUID::LDU2,2);
+    REQUIRE(f.output.packets.size()==20);
+    for(unsigned i=0;i<9;i++) {
+        const auto& p=f.output.packets[11+i];
+        REQUIRE(p.size()==75);REQUIRE(read64(p.data()+24)==10+i);
+        auto expected=TestPeer::expected(2,i);
+        REQUIRE(std::equal(expected.begin(),expected.end(),p.begin()+64));
+    }
+    auto last=f.bridge.m_opaqueRxLastFrame;
+    f.bridge.clockOpaqueP25Receive(last+std::chrono::milliseconds(1400));
+    REQUIRE(read32(f.output.packets.back().data()+20)==100);
+    f.bridge.clockOpaqueP25Receive(last+std::chrono::milliseconds(1500));
+    const auto& end=f.output.packets.back();
+    REQUIRE(end.size()==64);REQUIRE(end[4]==16);REQUIRE(read16(end.data()+10)==1);
+    REQUIRE(read64(end.data()+24)==19);
+    REQUIRE_FALSE(f.bridge.m_callInProgress);
+    const auto size=f.output.packets.size();
