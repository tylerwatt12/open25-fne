+TEST_CASE("Real FNE ingress preserves each packet owner across queued replacement and late End", "[opaque-receive-ingress]") {
+    WireReceiveFixture f;
+    // Queue all packets before reading. Ending A must not clear queued B or
+    // use a global current/TX stream value for any of the queued packets.
+    f.peer.ingest(f.voice(101,0));f.peer.ingest(f.terminal(101));f.peer.ingest(f.voice(202,0,2));
