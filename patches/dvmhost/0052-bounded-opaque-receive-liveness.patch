+// Activity describes native receive liveness only. It never carries IMBE,
+// increments the voice sequence, or refreshes the last real LDU deadline.
+void HostBridge::clockOpaqueP25Receive(std::chrono::steady_clock::time_point now)
+{
+    std::lock_guard<std::mutex> lock(m_opaqueRxMutex);
+    if (m_opaqueRxLastFrame==std::chrono::steady_clock::time_point()) return;
+    if (m_trafficFromUDP) {endOpaqueP25Receive(true);return;}
+    const auto deadline=m_opaqueRxLastFrame+std::chrono::milliseconds(1500);
+    if (now>=deadline) { endOpaqueP25Receive(false);return; }
+    if (!m_opaqueRxSequence || now<m_opaqueRxNextActivity) return;
+    uint8_t packet[packetHeader]{};
+    std::memcpy(packet,m_opaqueRxVoiceHeader,packetHeader);
+    packet[4]=17;packet[7]=0;
+    write16(packet+10,0);write16(packet+58,0);
+    const auto remaining=std::chrono::duration_cast<std::chrono::milliseconds>(deadline-now).count();
+    if (remaining<=0) { endOpaqueP25Receive(false);return; }
+    write32(packet+20,uint32_t(remaining));
+    write64(packet+24,++m_opaqueRxControlSequence);
+    std::memset(packet+48,0,9);
+    write64(packet+48,m_opaqueRxSequence);
+    sockaddr_storage address;uint32_t addressLength;
+    if (network::udp::Socket::lookup(m_udpSendAddress,m_udpSendPort,address,addressLength)==0)
+        m_udpAudioSocket->write(packet,packetHeader,address,addressLength);
+    m_opaqueRxNextActivity=now+std::chrono::milliseconds(100);
+}
