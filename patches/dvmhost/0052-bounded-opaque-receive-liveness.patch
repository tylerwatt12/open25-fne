+#include "common/p25/lc/tdulc/LC_CALL_TERM.h"
+namespace {
+class OpaqueWirePeer : public network::PeerNetwork {
+public:
+    OpaqueWireSocket* wire;
+    OpaqueWirePeer(uint32_t peer=12345U,bool promiscuous=false):PeerNetwork("127.0.0.1",49991U,0U,peer,"offline-private-wire",true,false,false,true,false,false,false,false,false,false,false,false) {
+        delete m_frameQueue;delete m_socket;
+        wire=new OpaqueWireSocket();m_socket=wire;
+        m_frameQueue=new network::FrameQueue(wire,peer,false);
+        network::udp::Socket::lookup("127.0.0.1",49991U,m_addr,m_addrLen);
+        wire->source=m_addr;wire->sourceLength=m_addrLen;
+        m_status=network::NET_STAT_RUNNING;m_enabled=true;m_promiscuousPeer=promiscuous;
+    }
+    void ingest(const std::vector<uint8_t>& packet){wire->incoming.push_back(packet);clock(0U);}
+    std::vector<uint8_t> frame(const uint8_t* body,uint32_t length,uint32_t stream,uint16_t sequence) {
+        OpaqueWireSocket output;network::FrameQueue sender(&output,m_peerId,false);
+        REQUIRE(sender.write(body,length,stream,m_peerId,m_peerId,{network::NET_FUNC::PROTOCOL,network::NET_SUBFUNC::PROTOCOL_SUBFUNC_P25},sequence,m_addr,m_addrLen));
+        return output.outgoing.back();
+    }
