+// Callers hold the receive mutex. Terminal packets keep the last exported
+// voice profile, including when LDU2 has already announced the next key/MI.
+void HostBridge::endOpaqueP25Receive(bool terminal)
+{
+    if (m_opaqueRxSequence) {
+        uint8_t packet[packetHeader]{};
+        std::memcpy(packet,m_opaqueRxVoiceHeader,packetHeader);
+        packet[7]=0;write16(packet+10,1);write16(packet+58,0);
+        write64(packet+24,++m_opaqueRxSequence);
+        sockaddr_storage address;uint32_t addressLength;
+        if (network::udp::Socket::lookup(m_udpSendAddress,m_udpSendPort,address,addressLength)==0)
+            m_udpAudioSocket->write(packet,packetHeader,address,addressLength);
+    }
+    if(m_rxStreamId!=0U) {
+        if(m_opaqueRxRetired.find(m_rxStreamId)==m_opaqueRxRetired.end())m_opaqueRxRetiredOrder.push_back(m_rxStreamId);
+        m_opaqueRxRetired[m_rxStreamId]=OpaqueRetiredOwner{m_opaqueRxReceived,m_opaqueRxSource,terminal};
+        if(m_opaqueRxRetiredOrder.size()>64U){m_opaqueRxRetired.erase(m_opaqueRxRetiredOrder.front());m_opaqueRxRetiredOrder.pop_front();}
+        if(m_network!=nullptr)m_network->retireP25Receive(m_rxStreamId);
+    }
+    m_opaqueRxSequence=0;m_opaqueRxControlSequence=0;m_opaqueRxAlgorithm=0;
+    m_opaqueRxLastFrame={};m_opaqueRxNextActivity={};
+    std::memset(m_opaqueRxVoiceHeader,0,packetHeader);
+    m_rxStreamId=0;
+    if (!m_trafficFromUDP) m_callInProgress=false;
+    m_networkWatchdog.stop();
+
+}
