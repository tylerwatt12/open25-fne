+// SPDX-License-Identifier: GPL-2.0-only
+// Offline socket boundary. Framing, CRC parsing, peer filtering and P25
+// packet queue methods remain production code; no socket is opened.
+#pragma once
+#include "common/network/Network.h"
+#include "common/network/FrameQueue.h"
+#include <algorithm>
+#include <cstring>
+#include <deque>
+#include <stdexcept>
+#include <vector>
+
+class OpaqueWireSocket : public network::udp::Socket {
+public:
+    std::deque<std::vector<uint8_t>> incoming;
+    std::vector<std::vector<uint8_t>> outgoing;
+    sockaddr_storage source{};
+    uint32_t sourceLength=0;
+    OpaqueWireSocket():Socket(0U){}
+    ssize_t read(uint8_t* out,uint32_t size,sockaddr_storage& address,uint32_t& length) noexcept override {
+        if(incoming.empty())return 0;
+        auto packet=std::move(incoming.front());incoming.pop_front();
+        if(packet.size()>size)return -1;
+        address=source;length=sourceLength;std::memcpy(out,packet.data(),packet.size());return packet.size();
+    }
+    bool write(const uint8_t* packet,uint32_t length,const sockaddr_storage&,uint32_t,ssize_t* written=nullptr) noexcept override {
+        outgoing.emplace_back(packet,packet+length);if(written!=nullptr)*written=length;return true;
+    }
+};
+
+class OpaqueWireNetwork : public network::Network {
+public:
+    OpaqueWireSocket* wire;
+    OpaqueWireNetwork(uint32_t peer=12345U,bool promiscuous=false):Network("127.0.0.1",49991U,0U,peer,"offline-private-wire",true,false,false,true,false,false,false,false,false,false,false,false) {
+        delete m_frameQueue;delete m_socket;
+        wire=new OpaqueWireSocket();m_socket=wire;
+        m_frameQueue=new network::FrameQueue(wire,peer,false);
+        network::udp::Socket::lookup("127.0.0.1",49991U,m_addr,m_addrLen);
+        wire->source=m_addr;wire->sourceLength=m_addrLen;
+        m_status=network::NET_STAT_RUNNING;m_enabled=true;m_promiscuousPeer=promiscuous;
+    }
+    void ingest(const std::vector<uint8_t>& packet){wire->incoming.push_back(packet);clock(0U);}
+    std::vector<uint8_t> frame(const uint8_t* body,uint32_t length,uint32_t stream,uint16_t sequence) {
+        OpaqueWireSocket output;
+        network::FrameQueue sender(&output,m_peerId,false);
+        if(!sender.write(body,length,stream,m_peerId,m_peerId,{network::NET_FUNC::PROTOCOL,network::NET_SUBFUNC::PROTOCOL_SUBFUNC_P25},sequence,m_addr,m_addrLen))throw std::runtime_error("offline framing failed");
+        return output.outgoing.back();
+    }
+    uint32_t receivedFilter()const{return m_rxP25StreamId.load();}
+    uint32_t chargedBytes()const{std::lock_guard<std::mutex> lock(m_rxP25Mutex);return m_rxP25Bytes;}
+    using network::BaseNetwork::createP25_LDU1Message;
+    using network::BaseNetwork::createP25_TDUMessage;
+};
+
+// Defined beside ControllerFixture so this invokes the actual RF control
+// writer and inherited network serializers, not a copied packet layout.
+std::vector<std::vector<uint8_t>> opaqueActualProducerDatagrams();
