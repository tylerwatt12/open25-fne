+// AABC-E2.1/PDF25 printed6 and Figures4.2.1-1/-2/PDF58-59 printed39-40.
+// Real dispatch queue owner, correlated permit callback and queued serializers.
+TEST_CASE("local Dispatch group grant owns standard MFID in abbreviated and explicit output", "[dispatch-grant][control-profile][mfid][local-origin-mfid]") {
+    using namespace p25::defines;
+    for (uint8_t previous : {0U,1U,0x90U,0x9CU}) for (bool explicitChannel : {false,true}) for (bool secure : {false,true}) {
+        CAPTURE(previous,explicitChannel,secure); Fixture f;
+        if (explicitChannel) f.channels.setRFChData(VC,::lookups::VoiceChData(2U,VC,3U,VC+1U,"127.0.0.1",48993U,"offline-test"));
+        f.control->control()->setLastMFId(previous);
+        auto request=f.request(); request.secure=secure;
+        const auto result=f.run(request);
+        REQUIRE(result.accepted); REQUIRE(result.issued); REQUIRE(result.channelId==2U); REQUIRE(result.channelNo==VC);
+        REQUIRE(f.rpc.permits==1U); REQUIRE(f.control->affiliations()->ownsGrant(TG,RID,VC,result.epoch));
+        unsigned packets=0U, preludes=0U, nulls=0U; std::array<uint8_t,1024U> queued{};
+        while (const auto length=f.control->getFrame(queued.data())) {
+            // The existing PDU writer surrounds one packet with three TDUs
+            // and five all-zero null records; validate them separately.
+            if (explicitChannel && length==27U && queued[0]==modem::TAG_EOT &&
+                std::all_of(queued.begin()+2U,queued.begin()+length,[](uint8_t byte) { return byte==0U; })) { ++nulls; continue; }
+            p25::NID nid(0x293U); REQUIRE(nid.decode(queued.data()+2U));
+            if (explicitChannel && nid.getDUID()==DUID::TDU) { ++preludes; continue; }
+            REQUIRE(nid.getDUID()==(explicitChannel?DUID::PDU:DUID::TSDU)); ++packets;
+            std::array<uint8_t,25U> coded{}; std::array<uint8_t,12U> raw{}; edac::Trellis trellis;
+            if (!explicitChannel) {
+                p25::P25Utils::decode(queued.data()+2U,coded.data(),114U,318U);
+                REQUIRE(trellis.decode12(coded.data(),raw.data())); REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size())); CAPTURE(raw);
+                const std::array<uint8_t,10U> expected{{0x80U,0x00U,uint8_t(secure?0x44U:0x04U),0x20U,0x19U,0x03U,0xE9U,0x00U,0x27U,0x12U}};
+                for (size_t i=0U;i<expected.size();++i) CHECK(raw[i]==expected[i]);
+            } else {
+                std::array<uint8_t,512U> plain{}; p25::P25Utils::decode(queued.data()+2U,plain.data(),0U,(length-2U)*8U);
+                Utils::getBitRange(plain.data(),coded.data(),112U,196U);
+                REQUIRE(trellis.decode12(coded.data(),raw.data())); REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size())); CAPTURE(raw);
+                const std::array<uint8_t,10U> expected{{0x37U,0xFDU,0x00U,0x00U,0x27U,0x12U,0x81U,0x00U,uint8_t(secure?0x44U:0x04U),0x00U}};
+                for (size_t i=0U;i<expected.size();++i) CHECK(raw[i]==expected[i]);
+                Utils::getBitRange(plain.data(),coded.data(),308U,196U);
+                REQUIRE(trellis.decode12(coded.data(),raw.data())); REQUIRE(edac::CRC::checkCRC32(raw.data(),raw.size()));
+                const std::array<uint8_t,8U> body{{0x00U,0x00U,0x20U,0x19U,0x30U,0x1AU,0x03U,0xE9U}};
+                for (size_t i=0U;i<body.size();++i) CHECK(raw[i]==body[i]);
+            }
+        }
+        REQUIRE(packets==1U); REQUIRE(preludes==(explicitChannel?3U:0U)); REQUIRE(nulls==(explicitChannel?5U:0U)); CHECK(p25::DispatchGrantTestAccess::lastMFID(*f.control)==previous);
+    }
+}
