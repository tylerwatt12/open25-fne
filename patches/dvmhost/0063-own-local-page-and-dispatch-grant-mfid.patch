+TEST_CASE("RF group grants retain the admitted profile through immediate and deferred ownership", "[dispatch-grant][control-profile][mfid][mfid-relay-preservation]") {
+    using namespace p25::defines;
+    for (uint8_t profile : {0U,1U,0x90U}) for (bool deferred : {false,true}) {
+        CAPTURE(profile,deferred); Fixture f;
+        if (deferred) p25::DispatchGrantTestAccess::allStart(*f.control,TG);
+        std::array<uint8_t,P25_TSDU_FRAME_LENGTH_BYTES+2U> input{}; input[0]=modem::TAG_DATA; input[1]=1U;
+        p25::lc::tsbk::IOSP_GRP_VCH request; request.setMFId(profile); request.setSrcId(10001U); request.setDstId(TG); request.setPriority(4U);
+        request.encode(input.data()+2U,false,false); p25::Sync::addP25Sync(input.data()+2U);
+        p25::NID nid(0x293U); nid.encode(input.data()+2U,DUID::TSDU);
+        p25::P25Utils::addStatusBits(input.data()+2U,P25_TSDU_FRAME_LENGTH_BITS,false,false);
+        REQUIRE(f.control->processFrame(input.data(),input.size()));
+        if (deferred) {
+            REQUIRE(f.rpc.permits==0U); const auto pending=f.control->rfAdmissions(); REQUIRE(pending.size()==1U); REQUIRE(pending[0].state=="pending"); f.drain();
+            f.control->control()->setLastMFId(0x9CU); // A different transaction arrives before Zone approval.
+            REQUIRE(f.control->decideRFAdmission(pending[0].id,pending[0].epoch,true).state=="approved");
+            p25::DispatchGrantTestAccess::run(*f.control);
+            REQUIRE(f.control->rfAdmissions()[0].state=="committed");
+        }
+        REQUIRE(f.rpc.permits==1U); unsigned packets=0U; std::array<uint8_t,1024U> queued{};
+        while (f.control->getFrame(queued.data())) {
+            ++packets; REQUIRE(nid.decode(queued.data()+2U)); REQUIRE(nid.getDUID()==DUID::TSDU);
+            std::array<uint8_t,25U> coded{}; std::array<uint8_t,12U> raw{}; edac::Trellis trellis;
+            p25::P25Utils::decode(queued.data()+2U,coded.data(),114U,318U); REQUIRE(trellis.decode12(coded.data(),raw.data())); REQUIRE(edac::CRC::checkCCITT162(raw.data(),raw.size())); CAPTURE(raw);
+            const std::array<uint8_t,10U> expected{{0x80U,profile,0x04U,0x20U,0x19U,0x03U,0xE9U,0x00U,0x27U,0x11U}};
+            for (size_t i=0U;i<expected.size();++i) CHECK(raw[i]==expected[i]);
+        }
+        REQUIRE(packets==1U); CHECK(p25::DispatchGrantTestAccess::lastMFID(*f.control)==(deferred?0x9CU:profile));
+    }
+}
