+
+// Normative oracle: AABD-B 6.7.2.1(d/e), PDF62 printed57; AABC-E
+// 6.2.8.1/Figure6.2.8-1, PDF165 printed146. GAV bits1..0:
+// 00=accept,10=deny Site,11=refused system. See affiliation-directory.md.
+TEST_CASE("affiliation distinguishes system-invalid from Site-excluded groups", "[p25][subscriber-access][affiliation-directory]") {
+    for (unsigned scenario = 0; scenario != 5; ++scenario) {
+        DYNAMIC_SECTION("directory scenario " << scenario) {
+            Fixture f(true);
+            f.controller->affiliations()->groupAff(RID, 1002U);
+            uint32_t target = TG;
+            uint8_t expected = 0U;
+            if (scenario != 0U) {
+                auto rule = f.groups.find(TG);
+                auto config = rule.config();
+                config.active(false);
+                config.systemValid(scenario == 1U);
+                // An invalid-system result cannot be overwritten by a Site rule.
+                config.nonPreferred(scenario == 4U);
+                rule.config(config); f.groups.addEntry(rule);
+                expected = scenario == 1U ? 2U : 3U;
+                if (scenario == 3U) target = 3001U; // absent system directory entry
+            }
+            const bool local = scenario == 0U;
+            REQUIRE(acl::AccessControl::validateTGId(target) == local);
+            REQUIRE(acl::AccessControl::validateSystemTGId(target) == (scenario < 2U));
+            // Literal request fields: system1, targetWGID, source10001.
+            f.signal(0x28U, (uint64_t(1U)<<40U)|(uint64_t(target)<<24U)|RID);
+            auto replies = f.responses(); unsigned count = 0U;
+            REQUIRE(replies.size() == 1U); // no spurious full-registration demand
+            for (auto& response : replies) if ((response[0]&0x3fU)==0x28U) {
+                ++count;
+                REQUIRE((response[2]&3U)==expected);
+                REQUIRE(((uint32_t(response[5])<<8U)|response[6])==target);
+                REQUIRE(((uint32_t(response[7])<<16U)|(uint32_t(response[8])<<8U)|response[9])==RID);
+            }
+            REQUIRE(count == 1U);
+            REQUIRE(f.controller->affiliations()->isUnitReg(RID));
+            REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,1002U));
+            REQUIRE(f.controller->affiliations()->isGroupAff(RID,target)==local);
+            REQUIRE(acl::AccessControl::validateGroupAffiliation(RID,target)==local);
+            REQUIRE(acl::AccessControl::validateGroupTransmit(RID,target)==local);
+            if (!local) {
+                f.signal(0x00U,(uint64_t(4U)<<56U)|(uint64_t(target)<<24U)|RID);
+                REQUIRE(f.controller->affiliations()->grantSize()==0U);
+                bool denied=false;
+                for(auto& response : f.responses()) if((response[0]&0x3fU)==0x27U) denied=true;
+                REQUIRE(denied);
+            }
+        }
+    }
+}
+TEST_CASE("classification-only system validity survives native YAML copies without granting access", "[p25][affiliation-directory]") {
+    auto rule=policy(true,{RID},true,{RID}); auto config=rule.config();
+    config.active(false); config.systemValid(true); rule.config(config);
+    yaml::Node saved; rule.getYaml(saved); ::lookups::TalkgroupRuleGroupVoice restored(saved);
+    REQUIRE(restored.config().systemValid()); REQUIRE(restored.config().validOnSystem());
+    REQUIRE_FALSE(restored.config().active());
+    Fixture f(true); f.groups.addEntry(restored);
+    REQUIRE(acl::AccessControl::validateSystemTGId(TG));
+    REQUIRE_FALSE(acl::AccessControl::validateTGId(TG));
+    REQUIRE_FALSE(acl::AccessControl::validateGroupAffiliation(RID,TG));
+    REQUIRE_FALSE(acl::AccessControl::validateGroupTransmit(RID,TG));
+}
