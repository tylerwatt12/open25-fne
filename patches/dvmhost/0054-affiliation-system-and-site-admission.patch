+/* Global directory validity does not grant Site service admission. */
+
+bool AccessControl::validateSystemTGId(uint32_t id)
+{
+    if (id == 0U) return false;
+    if (!s_tidLookup->getACL()) return true;
+    const auto rule = s_tidLookup->find(id);
+    return !rule.isInvalid() && rule.config().validOnSystem();
 }
 
