+TEST_CASE("status closure queue lock wait cannot extend the original response fence", "[p25][status-query][status-closure]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    REQUIRE(signal->requestStatusQuery(RID,0U));StatusQueryTestAccess::clock(*f.controller);f.responses();
+    const auto deadline=StatusQueryTestAccess::deadlineAfter(*f.controller,RID,std::chrono::milliseconds(250));
+    auto queue=StatusQueryTestAccess::holdQueue();
+    auto response=std::async(std::launch::async,[&]{return f.signal(0x19U,0x0000FFFFFC002711ULL);});
+    const auto ownedBy=std::chrono::steady_clock::now()+std::chrono::milliseconds(200);
+    while(!StatusQueryTestAccess::statusMutexHeld(*f.controller)&&std::chrono::steady_clock::now()<ownedBy)std::this_thread::yield();
+    const bool blocked=StatusQueryTestAccess::statusMutexHeld(*f.controller);
+    std::this_thread::sleep_until(deadline+std::chrono::milliseconds(10));queue.unlock();
+    REQUIRE(response.get());REQUIRE(blocked);
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Reported);REQUIRE(f.responses().empty());
+    REQUIRE(diagnosticLog().str().find("response closure not queued")!=std::string::npos);
+}
