+        {0x0000U, 0x00U, Block{{0x98U,0x00U,0x00U,0x00U,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0x86U,0x18U}}},
+        {0x0000U, 0x01U, Block{{0x98U,0x00U,0x00U,0x00U,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0x86U,0x18U}}},
+        {0x0102U, 0x00U, Block{{0x98U,0x00U,0x01U,0x02U,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0xA1U,0x28U}}},
+        {0x0102U, 0x01U, Block{{0x98U,0x00U,0x01U,0x02U,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0xA1U,0x28U}}},
+        {0xFFFFU, 0x00U, Block{{0x98U,0x00U,0xFFU,0xFFU,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0xB7U,0x26U}}},
+        {0xFFFFU, 0x01U, Block{{0x98U,0x00U,0xFFU,0xFFU,0xFFU,0xFFU,0xFCU,0x00U,0x27U,0x11U,0xB7U,0x26U}}},
+    }};
+    for(const auto& v:vectors)for(const auto prior:{0x90U,0x9CU}) {
+      DYNAMIC_SECTION("status "<<v.status<<" MFID "<<unsigned(v.mfid)<<" prior "<<prior) {
+        Fixture f(true);auto* signal=f.controller->control();
+        signal->setLastMFId(prior);StatusQueryTestAccess::redundant(*f.controller);
+        REQUIRE(signal->requestStatusQuery(RID,0U));StatusQueryTestAccess::clock(*f.controller);f.responses();
+        REQUIRE(StatusQueryTestAccess::lastMFId(*f.controller)==prior);
+        const uint64_t response=(uint64_t(v.status)<<48U)|0xFFFFFC002711ULL;
+        REQUIRE(f.signal(0x19U,response,v.mfid));
