+TEST_CASE("completed status fences reject changed or unmatched reports", "[p25][status-query][status-closure]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    const uint64_t response=0x0102FFFFFC002711ULL;
+    REQUIRE_FALSE(f.signal(0x19U,response));REQUIRE(f.responses().empty());
+    REQUIRE(signal->requestStatusQuery(RID,0U));StatusQueryTestAccess::clock(*f.controller);f.responses();
+    REQUIRE(f.signal(0x19U,response));REQUIRE(f.responses().size()==1U);
+    REQUIRE_FALSE(f.signal(0x19U,0x0103FFFFFC002711ULL)); // changed status
+    REQUIRE_FALSE(f.signal(0x19U,0x0102002712002711ULL)); // wrong FNE
+    REQUIRE_FALSE(f.signal(0x19U,0x0102FFFFFC002717ULL)); // another subscriber
+    for(const auto mfid:{1U,0x90U,0x9CU,0xA4U})REQUIRE_FALSE(f.signal(0x19U,response,mfid));
+    REQUIRE_FALSE(f.signal(0x19U,response,0U,true)); // bad CRC with intact channel coding
+    REQUIRE(f.responses().empty());REQUIRE(signal->statusQueryState(RID)==QueryState::Reported);
+}
