+TEST_CASE("completed status closures are owned and withdrawn by current control fences", "[p25][status-query][status-closure]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    REQUIRE(signal->requestStatusQuery(RID,0U));StatusQueryTestAccess::clock(*f.controller);f.responses();
+    REQUIRE(f.signal(0x19U,0x0000FFFFFC002711ULL));REQUIRE(f.controller->peekFrameLength()>0U);
+    SECTION("stop and restart") { f.controller->setCCRunning(false);f.controller->setCCRunning(true); }
+    SECTION("halt and resume") { f.controller->setCCHalted(true);f.controller->setCCHalted(false); }
+    SECTION("registration revoked on protocol owner") { f.controller->affiliations()->unitDereg(RID);StatusQueryTestAccess::clock(*f.controller); }
+    SECTION("subscriber disabled before handoff") { f.radios.addEntry(RID,false,"Disabled"); }
+    SECTION("inhibition before handoff") { StatusQueryTestAccess::inhibit(*f.controller,RID); }
+    REQUIRE(f.responses().empty());
+    REQUIRE_FALSE(f.signal(0x19U,0x0000FFFFFC002711ULL));
+    for(const auto& block:f.responses())REQUIRE((block[0]&0x3FU)!=0x18U); // existing denial policy is separate
+    REQUIRE(signal->statusQueryState(RID)==QueryState::Reported);
+}
