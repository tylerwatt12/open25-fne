+    const auto filler=f.responses();REQUIRE(filler.size()==1U);REQUIRE((filler[0][0]&0x3FU)==0x1AU);
+    const auto completedLog=diagnosticLog().str();
+    REQUIRE(f.signal(0x19U,0x0000FFFFFC002711ULL));
+    const auto closure=f.responses();REQUIRE(closure.size()==1U);REQUIRE((closure[0][0]&0x3FU)==0x18U);
+    REQUIRE(diagnosticLog().str()==completedLog);REQUIRE(signal->statusQueryState(RID)==QueryState::Reported);
+}
