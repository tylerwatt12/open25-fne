diff --git a/src/host/p25/Dispatch.h b/src/host/p25/Dispatch.h
new file mode 100644
index 0000000..9a475bc
--- /dev/null
+++ b/src/host/p25/Dispatch.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private authenticated dispatch allocation contract; no media or modem I/O. */
+#ifndef __P25_DISPATCH_H__
+#define __P25_DISPATCH_H__
+#include <atomic>
+#include <cstdint>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace p25 {
+enum class DispatchAction { Grant, Renew, Release, Status };
+struct DispatchRequest {
+    DispatchAction action = DispatchAction::Status;
+    uint32_t srcId = 0U, dstId = 0U, ttlMs = 1000U;
+    std::string leaseId;
+    uint64_t epoch = 0U;
+};
+struct DispatchResult {
+    int status = 409;
+    bool accepted = false, issued = false;
+    std::string state = "rejected", message, leaseId;
+    uint32_t srcId = 0U, dstId = 0U, channelId = 0U, channelNo = 0U, expiresInMs = 0U;
+    uint64_t epoch = 0U;
+};
+struct DispatchOperation {
+    enum Phase { Queued, Executing, Committed, Finished, Cancelled };
+    DispatchRequest request;
+    std::atomic<int> phase{Queued};
+    std::chrono::steady_clock::time_point deadline;
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool done = false;
+    DispatchResult result;
+};
+}
+#endif
