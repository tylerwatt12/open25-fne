+/* Private dispatch endpoints enqueue work; they never write a modem directly. */
+void RESTAPI::restAPI_PutDispatchGrant(const HTTPPayload& req, HTTPPayload& rep, const RequestMatch&) { restAPI_Dispatch(req, rep, p25::DispatchAction::Grant); }
+void RESTAPI::restAPI_PutDispatchRenew(const HTTPPayload& req, HTTPPayload& rep, const RequestMatch&) { restAPI_Dispatch(req, rep, p25::DispatchAction::Renew); }
+void RESTAPI::restAPI_PutDispatchRelease(const HTTPPayload& req, HTTPPayload& rep, const RequestMatch&) { restAPI_Dispatch(req, rep, p25::DispatchAction::Release); }
+void RESTAPI::restAPI_DispatchStatus(const HTTPPayload& req, HTTPPayload& rep, const RequestMatch&) { restAPI_Dispatch(req, rep, p25::DispatchAction::Status); }
+
+void RESTAPI::restAPI_Dispatch(const HTTPPayload& request, HTTPPayload& reply, p25::DispatchAction action)
+{
+    // Legacy errorPayload defaults its transport status to 200. This private
+    // contract must never present an auth/parse/rejection error as HTTP success.
+    struct DispatchReplyGuard {
+        HTTPPayload& reply;
+        ~DispatchReplyGuard() {
+            json::value decoded;
+            if (!json::parse(decoded, reply.content).empty() || !decoded.is<json::object>()) return;
+            auto body = decoded.get<json::object>();
+            if (!body["status"].is<int>() || body["status"].get<int>() < 400) return;
+            const bool rejected = false;
+            if (!body["accepted"].is<bool>()) body["accepted"].set<bool>(rejected);
+            if (!body["issued"].is<bool>()) body["issued"].set<bool>(rejected);
+            if (!body["state"].is<std::string>()) body["state"].set<std::string>("rejected");
+            HTTPPayload::StatusType status = HTTPPayload::SERVICE_UNAVAILABLE;
+            const int code = body["status"].get<int>();
+            if (code == 400) status = HTTPPayload::BAD_REQUEST;
+            else if (code == 401) status = HTTPPayload::UNAUTHORIZED;
+            else if (code == 403) status = HTTPPayload::FORBIDDEN;
+            else if (code == 404) status = HTTPPayload::NOT_FOUND;
+            reply.payload(body, status);
+        }
+    } replyGuard{reply};
+    if (!validateAuth(request, reply)) return;
+    if (m_p25 == nullptr) { errorPayload(reply, "P25 is unavailable", HTTPPayload::SERVICE_UNAVAILABLE); return; }
+    p25::DispatchRequest input; input.action = action;
+    if (action != p25::DispatchAction::Status || !request.content.empty()) {
+        json::object body;
+        if (!parseRequestBody(request, reply, body)) return;
+        const auto integer = [&](const char* key, uint32_t minimum, uint32_t maximum, uint32_t& value) {
+            // Parsed JSON numbers are double. get<int>() mutates this pinned
+            // library's type, so validate once before a checked conversion.
+            if (!body[key].is<double>()) return false;
+            const double number = body[key].get<double>();
+            if (!std::isfinite(number) || number < minimum || number > maximum || std::floor(number) != number) return false;
+            value = static_cast<uint32_t>(number); return true;
+        };
+        if (!integer("srcId", 1U, 0xFFFFFBU, input.srcId) || !integer("dstId", 1U, 0xFFFEU, input.dstId) ||
+            !body["leaseId"].is<std::string>()) {
+            errorPayload(reply, "valid srcId, dstId and leaseId are required"); return;
+        }
+        input.leaseId = body["leaseId"].get<std::string>();
+        if (action == p25::DispatchAction::Grant || action == p25::DispatchAction::Renew) {
+            if (!integer("ttlMs", 250U, 2000U, input.ttlMs)) {
+                errorPayload(reply, "ttlMs must be 250-2000"); return;
+            }
+        }
+        if (action == p25::DispatchAction::Renew || action == p25::DispatchAction::Release) {
+            if (!body["epoch"].is<std::string>()) { errorPayload(reply, "epoch must be a decimal string"); return; }
+            const auto epoch = body["epoch"].get<std::string>();
+            if (epoch.empty() || epoch.size() > 20U || !std::all_of(epoch.begin(), epoch.end(), [](char c) { return c >= '0' && c <= '9'; })) {
+                errorPayload(reply, "epoch must be a decimal string"); return;
+            }
+            try { input.epoch = std::stoull(epoch); }
+            catch (const std::exception&) { errorPayload(reply, "epoch is out of range"); return; }
+        }
+    }
+    const auto result = m_p25->dispatch(input);
+    json::object body;
+    body["status"].set<int>(result.status);
+    body["accepted"].set<bool>(result.accepted); body["issued"].set<bool>(result.issued);
+    body["state"].set<std::string>(result.state); body["message"].set<std::string>(result.message);
+    body["leaseId"].set<std::string>(result.leaseId);
+    body["srcId"].set<uint32_t>(result.srcId); body["dstId"].set<uint32_t>(result.dstId);
+    body["channelId"].set<uint32_t>(result.channelId); body["channelNo"].set<uint32_t>(result.channelNo);
+    body["epoch"].set<std::string>(std::to_string(result.epoch));
+    body["expiresInMs"].set<uint32_t>(result.expiresInMs);
+    // The pinned HTTP serializer supports a limited status set. Every rejected
+    // result is non-200; the precise native reason/status remains in JSON.
+    HTTPPayload::StatusType status = HTTPPayload::SERVICE_UNAVAILABLE;
+    if (result.status == 200) status = HTTPPayload::OK;
+    else if (result.status == 400) status = HTTPPayload::BAD_REQUEST;
+    else if (result.status == 403) status = HTTPPayload::FORBIDDEN;
+    else if (result.status == 404) status = HTTPPayload::NOT_FOUND;
+    reply.payload(body, status);
+}
