diff --git a/tests/p25/DispatchGrant_Tests.cpp b/tests/p25/DispatchGrant_Tests.cpp
new file mode 100644
index 0000000..5052899
--- /dev/null
+++ b/tests/p25/DispatchGrant_Tests.cpp
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Actual allocator and RPC contract tests. No sockets, modem or RF is opened. */
+#include "host/Host.h"
+#include "host/p25/Control.h"
+#include "host/modem/port/ModemNullPort.h"
+#include "host/network/RPCDefines.h"
+#include "common/Log.h"
+#include <catch2/catch_test_macros.hpp>
+#include <future>
+#include <thread>
+#include <functional>
+
+namespace p25 {
+struct DispatchGrantTestAccess {
+    static bool queued(Control& c) { std::lock_guard<std::mutex> lock(c.m_dispatchQueueMutex); return !c.m_dispatchQueue.empty(); }
+    static void run(Control& c) { c.clockDispatch(); }
+    static void expire(Control& c) { c.m_dispatchExpires = std::chrono::steady_clock::now() - std::chrono::milliseconds(1); }
+    static void disable(Control& c) { c.m_dispatchEnabled = false; }
+};
+}
+namespace {
+constexpr uint32_t RID = 10002U, TG = 1001U, TG2 = 1002U, VC = 25U;
+const std::string LEASE(32U, 'a'), LEASE2(32U, 'b');
+class ReadyModem : public modem::Modem {
+public:
+    ReadyModem() : Modem(new modem::port::ModemNullPort(), true, false, false, false, false, false,
+        0U, 0U, 0U, 8192U, 8192U, 8192U, true, true, false, false, false, false) { ready(); }
+    void ready() { m_modemState = modem::DVM_STATE::STATE_P25; m_statusGeneration.store(1U); m_error = m_lockout = false; }
+    void error() { m_error = true; }
+    void stale() { m_statusGeneration.store(0U); }
+};
+class DispatchRPC : public network::NetRPC {
+public:
+    unsigned permits = 0U, clears = 0U;
+    bool allow = true, reply = true, wrongToken = false;
+    std::function<void()> beforeReply;
+    DispatchRPC() : NetRPC("127.0.0.1", 48991U, 0U, "offline-test", false) {}
+    bool req(uint16_t func, const json::object& request, RPCType callback, std::string, uint16_t, bool blocking = false) override {
+        if (func != RPC_PERMIT_P25_TG) return true;
+        if (request.at("dstId").get<uint32_t>() == 0U) { ++clears; return true; }
+        ++permits; REQUIRE(blocking); REQUIRE(callback != nullptr);
+        if (beforeReply) beforeReply();
+        if (!reply) return false;
+        json::object response;
+        int status = allow ? OK : BAD_REQUEST; response["status"].set<int>(status);
+        response["dstId"] = request.at("dstId"); response["permitToken"] = request.at("permitToken");
+        if (wrongToken) response["permitToken"].set<std::string>("other:1");
+        // The real wire parser normalizes small JSON integers to int.
+        json::value parsed; REQUIRE(json::parse(parsed, json::value(response).serialize()).empty());
+        response = parsed.get<json::object>(); json::object ignored; callback(response, ignored); return true;
+    }
+};
+struct Fixture {
+    ::lookups::ChannelLookup channels;
+    ::lookups::RadioIdLookup radios{"", 0U, true};
+    ::lookups::TalkgroupRulesLookup groups{"", 0U, true};
+    ::lookups::IdenTableLookup identities{"", 0U};
+    ::lookups::RSSIInterpolator rssi;
+    ReadyModem modem;
+    DispatchRPC rpc;
+    network::NetRPC* old = g_RPC;
+    std::unique_ptr<p25::Control> control;
+    Fixture() {
+        g_logDisplayLevel = 0U; g_RPC = &rpc;
+        radios.addEntry(RID, true, "Dispatch"); radios.addEntry(10001U, true, "Subscriber");
+        radios.addEntry(10003U, false, "Denied"); groups.addEntry(TG, 1U, true); groups.addEntry(TG2, 1U, true);
+        channels.setRFChData(VC, ::lookups::VoiceChData(2U, VC, "127.0.0.1", 48993U, "offline-test")); channels.addRFCh(VC);
+        control = std::make_unique<p25::Control>(true, 0x293U, 1U, 16384U, &modem, nullptr, 120U, 1U, true,
+            &channels, &radios, &groups, &identities, &rssi, false, false, false, false, false);
+        yaml::Node config;
+        REQUIRE(yaml::Parse(config, std::string(R"(
+protocols:
+    p25:
+        dispatchEnable: true
+        verifyReg: true
+        verifyAff: true
+        tduPreambleCount: 0
+        control:
+            enable: true
+            dedicated: true
+            ackRequests: false
+            disableTSDUMBF: true
+            redundantImmediate: false
+system:
+    config:
+        controlCh:
+            notifyEnable: false
+)")));
+        control->setOptions(config, false, "N0TEST", ::lookups::VoiceChData(), 1U, 1U, 1U, 1U, 2U, 1U, false);
+        control->setSupervisor(true); control->setCCRunning(true);
+    }
+    ~Fixture() { control.reset(); g_RPC = old; }
+    p25::DispatchRequest request(p25::DispatchAction action = p25::DispatchAction::Grant, const std::string& lease = LEASE) {
+        p25::DispatchRequest request; request.action = action; request.srcId = RID; request.dstId = TG; request.leaseId = lease; return request;
+    }
+    p25::DispatchResult run(const p25::DispatchRequest& request) {
+        auto result = std::async(std::launch::async, [&] { return control->dispatch(request); });
+        const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+        while (!p25::DispatchGrantTestAccess::queued(*control) && result.wait_for(std::chrono::milliseconds(0)) != std::future_status::ready && std::chrono::steady_clock::now() < limit) std::this_thread::yield();
+        p25::DispatchGrantTestAccess::run(*control);
+        REQUIRE(result.wait_for(std::chrono::seconds(1)) == std::future_status::ready); return result.get();
+    }
+    size_t drain() { uint8_t frame[1024U]; size_t count = 0U; while (control->getFrame(frame) != 0U) ++count; return count; }
+};
+}
+
+TEST_CASE("dispatch success requires the actual correlated permit and is idempotent", "[dispatch-grant]") {
+    Fixture f;
+    REQUIRE_FALSE(f.control->affiliations()->isUnitReg(RID));
+    auto request = f.request(); const auto result = f.run(request);
+    REQUIRE(result.status == 200); REQUIRE(result.accepted); REQUIRE(result.issued); REQUIRE(result.epoch > 0U);
+    REQUIRE(result.channelNo == VC); REQUIRE(result.channelId == 2U); REQUIRE(f.rpc.permits == 1U);
+    REQUIRE(f.control->affiliations()->ownsGrant(TG, RID, VC, result.epoch)); REQUIRE(f.drain() > 0U);
+    const auto duplicate = f.run(request); REQUIRE(duplicate.epoch == result.epoch); REQUIRE(duplicate.accepted);
+    REQUIRE(f.rpc.permits == 1U); REQUIRE(f.drain() == 0U); REQUIRE_FALSE(f.control->affiliations()->isUnitReg(RID));
+    auto renew = f.request(p25::DispatchAction::Renew); renew.epoch = result.epoch;
+    REQUIRE(f.run(renew).accepted); REQUIRE(f.rpc.permits == 2U); REQUIRE(f.drain() == 0U);
+    auto release = f.request(p25::DispatchAction::Release); release.epoch = result.epoch;
+    REQUIRE(f.run(release).accepted); REQUIRE_FALSE(f.control->affiliations()->isGranted(TG)); REQUIRE(f.rpc.clears == 1U);
+    REQUIRE(f.run(release).accepted); REQUIRE(f.rpc.clears == 1U);
+    const auto replay = f.run(request); REQUIRE_FALSE(replay.accepted); REQUIRE(replay.state == "released"); REQUIRE(f.rpc.permits == 2U);
+}
+TEST_CASE("dispatch missing rejected mismatched or late permits cannot issue RF", "[dispatch-grant]") {
+    for (int mode = 0; mode < 4; ++mode) {
+        Fixture f;
+        if (mode == 0) f.rpc.allow = false;
+        if (mode == 1) f.rpc.reply = false;
+        if (mode == 2) f.rpc.wrongToken = true;
+        if (mode == 3) f.rpc.beforeReply = [&] { f.control->configureIdentification(true); f.control->requestIdentification(); };
+        const auto result = f.run(f.request());
+        REQUIRE_FALSE(result.accepted); REQUIRE_FALSE(result.issued); REQUIRE(f.drain() == 0U);
+        REQUIRE_FALSE(f.control->affiliations()->isGranted(TG)); REQUIRE(f.rpc.permits == 1U);
+        REQUIRE_FALSE(f.run(f.request()).accepted); REQUIRE(f.rpc.permits == 1U);
+    }
+}
+TEST_CASE("dispatch rejects disabled identities unavailable CC CW and occupied talkgroups", "[dispatch-grant]") {
+    for (int mode = 0; mode < 9; ++mode) {
+        Fixture f; auto request = f.request();
+        if (mode == 0) request.srcId = 10003U;
+        if (mode == 1) request.srcId = 10004U;
+        if (mode == 2) request.dstId = 1099U;
+        if (mode == 3) f.control->setCCRunning(false);
+        if (mode == 4) f.modem.error();
+        if (mode == 5) f.modem.stale();
+        if (mode == 6) f.control->setSupervisor(false);
+        if (mode == 7) { f.control->configureIdentification(true); f.control->requestIdentification(); }
+        if (mode == 8) REQUIRE(f.control->affiliations()->grantCh(TG, 10001U, 15U, true, false));
+        const auto result = f.run(request); REQUIRE_FALSE(result.accepted); REQUIRE_FALSE(result.issued);
+        REQUIRE(f.rpc.permits == 0U); REQUIRE(f.drain() == 0U);
+        if (mode == 8) REQUIRE(f.control->affiliations()->getGrantedSrcId(TG) == 10001U);
+    }
+}
+TEST_CASE("dispatch old cancellation and expiry cannot release a replacement allocation", "[dispatch-grant]") {
+    Fixture f; const auto first = f.run(f.request()); REQUIRE(first.accepted); f.drain();
+    REQUIRE(f.control->affiliations()->releaseGrant(TG, false));
+    REQUIRE(f.control->affiliations()->grantCh(TG, 10001U, 15U, true, false));
+    const auto replacement = f.control->affiliations()->grantEpoch(TG); REQUIRE(replacement != first.epoch);
+    auto release = f.request(p25::DispatchAction::Release); release.epoch = first.epoch;
+    REQUIRE(f.run(release).accepted); REQUIRE(f.control->affiliations()->ownsGrant(TG, 10001U, VC, replacement));
+    REQUIRE(f.drain() == 0U);
+}
+TEST_CASE("dispatch lease expiry clears only its permission and terminal status stays historical", "[dispatch-grant]") {
+    Fixture f; const auto first = f.run(f.request()); REQUIRE(first.accepted); f.drain();
+    p25::DispatchGrantTestAccess::expire(*f.control); f.control->clock();
+    REQUIRE_FALSE(f.control->affiliations()->isGranted(TG)); REQUIRE(f.rpc.clears == 1U);
+    const auto state = f.run(f.request(p25::DispatchAction::Status)); REQUIRE(state.state == "expired"); REQUIRE_FALSE(state.accepted); REQUIRE(state.issued);
+    const auto second = f.run(f.request(p25::DispatchAction::Grant, LEASE2)); REQUIRE(second.accepted); REQUIRE(second.epoch != first.epoch);
+    auto old = f.request(p25::DispatchAction::Release); old.epoch = first.epoch;
+    REQUIRE(f.run(old).accepted); REQUIRE(f.control->affiliations()->ownsGrant(TG, RID, VC, second.epoch));
+}
+TEST_CASE("dispatch queued timeout cannot later emit a grant", "[dispatch-grant]") {
+    Fixture f; const auto request = f.request(); const auto result = f.control->dispatch(request, 2U);
+    REQUIRE(result.status == 504); REQUIRE_FALSE(result.issued); p25::DispatchGrantTestAccess::run(*f.control);
+    REQUIRE(f.rpc.permits == 0U); REQUIRE(f.drain() == 0U); REQUIRE_FALSE(f.control->affiliations()->isGranted(TG));
+}
+TEST_CASE("dispatch permit wait past deadline rolls back without RF", "[dispatch-grant]") {
+    Fixture f; f.rpc.beforeReply = [] { std::this_thread::sleep_for(std::chrono::milliseconds(12)); };
+    auto request = f.request(); auto result = std::async(std::launch::async, [&] { return f.control->dispatch(request, 5U); });
+    while (!p25::DispatchGrantTestAccess::queued(*f.control)) std::this_thread::yield();
+    p25::DispatchGrantTestAccess::run(*f.control);
+    REQUIRE(result.get().issued == false); REQUIRE(f.rpc.permits == 1U); REQUIRE(f.drain() == 0U); REQUIRE_FALSE(f.control->affiliations()->isGranted(TG));
+}
+TEST_CASE("dispatch renew needs a fresh matching permit and rejects stale epoch", "[dispatch-grant]") {
+    Fixture f; const auto first = f.run(f.request()); REQUIRE(first.accepted); f.drain();
+    auto renew = f.request(p25::DispatchAction::Renew); renew.epoch = first.epoch + 1U;
+    REQUIRE_FALSE(f.run(renew).accepted); REQUIRE(f.rpc.permits == 1U); REQUIRE(f.control->affiliations()->isGranted(TG));
+    renew.epoch = first.epoch; f.rpc.wrongToken = true;
+    REQUIRE_FALSE(f.run(renew).accepted); REQUIRE_FALSE(f.control->affiliations()->isGranted(TG)); REQUIRE(f.drain() == 0U);
+}
+
+TEST_CASE("dispatch renewal deadline cannot extend a cancelled lease", "[dispatch-grant]") {
+    Fixture f; const auto first = f.run(f.request()); REQUIRE(first.accepted); f.drain();
+    auto renew = f.request(p25::DispatchAction::Renew); renew.epoch = first.epoch;
+    f.rpc.beforeReply = [] { std::this_thread::sleep_for(std::chrono::milliseconds(12)); };
+    auto result = std::async(std::launch::async, [&] { return f.control->dispatch(renew, 5U); });
+    while (!p25::DispatchGrantTestAccess::queued(*f.control)) std::this_thread::yield();
+    p25::DispatchGrantTestAccess::run(*f.control);
+    REQUIRE_FALSE(result.get().accepted); REQUIRE_FALSE(f.control->affiliations()->isGranted(TG)); REQUIRE(f.drain() == 0U);
+}
