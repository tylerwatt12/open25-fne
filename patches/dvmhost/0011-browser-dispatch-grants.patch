index 0000000..7516a62
--- /dev/null
+++ b/src/host/p25/Control.Dispatch.cpp
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Dispatch REST never writes protocol state. The normal clock owner executes
+ * bounded operations using the stock allocator and correlated VC permit. */
+#include "p25/Control.h"
+#include "Host.h"
+#include "common/p25/acl/AccessControl.h"
+#include "network/RPCDefines.h"
+#include "common/Log.h"
+#include <algorithm>
+
+using namespace p25;
+using Clock = std::chrono::steady_clock;
+namespace {
+DispatchResult resultFor(const DispatchRequest& request, int status, const std::string& message) {
+    DispatchResult result;
+    result.status = status; result.message = message;
+    result.srcId = request.srcId; result.dstId = request.dstId;
+    result.leaseId = request.leaseId; result.epoch = request.epoch;
+    return result;
+}
+bool validLease(const std::string& value) {
+    return value.size() >= 32U && value.size() <= 64U &&
+        std::all_of(value.begin(), value.end(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+void finish(const std::shared_ptr<DispatchOperation>& operation, const DispatchResult& result) {
+    std::lock_guard<std::mutex> lock(operation->mutex);
+    operation->result = result; operation->done = true;
+    operation->phase.store(DispatchOperation::Finished);
+    operation->changed.notify_all();
+}
+}
+
+DispatchResult Control::dispatch(const DispatchRequest& request, uint32_t waitMs)
+{
+    if (!request.leaseId.empty() && !validLease(request.leaseId))
+        return resultFor(request, 400, "leaseId must be 32-64 lowercase hexadecimal characters");
+    if (request.action != DispatchAction::Status || !request.leaseId.empty()) {
+        if (!validLease(request.leaseId) || request.srcId == 0U || request.srcId >= 0xFFFFFCU ||
+            request.dstId == 0U || request.dstId >= 0xFFFFU)
+            return resultFor(request, 400, "invalid dispatch identity or talkgroup");
+    }
+    if ((request.action == DispatchAction::Grant || request.action == DispatchAction::Renew) &&
+        (request.ttlMs < 250U || request.ttlMs > 2000U))
+        return resultFor(request, 400, "ttlMs must be 250-2000");
+    if ((request.action == DispatchAction::Renew || request.action == DispatchAction::Release) && request.epoch == 0U)
+        return resultFor(request, 400, "epoch is required");
+    auto operation = std::make_shared<DispatchOperation>();
+    operation->request = request;
+    operation->deadline = Clock::now() + std::chrono::milliseconds(std::min(waitMs, 750U));
+    {
+        std::lock_guard<std::mutex> lock(m_dispatchQueueMutex);
+        if (m_dispatchClosing.load() || m_dispatchQueue.size() >= 16U)
+            return resultFor(request, 503, "dispatch owner unavailable");
+        m_dispatchQueue.push_back(operation);
+    }
+    std::unique_lock<std::mutex> lock(operation->mutex);
+    if (operation->changed.wait_until(lock, operation->deadline, [&] { return operation->done; }))
+        return operation->result;
+    int phase = operation->phase.load();
+    while (phase == DispatchOperation::Queued || phase == DispatchOperation::Executing) {
+        if (operation->phase.compare_exchange_weak(phase, DispatchOperation::Cancelled)) {
+            auto result = resultFor(request, 504, "operation cancelled before grant commit");
+            result.state = "cancelled";
+            return result;
+        }
+    }
+    // A committed request can already have queued an RF grant. Do not claim
+    // rejection or retry: resolve using the same leaseId's status/release.
+    auto result = resultFor(request, 504, "commit began; query the same leaseId");
+    result.issued = phase == DispatchOperation::Committed;
+    result.state = result.issued ? "pending" : "cancelled";
+    return result;
+}
+
+bool Control::dispatchReady() const
+{
+    return m_dispatchEnabled && !m_dispatchClosing.load() && m_authoritative && m_supervisor &&
+        m_enableControl && m_dedicatedControl && m_duplex && m_ccRunning && !m_ccHalted &&
+        !identificationUnavailable() && m_modem != nullptr && !m_modem->hasError() &&
+        !m_modem->hasLockout() && m_modem->statusGeneration() != 0U &&
+        m_modem->getState() == modem::DVM_STATE::STATE_P25 && g_RPC != nullptr &&
+        (m_network == nullptr || m_network->getStatus() == network::NET_STAT_RUNNING);
+}
+
+void Control::rememberDispatch(const DispatchResult& result)
+{
+    if (m_dispatchHistory.find(result.leaseId) == m_dispatchHistory.end())
+        m_dispatchHistoryOrder.push_back(result.leaseId);
+    m_dispatchHistory[result.leaseId] = result;
+    while (m_dispatchHistoryOrder.size() > 128U) {
+        m_dispatchHistory.erase(m_dispatchHistoryOrder.front());
+        m_dispatchHistoryOrder.pop_front();
+    }
+}
+
+void Control::endDispatch(const std::string& state)
+{
+    if (m_dispatchLease.leaseId.empty()) return;
+    auto guard = m_affiliations->lockGrants();
+    if (m_affiliations->ownsGrant(m_dispatchLease.dstId, m_dispatchLease.srcId,
+        m_dispatchLease.channelNo, m_dispatchLease.epoch))
+        m_affiliations->releaseGrant(m_dispatchLease.dstId, false);
+    m_dispatchLease.status = 200; m_dispatchLease.accepted = false;
+    m_dispatchLease.state = state; m_dispatchLease.expiresInMs = 0U;
+    rememberDispatch(m_dispatchLease);
+    m_dispatchLease = DispatchResult();
+}
+
+void Control::clockDispatch()
+{
+    // This method is called only by the protocol clock owner, never by REST.
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    if (!m_dispatchLease.leaseId.empty()) {
+        auto guard = m_affiliations->lockGrants();
+        const bool owned = m_affiliations->ownsGrant(m_dispatchLease.dstId, m_dispatchLease.srcId,
+            m_dispatchLease.channelNo, m_dispatchLease.epoch);
+        if (!owned) endDispatch("lost");
+        else if (Clock::now() >= m_dispatchExpires) endDispatch("expired");
+        else if (!dispatchReady()) endDispatch("unavailable");
+    }
+    std::shared_ptr<DispatchOperation> operation;
+    {
+        std::lock_guard<std::mutex> lock(m_dispatchQueueMutex);
+        if (m_dispatchQueue.empty()) return;
+        operation = m_dispatchQueue.front(); m_dispatchQueue.pop_front();
+    }
+    int queued = DispatchOperation::Queued;
+    if (Clock::now() >= operation->deadline || !operation->phase.compare_exchange_strong(queued, DispatchOperation::Executing)) {
+        auto result = resultFor(operation->request, 504, "operation cancelled before execution");
+        result.state = "cancelled"; finish(operation, result); return;
+    }
+    finish(operation, executeDispatch(operation));
+}
+
+DispatchResult Control::executeDispatch(const std::shared_ptr<DispatchOperation>& operation)
+{
+    const auto& request = operation->request;
+    auto rejected = resultFor(request, 409, "dispatch allocation rejected");
+    const auto found = m_dispatchHistory.find(request.leaseId);
+    if (request.action == DispatchAction::Status) {
+        if (request.leaseId.empty()) {
+            if (m_dispatchLease.leaseId.empty()) {
+                rejected.status = 200; rejected.state = "idle"; rejected.message.clear(); return rejected;
+            }
+            auto result = m_dispatchLease;
+            result.expiresInMs = uint32_t(std::max<int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(m_dispatchExpires - Clock::now()).count()));
+            return result;
+        }
+        if (found == m_dispatchHistory.end()) { rejected.status = 404; rejected.message = "unknown leaseId"; return rejected; }
+        if (found->second.srcId != request.srcId || found->second.dstId != request.dstId) {
+            rejected.message = "lease identity mismatch"; return rejected;
+        }
+        auto result = found->second;
+        if (m_dispatchLease.leaseId == request.leaseId)
+            result.expiresInMs = uint32_t(std::max<int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(m_dispatchExpires - Clock::now()).count()));
+        return result;
+    }
+    if (request.action == DispatchAction::Grant && found != m_dispatchHistory.end()) {
+        auto result = found->second;
+        if (result.srcId != request.srcId || result.dstId != request.dstId) {
+            rejected.message = "lease identity mismatch"; return rejected;
+        }
+        if (m_dispatchLease.leaseId == request.leaseId)
+            result.expiresInMs = uint32_t(std::max<int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(m_dispatchExpires - Clock::now()).count()));
+        return result; // never RF or TTL extension on duplicate submission
+    }
+    if (request.action == DispatchAction::Release || request.action == DispatchAction::Renew) {
+        if (found == m_dispatchHistory.end() || found->second.srcId != request.srcId ||
+            found->second.dstId != request.dstId || found->second.epoch != request.epoch) {
+            rejected.message = "lease identity or epoch mismatch"; return rejected;
+        }
+        if (m_dispatchLease.leaseId != request.leaseId) {
+            auto result = found->second;
+            result.status = request.action == DispatchAction::Release ? 200 : 409;
+            result.accepted = request.action == DispatchAction::Release;
+            return result; // idempotent cancellation of a completed lease
+        }
+        if (request.action == DispatchAction::Release) {
+            endDispatch("released");
+            auto result = m_dispatchHistory.at(request.leaseId); result.accepted = true; return result;
+        }
+        if (!dispatchReady()) { endDispatch("unavailable"); rejected.message = "dispatch owner unavailable"; return rejected; }
+        const auto lease = m_dispatchLease;
+        std::string permitToken;
+        ::lookups::VoiceChData channel;
+        {
+            auto guard = m_affiliations->lockGrants();
+            if (!m_affiliations->ownsGrant(lease.dstId, lease.srcId, lease.channelNo, lease.epoch)) {
+                endDispatch("lost"); return rejected;
+            }
+            permitToken = m_affiliations->grantPermitToken(lease.dstId);
+            channel = m_affiliations->rfCh()->getRFChData(lease.channelNo);
+        }
+        auto accepted = std::make_shared<std::atomic<bool>>(false);
+        json::object req;
+        req["dstId"].set<uint32_t>(lease.dstId); req["permitToken"].set<std::string>(permitToken);
+        const bool replied = !permitToken.empty() && g_RPC->req(RPC_PERMIT_P25_TG, req,
+            [accepted, permitToken, lease](json::object& response, json::object&) {
+                accepted->store(response["status"].is<int>() && response["status"].get<int>() == network::NetRPC::OK &&
+                    response["dstId"].is<int>() && response["dstId"].get<uint32_t>() == lease.dstId &&
+                    response["permitToken"].is<std::string>() && response["permitToken"].get<std::string>() == permitToken);
+            }, channel.address(), channel.port(), true);
+        auto guard = m_affiliations->lockGrants();
+        if (!replied || !accepted->load() || !dispatchReady() || Clock::now() >= m_dispatchExpires ||
+            Clock::now() >= operation->deadline || operation->phase.load() == DispatchOperation::Cancelled ||
+            !m_affiliations->ownsGrant(lease.dstId, lease.srcId, lease.channelNo, lease.epoch)) {
+            endDispatch("lost"); rejected.message = "voice permit renewal not accepted"; return rejected;
+        }
+        // Renewal and timeout have the same single winner as initial grant.
+        // A REST timeout cannot claim cancellation and then extend the lease.
+        int renewing = DispatchOperation::Executing;
+        if (!operation->phase.compare_exchange_strong(renewing, DispatchOperation::Committed)) {
+            endDispatch("lost"); rejected.message = "renewal cancelled before commit"; return rejected;
+        }
+        m_affiliations->touchGrant(lease.dstId);
+        m_dispatchExpires = Clock::now() + std::chrono::milliseconds(request.ttlMs);
+        m_dispatchLease.expiresInMs = request.ttlMs;
+        rememberDispatch(m_dispatchLease); return m_dispatchLease;
+    }
+    if (m_dispatchSeen.find(request.leaseId) != m_dispatchSeen.end()) {
+        rejected.status = 410; rejected.message = "completed leaseId has aged out; it cannot be reused"; return rejected;
+    }
+    if (m_dispatchSeen.size() >= 65536U) {
+        rejected.status = 503; rejected.message = "dispatch lease history is full"; return rejected;
+    }
+    m_dispatchSeen.insert(request.leaseId); // one attempt per lease, including rejected/uncertain requests
+    auto reject = [&](int status, const char* reason) {
+        auto result = resultFor(request, status, reason); result.issued = operation->phase.load() == DispatchOperation::Committed; rememberDispatch(result); return result;
+    };
+    if (!dispatchReady()) return reject(503, "dispatch owner unavailable or identifying");
+    const auto radio = m_ridLookup->find(request.srcId);
+    const auto group = m_tidLookup->find(request.dstId);
+    if (radio.radioDefault() || !radio.radioEnabled() || group.isInvalid() || !group.config().active() ||
+        !acl::AccessControl::validateSrcId(request.srcId) || !acl::AccessControl::validateTGId(request.dstId))
+        return reject(403, "radio or talkgroup is not enabled in the native allow lists");
+    if (!m_dispatchLease.leaseId.empty()) return reject(409, "another dispatch lease is active");
+    {
+        auto guard = m_affiliations->lockGrants();
+        if (m_affiliations->isGranted(request.dstId)) return reject(409, "talkgroup is already allocated");
+        if (!m_affiliations->rfCh()->isRFChAvailable()) return reject(409, "no voice resource is available");
+    }
+    if (m_rfState != RS_RF_LISTENING && m_rfState != RS_RF_DATA)
+        return reject(409, "RF control input is busy");
+    // Reserve only when the request still owns its pre-commit phase. The stock
+    // allocator requires a positive, token-matched VC reply before this hook.
+    const bool granted = m_control->writeRF_TSDU_Grant(request.srcId, request.dstId, 4U, true, true, false, 0U, [&] {
+        if (!dispatchReady() || Clock::now() >= operation->deadline) return false;
+        int executing = DispatchOperation::Executing;
+        return operation->phase.compare_exchange_strong(executing, DispatchOperation::Committed);
+    });
+    auto guard = m_affiliations->lockGrants();
+    const uint32_t channelNo = m_affiliations->getGrantedCh(request.dstId);
+    const uint64_t epoch = m_affiliations->grantEpoch(request.dstId);
+    if (!granted || operation->phase.load() != DispatchOperation::Committed ||
+        !m_affiliations->ownsGrant(request.dstId, request.srcId, channelNo, epoch) ||
+        m_affiliations->grantPermitToken(request.dstId).empty())
+        return reject(409, "native allocation or correlated voice permit was not accepted");
+    auto result = resultFor(request, 200, "");
+    result.accepted = true; result.issued = true; result.state = "granted";
+    result.channelNo = channelNo; result.channelId = m_affiliations->rfCh()->getRFChData(channelNo).chId();
+    result.epoch = epoch; result.expiresInMs = request.ttlMs;
+    m_dispatchLease = result;
+    m_dispatchExpires = Clock::now() + std::chrono::milliseconds(request.ttlMs);
+    rememberDispatch(result);
+    LogInfoEx(LOG_P25, "dispatch allocation accepted, srcId = %u, dstId = %u, chNo = %u-%u, epoch = %llu", result.srcId, result.dstId, result.channelId, result.channelNo, (unsigned long long)result.epoch);
+    return result;
+}
+
+void Control::shutdownDispatch()
+{
+    m_dispatchClosing.store(true);
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    endDispatch("stopped");
+    std::lock_guard<std::mutex> lock(m_dispatchQueueMutex);
+    for (const auto& operation : m_dispatchQueue) finish(operation, resultFor(operation->request, 503, "dispatch owner stopped"));
+    m_dispatchQueue.clear();
+}
