+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded completion of already queued normal traffic before identification. */
+#ifndef DVM_HOST_CWID_DRAIN_H
+#define DVM_HOST_CWID_DRAIN_H
+
+#include "CWIDPolicy.h"
+
+namespace identification {
+
+class DrainTransport {
+public:
+    virtual ~DrainTransport() {}
+    virtual uint64_t nowMs() const = 0;
+    virtual bool hasQueued() const = 0;
+    // Submit at most one already queued normal frame. False is a write error;
+    // true may also mean temporary backpressure with the queue left unchanged.
+    virtual bool sendOne() = 0;
+    // Fresh modem status must show no TX after drain began AND after the last
+    // actual frame submission. A transport invalidates its status baseline on
+    // each submission; cached idle from before that write cannot complete drain.
+    virtual bool idleReady() const = 0;
+    virtual bool healthy() const = 0;
+    virtual void pump(uint32_t milliseconds) = 0;
+};
+
+enum class DrainResult { Completed, Fault, Timeout, WriteFailed };
+
+// The caller has closed new permits/readers and exclusively owns the normal
+// modem writer. This executor only finishes its existing queue; it never clears
+// the queue, changes mode, generates an end marker, or begins identification.
+inline DrainResult drain(DrainTransport& transport, uint32_t totalTimeoutMs) {
+    uint64_t previous = transport.nowMs();
+    const uint64_t until = detail::deadline(previous, totalTimeoutMs);
+    uint64_t pumps = uint64_t(totalTimeoutMs) / 20U + 8U;
+    uint64_t now = previous;
+    auto check = [&]() {
+        if (!transport.healthy())
+            return DrainResult::Fault;
+        now = transport.nowMs();
+        if (now < previous)
+            return DrainResult::Fault;
+        previous = now;
+        return now > until ? DrainResult::Timeout : DrainResult::Completed;
+    };
+
+    for (;;) {
+        DrainResult state = check();
+        if (state != DrainResult::Completed)
+            return state;
+        bool queued = transport.hasQueued();
+        state = check();
+        if (state != DrainResult::Completed)
+            return state;
+        if (queued) {
+            // At the exact deadline an observed idle may complete, but no new
+            // normal frame may begin once the remaining drain budget is zero.
+            if (now == until)
+                return DrainResult::Timeout;
+            const bool written = transport.sendOne();
+            state = check();
+            if (state != DrainResult::Completed)
+                return state;
+            if (!written)
+                return DrainResult::WriteFailed;
+            queued = transport.hasQueued();
+            state = check();
+            if (state != DrainResult::Completed)
+                return state;
+        }
+        if (!queued) {
+            const bool idle = transport.idleReady();
+            state = check();
+            if (state != DrainResult::Completed)
+                return state;
+            if (idle) {
+                // Be robust to a transport discovering queued work while it
+                // refreshes status. Both conditions must hold at completion.
+                const bool stillQueued = transport.hasQueued();
+                state = check();
+                if (state != DrainResult::Completed)
+                    return state;
+                if (!stillQueued)
+                    return DrainResult::Completed;
+            }
+        }
+        if (now == until)
+            return DrainResult::Timeout;
+        if (pumps == 0U)
+            return DrainResult::Fault;
+        --pumps;
+        transport.pump(uint32_t(std::min<uint64_t>(20U, until - now)));
+    }
+}
+
+} // namespace identification
+#endif
