diff --git a/tests/CWIDDrain_Tests.cpp b/tests/CWIDDrain_Tests.cpp
new file mode 100644
index 0000000..22c097a
--- /dev/null
+++ b/tests/CWIDDrain_Tests.cpp
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pure queue/status fixtures. No Host, modem, network, RF, or wall clock. */
+#include "host/CWIDDrain.h"
+#include <catch2/catch_test_macros.hpp>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace {
+using identification::DrainResult;
+
+struct DrainFixture final : identification::DrainTransport {
+    mutable uint64_t clock = 0U;
+    unsigned queued = 2U, writes = 0U, pumps = 0U;
+    mutable unsigned statusChecks = 0U;
+    uint64_t fifoIdleAt = 100U, freshAfterWriteAt = 0U;
+    uint32_t sendCost = 0U, queueCost = 0U, statusCost = 0U;
+    bool fault = false, writeOK = true, advance = true, consume = true;
+    bool refreshStatus = true;
+    mutable bool discovered = false;
+    mutable std::vector<std::string> phases;
+    std::function<void(DrainFixture&)> afterWrite, afterPump;
+    std::function<void(const DrainFixture&)> afterStatus;
+
+    uint64_t nowMs() const override { return clock; }
+    bool hasQueued() const override {
+        clock += queueCost;
+        phases.push_back(queued ? "queued" : "empty");
+        return queued != 0U;
+    }
+    bool sendOne() override {
+        ++writes;
+        phases.push_back("write");
+        clock += sendCost;
+        if (writeOK && consume && queued != 0U) {
+            --queued;
+            // Even if the FIFO formerly looked idle, this write requires a
+            // later status report before the fixture can prove completion.
+            freshAfterWriteAt = clock + 20U;
+        }
+        if (afterWrite) afterWrite(*this);
+        return writeOK;
+    }
+    bool idleReady() const override {
+        ++statusChecks;
+        clock += statusCost;
+        phases.push_back("status");
+        if (afterStatus) afterStatus(*this);
+        return refreshStatus && clock >= fifoIdleAt && clock >= freshAfterWriteAt;
+    }
+    bool healthy() const override { return !fault; }
+    void pump(uint32_t ms) override {
+        REQUIRE(ms > 0U);
+        REQUIRE(ms <= 20U);
+        ++pumps;
+        phases.push_back("pump");
+        if (advance) clock += ms;
+        if (afterPump) afterPump(*this);
+    }
+};
+}
+
+TEST_CASE("CW drain finishes normal frames then waits for fresh actual FIFO idle", "[cwid][drain]") {
+    DrainFixture transport;
+    REQUIRE(identification::drain(transport, 200U) == DrainResult::Completed);
+    REQUIRE(transport.queued == 0U);
+    REQUIRE(transport.writes == 2U);
+    REQUIRE(transport.clock == 100U);
+    unsigned seenWrites = 0U;
+    for (const auto& phase : transport.phases) {
+        if (phase == "write") ++seenWrites;
+        if (phase == "status") REQUIRE(seenWrites == 2U);
+    }
+    REQUIRE(transport.statusChecks > 0U);
+}
+
+TEST_CASE("A bare CW drain does not invent a TX-start requirement", "[cwid][drain]") {
+    DrainFixture transport;
+    transport.queued = 0U;
+    transport.fifoIdleAt = 40U;
+    REQUIRE(identification::drain(transport, 100U) == DrainResult::Completed);
+    REQUIRE(transport.writes == 0U);
+    REQUIRE(transport.clock == 40U);
+}
+
+TEST_CASE("CW drain does not mistake cached idle or an empty software queue for finished RF", "[cwid][drain]") {
+    DrainFixture transport;
+    SECTION("empty software queue but firmware FIFO still active") {
+        transport.queued = 0U;
+        transport.fifoIdleAt = 121U;
+        REQUIRE(identification::drain(transport, 120U) == DrainResult::Timeout);
+        REQUIRE(transport.clock == 120U);
+    }
+    SECTION("last write invalidates a formerly idle report") {
+        transport.queued = 1U;
+        transport.fifoIdleAt = 0U;
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Completed);
+        REQUIRE(transport.clock == 20U);
+        REQUIRE(transport.writes == 1U);
+    }
+    SECTION("fresh status never arrives") {
+        transport.queued = 0U;
+        transport.refreshStatus = false;
+        REQUIRE(identification::drain(transport, 65U) == DrainResult::Timeout);
+        REQUIRE(transport.clock == 65U);
+    }
+}
+
+TEST_CASE("CW drain reports failures without retransmitting failed frames", "[cwid][drain]") {
+    DrainFixture transport;
+    SECTION("initial health failure does not write") {
+        transport.fault = true;
+        REQUIRE(identification::drain(transport, 200U) == DrainResult::Fault);
+        REQUIRE(transport.writes == 0U);
+    }
+    SECTION("short or failed normal frame write") {
+        transport.writeOK = false;
+        REQUIRE(identification::drain(transport, 200U) == DrainResult::WriteFailed);
+        REQUIRE(transport.writes == 1U);
+        REQUIRE(transport.queued == 2U);
+    }
+    SECTION("health failure in write callback") {
+        transport.afterWrite = [](DrainFixture& t) { t.fault = true; };
+        REQUIRE(identification::drain(transport, 200U) == DrainResult::Fault);
+        REQUIRE(transport.writes == 1U);
+    }
+    SECTION("health failure during FIFO drain") {
+        transport.queued = 0U;
+        transport.afterPump = [](DrainFixture& t) { t.fault = true; };
+        REQUIRE(identification::drain(transport, 200U) == DrainResult::Fault);
+        REQUIRE(transport.writes == 0U);
+    }
+}
+
+TEST_CASE("CW drain absolute deadline includes transport callback work", "[cwid][drain]") {
+    DrainFixture transport;
+    SECTION("queue inspection consumes all budget") {
+        transport.queueCost = 101U;
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Timeout);
+        REQUIRE(transport.writes == 0U);
+    }
+    SECTION("frame write consumes all budget") {
+        transport.sendCost = 101U;
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Timeout);
+        REQUIRE(transport.writes == 1U);
+    }
+    SECTION("status callback finishes after deadline") {
+        transport.queued = 0U;
+        transport.fifoIdleAt = 0U;
+        transport.statusCost = 101U;
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Timeout);
+        REQUIRE(transport.writes == 0U);
+    }
+    SECTION("idle at exact deadline completes") {
+        transport.queued = 0U;
+        transport.fifoIdleAt = 60U;
+        REQUIRE(identification::drain(transport, 60U) == DrainResult::Completed);
+        REQUIRE(transport.clock == 60U);
+    }
+    SECTION("zero budget cannot start queued frame") {
+        REQUIRE(identification::drain(transport, 0U) == DrainResult::Timeout);
+        REQUIRE(transport.writes == 0U);
+    }
+    SECTION("zero budget may observe already fresh empty idle") {
+        transport.queued = 0U;
+        transport.fifoIdleAt = 0U;
+        REQUIRE(identification::drain(transport, 0U) == DrainResult::Completed);
+        REQUIRE(transport.writes == 0U);
+    }
+}
+
+TEST_CASE("CW drain remains bounded with backpressure or a broken clock", "[cwid][drain]") {
+    DrainFixture transport;
+    SECTION("normal backpressure can clear without a false write failure") {
+        transport.consume = false;
+        transport.afterPump = [](DrainFixture& t) { if (t.clock >= 40U) t.consume = true; };
+        REQUIRE(identification::drain(transport, 200U) == DrainResult::Completed);
+        REQUIRE(transport.queued == 0U);
+    }
+    SECTION("persistent backpressure times out with existing queue intact") {
+        transport.consume = false;
+        REQUIRE(identification::drain(transport, 65U) == DrainResult::Timeout);
+        REQUIRE(transport.clock == 65U);
+        REQUIRE(transport.queued == 2U);
+    }
+    SECTION("nonadvancing clock cannot spin forever") {
+        transport.advance = false;
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Fault);
+        REQUIRE(transport.pumps < 20U);
+    }
+    SECTION("clock regression is a fault") {
+        transport.clock = 10U;
+        transport.afterPump = [](DrainFixture& t) { t.clock = 9U; };
+        REQUIRE(identification::drain(transport, 100U) == DrainResult::Fault);
+        REQUIRE(transport.pumps == 1U);
+    }
+}
+
+TEST_CASE("CW drain rechecks queue after idle observation", "[cwid][drain]") {
+    DrainFixture transport;
+    transport.queued = 0U;
+    transport.fifoIdleAt = 0U;
+    transport.afterStatus = [](const DrainFixture& value) {
+        auto& t = const_cast<DrainFixture&>(value);
+        if (!t.discovered) { t.discovered = true; t.queued = 1U; }
+    };
+    REQUIRE(identification::drain(transport, 200U) == DrainResult::Completed);
+    REQUIRE(transport.writes == 1U);
+    REQUIRE(transport.queued == 0U);
+    REQUIRE(transport.clock >= transport.freshAfterWriteAt);
+}
