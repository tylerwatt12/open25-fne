+/* Fences preceding serial commands through the normal response parser. */
+
+bool Modem::requestSerialBarrier()
+{
+    if (m_protoVer < 2U || m_error || m_serialBarrierPending.exchange(true))
+        return false;
+
+    const uint8_t request[3U] = {DVM_SHORT_FRAME_START, 3U, CMD_GET_VERSION};
+    if (write(request, sizeof(request)) != int(sizeof(request))) {
+        m_serialBarrierPending.store(false);
+        return false;
+    }
+    return true;
+}
+
+/* The CW owner excludes normal serial IO and restores its original mode. */
+
+bool Modem::boundedCWOperation(bool active)
+{
+    auto* uart = dynamic_cast<port::UARTPort*>(m_port);
+    if (uart != nullptr && !uart->boundedIO(active)) {
+        m_error = true;
+        // Never re-enter an unbounded reset/reconnect path after a failed
+        // transition into or out of bounded serial operation.
+        m_boundedCWOperation.store(true);
+        return false;
+    }
+    m_boundedCWOperation.store(active);
+    return true;
+}
