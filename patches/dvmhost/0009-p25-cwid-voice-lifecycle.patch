diff --git a/tests/CWIDUART_Tests.cpp b/tests/CWIDUART_Tests.cpp
new file mode 100644
index 0000000..fcc8e07
--- /dev/null
+++ b/tests/CWIDUART_Tests.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Actual POSIX PTYs and UART/parser methods; no physical modem or network. */
+#include "host/modem/Modem.h"
+#include "host/modem/port/UARTPort.h"
+#include <catch2/catch_test_macros.hpp>
+
+#if !defined(_WIN32)
+#if defined(__APPLE__)
+#include <util.h>
+#else
+#include <pty.h>
+#endif
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <array>
+#include <chrono>
+#include <future>
+#include <vector>
+#include <algorithm>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+
+struct LocalPTY {
+    int master = -1, slave = -1;
+    LocalPTY() {
+        REQUIRE(::openpty(&master, &slave, nullptr, nullptr, nullptr) == 0);
+        termios attributes{};
+        REQUIRE(::tcgetattr(slave, &attributes) == 0);
+        ::cfmakeraw(&attributes);
+        attributes.c_cc[VMIN] = 0;
+        attributes.c_cc[VTIME] = 0;
+        REQUIRE(::tcsetattr(slave, TCSANOW, &attributes) == 0);
+    }
+    ~LocalPTY() { if (master != -1) ::close(master); if (slave != -1) ::close(slave); }
+    int takeSlave() { const int result = slave; slave = -1; return result; }
+    void feed(const uint8_t* data, size_t size) {
+        REQUIRE(::write(master, data, size) == ssize_t(size));
+    }
+};
+
+class PTYUART final : public modem::port::UARTPort {
+public:
+    explicit PTYUART(int descriptor) : UARTPort(modem::port::SERIAL_115200) {
+        m_fd = descriptor;
+        m_isOpen = descriptor != -1;
+    }
+    ~PTYUART() override { close(); }
+    int descriptor() const { return m_fd; }
+};
+
+class PTYModem final : public modem::Modem {
+public:
+    explicit PTYModem(PTYUART* port) : Modem(port, true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U,
+        true, true, false, false, false, false) { m_protoVer = 4U; }
+};
+}
+
+TEST_CASE("Bounded UART restores the original POSIX descriptor flags", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    int original = ::fcntl(uart.descriptor(), F_GETFL, 0);
+    REQUIRE(original != -1);
+    SECTION("original blocking mode") { original &= ~O_NONBLOCK; }
+    SECTION("original nonblocking mode") { original |= O_NONBLOCK; }
+    REQUIRE(::fcntl(uart.descriptor(), F_SETFL, original) == 0);
+    original = ::fcntl(uart.descriptor(), F_GETFL, 0);
+    REQUIRE(uart.boundedIO(true));
+    REQUIRE((::fcntl(uart.descriptor(), F_GETFL, 0) & O_NONBLOCK) != 0);
+    REQUIRE(uart.boundedIO(true)); // A repeated enable cannot replace saved flags.
+    REQUIRE(uart.boundedIO(false));
+    REQUIRE(::fcntl(uart.descriptor(), F_GETFL, 0) == original);
+    REQUIRE(uart.boundedIO(false));
+}
+
+TEST_CASE("Bounded UART returns a partial actual PTY read without waiting for the remainder", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    REQUIRE(uart.boundedIO(true));
+    const std::array<uint8_t, 8U> first{{1U, 2U, 3U, 4U, 5U, 6U, 7U, 8U}};
+    pty.feed(first.data(), first.size());
+    std::array<uint8_t, 172U> out{};
+    auto read = std::async(std::launch::async, [&]() { return uart.read(out.data(), out.size()); });
+    const bool promptly = read.wait_for(std::chrono::milliseconds(200)) == std::future_status::ready;
+    if (!promptly) {
+        // Release a regressed blocking reader so the assertion can report the
+        // failure without leaving the whole offline suite hung indefinitely.
+        std::array<uint8_t, 164U> rest{};
+        pty.feed(rest.data(), rest.size());
+    }
+    const int got = read.get();
+    REQUIRE(promptly);
+    REQUIRE(got == int(first.size()));
+    REQUIRE(std::equal(first.begin(), first.end(), out.begin()));
+    REQUIRE(uart.read(out.data(), out.size()) == 0);
+}
+
+TEST_CASE("Bounded modem parses a fragmented 172-byte GET_VERSION on a real PTY", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    auto* uart = new PTYUART(pty.takeSlave());
+    const int original = ::fcntl(uart->descriptor(), F_GETFL, 0);
+    PTYModem modem(uart);
+    modem.suppressCWResets(true); // Early latch changes no descriptor state.
+    REQUIRE(::fcntl(uart->descriptor(), F_GETFL, 0) == original);
+    REQUIRE_FALSE(modem.hasError());
+    REQUIRE(modem.boundedCWOperation(true)); // Exercises the actual Modem-to-UART hook under ownership.
+    REQUIRE_FALSE(modem.hasError());
+    REQUIRE((::fcntl(uart->descriptor(), F_GETFL, 0) & O_NONBLOCK) != 0);
+    REQUIRE(modem.requestSerialBarrier());
+    std::array<uint8_t, 172U> reply{};
+    reply[0U] = 0xFEU; reply[1U] = 172U; reply[2U] = 0x00U; reply[3U] = 4U;
+    constexpr size_t firstSize = 24U;
+    pty.feed(reply.data(), firstSize);
+    auto clock = std::async(std::launch::async, [&]() { modem.clock(0U); });
+    const bool promptly = clock.wait_for(std::chrono::milliseconds(200)) == std::future_status::ready;
+    if (!promptly) pty.feed(reply.data() + firstSize, reply.size() - firstSize);
+    clock.get();
+    REQUIRE(promptly);
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    pty.feed(reply.data() + firstSize, reply.size() - firstSize);
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 1U);
+    REQUIRE_FALSE(modem.hasError());
+    REQUIRE(modem.boundedCWOperation(false));
+    REQUIRE_FALSE(modem.hasError());
+    const int restored = ::fcntl(uart->descriptor(), F_GETFL, 0);
+    REQUIRE(restored != -1);
+    // Darwin may add an unrelated kernel flag after actual PTY IO. Verify
+    // every mutable mode flag here; the no-IO test above checks full equality.
+    const int mutableFlags = O_NONBLOCK | O_ASYNC | O_APPEND;
+    REQUIRE((restored & mutableFlags) == (original & mutableFlags));
+}
+
+TEST_CASE("Bounded UART stops promptly at PTY backpressure and EOF", "[modem][cwid][uart]") {
+    LocalPTY pty;
+    PTYUART uart(pty.takeSlave());
+    REQUIRE(uart.boundedIO(true));
+    SECTION("backpressure returns a short write or zero without retrying forever") {
+        std::array<uint8_t, 1024U> data{};
+        bool limited = false;
+        for (unsigned i = 0U; i < 4096U; ++i) {
+            const auto start = Clock::now();
+            const int written = uart.write(data.data(), data.size());
+            REQUIRE(Clock::now() - start < std::chrono::milliseconds(200));
+            REQUIRE(written >= 0);
+            REQUIRE(written <= int(data.size()));
+            if (written < int(data.size())) { limited = true; break; }
+        }
+        REQUIRE(limited);
+    }
+    SECTION("closed peer does not cause a read or write spin") {
+        REQUIRE(::close(pty.master) == 0);
+        pty.master = -1;
+        uint8_t byte = 0U;
+        const auto start = Clock::now();
+        REQUIRE(uart.read(&byte, 1U) <= 0);
+        REQUIRE(uart.write(&byte, 1U) <= 0);
+        REQUIRE(Clock::now() - start < std::chrono::milliseconds(200));
+    }
+}
+
+TEST_CASE("A UART bounded-mode hook failure marks the modem unhealthy", "[modem][cwid][uart]") {
+    PTYModem modem(new PTYUART(-1));
+    REQUIRE_FALSE(modem.boundedCWOperation(true));
+    REQUIRE(modem.hasError());
+}
+#endif // !defined(_WIN32)
