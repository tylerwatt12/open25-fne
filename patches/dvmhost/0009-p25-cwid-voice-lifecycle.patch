+// Finish the already accepted voice queue under the Host writer lock. A
+// version reply fences prior serial responses before quiet status is accepted.
+class CWVoiceDrainTransport final : public identification::DrainTransport {
+public:
+    CWVoiceDrainTransport(p25::Control& controller, modem::Modem& modem, std::function<void()> heartbeat) :
+        m_controller(controller), m_modem(modem), m_heartbeat(std::move(heartbeat)),
+        m_lastPump(identificationNow()), m_lastStatus(modem.statusGeneration()),
+        m_barrierGeneration(modem.serialBarrierGeneration()), m_rejectGeneration(modem.p25WriteRejectGeneration()), m_quietSamples(0U),
+        m_barrierRequested(false), m_barrierPassed(false), m_failed(false) {}
+    uint64_t nowMs() const override { return identificationNow(); }
+    bool hasQueued() const override { return m_controller.peekFrameLength() != 0U; }
+    bool sendOne() override {
+        const uint32_t next = m_controller.peekFrameLength();
+        if (next == 0U) return true;
+        if (!m_modem.hasP25Space(next)) return true; // Backpressure; do not pop.
+        uint8_t data[P25DEF::P25_PDU_FRAME_LENGTH_BYTES * 2U];
+        if (next > sizeof(data)) return false;
+        bool immediate = false;
+        const uint32_t length = m_controller.getFrame(data, &immediate);
+        if (length == 0U || length != next) return false;
+        m_lastStatus = m_modem.statusGeneration();
+        m_quietSamples = 0U;
+        m_barrierRequested = m_barrierPassed = false;
+        return m_modem.writeP25Frame(data, length, immediate);
+    }
+    bool idleReady() const override {
+        if (hasQueued()) return false;
+        if (!m_barrierRequested) {
+            m_barrierGeneration = m_modem.serialBarrierGeneration();
+            m_barrierRequested = true;
+            if (!m_modem.requestSerialBarrier()) m_failed = true;
+            return false;
+        }
+        if (m_modem.serialBarrierGeneration() <= m_barrierGeneration) return false;
+        if (!m_barrierPassed) {
+            m_barrierPassed = true;
+            m_lastStatus = m_modem.statusGeneration();
+            m_quietSamples = 0U;
+            return false;
+        }
+        const uint64_t generation = m_modem.statusGeneration();
+        if (generation != m_lastStatus) {
+            m_lastStatus = generation;
+            if (!m_modem.hasTX() && m_modem.getState() == modem::STATE_P25)
+                ++m_quietSamples;
+            else
+                m_quietSamples = 0U;
+        }
+        return m_quietSamples >= 2U;
+    }
+    bool healthy() const override {
+        const bool hardStop = g_killed && g_signal != SIGINT && g_signal != SIGHUP;
+        return !m_failed && !hardStop && !m_modem.hasError() && !m_modem.hasLockout() &&
+            m_modem.p25WriteRejectGeneration() == m_rejectGeneration;
+    }
+    void pump(uint32_t milliseconds) override {
+        Thread::sleep(milliseconds);
+        const uint64_t now = nowMs();
+        m_heartbeat();
+        m_modem.clock(uint32_t(now - m_lastPump));
+        m_lastPump = now;
+        m_modem.clearP25Receive(); // Drop RF while quiesced; preserve parser/status framing.
+    }
+private:
+    p25::Control& m_controller;
+    modem::Modem& m_modem;
+    std::function<void()> m_heartbeat;
+    uint64_t m_lastPump;
+    mutable uint64_t m_lastStatus, m_barrierGeneration;
+    const uint64_t m_rejectGeneration;
+    mutable uint32_t m_quietSamples;
+    mutable bool m_barrierRequested, m_barrierPassed, m_failed;
+};
