+}
+
+TEST_CASE("Orphan ends preserve standalone LC and master-off voice behavior", "[p25][cwid][lifecycle]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode(false);
+    REQUIRE_FALSE(voice.voiceFrame(DUID::TDU));
+    REQUIRE_FALSE(voice.voiceFrame(DUID::TDULC, 0U));
+    REQUIRE(voice.rpc.releases.empty());
+    REQUIRE(voice.drainVoice().empty());
+    REQUIRE(voice.voiceFrame(DUID::TDULC, GROUP, true)); // A supported standalone group LC still relays.
+    REQUIRE_FALSE(voice.drainVoice().empty());
+    REQUIRE(voice.rpc.releases.empty());
+    voice.permitVoice("fedcba:1");
+    REQUIRE(voice.voiceFrame(DUID::HDU));
+    REQUIRE(voice.voiceFrame(DUID::TDU)); // HDU/preamble-only communication still ends.
+    REQUIRE(voice.rpc.releases == std::vector<uint32_t>{GROUP});
+    REQUIRE_FALSE(voice.controller->identificationUnavailable());
+    REQUIRE_FALSE(voice.controller->identificationPending());
+}
+
+TEST_CASE("Normal end drains every actual queued LDU and valid terminal tail before CW cleanup", "[p25][cwid][lifecycle]") {
+    ControllerFixture voice(true, false, false, false, false);
+    voice.voiceMode();
+    voice.permitVoice("ab12:1");
+    REQUIRE(voice.voiceFrame(DUID::HDU));
+    REQUIRE(voice.voiceFrame(DUID::LDU1));
+    REQUIRE(voice.voiceFrame(DUID::LDU2));
+    REQUIRE(voice.voiceFrame(DUID::LDU1));
+    REQUIRE(voice.voiceFrame(DUID::TDU));
+    REQUIRE(voice.controller->identificationUnavailable());
+    REQUIRE(voice.controller->tryBeginIdentification());
+    voice.controller->queueIdentificationTail();
+    struct ActualQueueDrain : identification::DrainTransport {
+        Control& control;
+        uint64_t clock = 0U, lastWrite = 0U;
+        std::vector<DUID::E> output;
+        std::vector<uint32_t> terminalDestinations;
+        explicit ActualQueueDrain(Control& value) : control(value) {}
+        uint64_t nowMs() const override { return clock; }
+        bool hasQueued() const override { return control.peekFrameLength() != 0U; }
+        bool sendOne() override {
+            std::array<uint8_t, 1024U> frame{};
+            const uint32_t length = control.getFrame(frame.data());
+            REQUIRE(length > 0U);
+            NID nid(0x293U);
+            if (!nid.decode(frame.data() + 2U)) {
+                REQUIRE(std::all_of(frame.begin() + 2U, frame.begin() + length,
+                    [](uint8_t value) { return value == 0U; })); // Native tail padding is not a P25 data unit.
+                lastWrite = clock;
+                return true;
+            }
+            output.push_back(nid.getDUID());
+            if (nid.getDUID() == DUID::TDULC) {
+                lc::tdulc::LC_CALL_TERM end;
+                REQUIRE(end.decode(frame.data() + 2U));
+                terminalDestinations.push_back(end.getDstId());
+            }
+            lastWrite = clock;
+            return true;
+        }
+        bool idleReady() const override { return clock >= lastWrite + 750U; }
+        bool healthy() const override { return true; }
+        void pump(uint32_t milliseconds) override { clock += milliseconds; }
+    } drain(*voice.controller);
+    REQUIRE(identification::drain(drain, 2000U) == identification::DrainResult::Completed);
+    REQUIRE(std::count(drain.output.begin(), drain.output.end(), DUID::LDU1) == 2U);
+    REQUIRE(std::count(drain.output.begin(), drain.output.end(), DUID::LDU2) == 1U);
+    const auto lastAudio = std::find_if(drain.output.rbegin(), drain.output.rend(), [](DUID::E duid) {
+        return duid == DUID::LDU1 || duid == DUID::LDU2;
+    }).base();
+    const auto firstTerm = std::find_if(drain.output.begin(), drain.output.end(), [](DUID::E duid) {
+        return duid == DUID::TDU || duid == DUID::TDULC;
+    });
+    REQUIRE(firstTerm != drain.output.end());
+    REQUIRE(lastAudio <= firstTerm); // Every accepted LDU precedes terminal RF; presence alone is insufficient.
+    REQUIRE_FALSE(drain.terminalDestinations.empty());
+    for (const auto target : drain.terminalDestinations) REQUIRE(target == GROUP);
+    REQUIRE(drain.clock >= drain.lastWrite + 750U); // Software-empty alone was insufficient.
+    voice.controller->clearIdentificationTraffic();
+    voice.controller->reset();
+    voice.controller->completeIdentification();
+    REQUIRE_FALSE(voice.controller->writeRF_VoiceEnd());
+    REQUIRE(voice.drainVoice().empty());
+    REQUIRE_FALSE(voice.voiceFrame(DUID::TDU));
+    REQUIRE(voice.drainVoice().empty());
+    REQUIRE_FALSE(voice.controller->identificationPending());
+}
