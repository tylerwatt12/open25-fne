+
+namespace {
+// Feed complete or fragmented actual serial packets through Modem::clock and
+// getResponse. No modem open/firmware handshake, socket, or wall-clock sleeps.
+class FeedModemPort final : public modem::port::IModemPort {
+public:
+    std::deque<uint8_t> input;
+    std::vector<std::vector<uint8_t>> writes;
+    bool shortWrite = false;
+    unsigned opens = 0U, closes = 0U;
+    bool open() override { ++opens; return true; }
+    void close() override { ++closes; }
+    int read(uint8_t* out, uint32_t length) override {
+        const uint32_t count = std::min<uint32_t>(length, uint32_t(input.size()));
+        for (uint32_t i = 0U; i < count; ++i) {
+            out[i] = input.front();
+            input.pop_front();
+        }
+        return int(count);
+    }
+    int write(const uint8_t* data, uint32_t length) override {
+        writes.emplace_back(data, data + length);
+        return int(length) - (shortWrite ? 1 : 0);
+    }
+    void feed(const std::vector<uint8_t>& bytes) { input.insert(input.end(), bytes.begin(), bytes.end()); }
+};
+
+class BarrierModem final : public modem::Modem {
+public:
+    explicit BarrierModem(FeedModemPort* port) : Modem(port, true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U,
+        true, true, false, false, false, false) {
+        // Represents the protocol already established by ordinary open().
+        m_protoVer = 4U;
+    }
+};
+
+std::vector<uint8_t> versionReply(uint8_t protocol = 4U, size_t size = 21U) {
+    std::vector<uint8_t> packet(size, 0U);
+    packet[0U] = 0xFEU;
+    packet[1U] = uint8_t(size);
+    packet[2U] = 0x00U;
+    if (size > 3U) packet[3U] = protocol;
+    return packet;
+}
+std::vector<uint8_t> idleStatus() {
+    return {0xFEU, 12U, 0x01U, 0x08U, uint8_t(modem::STATE_P25), 0U, 0U, 0U, 0U, 0U, 10U, 0U};
+}
+}
+
+TEST_CASE("Serial barrier is one text-free GET_VERSION request with no reopen or retry", "[modem][cwid][serial-barrier]") {
+    auto* port = new FeedModemPort;
+    BarrierModem modem(port);
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    REQUIRE(modem.requestSerialBarrier());
+    REQUIRE_FALSE(modem.requestSerialBarrier());
+    REQUIRE(port->writes.size() == 1U);
+    const std::vector<uint8_t> expected{0xFEU, 3U, 0x00U};
+    REQUIRE(port->writes.front() == expected);
+    REQUIRE(port->opens == 0U);
+    REQUIRE(port->closes == 0U);
+    // Receipt, not submission, advances the fence.
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    port->feed(versionReply());
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 1U);
+    REQUIRE_FALSE(modem.hasError());
+    REQUIRE(modem.requestSerialBarrier());
+    REQUIRE(port->writes.size() == 2U);
+    port->feed(versionReply());
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 2U);
+}
+
+TEST_CASE("Serial barrier rejects unsolicited, malformed, or mismatched version replies", "[modem][cwid][serial-barrier]") {
+    auto* port = new FeedModemPort;
+    BarrierModem modem(port);
+    SECTION("unsolicited valid reply cannot advance the generation") {
+        port->feed(versionReply());
+        modem.clock(0U);
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+        REQUIRE_FALSE(modem.hasError());
+    }
+    SECTION("short reply clears pending and fails closed") {
+        REQUIRE(modem.requestSerialBarrier());
+        port->feed(versionReply(4U, 4U));
+        modem.clock(0U);
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+        REQUIRE(modem.hasError());
+        // A late valid version after failure is no longer a pending fence.
+        port->feed(versionReply());
+        modem.clock(0U);
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+        REQUIRE_FALSE(modem.requestSerialBarrier());
+    }
+    SECTION("protocol mismatch cannot satisfy the barrier") {
+        REQUIRE(modem.requestSerialBarrier());
+        port->feed(versionReply(3U));
+        modem.clock(0U);
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+        REQUIRE(modem.hasError());
+    }
+    SECTION("version command NAK fails closed") {
+        REQUIRE(modem.requestSerialBarrier());
+        port->feed({0xFEU, 5U, 0x7FU, 0x00U, 1U});
+        modem.clock(0U);
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+        REQUIRE(modem.hasError());
+    }
+}
+
+TEST_CASE("Serial barrier observes preceding packets and waits for a complete framed reply", "[modem][cwid][serial-barrier]") {
+    auto* port = new FeedModemPort;
+    BarrierModem modem(port);
+    REQUIRE(modem.requestSerialBarrier());
+    port->feed(idleStatus());
+    port->feed({0xFEU, 21U, 0x00U, 4U});
+    modem.clock(0U); // The older idle status is not the command's fence.
+    REQUIRE(modem.statusGeneration() == 1U);
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    modem.clock(0U); // Incomplete version payload remains pending.
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    const auto version = versionReply();
+    port->feed(std::vector<uint8_t>(version.begin() + 4U, version.end()));
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 1U);
+    REQUIRE(modem.statusGeneration() == 1U);
+    // Duplicate unsolicited version packets cannot create another barrier.
+    port->feed(versionReply());
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 1U);
+    port->feed(idleStatus());
+    modem.clock(0U);
+    REQUIRE(modem.statusGeneration() == 2U);
+    REQUIRE_FALSE(modem.hasError());
+}
+
+TEST_CASE("Serial barrier short writes clear the pending reservation without retry", "[modem][cwid][serial-barrier]") {
+    auto* port = new FeedModemPort;
+    BarrierModem modem(port);
+    port->shortWrite = true;
+    REQUIRE_FALSE(modem.requestSerialBarrier());
+    REQUIRE(port->writes.size() == 1U);
+    port->feed(versionReply());
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 0U);
+    port->shortWrite = false;
+    REQUIRE(modem.requestSerialBarrier());
+    REQUIRE(port->writes.size() == 2U);
+    port->feed(versionReply());
+    modem.clock(0U);
+    REQUIRE(modem.serialBarrierGeneration() == 1U);
+}
+
+TEST_CASE("Normal P25 firmware NAKs advance the drain rejection generation only", "[modem][cwid][drain-nak]") {
+    auto* port = new FeedModemPort;
+    BarrierModem modem(port);
+    REQUIRE(modem.p25WriteRejectGeneration() == 0U);
+    // Both a FIFO refusal and another firmware reason invalidate a drain
+    // attempt; a full serial write is insufficient evidence of acceptance.
+    for (uint8_t reason : {uint8_t(8U), uint8_t(1U)}) {
+        const auto before = modem.p25WriteRejectGeneration();
+        port->feed({0xFEU, 5U, 0x7FU, 0x31U, reason});
+        modem.clock(0U);
+        REQUIRE(modem.p25WriteRejectGeneration() == before + 1U);
+        REQUIRE_FALSE(modem.hasError());
+        REQUIRE(modem.serialBarrierGeneration() == 0U);
+    }
+    const auto rejected = modem.p25WriteRejectGeneration();
+    port->feed({0xFEU, 5U, 0x7FU, 0x18U, 1U}); // Unrelated DMR command NAK.
+    modem.clock(0U);
+    REQUIRE(modem.p25WriteRejectGeneration() == rejected);
+    REQUIRE_FALSE(modem.hasError());
+    port->feed(idleStatus());
+    modem.clock(0U);
+    REQUIRE(modem.p25WriteRejectGeneration() == rejected);
+    REQUIRE(modem.statusGeneration() == 1U);
+    REQUIRE(port->writes.empty()); // No retry or reopen was triggered.
+    REQUIRE(port->opens == 0U);
+    REQUIRE(port->closes == 0U);
+}
