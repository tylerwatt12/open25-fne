+// AABC-E 6.1.9.1 / Figure 6.1.9-1, PDF108 / printed89:
+// literal abbreviated affiliation request, System1, group101, 24-bit source.
+// AABD-B 6.7.2.1(b), PDF62 / printed57 requires DENY_RSP for invalid WUID.
+TEST_CASE("invalid working unit identities receive affiliation service denials instead of group refusals", "[p25][zero-capacity][affiliation-denial]") {
+    ControllerFixture fixture(false,false,true);
+    std::array<uint8_t,3U> source{{0x00U,0x03U,0xE9U}}; //1001, enabled but not registered.
+    SECTION("enabled unregistered unit") {}
+    SECTION("disabled unit") { source[2]=0xEBU; } //1003
+    SECTION("unknown unit") { source[2]=0xECU; } //1004
+    SECTION("null working address") { source={{0x00U,0x00U,0x00U}}; }
+    SECTION("all-unit reserved address") { source={{0xFFU,0xFFU,0xFFU}}; }
+    ControllerFixture::RawBlock request{{0xA8U,0x00U,0x00U,0x00U,0x01U,0x00U,0x65U,
+        source[0],source[1],source[2],0x00U,0x00U}};
+    edac::CRC::addCCITT162(request.data(),request.size());
+    REQUIRE(fixture.receiveRaw(request));
+    auto replies=fixture.drain(); REQUIRE(replies.size()==2U); //Existing demandUnitRegForRefusedAff policy.
+    const auto* wire=replies.front()->getDecodedRaw(); REQUIRE(wire!=nullptr);
+    REQUIRE((wire[0]&0x3fU)==0x27U); //DENY_RSP, not GRP_AFF_RSP0x28.
+    REQUIRE(wire[1]==0x00U); REQUIRE((wire[2]&0x3fU)==0x28U); //denied service.
+    REQUIRE(wire[3]==0x10U); //Chosen Requesting Unit Not Valid reason.
+    REQUIRE(wire[7]==source[0]); REQUIRE(wire[8]==source[1]); REQUIRE(wire[9]==source[2]);
+    const auto* registration=replies.back()->getDecodedRaw(); REQUIRE(registration!=nullptr);
+    REQUIRE((registration[0]&0x3fU)==0x2DU);
+    REQUIRE(registration[4]==source[0]); REQUIRE(registration[5]==source[1]); REQUIRE(registration[6]==source[2]);
+    REQUIRE(fixture.controller->affiliations()->grpAffSize()==0U);
+    REQUIRE(fixture.controller->affiliations()->grantSize()==0U);
+    REQUIRE(fixture.channels.rfChDataSize()==0U);
 }
