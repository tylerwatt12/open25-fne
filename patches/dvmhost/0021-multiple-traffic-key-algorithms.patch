+// SPDX-License-Identifier: GPL-2.0-only
+/* Actual RF/DFSI voice-path regression tests. All modem/network ports remain
+ * unopened. Cipher correctness is qualified separately by packet-codec vectors;
+ * these valid FEC frames exercise admission, accepted ESS state and repetition. */
+#include "host/Host.h"
+#include "host/p25/Control.h"
+#include "host/modem/port/ModemNullPort.h"
+#include "common/p25/Audio.h"
+#include "common/p25/NID.h"
+#include "common/p25/P25Utils.h"
+#include "common/p25/Sync.h"
+#include "common/Log.h"
+#include <catch2/catch_test_macros.hpp>
+#include <algorithm>
+#include <array>
+#include <deque>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+using namespace p25;
+using namespace p25::defines;
+constexpr uint32_t Source = 10001U, Group = 1001U, NAC = 0x293U;
+using MI = std::array<uint8_t, MI_LENGTH_BYTES>;
+
+class VoiceNetwork : public network::Network {
+public:
+    std::deque<std::vector<uint8_t>> incoming;
+    std::vector<std::vector<uint8_t>> outgoing;
+    VoiceNetwork() : Network("127.0.0.1", 49991U, 0U, 100101001U, "unopened-voice-test", true, false,
+        false, true, false, false, false, false, false, false, false, false) { m_status = network::NET_STAT_RUNNING; }
+    UInt8Array readP25(bool& available, uint32_t& length) override {
+        available = !incoming.empty(); length = 0U;
+        if (!available) return nullptr;
+        auto bytes = std::move(incoming.front()); incoming.pop_front(); length = bytes.size();
+        UInt8Array result(new uint8_t[length]); std::copy(bytes.begin(), bytes.end(), result.get()); return result;
+    }
+    void resetP25() override { incoming.clear(); }
+    using network::BaseNetwork::createP25_LDU1Message;
+    using network::BaseNetwork::createP25_LDU2Message;
+    bool writeP25LDU1(const lc::LC& control, const p25::data::LowSpeedData& lsd, const uint8_t* data,
+        FrameType::E type, uint8_t flags) override {
+        uint32_t length; auto message = createP25_LDU1Message(length, control, lsd, data, type, flags);
+        outgoing.emplace_back(message.get(), message.get() + length); return true;
+    }
+    bool writeP25LDU2(const lc::LC& control, const p25::data::LowSpeedData& lsd, const uint8_t* data,
+        uint8_t flags) override {
+        uint32_t length; auto message = createP25_LDU2Message(length, control, lsd, data, flags);
+        outgoing.emplace_back(message.get(), message.get() + length); return true;
+    }
+};
+
+struct Observed {
+    DUID::E duid;
+    uint32_t source, group, key;
+    uint8_t algorithm;
+    bool secure;
+    MI mi;
+};
+
+struct VoiceFixture {
+    ::lookups::ChannelLookup channels;
+    ::lookups::RadioIdLookup radios{"", 0U, false};
+    ::lookups::TalkgroupRulesLookup groups{"", 0U, false};
+    ::lookups::IdenTableLookup identities{"", 0U};
+    ::lookups::RSSIInterpolator rssi;
+    modem::Modem modem{new modem::port::ModemNullPort(), true, false, false, false,
+        false, false, 0U, 0U, 0U, 8192U, 8192U, 8192U,
+        true, true, false, false, false, false};
+    VoiceNetwork network;
+    network::NetRPC rpc{"127.0.0.1", 48991U, 0U, "unopened-voice-test", false};
+    network::NetRPC* previousRPC = g_RPC;
+    std::unique_ptr<Control> controller;
+    uint8_t algorithm;
+    uint16_t key;
+    VoiceFixture(uint8_t selectedAlgorithm, uint16_t selectedKey) : algorithm(selectedAlgorithm), key(selectedKey) {
+        g_logDisplayLevel = 0U;
+        g_RPC = &rpc;
+        controller = std::make_unique<Control>(true, NAC, 1U, 16384U, &modem, &network, 120U, 1U, true,
+            &channels, &radios, &groups, &identities, &rssi, false, false, false, false, false);
+        yaml::Node configuration;
+        REQUIRE(yaml::Parse(configuration, std::string(R"(
+protocols:
+    p25:
+        verifyReg: false
+        verifyAff: false
+        inhibitUnauthorized: false
+        tduPreambleCount: 0
+        rfTalkgroupSecurity:
+            - talkgroup: 1001
+              mode: secure
+              algorithmId: )") + std::to_string(algorithm) + R"(
+              keyId: )" + std::to_string(key) + R"(
+        control:
+            enable: false
+            dedicated: false
+system:
+    config:
+        controlCh:
+            notifyEnable: false
+)"));
+        controller->setOptions(configuration, false, "N0TEST", ::lookups::VoiceChData(), 1U, 1U, 1U, 1U, 2U, 25U, false);
+        controller->setCCRunning(false);
+        controller->configureIdentification(false);
+    }
+    ~VoiceFixture() { controller.reset(); g_RPC = previousRPC; }
+    lc::LC control(uint8_t selectedAlgorithm, uint16_t selectedKey, const MI& mi) const {
+        lc::LC value; value.setLCO(LCO::GROUP); value.setGroup(true);
+        value.setSrcId(Source); value.setDstId(Group);
+        value.setNetId(1U); value.setSysId(1U);
+        value.setEncrypted(selectedAlgorithm != ALGO_UNENCRYPT);
+        value.setAlgId(selectedAlgorithm); value.setKId(selectedKey); value.setMI(mi.data());
+        return value;
+    }
+    std::vector<uint8_t> frame(DUID::E duid, uint8_t selectedAlgorithm, uint16_t selectedKey, const MI& mi) const {
+        const uint32_t length = duid == DUID::HDU ? P25_HDU_FRAME_LENGTH_BYTES : P25_LDU_FRAME_LENGTH_BYTES;
+        std::vector<uint8_t> result(length + 2U, 0U);
+        result[0U] = modem::TAG_DATA; result[1U] = 1U;
+        auto value = control(selectedAlgorithm, selectedKey, mi);
+        if (duid != DUID::HDU) {
+            Audio audio; for (unsigned i = 0U; i < 9U; ++i) audio.encode(result.data() + 2U, NULL_IMBE, i);
+        }
+        if (duid == DUID::HDU) value.encodeHDU(result.data() + 2U);
+        if (duid == DUID::LDU1) value.encodeLDU1(result.data() + 2U);
+        if (duid == DUID::LDU2) value.encodeLDU2(result.data() + 2U);
+        Sync::addP25Sync(result.data() + 2U); NID nid(NAC); nid.encode(result.data() + 2U, duid);
+        P25Utils::addStatusBits(result.data() + 2U, length * 8U, true, false);
+        return result;
+    }
+    bool rf(DUID::E duid, const MI& mi, uint8_t selectedAlgorithm = 0U, uint16_t selectedKey = UINT16_MAX) {
+        auto bytes = frame(duid, selectedAlgorithm ? selectedAlgorithm : algorithm,
+            selectedKey == UINT16_MAX ? key : selectedKey, mi);
+        return controller->processFrame(bytes.data(), bytes.size());
+    }
+    void net(DUID::E duid, const MI& mi, bool initial = false, uint8_t selectedAlgorithm = 0U, uint16_t selectedKey = UINT16_MAX) {
+        auto value = control(selectedAlgorithm ? selectedAlgorithm : algorithm,
+            selectedKey == UINT16_MAX ? key : selectedKey, mi);
+        auto bytes = frame(duid, value.getAlgId(), value.getKId(), mi);
+        p25::data::LowSpeedData lsd; uint32_t length = 0U; UInt8Array message;
+        if (duid == DUID::LDU1) message = network.createP25_LDU1Message(length, value, lsd,
+            bytes.data() + 2U, initial ? FrameType::HDU_VALID : FrameType::DATA_UNIT, 0U);
+        else message = network.createP25_LDU2Message(length, value, lsd, bytes.data() + 2U, 0U);
+        network.incoming.emplace_back(message.get(), message.get() + length);
+        controller->clock();
+        REQUIRE(network.incoming.empty());
+    }
+    std::vector<Observed> drain() {
+        std::vector<Observed> result; std::array<uint8_t, 1024U> bytes{};
+        while (controller->getFrame(bytes.data()) != 0U) {
+            NID nid(NAC); if (!nid.decode(bytes.data() + 2U)) continue;
+            lc::LC value; const auto duid = nid.getDUID();
+            if (duid == DUID::HDU) REQUIRE(value.decodeHDU(bytes.data() + 2U));
+            else if (duid == DUID::LDU1) REQUIRE(value.decodeLDU1(bytes.data() + 2U));
+            else if (duid == DUID::LDU2) REQUIRE(value.decodeLDU2(bytes.data() + 2U));
+            else continue;
+            Observed observation{duid, value.getSrcId(), value.getDstId(), value.getKId(), value.getAlgId(), value.getEncrypted(), {}};
+            value.getMI(observation.mi.data()); result.push_back(observation);
+        }
+        return result;
+    }
+    void requireLDU(DUID::E duid, const MI& mi) {
+        const auto emitted = drain();
+        const auto found = std::find_if(emitted.begin(), emitted.end(), [&](const Observed& value) { return value.duid == duid; });
+        REQUIRE(found != emitted.end());
+        REQUIRE(found->secure);
+        if (duid == DUID::LDU1) { REQUIRE(found->source == Source); REQUIRE(found->group == Group); }
+        if (duid == DUID::LDU2) { REQUIRE(found->algorithm == algorithm); REQUIRE(found->key == key); REQUIRE(found->mi == mi); }
+    }
+    void requireForwardedIdentity() {
+        REQUIRE_FALSE(network.outgoing.empty());
+        for (const auto& bytes : network.outgoing) {
+            const uint32_t source = GET_UINT24(bytes.data(), 5U);
+            const uint32_t group = GET_UINT24(bytes.data(), 8U);
+            REQUIRE(source == Source);
+            REQUIRE(group == Group);
+        }
+    }
+};
+}
+
+TEST_CASE("rejected RF encryption headers preserve the active voice session", "[p25][crypto][voice-path]") {
+    for (uint8_t algorithm : {0x81U, 0x84U, 0xaaU}) for (uint16_t key : {0U, 7U}) {
+        CAPTURE(algorithm, key);
+        VoiceFixture fixture(algorithm, key);
+        MI first{1U, 2U, 3U, 4U, 5U, 6U, 7U, 8U, 0U};
+        REQUIRE(fixture.rf(DUID::HDU, first)); fixture.drain();
+        REQUIRE(fixture.rf(DUID::LDU1, first)); fixture.requireLDU(DUID::LDU1, first);
+        REQUIRE(fixture.controller->getRFState() == RS_RF_AUDIO);
+        const auto forwarded = fixture.network.outgoing.size();
+        // Reject actual short buffers before NID/FEC decoding, without
+        // replacing the accepted RF session or its encryption metadata.
+        for (DUID::E duid : {DUID::HDU, DUID::LDU1, DUID::LDU2}) {
+            auto truncated = fixture.frame(duid, algorithm, key, first);
+            truncated.resize(truncated.size() - 1U);
+            REQUIRE_FALSE(fixture.controller->processFrame(truncated.data(), truncated.size()));
+        }
+        auto noNID = fixture.frame(DUID::LDU1, algorithm, key, first);
+        for (size_t length : {0U, 1U, 2U, 8U, 16U})
+            REQUIRE_FALSE(fixture.controller->processFrame(noNID.data(), length));
+        REQUIRE_FALSE(fixture.rf(DUID::HDU, first, algorithm, uint16_t(key + 1U)));
+        REQUIRE_FALSE(fixture.rf(DUID::HDU, first, algorithm == 0x81U ? 0x84U : 0x81U, key));
+        REQUIRE(fixture.drain().empty()); REQUIRE(fixture.network.outgoing.size() == forwarded);
+        REQUIRE(fixture.controller->getRFState() == RS_RF_AUDIO);
+        for (unsigned pair = 0U; pair < 3U; ++pair) {
+            MI next = first; next[7U] = uint8_t(9U + pair);
+            REQUIRE_FALSE(fixture.rf(DUID::LDU2, next, algorithm, uint16_t(key + 1U)));
+            REQUIRE_FALSE(fixture.rf(DUID::LDU2, next, algorithm == 0x81U ? 0x84U : 0x81U, key));
+            REQUIRE(fixture.drain().empty());
+            REQUIRE(fixture.rf(DUID::LDU2, next)); fixture.requireLDU(DUID::LDU2, next);
+            REQUIRE(fixture.rf(DUID::LDU1, next)); fixture.requireLDU(DUID::LDU1, next);
+        }
+        fixture.requireForwardedIdentity();
+    }
+}
+
+TEST_CASE("network secure voice retains accepted ESS across ordinary LDU1s and rejected ESS", "[p25][crypto][voice-path]") {
+    for (uint8_t algorithm : {0x81U, 0x84U, 0xaaU}) for (uint16_t key : {0U, 7U}) {
+        CAPTURE(algorithm, key);
+        VoiceFixture fixture(algorithm, key);
+        MI first{8U, 7U, 6U, 5U, 4U, 3U, 2U, 1U, 0U};
+        fixture.net(DUID::LDU1, first, true);
+        // The RF engine buffers the first LDU1 until the first LDU2 completes
+        // setup. Start with an accepted pair before testing rejected ESS.
+        fixture.net(DUID::LDU2, first); fixture.requireLDU(DUID::LDU1, first);
+        for (unsigned pair = 0U; pair < 3U; ++pair) {
+            MI next = first; next[7U] = uint8_t(11U + pair);
+            fixture.net(DUID::LDU2, next, false, algorithm, uint16_t(key + 1U));
+            fixture.net(DUID::LDU2, next, false, algorithm == 0x81U ? 0x84U : 0x81U, key);
+            REQUIRE(fixture.drain().empty());
+            // No valid ESS has arrived to repair the state. An ordinary
+            // LDU1 must still use the previously accepted security identity.
+            fixture.net(DUID::LDU1, first); fixture.requireLDU(DUID::LDU1, first);
+            fixture.net(DUID::LDU2, next); fixture.requireLDU(DUID::LDU2, next);
+            fixture.net(DUID::LDU1, next); fixture.requireLDU(DUID::LDU1, next);
+        }
+        REQUIRE(fixture.network.outgoing.empty()); // Network voice must not loop back to its input.
+    }
+}
