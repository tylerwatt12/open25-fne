+// SPDX-License-Identifier: GPL-2.0-only
+// Current Zone intent and local RFSS observations are distinct; no wire fields.
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace p25 {
+struct InhibitDesired { uint32_t radioId = 0U; bool inhibited = false; };
+struct InhibitRestore { uint32_t radioId = 0U; bool blocked = false; bool pendingUninhibit = false; };
+struct InhibitStatus {
+    uint32_t radioId = 0U; bool desiredInhibited = false; bool blocked = false;
+    bool pendingUninhibit = false; std::string procedure = "idle"; uint32_t attempts = 0U;
+};
+struct InhibitResult { uint32_t status = 200U; std::string message = "OK"; std::vector<InhibitStatus> radios; };
+}
