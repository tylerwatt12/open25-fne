+namespace {
+bool inhibitRadioId(const json::value& value, uint32_t& id)
+{
+    if (!value.is<double>()) return false;
+    const double number = value.get<double>();
+    if (!std::isfinite(number) || number < 1.0 || number > 16777211.0 || std::floor(number) != number) return false;
+    id = static_cast<uint32_t>(number); return true;
+}
+void inhibitResponse(HTTPPayload& reply, const p25::InhibitResult& result)
+{
+    if (result.status != 200U) { errorPayload(reply, result.message, static_cast<HTTPPayload::StatusType>(result.status)); return; }
+    json::object response; setResponseDefaultStatus(response); json::array rows;
+    for (const auto& item : result.radios) {
+        json::object row; row["radio_id"].set<uint32_t>(item.radioId); row["desired_inhibited"].set<bool>(item.desiredInhibited);
+        row["blocked"].set<bool>(item.blocked); row["pending_uninhibit"].set<bool>(item.pendingUninhibit);
+        row["procedure"].set<std::string>(item.procedure); row["attempts"].set<uint32_t>(item.attempts);
+        json::value value; value.set<json::object>(row); rows.push_back(value);
+    }
+    const uint32_t count = rows.size(), limit = 32U;
+    response["radios"].set<json::array>(rows); response["record_count"].set<uint32_t>(count);
+    response["record_limit"].set<uint32_t>(limit); reply.payload(response);
+}
+}
+void RESTAPI::restAPI_GetP25InhibitPolicy(const HTTPPayload& request, HTTPPayload& reply, const RequestMatch& match)
+{
+    if (!validateAuth(request, reply)) return;
+    if (m_p25 == nullptr) { errorPayload(reply, "P25 mode is not enabled", HTTPPayload::SERVICE_UNAVAILABLE); return; }
+    inhibitResponse(reply, m_p25->control()->inhibitSnapshot());
+}
+void RESTAPI::restAPI_PutP25InhibitPolicy(const HTTPPayload& request, HTTPPayload& reply, const RequestMatch& match)
+{
+    if (!validateAuth(request, reply)) return;
+    if (m_p25 == nullptr) { errorPayload(reply, "P25 mode is not enabled", HTTPPayload::SERVICE_UNAVAILABLE); return; }
+    if (request.content.size() > 4096U) { errorPayload(reply, "inhibit policy body exceeds 4096 bytes"); return; }
+    json::object req; if (!parseRequestBody(request, reply, req)) return;
+    if (!req["radios"].is<json::array>()) { errorPayload(reply, "radios must be the complete desired array"); return; }
+    for (const auto& item : req) if (item.first != "radios" && item.first != "control_state") { errorPayload(reply, "unknown inhibit policy field"); return; }
+    const auto rows = req["radios"].get<json::array>();
+    if (rows.size() > 32U) { errorPayload(reply, "inhibit policy exceeds 32 records"); return; }
+    std::vector<p25::InhibitDesired> desired; std::vector<p25::InhibitRestore> mirror;
+    for (const auto& value : rows) {
+        if (!value.is<json::object>()) { errorPayload(reply, "each desired record must be an object"); return; }
+        auto row = value.get<json::object>();
+        uint32_t radioId = 0U;
+        if (row.size() != 2U || !inhibitRadioId(row["radio_id"], radioId) || !row["inhibited"].is<bool>()) { errorPayload(reply, "desired record requires radio_id and inhibited only"); return; }
+        desired.push_back(p25::InhibitDesired{radioId,row["inhibited"].get<bool>()});
+    }
+    const bool hasMirror = req.find("control_state") != req.end();
+    if (hasMirror) {
+        if (!req["control_state"].is<json::array>()) { errorPayload(reply, "control_state must be an array"); return; }
+        const auto actual = req["control_state"].get<json::array>();
+        if (actual.size() > 32U) { errorPayload(reply, "control_state exceeds 32 records"); return; }
+        for (const auto& value : actual) {
+            if (!value.is<json::object>()) { errorPayload(reply, "each control_state record must be an object"); return; }
+            auto row = value.get<json::object>();
+            uint32_t radioId = 0U;
+            if (row.size() != 3U || !inhibitRadioId(row["radio_id"], radioId) || !row["blocked"].is<bool>() || !row["pending_uninhibit"].is<bool>()) { errorPayload(reply, "control_state requires radio_id, blocked and pending_uninhibit only"); return; }
+            mirror.push_back(p25::InhibitRestore{radioId,row["blocked"].get<bool>(),row["pending_uninhibit"].get<bool>()});
+        }
+    }
+    inhibitResponse(reply, m_p25->control()->updateInhibitPolicy(desired,mirror,hasMirror,750U));
+}
