@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// AABD-B13.3/13.4: operational RFSS inhibition is distinct from provisioning.
+#include "p25/packet/ControlSignaling.h"
+#include "common/p25/acl/AccessControl.h"
+#include "common/p25/lc/tsbk/IOSP_ACK_RSP.h"
+#include "common/Log.h"
+#include <atomic>
+using namespace p25;
+using namespace p25::packet;
+using namespace p25::defines;
+namespace { constexpr size_t MAX_INHIBIT_RADIOS=32U, MAX_INHIBIT_OPERATIONS=16U;
+constexpr uint32_t INHIBIT_WAIT_MS=2000U, INHIBIT_ATTEMPTS=5U;
+bool active(const std::string& state){return state=="queued"||state=="awaiting";}
+}
+
+bool ControlSignaling::validInhibitRID(uint32_t radio) const
+{
+    return radio>0U && radio<0xFFFFFCU && m_p25->m_dispatchSubscribers.count(radio)!=0U;
+}
+bool ControlSignaling::isInhibited(uint32_t target) const
+{
+    const auto blocked=std::atomic_load(&m_blockedRadios);
+    return blocked->count(target)!=0U;
+}
+void ControlSignaling::publishInhibitionLocked()
+{
+    auto blocked=std::make_shared<std::set<uint32_t>>();
+    for(const auto& item:m_inhibitions)if(item.second.blocked)blocked->insert(item.first);
+    std::shared_ptr<const std::set<uint32_t>> snapshot=blocked;
+    std::atomic_store(&m_blockedRadios,snapshot);
+}
+InhibitResult ControlSignaling::inhibitSnapshotLocked() const
+{
+    InhibitResult out;
+    for(const auto& item:m_inhibitions){const auto& r=item.second;
+        out.radios.push_back(InhibitStatus{item.first,r.desired,r.blocked,r.pending,r.procedure,r.attempts});}
+    return out;
+}
+InhibitResult ControlSignaling::inhibitSnapshot()
+{
+    std::lock_guard<std::mutex> lock(m_inhibitMutex);return inhibitSnapshotLocked();
+}
+void ControlSignaling::emitInhibitState(uint32_t target,const InhibitRecord& r)
+{
+    LogInfoEx(LOG_HOST,"P25 Inhibit State, radio_id = %u, desired_inhibited = %u, blocked = %u, pending_uninhibit = %u, attempts = %u",
+        target,r.desired,r.blocked,r.pending,r.attempts);
+}
+bool ControlSignaling::configureInhibitions(yaml::Node policy)
+{
+    if(!policy.isNone()&&!policy.isMap())return false;
+    if(policy.isMap())for(auto it=policy.begin();it!=policy.end();it++)if((*it).first!="desired"&&(*it).first!="restore")return false;
+    auto desired=policy["desired"],restore=policy["restore"];
+    // This bundled YAML parser stores the valid empty flow sequence[] as a
+    // scalar. Accept exactly that spelling, not arbitrary scalar policy data.
+    const auto sequence=[](yaml::Node node){return node.isNone()||node.isSequence()||(node.isScalar()&&node.as<std::string>("")=="[]");};
+    if(!sequence(desired)||!sequence(restore)||desired.size()>MAX_INHIBIT_RADIOS||restore.size()>MAX_INHIBIT_RADIOS)return false;
+    std::map<uint32_t,InhibitRecord> next;std::set<uint32_t> declared;
+    for(size_t i=0;i<desired.size();++i){auto entry=desired[i];const uint32_t id=entry["radio_id"].as<uint32_t>(0U);
+        const auto flag=entry["inhibited"].as<std::string>("");
+        if(!validInhibitRID(id)||(flag!="true"&&flag!="false")||!declared.insert(id).second)return false;
+        if(flag=="true"){InhibitRecord record;record.desired=record.blocked=true;next.emplace(id,record);}
+    }
+    std::set<uint32_t> seen;
+    for(size_t i=0;i<restore.size();++i){auto entry=restore[i];const auto id=entry["radio_id"].as<uint32_t>(0U);
+        const auto blocked=entry["blocked"].as<std::string>(""),pending=entry["pending_uninhibit"].as<std::string>("");
+        if(!validInhibitRID(id)||!seen.insert(id).second||(blocked!="true"&&blocked!="false")||(pending!="true"&&pending!="false")||(pending=="true"&&blocked!="true"))return false;
+        auto found=next.find(id);InhibitRecord record;if(found!=next.end())record=found->second;
+        record.blocked=record.desired||blocked=="true";record.pending=!record.desired&&(record.blocked||pending=="true");
+        if(record.desired||record.blocked||record.pending)next[id]=record;
+    }
+    if(next.size()>MAX_INHIBIT_RADIOS)return false;
+    std::lock_guard<std::mutex> lock(m_inhibitMutex);
+    for(auto& item:m_inhibitions)if(item.second.owner)item.second.owner->active.store(false);
+    m_inhibitions=std::move(next);m_inhibitCompletions.clear();m_inhibitCompletionOrder.clear();publishInhibitionLocked();return true;
+}
+InhibitResult ControlSignaling::submitInhibitOperation(const std::shared_ptr<InhibitOperation>& op,uint32_t waitMs)
+{
+    std::unique_lock<std::mutex> lock(m_inhibitMutex);
+    if(m_inhibitOperations.size()+m_inhibitCompleting>=MAX_INHIBIT_OPERATIONS)return InhibitResult{503U,"inhibit owner mailbox full",{}};
+    op->deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(std::min(waitMs?waitMs:750U,750U));
+    m_inhibitOperations.push_back(op);
+    if(waitMs==0U)return InhibitResult{202U,"queued for protocol owner",{}};
+    m_inhibitChanged.wait_until(lock,op->deadline,[&]{return op->done;});
+    if(!op->done){
+        op->cancelled=true;
+        if(op->owner){
+            op->owner->active.store(false);const auto found=m_inhibitions.find(op->target);
+            if(found!=m_inhibitions.end()&&found->second.serial==op->serial&&active(found->second.procedure))found->second.procedure="cancelled";
+        }
+        return InhibitResult{503U,op->committed?"inhibit owner completion timed out; committed protection retained":"inhibit operation cancelled before owner commit",{}};
+    }
+    return op->result;
+}
+InhibitResult ControlSignaling::updateInhibitPolicy(const std::vector<InhibitDesired>& desired,
+    const std::vector<InhibitRestore>& controlState,bool hasControlState,uint32_t waitMs)
+{
+    if(desired.size()>MAX_INHIBIT_RADIOS||controlState.size()>MAX_INHIBIT_RADIOS)
+        return InhibitResult{400U,"inhibit policy exceeds 32 records",{}};
+    auto op=std::make_shared<InhibitOperation>();op->desired=desired;op->controlState=controlState;op->hasControlState=hasControlState;
+    return submitInhibitOperation(op,waitMs);
+}
+InhibitResult ControlSignaling::requestInhibitCommand(uint32_t target,bool inhibit,uint32_t waitMs)
+{
+    auto op=std::make_shared<InhibitOperation>();op->policy=false;op->target=target;op->inhibit=inhibit;
+    return submitInhibitOperation(op,waitMs);
+}
+void ControlSignaling::noteInhibitedService(uint32_t target)
+{
+    std::lock_guard<std::mutex> lock(m_inhibitMutex);const auto it=m_inhibitions.find(target);
+    if(it!=m_inhibitions.end()&&it->second.blocked)it->second.wake=true;
+}
+void ControlSignaling::noteInhibitPresence(uint32_t target)
+{
+    std::lock_guard<std::mutex> lock(m_inhibitMutex);const auto it=m_inhibitions.find(target);
+    if(it!=m_inhibitions.end()&&!it->second.desired&&it->second.pending)it->second.wake=true;
+}
+void ControlSignaling::cancelInhibitions()
+{
+    std::lock_guard<std::mutex> lock(m_inhibitMutex);
+    for(auto& item:m_inhibitions){auto& r=item.second;if(r.owner)r.owner->active.store(false);
+        if(active(r.procedure)||r.attempts!=0U)r.procedure="cancelled";r.wake=false;}
+    for(auto& op:m_inhibitOperations){op->cancelled=true;op->done=true;op->result={503U,"inhibit owner withdrawn",{}};}
+    m_inhibitOperations.clear();m_inhibitCompletions.clear();m_inhibitCompletionOrder.clear();m_inhibitChanged.notify_all();
+}
+bool ControlSignaling::startInhibitLocked(uint32_t target,InhibitRecord& r)
+{
+    if(!m_p25->m_enableControl||!m_p25->m_dedicatedControl||!m_p25->m_ccRunning||m_p25->m_ccHalted||
+        m_p25->identificationActive()||!m_p25->physicalSubscriberPermitted(target)||m_p25->m_modem==nullptr||
+        m_p25->m_modem->hasError()||m_p25->m_modem->hasLockout())return false;
+    if(r.owner)r.owner->active.store(false);
+    r.owner=std::make_shared<TxFrameOwner>(target);r.serial=++m_inhibitSerial;
+    r.function=r.desired?ExtendedFunctions::INHIBIT:ExtendedFunctions::UNINHIBIT;
+    r.attempts=0U;r.remainingMs=0U;r.procedure="queued";r.wake=false;
+    if(!r.desired)r.pending=true;
+    return true;
+}
+void ControlSignaling::clockInhibitions(uint32_t ms)
+{
+    bool revoke=false;std::set<uint32_t> newlyBlocked;
+    std::vector<std::shared_ptr<InhibitOperation>> completed;
+    {
+        std::lock_guard<std::mutex> lock(m_inhibitMutex);std::set<uint32_t> firstSent;
+        while(!m_inhibitOperations.empty()){
+            auto op=m_inhibitOperations.front();m_inhibitOperations.pop_front();
+            if(op->cancelled||std::chrono::steady_clock::now()>=op->deadline){op->done=true;op->result={503U,"inhibit operation expired before owner commit",{}};continue;}
+            ++m_inhibitCompleting;
+            if(op->policy){
+                bool valid=!op->hasControlState||(!m_p25->m_enableControl&&!m_p25->m_authoritative&&m_p25->m_managedSite);
+                std::set<uint32_t> desired,declared;
+                for(const auto& item:op->desired){if(!validInhibitRID(item.radioId)||!declared.insert(item.radioId).second){valid=false;break;}if(item.inhibited)desired.insert(item.radioId);}
+                auto next=m_inhibitions;
+                // Omission changes intent only. Existing blocked state becomes
+                // pending re-enable and remains blocked until a valid issued ACK.
+                for(auto& item:next){auto& record=item.second;const bool wanted=desired.count(item.first)!=0U;
+                    if(record.desired!=wanted){record.owner.reset();record.procedure="idle";record.attempts=0U;record.wake=false;}
+                    record.desired=wanted;if(wanted){record.blocked=true;record.pending=false;}else if(record.blocked)record.pending=true;
+                }
+                for(const auto id:desired)if(next.count(id)==0U){InhibitRecord record;record.desired=record.blocked=true;next.emplace(id,record);}
+                if(op->hasControlState){
+                    // A dedicated VC has no independent ACK authority. Only a
+                    // complete snapshot from its current CC owner replaces the
+                    // actual mirror. Desired=true always wins over a stale false.
+                    std::map<uint32_t,InhibitRecord> mirror;std::set<uint32_t> seen;
+                    for(const auto& state:op->controlState){
+                        if(!validInhibitRID(state.radioId)||!seen.insert(state.radioId).second){valid=false;break;}
+                        InhibitRecord record;record.desired=desired.count(state.radioId)!=0U;
+                        if((state.pendingUninhibit&&!state.blocked)||(!record.desired&&state.blocked&&!state.pendingUninhibit)){valid=false;break;}
+                        record.blocked=record.desired||state.blocked;record.pending=!record.desired&&state.pendingUninhibit;
+                        if(record.desired||record.blocked||record.pending)mirror.emplace(state.radioId,record);
+                    }
+                    for(const auto id:desired)if(seen.count(id)==0U)valid=false;
+                    next=std::move(mirror);
+                }
+                for(auto it=next.begin();it!=next.end();)if(!it->second.desired&&!it->second.blocked&&!it->second.pending&&!active(it->second.procedure))it=next.erase(it);else ++it;
+                if(next.size()>MAX_INHIBIT_RADIOS)valid=false;
+                if(valid){
+                    for(auto& old:m_inhibitions){const auto found=next.find(old.first);
+                        if(old.second.owner&&(found==next.end()||old.second.desired!=found->second.desired||op->hasControlState))old.second.owner->active.store(false);}
+                    m_inhibitions=std::move(next);publishInhibitionLocked();
+                    std::set<uint32_t> blocked;for(const auto& item:m_inhibitions)if(item.second.blocked){blocked.insert(item.first);newlyBlocked.insert(item.first);}
+                    for(const auto id:desired){m_inhibitCompletions.erase(id);m_inhibitCompletionOrder.erase(std::remove(m_inhibitCompletionOrder.begin(),m_inhibitCompletionOrder.end(),id),m_inhibitCompletionOrder.end());}
+                    m_p25->cancelInhibitedFrames(blocked);revoke=true;op->committed=true;op->result=inhibitSnapshotLocked();
+                }else op->result={400U,"invalid inhibit policy, mirror role/identity, or current union exceeds 32 records",{}};
+            }else{
+                auto found=m_inhibitions.find(op->target);
+                const bool wanted=found!=m_inhibitions.end()&&found->second.desired;
+                if(!validInhibitRID(op->target))op->result={400U,"target is not a provisioned physical subscriber",{}};
+                else if(wanted!=op->inhibit)op->result={409U,"command disagrees with current Zone inhibit policy",{}};
+                else if(!m_p25->m_managedSite||!m_p25->m_zoneConnected.load())op->result={503U,"new inhibit commands require the connected Zone",{}};
+                else if(found!=m_inhibitions.end()&&active(found->second.procedure))op->result={409U,"inhibit procedure already active",{}};
+                else if((found==m_inhibitions.end()&&m_inhibitions.size()>=MAX_INHIBIT_RADIOS)||std::count_if(m_inhibitions.begin(),m_inhibitions.end(),[](const auto& x){return active(x.second.procedure);})>=MAX_INHIBIT_OPERATIONS)op->result={503U,"inhibit state or active procedure capacity full",{}};
+                else {
+                    if(found==m_inhibitions.end()){
+                        // An explicit re-enable has unknown prior handset state.
+                        // Keep conservative RFSS protection until its issued ACK.
+                        InhibitRecord record;record.blocked=record.pending=true;found=m_inhibitions.emplace(op->target,record).first;
+                        publishInhibitionLocked();std::set<uint32_t> blocked;
+                        for(const auto& item:m_inhibitions)if(item.second.blocked)blocked.insert(item.first);
+                        m_p25->cancelInhibitedFrames(blocked);newlyBlocked.insert(op->target);revoke=true;
+                    }
+                    auto& record=found->second;
+                    if(!startInhibitLocked(op->target,record))op->result={503U,"inhibit RF owner or target unavailable",{}};
+                    else if(writeRF_TSDU_Ext_Func(record.function,WUID_FNE,op->target,record.owner)){
+                        op->owner=record.owner;op->serial=record.serial;op->committed=true;
+                        record.attempts=1U;record.remainingMs=INHIBIT_WAIT_MS;record.procedure="awaiting";firstSent.insert(op->target);op->result=inhibitSnapshotLocked();
+                    }else{record.owner->active.store(false);record.procedure="cancelled";op->result={503U,"inhibit command could not enter RF queue",{}};}
+                }
+            }
+            completed.push_back(op);
+        }
+        size_t activeCount=std::count_if(m_inhibitions.begin(),m_inhibitions.end(),[](const auto& x){return active(x.second.procedure);});
+        for(auto& item:m_inhibitions){auto& record=item.second;if(firstSent.count(item.first)!=0U)continue;
+            if(!active(record.procedure)&&record.wake){if(activeCount>=MAX_INHIBIT_OPERATIONS)continue;if(!startInhibitLocked(item.first,record))continue;++activeCount;}
+            if(!active(record.procedure))continue;
+            if(!m_p25->m_enableControl||!m_p25->m_ccRunning||m_p25->m_ccHalted||m_p25->identificationActive()||
+                !m_p25->physicalSubscriberPermitted(item.first)||m_p25->m_modem==nullptr||m_p25->m_modem->hasError()||m_p25->m_modem->hasLockout()){
+                record.owner->active.store(false);record.procedure="cancelled";continue;}
+            if(record.procedure=="awaiting"){
+                if(ms<record.remainingMs){record.remainingMs-=ms;continue;}
+                if(record.attempts==INHIBIT_ATTEMPTS){record.owner->active.store(false);record.procedure="no_response";
+                    LogInfoEx(LOG_HOST,"P25 Radio %s, no response, arg = %u, tgt = %u, attempts = %u",record.desired?"Inhibit":"Uninhibit",WUID_FNE,item.first,record.attempts);
+                    emitInhibitState(item.first,record);continue;}
+            }
+            if(!writeRF_TSDU_Ext_Func(record.function,WUID_FNE,item.first,record.owner)){record.owner->active.store(false);record.procedure="cancelled";continue;}
+            ++record.attempts;record.remainingMs=INHIBIT_WAIT_MS;record.procedure="awaiting";
+        }
+    }
+    if(revoke)m_p25->revokeInhibitedServices(newlyBlocked);
+    // Complete the REST owner operation only after old permits/grants/voice
+    // have retired. Never retain m_inhibitMutex while taking m_permitMutex.
+    {
+        std::lock_guard<std::mutex> lock(m_inhibitMutex);
+        for(auto& op:completed){op->done=true;--m_inhibitCompleting;}
+        m_inhibitChanged.notify_all();
+    }
+}
+bool ControlSignaling::acceptInhibitResponse(uint32_t function,uint32_t argument,uint32_t source,uint8_t mfid)
+{
+    if(!m_p25->m_enableControl||!m_p25->m_dedicatedControl||!m_p25->m_ccRunning||m_p25->m_ccHalted||
+        (mfid!=MFG_STANDARD&&mfid!=MFG_STANDARD_ALT)||argument!=WUID_FNE)return false;
+    std::unique_lock<std::mutex> lock(m_inhibitMutex);auto found=m_inhibitions.find(source);
+    const bool completion=found==m_inhibitions.end();
+    auto retired=m_inhibitCompletions.find(source);
+    if(completion&&retired==m_inhibitCompletions.end())return false;
+    auto& record=completion?retired->second:found->second;
+    if((record.procedure!="awaiting"&&record.procedure!="no_response"&&record.procedure!="acknowledged")||record.attempts==0U||
+        function!=(record.desired?ExtendedFunctions::INHIBIT_ACK:ExtendedFunctions::UNINHIBIT_ACK)||
+        record.function!=(record.desired?ExtendedFunctions::INHIBIT:ExtendedFunctions::UNINHIBIT))return false;
+    // AABD-B13.3.2/13.4.2: System Default source, not EXT_FNCT RF echo.
+    lc::tsbk::IOSP_ACK_RSP ack;ack.setAIV(true);ack.setEX(false);ack.setService(TSBKO::IOSP_EXT_FNCT);
+    ack.setDstId(WUID_SYSTEM_DEFAULT);ack.setSrcId(source);
+    if(!writeRF_TSDU_SBF(&ack,true,true,true,false))return false;
+    if(record.owner)record.owner->active.store(false);
+    const bool first=record.procedure!="acknowledged";record.procedure="acknowledged";record.wake=false;
+    if(!record.desired){record.blocked=false;record.pending=false;}
+    const auto observed=record;
+    if(!record.desired&&!completion){
+        m_inhibitCompletionOrder.erase(std::remove(m_inhibitCompletionOrder.begin(),m_inhibitCompletionOrder.end(),source),m_inhibitCompletionOrder.end());
+        if(m_inhibitCompletionOrder.size()>=16U){m_inhibitCompletions.erase(m_inhibitCompletionOrder.front());m_inhibitCompletionOrder.pop_front();}
+        m_inhibitCompletions[source]=observed;m_inhibitCompletionOrder.push_back(source);m_inhibitions.erase(found);publishInhibitionLocked();
+    }
+    lock.unlock();markValidatedWUID(source);refreshAcknowledgedWUID();
+    if(first){LogInfoEx(LOG_RF,P25_TSDU_STR ", TSBKO, IOSP_EXT_FNCT (Extended Function Response), op = $%02X, arg = %u, tgt = %u",function,argument,source);emitInhibitState(source,observed);}
+    return true;
+}
+
+bool ControlSignaling::inhibitAdmitsTSBK(const lc::TSBK& message,bool reassert)
+{
+    switch(message.getLCO()){
+    case TSBKO::IOSP_U_REG:case TSBKO::ISP_LOC_REG_REQ:
+    case TSBKO::ISP_AUTH_RESP:case TSBKO::IOSP_EXT_FNCT:return true;
+    case TSBKO::IOSP_GRP_AFF:case TSBKO::ISP_GRP_AFF_Q_RSP:
+        if(message.getDstId()==0U)return true;
+        break;
+    default:break;
+    }
+    if(!isInhibited(message.getSrcId())||!m_p25->physicalSubscriberPermitted(message.getSrcId()))return true;
+    if(reassert)noteInhibitedService(message.getSrcId());
+    return false;
+}
+uint32_t ControlSignaling::inhibitedIndividualTarget(const lc::TSBK& message) const
+{
+    switch(message.getLCO()){
+    case TSBKO::IOSP_UU_VCH:case TSBKO::IOSP_UU_ANS:case TSBKO::IOSP_STS_UPDT:
+    case TSBKO::IOSP_MSG_UPDT:case TSBKO::IOSP_RAD_MON:case TSBKO::IOSP_CALL_ALRT:
+        return isInhibited(message.getDstId())?message.getDstId():0U;
+    default:return 0U;
+    }
+}
+
+TxFrameOwnership ControlSignaling::signalingServiceOwner(const lc::TSBK& message) const
+{
+    switch(message.getLCO()){
+    case TSBKO::IOSP_GRP_VCH:return m_p25->serviceFrameOwner(message.getSrcId());
+    case TSBKO::OSP_GRP_VCH_GRANT_UPD:return m_p25->serviceFrameOwner(m_p25->m_affiliations->getGrantedSrcId(message.getDstId()));
+    case TSBKO::IOSP_UU_VCH:case TSBKO::OSP_UU_VCH_GRANT_UPD:case TSBKO::IOSP_UU_ANS:
+    case TSBKO::IOSP_STS_UPDT:case TSBKO::IOSP_MSG_UPDT:case TSBKO::IOSP_RAD_MON:case TSBKO::IOSP_CALL_ALRT:
+        return m_p25->serviceFrameOwner(message.getSrcId(),message.getDstId());
+    default:return {};
+    }
+}
