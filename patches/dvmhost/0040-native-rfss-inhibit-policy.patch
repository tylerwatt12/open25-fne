+        auto owner=std::async(std::launch::async,[&]{Access::tick(*f.controller);});
+        end=std::chrono::steady_clock::now()+std::chrono::seconds(2);while(!f.controller->isRadioInhibited(RID)&&std::chrono::steady_clock::now()<end)std::this_thread::yield();REQUIRE(f.controller->isRadioInhibited(RID));
+        const bool wasPending=operation.wait_for(std::chrono::milliseconds(0))==std::future_status::timeout;
+        const bool expiredReady=!expire||operation.wait_for(std::chrono::milliseconds(200))==std::future_status::ready;
+        InhibitResult expiredResult;uint32_t queuedLength=0U;
+        if(expire&&expiredReady){expiredResult=operation.get();queuedLength=f.controller->peekFrameLength();}
+        // Release/join even when deliberately broken code violates an assertion.
+        permit.unlock();owner.get();REQUIRE(wasPending);REQUIRE(expiredReady);
+        if(expire){REQUIRE(expiredResult.status==503);REQUIRE(queuedLength==0U);}else REQUIRE(operation.get().status==200);
+        REQUIRE(f.controller->isRadioInhibited(RID));if(expire){const auto rows=f.controller->control()->inhibitSnapshot().radios;REQUIRE(rows[0].blocked);REQUIRE(rows[0].pendingUninhibit);REQUIRE(rows[0].procedure=="cancelled");REQUIRE(f.responses().empty());}
+    }
