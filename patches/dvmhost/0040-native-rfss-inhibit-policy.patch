+bool Control::isRadioInhibited(uint32_t source) const {return m_control!=nullptr&&m_control->isInhibited(source);}
+void Control::noteInhibitedService(uint32_t source){if(m_control)m_control->noteInhibitedService(source);}
+TxFrameOwnership Control::serviceFrameOwner(uint32_t source,uint32_t target) const
+{
+    if(m_dispatchSubscribers.count(source)==0U&&m_dispatchSubscribers.count(target)==0U)return {};
+    auto owner=std::make_shared<TxFrameOwner>(source,true,source,target);
+    if(isRadioInhibited(source)||isRadioInhibited(target))owner->active.store(false);
+    return owner;
+}
+void Control::cancelInhibitedFrames(const std::set<uint32_t>& blocked)
+{
+    std::lock_guard<std::mutex> lock(s_queueLock);
+    const auto cancel=[&](const TxFrameOwnership& owner){
+        if(owner->service&&(blocked.count(owner->source)!=0U||blocked.count(owner->individualTarget)!=0U))owner->active.store(false);
+        return !owner->active.load();
+    };
+    m_txImmQueue.discard(cancel);m_txQueue.discard(cancel);
+}
+void Control::revokeInhibitedServices(const std::set<uint32_t>& newlyBlocked)
+{
+    const auto blocked=[&](uint32_t id){return newlyBlocked.count(id)!=0U||isRadioInhibited(id);};
+    std::lock_guard<std::recursive_mutex> permit(m_permitMutex);
+    const bool retirePermit=m_permittedSrcId!=0U&&blocked(m_permittedSrcId);
+    const bool retireRF=retirePermit||(m_rfLastSrcId!=0U&&blocked(m_rfLastSrcId));
+    if(retirePermit) {
+        m_inhibitRetiredPermitToken=m_permitToken;
+        clearIdentificationTraffic();
+    }
+    if(retireRF){
+        m_voice->resetRF();m_rfState=RS_RF_LISTENING;m_rfLossWatchdog.stop();m_rfTimeout.stop();
+        m_rfLastSrcId=m_rfLastDstId=0U;
+    }
+    if((m_netLastSrcId!=0U&&blocked(m_netLastSrcId))||
+        (!m_voice->m_netLC.getGroup()&&blocked(m_voice->m_netLC.getDstId()))){m_voice->resetNet();m_netState=RS_NET_IDLE;m_netLastSrcId=m_netLastDstId=0U;}
+    auto guard=m_affiliations->lockGrants();
+    const auto grants=m_affiliations->grantTable();
+    for(const auto& item:grants){
+        const auto source=m_affiliations->getGrantedSrcId(item.first);
+        if(blocked(source)||(!m_affiliations->isGroup(item.first)&&blocked(item.first))){
+            m_affiliations->releaseGrant(item.first,false);m_grantPriorities.erase(item.first);
+        }
+    }
+}
