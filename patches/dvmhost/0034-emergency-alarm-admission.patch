+TEST_CASE("emergency alarm ACK and accepted event require a valid SU and admitted supported Site group", "[p25][emergency-admission]") {
+    struct Case { const char* name; unsigned mode; uint32_t source; uint32_t group; uint8_t reason; };
+    const Case cases[]={
+        {"supported",0U,RID,TG,0U},
+        {"preprogrammed_before_affiliation_direct_tx_denied",1U,RID,TG,0U},
+        {"unknown_group",2U,RID,1099U,0x30U},
+        {"disabled_group",3U,RID,TG,0x30U},
+        {"not_in_applied_site_groups",4U,RID,1002U,0x30U},
+        {"subscriber_admission_selected_empty",5U,RID,TG,0x31U},
+        {"site_nonpreferred",6U,RID,TG,0x31U},
+        {"unregistered",7U,RID,TG,0x10U},
+        {"disabled_subscriber",8U,RID,TG,0x10U},
+        {"unknown_subscriber",9U,19999U,TG,0x10U},
+        {"console_identity",10U,APP,TG,0x10U},
+        {"null_group",11U,RID,0U,0x30U},
+        {"all_group_even_if_bad_lookup_provisions_it",12U,RID,0xFFFFU,0x30U},
+        {"highest_assignable_group",13U,RID,0xFFFEU,0U},
+        {"lowest_assignable_group",14U,RID,1U,0U},
+        {"wildcard_acl_does_not_provision_unknown_group",15U,RID,1099U,0x30U},
+        {"diagnostic_verbose_disabled",16U,RID,TG,0U}
+    };
+    json::array observations;
+    for (const auto& c:cases) {
+        CAPTURE(c.name,c.source,c.group,c.reason);
+        Fixture f(c.mode!=15U); auto* units=f.controller->affiliations();
+        units->groupAff(RID,1002U); // Preprogrammed emergency group can differ.
+        f.age(1000U);
+        if(c.mode==1U) { f.apply(true,{RID},true,{}); REQUIRE_FALSE(acl::AccessControl::validateGroupTransmit(RID,TG)); }
+        if(c.mode==3U) f.groups.addEntry(TG,1U,false);
+        if(c.mode==4U) f.groups.eraseEntry(1002U,1U);
+        if(c.mode==5U) f.apply(true,{},false,{});
+        if(c.mode==6U) f.groups.addEntry(TG,1U,true,false,true);
+        if(c.mode==7U) units->unitDereg(RID,false);
+        if(c.mode==8U) f.radios.addEntry(RID,false,"disabled");
+        if(c.mode==12U || c.mode==13U || c.mode==14U) f.groups.addEntry(c.group,1U,true);
+        if(c.mode==16U) f.controller->setDebugVerbose(false,false);
+        nativeLog().str(""); nativeLog().clear();
+        // Literal SI1/SI2/reserved/Group/Source field positions, not encoder output.
+        const uint64_t input=0x0102000000000000ULL|(uint64_t(c.group)<<24U)|c.source;
+        const bool accepted=c.reason==0U;
+        REQUIRE(f.signal(0x27U,input)==accepted);
+        auto output=f.responses(); REQUIRE(output.size()==1U);
+        const std::array<uint8_t,7U> prefix=accepted
+            ? std::array<uint8_t,7U>{{0xA0U,0x00U,0x27U,0x00U,0x00U,0x00U,0x00U}}
+            : std::array<uint8_t,7U>{{0xA7U,0x00U,0x27U,c.reason,0x00U,0x00U,0x00U}};
+        for(size_t i=0U;i<prefix.size();++i) REQUIRE(output[0][i]==prefix[i]);
+        REQUIRE(output[0][7]==uint8_t(c.source>>16U));
+        REQUIRE(output[0][8]==uint8_t(c.source>>8U));
+        REQUIRE(output[0][9]==uint8_t(c.source));
+        REQUIRE(acceptedLogs()==(accepted?1U:0U));
+        REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+        REQUIRE(units->grantSize()==0U);
+        if(c.mode!=7U) REQUIRE(units->isGroupAff(RID,1002U));
+        REQUIRE_FALSE(units->isGroupAff(RID,TG));
+        if(c.source==RID && c.mode!=7U && c.mode!=8U) {
+            REQUIRE(units->isUnitReg(RID)); REQUIRE(units->unitRegTimer(RID)==0U);
+        }
+        if(c.mode==8U) REQUIRE(units->unitRegTimer(RID)==1U);
+        json::object observation;
+        observation["case"].set<std::string>(c.name);
+        observation["accepted"].set<bool>(accepted);
+        observation["radio_id"].set<uint32_t>(c.source);
+        observation["talkgroup_id"].set<uint32_t>(c.group);
+        observation["deny_reason"].set<uint8_t>(c.reason);
+        observation["native_log"].set<std::string>(nativeLog().str());
+        observation["response_tsbk_hex"].set<std::string>(hex(output[0].data(),output[0].size()));
+        json::value record; record.set<json::object>(observation); observations.push_back(record);
+    }
+    if(const char* path=std::getenv("DVM_EMERGENCY_ADMISSION_EXPORT")) {
+        json::value document; document.set<json::array>(observations);
+        std::ofstream output(path,std::ios::trunc); REQUIRE(output.good());
+        output << document.serialize(true) << "\n"; REQUIRE(output.good());
+    }
+}
+
+TEST_CASE("admission precedes emergency cause event publication and remains valid during Site Trunking", "[p25][emergency-admission]") {
+    for(uint8_t si1:{0U,1U,2U,4U,8U,0x80U}) for(uint8_t si2:{0U,1U,0x80U}) {
+        CAPTURE(si1,si2); Fixture f; f.controller->affiliations()->groupUnaff(RID);
+        const uint64_t input=(uint64_t(si1)<<56U)|(uint64_t(si2)<<48U)|(uint64_t(TG)<<24U)|RID;
+        REQUIRE(f.signal(0x27U,input)); auto packets=f.responses(); REQUIRE(packets.size()==1U);
+        REQUIRE((packets[0][0]&0x3FU)==0x20U); REQUIRE((packets[0][2]&0x3FU)==0x27U);
+        REQUIRE(acceptedLogs()==1U); REQUIRE_FALSE(f.controller->affiliations()->isGroupAff(RID,TG));
+        f.groups.addEntry(TG,1U,false); nativeLog().str(""); nativeLog().clear();
+        REQUIRE_FALSE(f.signal(0x27U,input)); packets=f.responses(); REQUIRE(packets.size()==1U);
+        REQUIRE((packets[0][0]&0x3FU)==0x27U); REQUIRE(packets[0][3]==0x30U);
+        REQUIRE(acceptedLogs()==0U);
+    }
+}
