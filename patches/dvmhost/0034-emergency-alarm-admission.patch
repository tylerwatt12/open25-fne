+// SPDX-License-Identifier: GPL-2.0-only
+// Literal alarm/ACK/DENY fixtures: AABC-E 6.1.6/Fig6.1.6-1 PDF103/p84;
+// 6.2.1.1/Fig6.2.1-1 PDF150/p131; 6.2.5/Fig6.2.5-1 PDF160/p141;
+// AnnexB PDF232/p213; Table2.3.16-1 PDF34/p15. AABD-B11.2.1-.3
+// PDF104-106/p99-101 supplies validity/preprogrammed-group behavior.
+// Existing CRC/Trellis supply framing only. No physical or socket opens.
+#include "host/Host.h"
+#include "host/p25/Control.h"
+#include "host/modem/port/ModemNullPort.h"
+#include "common/network/P25SiteRouting.h"
+#include "common/p25/acl/AccessControl.h"
+#include "common/p25/Audio.h"
+#include "common/p25/NID.h"
+#include "common/p25/P25Utils.h"
+#include "common/p25/Sync.h"
+#include "common/edac/CRC.h"
+#include "common/edac/Trellis.h"
+#include "common/Log.h"
+#include "common/json/json.h"
+#include <iostream>
