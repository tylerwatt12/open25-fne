+namespace {
+class SiteNetwork : public network::Network {
+public:
+    std::deque<std::vector<uint8_t>> incoming;
+    std::vector<std::vector<uint8_t>> outgoing;
+    std::vector<std::unordered_map<uint32_t,uint32_t>> snapshots;
+    bool announceAffiliationUpdate(const std::unordered_map<uint32_t,uint32_t> affiliations) override { snapshots.push_back(affiliations); return true; }
+    SiteNetwork() : Network("127.0.0.1", 49991U, 0U, 100101001U, "offline", true, false,
+        false, true, false, false, false, false, false, false, false, false) { m_status = network::NET_STAT_RUNNING; }
+    void running(bool active) { m_status = active ? network::NET_STAT_RUNNING : network::NET_STAT_WAITING_CONNECT; }
+    UInt8Array readP25(bool& ret, uint32_t& length) override {
+        ret = !incoming.empty(); length = 0U; if (!ret) return nullptr;
+        auto bytes = std::move(incoming.front()); incoming.pop_front(); length = bytes.size();
+        UInt8Array result(new uint8_t[length]); std::copy(bytes.begin(), bytes.end(), result.get()); return result;
+    }
+    void resetP25() override { incoming.clear(); }
+    using network::BaseNetwork::createP25_TDUMessage;
+    using network::BaseNetwork::createP25_LDU1Message;
+    using network::BaseNetwork::createP25_LDU2Message;
+    bool writeP25LDU1(const LC& control, const p25::data::LowSpeedData& lsd, const uint8_t* data, FrameType::E type, uint8_t flags) override {
+        uint32_t length; auto message=createP25_LDU1Message(length, control, lsd, data, type, flags);
+        outgoing.emplace_back(message.get(),message.get()+length); return true;
+    }
+    bool writeP25LDU2(const LC& control, const p25::data::LowSpeedData& lsd, const uint8_t* data, uint8_t flags) override {
+        uint32_t length; auto message=createP25_LDU2Message(length, control, lsd, data, flags);
+        outgoing.emplace_back(message.get(),message.get()+length); return true;
+    }
+    bool writeP25TDU(const LC& control, const p25::data::LowSpeedData& lsd, uint8_t flags = 0U) override {
+        uint32_t length; auto message=createP25_TDUMessage(length,control,lsd,flags);
+        outgoing.emplace_back(message.get(),message.get()+length); return true;
+    }
+    std::vector<uint8_t> encoded(DUID::E duid, uint32_t source = SOURCE) {
+        LC control; control.setLCO(LCO::GROUP); control.setGroup(true); control.setSrcId(source); control.setDstId(GROUP); control.setAlgId(ALGO_UNENCRYPT);
+        p25::data::LowSpeedData lsd;
+        std::array<uint8_t,P25_LDU_FRAME_LENGTH_BYTES> frame{};
+        // Native IMBE FEC/interleaving, then native DFSI serialization.
+        p25::Audio audio;
+        for (uint32_t i=0; i<9U; ++i) audio.encode(frame.data(), NULL_IMBE, i);
+        uint32_t length=0;
+        UInt8Array message;
+        if (duid == DUID::TDU) message=createP25_TDUMessage(length,control,lsd,0U);
+        else if (duid == DUID::LDU1) message=createP25_LDU1Message(length,control,lsd,frame.data(),FrameType::HDU_VALID);
+        else message=createP25_LDU2Message(length,control,lsd,frame.data());
+        return std::vector<uint8_t>(message.get(), message.get()+length);
+    }
+};
