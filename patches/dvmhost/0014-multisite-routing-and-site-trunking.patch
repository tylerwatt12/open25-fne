+TEST_CASE("Remote voice watchdog retires its local permit during zone loss", "[p25][multisite][site-trunking]") {
+    SiteNetwork net; ControllerFixture voice(true,false,false,false,false,&net); voice.voiceMode(false); voice.permitVoice("aaa:1");
+    net.incoming.push_back(net.encoded(DUID::LDU1)); MultiSiteTestAccess::process(*voice.controller);
+    net.incoming.push_back(net.encoded(DUID::LDU2)); MultiSiteTestAccess::process(*voice.controller);
+    REQUIRE_FALSE(voice.drainVoice().empty()); REQUIRE(MultiSiteTestAccess::permitted(*voice.controller));
+    MultiSiteTestAccess::managed(*voice.controller); MultiSiteTestAccess::expireNetwork(*voice.controller);
+    voice.controller->clock();
+    REQUIRE_FALSE(MultiSiteTestAccess::permitted(*voice.controller)); REQUIRE(voice.rpc.releases==std::vector<uint32_t>{GROUP});
+}
