+TEST_CASE("Native peer timeout schedules reconnection without site restart", "[network][multisite][site-trunking]") {
+    network::Network peer("127.0.0.1",49999U,0U,100101000U,"offline",true,false,false,true,false,false,false,false,false,false,false,false);
+    peer.enable(true); REQUIRE(peer.open()); REQUIRE(peer.getStatus()==network::NET_STAT_WAITING_CONNECT);
+    // Native retry clock, real localhost UDP socket; no running FNE is required.
+    peer.clock(10001U); REQUIRE(peer.getStatus()==network::NET_STAT_WAITING_LOGIN);
+    peer.clock(600001U); REQUIRE(peer.getStatus()==network::NET_STAT_WAITING_CONNECT);
+    peer.clock(10001U); REQUIRE(peer.getStatus()==network::NET_STAT_WAITING_LOGIN);
+    peer.close();
+}
