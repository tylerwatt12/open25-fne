+// SPDX-License-Identifier: GPL-2.0-only
+/* Current TrunkSystem P25 system/site routing policy. No transport or RF scheduler. */
+#ifndef __P25_SITE_ROUTING_H__
+#define __P25_SITE_ROUTING_H__
+#include "common/yaml/Yaml.h"
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
