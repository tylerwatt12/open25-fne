+    REQUIRE(route.configure(sitePolicy(),error)); REQUIRE(error.empty());
+    REQUIRE(route.system(1U,1U)); REQUIRE_FALSE(route.system(2U,1U)); REQUIRE_FALSE(route.system(1U,2U));
+    REQUIRE(route.affiliate(100101000U,SOURCE,GROUP));
+    REQUIRE_FALSE(route.affiliate(100102001U,TARGET,GROUP)); // Only accepted CC reports.
+    REQUIRE_FALSE(route.affiliate(100103000U,TARGET,GROUP)); // Restricted site.
+    REQUIRE(route.begin(100101001U,42U,SOURCE,GROUP));
+    REQUIRE_FALSE(route.forward(100101001U,100102000U,42U,SOURCE,GROUP,true,false));
+    route.end(100101001U,42U,GROUP);
+    REQUIRE(route.affiliate(100102000U,TARGET,GROUP));
+    REQUIRE(route.begin(100101001U,43U,SOURCE,GROUP));
+    REQUIRE(route.forward(100101001U,100102000U,43U,SOURCE,GROUP,true,false));
+    REQUIRE_FALSE(route.forward(100101001U,100101000U,43U,SOURCE,GROUP,true,false));
+    REQUIRE_FALSE(route.forward(100101001U,100103001U,43U,SOURCE,GROUP,false,false));
+    REQUIRE_FALSE(route.forward(100101001U,123U,43U,SOURCE,GROUP,false,false));
+    REQUIRE_FALSE(route.forward(100101001U,100102001U,43U,TARGET,GROUP,false,false));
+    REQUIRE_FALSE(route.begin(100102001U,44U,TARGET,GROUP)); // No second origin/relay loop.
+    REQUIRE(route.forward(100101001U,100102001U,43U,SOURCE,GROUP,false,false));
+    REQUIRE_FALSE(route.forward(100101000U,100102000U,43U,SOURCE,GROUP,false,false,true));
+    route.unaffiliate(100102000U,TARGET);
+    REQUIRE(route.forward(100101001U,100102000U,43U,SOURCE,GROUP,false,true));
+    REQUIRE(route.forward(100101001U,100102001U,43U,SOURCE,GROUP,false,true));
+    route.end(100101001U,43U,GROUP);
+    REQUIRE_FALSE(route.forward(100101001U,100102001U,43U,SOURCE,GROUP,false,true));
+    REQUIRE(route.begin(100101001U,45U,SOURCE,GROUP));
+    REQUIRE_FALSE(route.forward(100101001U,100102001U,45U,SOURCE,GROUP,false,false));
+}
