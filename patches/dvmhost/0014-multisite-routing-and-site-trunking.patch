+namespace network {
+class P25SiteRouting {
+public:
+    enum class Role { Unknown, Control, Voice, Console };
+    struct Site {
+        uint32_t control = 0U;
+        std::set<uint32_t> voice, consoles, groups;
+        std::map<uint32_t, uint32_t> affiliations;
+    };
+    bool configure(yaml::Node master, std::string& error) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_sites.clear(); m_peers.clear(); m_owners.clear(); m_calls.clear(); m_valid = false;
+        const auto number = [](const yaml::Node& node, uint32_t maximum, uint32_t& result) {
+            if (!node.isScalar()) return false;
+            const auto value = node.as<std::string>();
+            if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos) return false;
+            try { const auto parsed = std::stoull(value); if (parsed == 0U || parsed > maximum) return false; result = uint32_t(parsed); return true; }
+            catch (...) { return false; }
+        };
+        auto system = master["p25System"];
+        if (!system.isMap() || !number(system["netId"], 0xFFFFFU, m_netId) || !number(system["sysId"], 0xFFFU, m_sysId)) {
+            error = "p25System requires nonzero netId (20 bit) and sysId (12 bit)"; return false;
+        }
+        auto sites = master["p25Sites"];
+        if (!sites.isSequence() || sites.size() == 0U) { error = "p25Sites must contain configured sites"; return false; }
+        for (size_t i = 0U; i < sites.size(); ++i) {
+            auto node = sites[i]; Site site;
+            if (!node.isMap() || !number(node["controlPeerId"], 999999999U, site.control)) { error = "invalid controlPeerId"; return false; }
+            if (m_peers.count(site.control)) { error = "duplicate P25 peer ID"; return false; }
+            m_peers[site.control] = {site.control, Role::Control};
+            const auto list = [&](const char* key, std::set<uint32_t>& values, Role role, uint32_t maximum) {
+                auto entries = node[key];
+                if (entries.isScalar() && entries.as<std::string>() == "[]") return true;
+                if (!entries.isSequence()) return false;
+                for (size_t j = 0U; j < entries.size(); ++j) {
+                    uint32_t value = 0U;
+                    if (!number(entries[j], maximum, value) || values.count(value)) return false;
+                    if (role != Role::Unknown && m_peers.count(value)) return false;
+                    values.insert(value);
+                    if (role != Role::Unknown) m_peers[value] = {site.control, role};
+                }
+                return true;
+            };
+            if (!list("voicePeerIds", site.voice, Role::Voice, 999999999U) ||
+                !list("consolePeerIds", site.consoles, Role::Console, 999999999U) ||
+                !list("talkgroups", site.groups, Role::Unknown, 65535U)) { error = "invalid or duplicate site peer/talkgroup list"; return false; }
+            m_sites.emplace(site.control, std::move(site));
+        }
+        m_valid = true; error.clear(); return true;
+    }
+    uint32_t netId() const { return m_netId; }
+    uint32_t sysId() const { return m_sysId; }
+    bool owns(uint32_t origin, uint32_t stream, uint32_t rid, uint32_t group) const {
+        std::lock_guard<std::mutex> lock(m_mutex); const auto found=m_calls.find(group);
+        return found!=m_calls.end() && found->second.origin==origin && found->second.stream==stream && found->second.rid==rid;
+    }
+    bool valid() const { std::lock_guard<std::mutex> lock(m_mutex); return m_valid; }
+    bool system(uint32_t net, uint32_t sys) const { std::lock_guard<std::mutex> lock(m_mutex); return m_valid && net == m_netId && sys == m_sysId; }
+    Role role(uint32_t peer) const { std::lock_guard<std::mutex> lock(m_mutex); return roleUnlocked(peer); }
+    uint32_t controlPeer(uint32_t peer) const { std::lock_guard<std::mutex> lock(m_mutex); return controlUnlocked(peer); }
+    bool allowed(uint32_t peer, uint32_t group) const { std::lock_guard<std::mutex> lock(m_mutex); return allowedUnlocked(peer, group); }
+    bool sameSite(uint32_t a, uint32_t b) const { std::lock_guard<std::mutex> lock(m_mutex); return controlUnlocked(a) != 0U && controlUnlocked(a) == controlUnlocked(b); }
+    bool voiceAssociation(uint32_t cc, uint32_t vc) const { std::lock_guard<std::mutex> lock(m_mutex); return roleUnlocked(cc) == Role::Control && roleUnlocked(vc) == Role::Voice && controlUnlocked(vc) == cc; }
+    // These methods receive accepted reports from the authenticated site CC.
+    // A new accepted registration/affiliation moves the subscriber's interest.
+    bool affiliate(uint32_t cc, uint32_t rid, uint32_t group, bool snapshot = false) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (roleUnlocked(cc) != Role::Control || rid == 0U || !allowedUnlocked(cc, group)) return false;
+        auto owner = m_owners.find(rid);
+        if (snapshot && owner != m_owners.end() && owner->second != cc) return false;
+        for (auto& entry : m_sites) if (entry.first != cc) entry.second.affiliations.erase(rid);
+        m_owners[rid] = cc; m_sites.at(cc).affiliations[rid] = group; return true;
+    }
+    bool registerUnit(uint32_t cc, uint32_t rid) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (roleUnlocked(cc) != Role::Control || rid == 0U) return false;
+        for (auto& entry : m_sites) if (entry.first != cc) entry.second.affiliations.erase(rid);
+        m_owners[rid] = cc; return true;
+    }
+    void unaffiliate(uint32_t cc, uint32_t rid, bool deregister = false) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (roleUnlocked(cc) != Role::Control) return;
+        m_sites.at(cc).affiliations.erase(rid);
+        if (deregister && m_owners.count(rid) && m_owners.at(rid) == cc) m_owners.erase(rid);
+    }
+    void clearSnapshot(uint32_t cc) { std::lock_guard<std::mutex> lock(m_mutex); if (roleUnlocked(cc) == Role::Control) m_sites.at(cc).affiliations.clear(); }
+    void disconnected(uint32_t cc) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (roleUnlocked(cc) != Role::Control) return;
+        m_sites.at(cc).affiliations.clear();
+        for (auto it = m_owners.begin(); it != m_owners.end();) if (it->second == cc) it = m_owners.erase(it); else ++it;
+    }
+    // A call's recipient sites remain attached through its terminal TDU, even if
+    // affiliation changes during the call. Only one origin owns a group stream.
+    bool begin(uint32_t origin, uint32_t stream, uint32_t rid, uint32_t group, bool* first = nullptr) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const auto role = roleUnlocked(origin);
+        if ((role != Role::Voice && role != Role::Console) || !allowedUnlocked(origin, group) || !rid || !stream) return false;
+        if (first) *first = false;
+        auto found = m_calls.find(group);
+        const auto now = std::chrono::steady_clock::now();
+        if (found != m_calls.end() && now - found->second.last > std::chrono::seconds(10)) { m_calls.erase(found); found = m_calls.end(); }
+        if (found != m_calls.end()) {
+            if (found->second.origin != origin || found->second.stream != stream || found->second.rid != rid) return false;
+            found->second.last = now; return true;
+        }
+        if (first) *first = true;
+        Call call{origin, stream, rid, {}, now};
+        for (const auto& entry : m_sites) if (entry.second.groups.count(group) && interestedUnlocked(entry.second, group)) call.sites.insert(entry.first);
+        call.sites.insert(controlUnlocked(origin));
+        m_calls[group] = std::move(call); return true;
+    }
+    bool forward(uint32_t origin, uint32_t target, uint32_t stream, uint32_t rid, uint32_t group, bool demand, bool terminal, bool signaling = false) const {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const auto sourceCC = controlUnlocked(origin), targetCC = controlUnlocked(target);
+        if (!sourceCC || !targetCC || origin == target) return false;
+        // Site control signaling has site-local channel numbers and subscriber
+        // responses. It must never be rebroadcast as another site's signaling.
+        if (signaling) return sourceCC == targetCC;
+        if (!allowedUnlocked(origin, group) || !allowedUnlocked(target, group)) return false;
+        const auto call = m_calls.find(group);
+        if (call == m_calls.end() || call->second.origin != origin || call->second.stream != stream || call->second.rid != rid || !call->second.sites.count(targetCC)) return false;
+        const auto targetRole = roleUnlocked(target);
+        if (demand) return targetRole == Role::Control && sourceCC != targetCC;
+        if (targetRole == Role::Control) return terminal && sourceCC != targetCC;
+        return targetRole == Role::Voice || targetRole == Role::Console;
+    }
+    void end(uint32_t origin, uint32_t stream, uint32_t group) {
+        std::lock_guard<std::mutex> lock(m_mutex); const auto call = m_calls.find(group);
+        if (call != m_calls.end() && call->second.origin == origin && call->second.stream == stream) m_calls.erase(call);
+    }
+private:
+    struct Call { uint32_t origin, stream, rid; std::set<uint32_t> sites; std::chrono::steady_clock::time_point last; };
+    Role roleUnlocked(uint32_t peer) const { const auto it=m_peers.find(peer); return it==m_peers.end()?Role::Unknown:it->second.second; }
+    uint32_t controlUnlocked(uint32_t peer) const { const auto it=m_peers.find(peer); return it==m_peers.end()?0U:it->second.first; }
+    bool allowedUnlocked(uint32_t peer, uint32_t group) const { const auto it=m_sites.find(controlUnlocked(peer)); return m_valid && it!=m_sites.end() && it->second.groups.count(group); }
+    static bool interestedUnlocked(const Site& site, uint32_t group) { return std::any_of(site.affiliations.begin(), site.affiliations.end(), [group](const auto& item){return item.second==group;}); }
+    mutable std::mutex m_mutex;
+    bool m_valid = false;
+    uint32_t m_netId = 0U, m_sysId = 0U;
+    std::map<uint32_t, Site> m_sites;
+    std::map<uint32_t, std::pair<uint32_t, Role>> m_peers;
+    std::map<uint32_t, uint32_t> m_owners;
+    std::map<uint32_t, Call> m_calls;
+};
+}
+#endif
