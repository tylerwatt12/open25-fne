+// AABD-B 6.6.1 (PDF59/printed54): refresh on a transaction accepted as valid,
+// not on the outbound command, an arbitrary ACK, or an expired procedure.
+TEST_CASE("only a matched message ACK refreshes its source WUID validity", "[p25][message-update][wuid-refresh]") {
+    SECTION("accepted matched ACK refreshes source and no other identity") {
+        Fixture f(true);auto* signal=f.controller->control();auto* units=f.controller->affiliations();
+        units->unitReg(WUID_FNE);units->unitReg(SECOND_SU);
+        REQUIRE(signal->requestMessageUpdate(RID,0x1234U,0U));MessageUpdateTestAccess::clock(*f.controller);f.responses();
+        f.age(43199000U);REQUIRE(units->unitRegTimer(RID)==43199U);
+        REQUIRE(f.signal(0x20U,0x1C00FFFFFC002711ULL));
+        REQUIRE(signal->messageUpdateState(RID)==MessageState::Acknowledged);
+        REQUIRE(units->unitRegTimer(RID)==0U);
+        REQUIRE(units->unitRegTimer(WUID_FNE)==43199U);REQUIRE(units->unitRegTimer(SECOND_SU)==43199U);
+        f.age(1001U);REQUIRE(units->isUnitReg(RID));
+        REQUIRE_FALSE(units->isUnitReg(WUID_FNE));REQUIRE_FALSE(units->isUnitReg(SECOND_SU));
+        f.age(43199000U);REQUIRE_FALSE(units->isUnitReg(RID));
+    }
+    SECTION("unissued or late ACK does not postpone expiry") {
+        for(unsigned state=0;state<3U;++state) {
+            Fixture f(true);auto* signal=f.controller->control();auto* units=f.controller->affiliations();
+            if(state>0U) REQUIRE(signal->requestMessageUpdate(RID,1U,0U));
+            if(state==2U) { MessageUpdateTestAccess::clock(*f.controller);f.responses();MessageUpdateTestAccess::expire(*f.controller,RID); }
+            f.age(43199000U);REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL));
+            REQUIRE(units->unitRegTimer(RID)==43199U);f.age(1001U);REQUIRE_FALSE(units->isUnitReg(RID));
+        }
+    }
+    SECTION("wrong service target flags profile or CRC does not refresh") {
+        Fixture f(true);auto* signal=f.controller->control();auto* units=f.controller->affiliations();
+        REQUIRE(signal->requestMessageUpdate(RID,1U,0U));MessageUpdateTestAccess::clock(*f.controller);f.responses();f.age(43199000U);
+        for(const auto value:{0x1F00FFFFFC002711ULL,0x1C00002717002711ULL,0x9C00FFFFFC002711ULL,0x5C00FFFFFC002711ULL}) {
+            f.signal(0x20U,value);f.responses();REQUIRE(units->unitRegTimer(RID)==43199U);
+        }
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,0x90U));REQUIRE(units->unitRegTimer(RID)==43199U);
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,0U,true));REQUIRE(units->unitRegTimer(RID)==43199U);
+        REQUIRE(signal->messageUpdateState(RID)==MessageState::Awaiting);
+        f.age(1001U);REQUIRE_FALSE(units->isUnitReg(RID));
+    }
