+TEST_CASE("control stop halt reset and failed admission never replay queued messages", "[p25][message-update]") {
+    for(unsigned path=0;path<4U;++path) {
+        Fixture f(true);auto* signal=f.controller->control();REQUIRE(signal->requestMessageUpdate(RID,1U,0U));
+        MessageUpdateTestAccess::clock(*f.controller);
+        if(path==0U){f.controller->setCCRunning(false);f.controller->setCCRunning(true);}
+        if(path==1U){f.controller->setCCHalted(true);f.controller->setCCHalted(false);}
+        if(path==2U)f.controller->reset();
+        if(path==3U)signal->cancelMessageUpdates();
+        REQUIRE(signal->messageUpdateState(RID)==MessageState::Cancelled);REQUIRE(f.responses().empty());
+        MessageUpdateTestAccess::clock(*f.controller);REQUIRE(f.responses().empty());
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL));
+    }
+    Fixture f(true);auto* signal=f.controller->control();
+    REQUIRE_FALSE(signal->requestMessageUpdate(RID,0xFFFFU,1U));
+    MessageUpdateTestAccess::clock(*f.controller);REQUIRE(f.responses().empty());
+    REQUIRE(signal->messageUpdateState(RID)==MessageState::Cancelled);
+}
+TEST_CASE("message first enqueue deadline remains binding across the real queue lock", "[p25][message-update][message-update-deadline]") {
+    Fixture f(true);auto* signal=f.controller->control();auto queue=MessageUpdateTestAccess::holdQueue();
+    auto request=std::async(std::launch::async,[&]{return signal->requestMessageUpdate(RID,7U,750U);});
+    const auto queuedBy=std::chrono::steady_clock::now()+std::chrono::milliseconds(500);
+    while(signal->messageUpdateState(RID)!=MessageState::Queued&&std::chrono::steady_clock::now()<queuedBy)std::this_thread::yield();
+    REQUIRE(signal->messageUpdateState(RID)==MessageState::Queued);
+    std::promise<void> started;auto entered=started.get_future();
+    auto clock=std::async(std::launch::async,[&]{started.set_value();MessageUpdateTestAccess::clock(*f.controller);});entered.wait();
+    const auto ownedBy=std::chrono::steady_clock::now()+std::chrono::milliseconds(250);
+    while(!MessageUpdateTestAccess::messageMutexHeld(*f.controller)&&std::chrono::steady_clock::now()<ownedBy)std::this_thread::yield();
+    const bool blocked=MessageUpdateTestAccess::messageMutexHeld(*f.controller);
+    std::this_thread::sleep_for(std::chrono::milliseconds(800));queue.unlock();clock.get();
+    REQUIRE(blocked);CHECK_FALSE(request.get());CHECK(signal->messageUpdateState(RID)==MessageState::Cancelled);
+    CHECK_FALSE(MessageUpdateTestAccess::ownerActive(*f.controller,RID));CHECK(f.responses().empty());
+}
