--- /dev/null
+++ b/src/host/p25/packet/ControlSignaling.Message.cpp
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Phase 1 local-home FNE-origin short coded message. AABD-B 10.2.2/10.2.4-5
+// (PDF91-93/printed86-88); AABC-E 6.2.10.1 Fig6.2.10-1 (PDF170/printed151),
+// 6.1.1.1 Fig6.1.1-1 (PDF94/printed75), 2.3.25 (PDF38/printed19).
+// One send, 750ms enqueue and 10s response fence are project policy.
+#include "p25/packet/ControlSignaling.h"
+#include "common/p25/lc/tsbk/IOSP_MSG_UPDT.h"
+#include "p25/lookups/P25AffiliationLookup.h"
+#include "common/Log.h"
+using namespace p25;
+using namespace p25::packet;
+using namespace p25::defines;
+namespace {
+bool active(ControlSignaling::MessageUpdateState state) {
+    return state == ControlSignaling::MessageUpdateState::Queued || state == ControlSignaling::MessageUpdateState::Awaiting;
+}
+}
+bool ControlSignaling::requestMessageUpdate(uint32_t target, uint16_t message, uint32_t waitMs) {
+    std::unique_lock<std::mutex> lock(m_messageUpdateMutex);
+    // REST parses the address/code; the protocol owner admits actual operation.
+    if (target == 0U || target >= WUID_FNE) return false;
+    auto old = m_messageUpdates.find(target);
+    if (old != m_messageUpdates.end() && (active(old->second.state) || std::chrono::steady_clock::now() < old->second.deadline)) return false;
+    if (std::count_if(m_messageUpdates.begin(), m_messageUpdates.end(), [](const auto& row) { return active(row.second.state); }) >= 16) return false;
+    if (old == m_messageUpdates.end() && m_messageUpdates.size() >= 128U) {
+        const auto now = std::chrono::steady_clock::now();
+        auto retired = std::find_if(m_messageUpdates.begin(), m_messageUpdates.end(), [&](const auto& row) {
+            return !active(row.second.state) && now >= row.second.deadline;
+        });
+        if (retired == m_messageUpdates.end()) return false;
+        m_messageUpdates.erase(retired);
+    }
+    MessageUpdate request; request.serial = ++m_messageUpdateSerial; request.message = message;
+    request.deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(waitMs ? std::min(waitMs, 750U) : 750U);
+    request.owner = std::make_shared<TxFrameOwner>(target, true, WUID_FNE, target, request.deadline, std::chrono::seconds(10));
+    m_messageUpdates[target] = request;
+    if (waitMs == 0U) return true; // test/mailbox admission only
+    const auto serial = request.serial;
+    m_messageUpdateChanged.wait_until(lock, request.deadline, [&] {
+        auto current = m_messageUpdates.find(target);
+        return current == m_messageUpdates.end() || current->second.serial != serial || current->second.state != MessageUpdateState::Queued;
+    });
+    auto current = m_messageUpdates.find(target);
+    if (current == m_messageUpdates.end() || current->second.serial != serial) return false;
+    if (current->second.state == MessageUpdateState::Queued) {
+        current->second.state = MessageUpdateState::Cancelled; current->second.owner->active.store(false);
+    }
+    return current->second.state == MessageUpdateState::Awaiting || current->second.state == MessageUpdateState::Acknowledged;
+}
+ControlSignaling::MessageUpdateState ControlSignaling::messageUpdateState(uint32_t target) {
+    std::lock_guard<std::mutex> lock(m_messageUpdateMutex); auto found = m_messageUpdates.find(target);
+    return found == m_messageUpdates.end() ? MessageUpdateState::None : found->second.state;
+}
+void ControlSignaling::cancelMessageUpdates() {
+    std::lock_guard<std::mutex> lock(m_messageUpdateMutex);
+    for (auto& row : m_messageUpdates) {
+        if (active(row.second.state)) row.second.state = MessageUpdateState::Cancelled;
+        row.second.owner->active.store(false);
+    }
+    m_messageUpdateChanged.notify_all();
+}
+void ControlSignaling::clockMessageUpdates() {
+    std::lock_guard<std::mutex> lock(m_messageUpdateMutex);
+    for (auto& row : m_messageUpdates) {
+        auto& request = row.second;
+        if (!active(request.state)) continue;
+        if (!request.owner->active.load() || !statusQueryTargetAvailable(row.first)) {
+            request.state = MessageUpdateState::Cancelled; request.owner->active.store(false); continue;
+        }
+        if (std::chrono::steady_clock::now() >= request.deadline) {
+            const bool issued = request.state == MessageUpdateState::Awaiting;
+            request.state = issued ? MessageUpdateState::NoResponse : MessageUpdateState::Cancelled;
+            request.owner->active.store(false);
+            if (issued) LogInfoEx(LOG_HOST, "P25 Message Update, no response, arg = %u, tgt = %u, message = $%04X, attempts = 1", WUID_FNE, row.first, request.message);
+            continue;
+        }
+        if (request.state == MessageUpdateState::Awaiting) continue;
+        lc::tsbk::IOSP_MSG_UPDT update; update.setMFId(MFG_STANDARD);
+        update.setSrcId(WUID_FNE); update.setDstId(row.first); update.setMessage(request.message);
+        if (!writeRF_TSDU_SBF(&update, true, true, true, false, request.owner)) {
+            request.state = MessageUpdateState::Cancelled; request.owner->active.store(false); continue;
+        }
+        request.state = MessageUpdateState::Awaiting;
+        request.deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    }
+    m_messageUpdateChanged.notify_all();
+}
+bool ControlSignaling::acceptMessageUpdateResponse(uint32_t source, uint32_t target, uint8_t mfid, uint8_t service, bool aiv, bool extended) {
+    std::lock_guard<std::mutex> lock(m_messageUpdateMutex); auto found = m_messageUpdates.find(source);
+    if (found == m_messageUpdates.end()) return false;
+    auto& request = found->second;
+    if (request.state != MessageUpdateState::Awaiting || !request.owner->active.load() ||
+        std::chrono::steady_clock::now() >= request.deadline || target != WUID_FNE || service != TSBKO::IOSP_MSG_UPDT ||
+        aiv || extended || (mfid != MFG_STANDARD && mfid != MFG_STANDARD_ALT) || !statusQueryTargetAvailable(source)) return false;
+    request.state = MessageUpdateState::Acknowledged;
+    request.owner->active.store(false); // cancel any undrained message; retain the response fence
+    LogInfoEx(LOG_HOST, "P25 Message Update, acknowledged, arg = %u, tgt = %u, message = $%04X, attempts = 1", WUID_FNE, source, request.message);
+    m_messageUpdateChanged.notify_all();
+    return true;
+}
