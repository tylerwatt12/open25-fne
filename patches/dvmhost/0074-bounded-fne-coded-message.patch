+TEST_CASE("message acknowledgment is a matched issued service outcome with no generic echo", "[p25][message-update]") {
+    for(const uint8_t mfid:{0U,1U}) {
+        Fixture f(true);auto* signal=f.controller->control();
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,mfid));
+        REQUIRE(outcomeLogs("acknowledged")==0U);
+        REQUIRE(signal->requestMessageUpdate(RID,0x1234U,0U));
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,mfid)); // mailbox is not issued
+        MessageUpdateTestAccess::clock(*f.controller);
+        REQUIRE(f.controller->peekFrameLength()>0U); // deliberately undrained message
+        REQUIRE(f.signal(0x20U,0x1C00FFFFFC002711ULL,mfid));
+        REQUIRE(signal->messageUpdateState(RID)==MessageState::Acknowledged);
+        REQUIRE(outcomeLogs("acknowledged")==1U);
+        REQUIRE(diagnosticLog().str().find("P25 Message Update, acknowledged, arg = 16777212, tgt = 10001, message = $1234, attempts = 1")!=std::string::npos);
+        REQUIRE_FALSE(MessageUpdateTestAccess::ownerActive(*f.controller,RID));
+        REQUIRE(f.responses().empty()); // ACK cancels the undrained message
+        REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,mfid));
+        REQUIRE(outcomeLogs("acknowledged")==1U);
+        REQUIRE_FALSE(signal->requestMessageUpdate(RID,8U,0U)); // retain original window fence
+    }
+}
+TEST_CASE("unrelated malformed and expired acknowledgments cannot complete message update", "[p25][message-update]") {
+    Fixture f(true);auto* signal=f.controller->control();
+    REQUIRE(signal->requestMessageUpdate(RID,1U,0U));MessageUpdateTestAccess::clock(*f.controller);f.responses();
+    const std::array<uint64_t,5> wrong{{
+        0x1C00FFFFFC002717ULL, // wrong source
+        0x1C00002717002711ULL, // wrong target
+        0x1F00FFFFFC002711ULL, // another service
+        0x9C00FFFFFC002711ULL, // AIV set: not abbreviated ACK_RSP_U
+        0x5C00FFFFFC002711ULL  // EX set: not abbreviated ACK_RSP_U
+    }};
+    for(const auto value:wrong) {
+        f.signal(0x20U,value);f.responses();
+        REQUIRE(signal->messageUpdateState(RID)==MessageState::Awaiting);
+        REQUIRE(outcomeLogs("acknowledged")==0U);
+    }
+    REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,0x90U));
+    REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL,0U,true));
+    REQUIRE(signal->messageUpdateState(RID)==MessageState::Awaiting);
+    MessageUpdateTestAccess::expire(*f.controller,RID);
+    REQUIRE_FALSE(f.signal(0x20U,0x1C00FFFFFC002711ULL)); // wall fence, no protocol tick
+    REQUIRE(outcomeLogs("acknowledged")==0U);
+    MessageUpdateTestAccess::clock(*f.controller);
+    REQUIRE(signal->messageUpdateState(RID)==MessageState::NoResponse);
+    REQUIRE(outcomeLogs("no response")==1U);
+    MessageUpdateTestAccess::clock(*f.controller);REQUIRE(outcomeLogs("no response")==1U);
+    REQUIRE(f.responses().empty());
+}
