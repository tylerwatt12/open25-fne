+TEST_CASE("emergency ACK failure is diagnostic with zero capacity and denial remains distinct", "[p25][emergency-admission][emergency-ack-queue]") {
+    const uint64_t alarm=0x0102000000000000ULL|(uint64_t(TG)<<24U)|RID;
+    Fixture f(true,0U); auto* units=f.controller->affiliations();
+    f.controller->setDebugVerbose(false,false);
+    f.age(1000U);
+    REQUIRE(f.signal(0x27U,alarm));
+    REQUIRE(acceptedLogs()==1U);
+    REQUIRE(ackQueueFailureLogs()==1U);
+    REQUIRE(f.responses().empty());
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    REQUIRE(units->grantSize()==0U);
+
+    f.groups.addEntry(TG,1U,false);
+    REQUIRE_FALSE(f.signal(0x27U,alarm));
+    REQUIRE(acceptedLogs()==1U);
+    REQUIRE(ackQueueFailureLogs()==1U);
+    REQUIRE(nativeLog().str().find("emergency alarm denial,")!=std::string::npos);
+    REQUIRE(f.responses().empty());
+    REQUIRE(units->unitRegTimer(RID)==1U);
+}
