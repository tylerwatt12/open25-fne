+TEST_CASE("emergency receipt survives a rejected ACK queue and retry can queue the unchanged reply", "[p25][emergency-admission][emergency-ack-queue]") {
+    const uint64_t alarm=0x0102000000000000ULL|(uint64_t(TG)<<24U)|RID;
+    // Exact room for one existing TSDU plus its two-octet queue length.
+    Fixture f(true,P25_TSDU_FRAME_LENGTH_BYTES+4U);
+    auto* units=f.controller->affiliations();
+    f.controller->setDebugVerbose(false,false);
+    nativeLog().str(""); nativeLog().clear();
+    f.age(1000U);
+    REQUIRE(f.signal(0x27U,alarm));
+    REQUIRE(acceptedLogs()==1U);
+    REQUIRE(ackQueueFailureLogs()==0U);
+    REQUIRE(units->unitRegTimer(RID)==0U);
+
+    // Without draining the first reply, this actual receive path must retain
+    // the second observation while reporting only the failed queue admission.
+    f.age(1000U);
+    REQUIRE(f.signal(0x27U,alarm));
+    REQUIRE(acceptedLogs()==2U);
+    REQUIRE(ackQueueFailureLogs()==1U);
+    REQUIRE(nativeLog().str().find("emergency alarm ACK not queued, srcId = 10001, dstId = 1001")!=std::string::npos);
+    REQUIRE(units->unitRegTimer(RID)==1U);
+    REQUIRE(f.controller->getRFState()==RS_RF_LISTENING);
+    REQUIRE(units->grantSize()==0U);
+    REQUIRE_FALSE(units->isGroupAff(RID,TG));
+    auto first=f.responses(); REQUIRE(first.size()==1U);
+
+    // A later SU retry may use the now-free queue. The diagnostic neither
+    // clears the received alarm nor creates a retry, grant or new wire format.
+    REQUIRE(f.signal(0x27U,alarm));
+    REQUIRE(acceptedLogs()==3U);
+    REQUIRE(ackQueueFailureLogs()==1U);
+    REQUIRE(units->unitRegTimer(RID)==0U);
+    auto retried=f.responses(); REQUIRE(retried.size()==1U);
+    REQUIRE(retried[0]==first[0]);
+    if(const char* path=std::getenv("DVM_EMERGENCY_ACK_EXPORT")) {
+        json::object observation;
+        const uint32_t acceptedCount=3U, failureCount=1U;
+        observation["native_log"].set<std::string>(nativeLog().str());
+        observation["accepted_observations"].set<uint32_t>(acceptedCount);
+        observation["ack_queue_failures"].set<uint32_t>(failureCount);
+        observation["first_queued_ack_tsbk_hex"].set<std::string>(hex(first[0].data(),first[0].size()));
+        observation["retry_queued_ack_tsbk_hex"].set<std::string>(hex(retried[0].data(),retried[0].size()));
+        json::value document; document.set<json::object>(observation);
+        std::ofstream output(path,std::ios::trunc); REQUIRE(output.good());
+        output << document.serialize(true) << "\n"; REQUIRE(output.good());
+    }
+}
