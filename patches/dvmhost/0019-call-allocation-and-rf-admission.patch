+
+void Control::recordGrantPriority(uint32_t destination, uint32_t source, bool emergency)
+{
+    auto guard = m_affiliations->lockGrants();
+    const auto epoch = m_affiliations->grantEpoch(destination);
+    const auto channel = m_affiliations->getGrantedCh(destination);
+    if (!m_affiliations->ownsGrant(destination, source, channel, epoch)) return;
+    uint32_t priority = 10U;
+    const auto configured = m_dispatchTalkgroupPriorities.find(destination);
+    if (configured != m_dispatchTalkgroupPriorities.end()) priority = configured->second;
+    const auto previous = m_grantPriorities.find(destination);
+    if (previous != m_grantPriorities.end() && previous->second.epoch == epoch)
+        emergency = emergency || previous->second.emergency;
+    m_grantPriorities[destination] = GrantPriority{source, channel, emergency ? 1U : priority, epoch, emergency};
+}
+
+bool Control::rfSecurityPermitted(uint32_t destination, bool secure, uint32_t key, bool media) const
+{
+    const auto policy = m_rfTalkgroupSecurity.find(destination);
+    if (policy == m_rfTalkgroupSecurity.end()) return true;
+    const auto& value = policy->second;
+    if (value.mode != "clear" && value.mode != "secure" && value.mode != "selectable") return false;
+    if ((value.mode == "clear" && secure) || (value.mode == "secure" && !secure)) return false;
+    return !secure || !media || (value.key != 0U && key == value.key);
+}
+
+// Retire the actual VC permit before reusing a channel. This covers both
+// network and RF-origin grants; no emergency is ever a preemption candidate.
+bool Control::preemptDispatchResource(uint32_t destination)
+{
+    auto guard = m_affiliations->lockGrants();
+    const bool conflicting = m_affiliations->isGranted(destination);
+    uint32_t victim = 0U;
+    GrantPriority allocation;
+    for (const auto& entry : m_grantPriorities) {
+        const auto& current = entry.second;
+        if (current.emergency || (conflicting && entry.first != destination) ||
+            !m_affiliations->ownsGrant(entry.first, current.source, current.channel, current.epoch)) continue;
+        if (victim == 0U || current.priority > allocation.priority ||
+            (current.priority == allocation.priority && entry.first < victim)) {
+            victim = entry.first; allocation = current;
+        }
+    }
+    if (victim == 0U || g_RPC == nullptr) return false;
+    const auto channel = m_affiliations->rfCh()->getRFChData(allocation.channel);
+    const auto token = m_affiliations->grantPermitToken(victim);
+    if (token.empty() || !channel.isValidCh() || channel.address().empty() || channel.port() == 0U) return false;
+    auto cleared = std::make_shared<std::atomic<bool>>(false);
+    json::object clear;
+    const uint32_t none = 0U;
+    clear["dstId"].set<uint32_t>(none); clear["permitToken"].set<std::string>(token);
+    guard.unlock();
+    const bool replied = g_RPC->req(RPC_PERMIT_P25_TG, clear,
+        [cleared, token](json::object& response, json::object&) {
+            cleared->store(response["status"].is<int>() && response["status"].get<int>() == network::NetRPC::OK &&
+                response["dstId"].is<int>() && response["dstId"].get<uint32_t>() == 0U &&
+                response["permitToken"].is<std::string>() && response["permitToken"].get<std::string>() == token);
+        }, channel.address(), channel.port(), true);
+    guard.lock();
+    if (!replied || !cleared->load() || !m_affiliations->ownsGrant(victim, allocation.source, allocation.channel, allocation.epoch)) return false;
+    m_affiliations->releaseGrant(victim, false);
+    std::string leaseId;
+    for (const auto& entry : m_dispatchLeases) {
+        const auto& lease = entry.second.result;
+        if (lease.dstId == victim && lease.srcId == allocation.source && lease.epoch == allocation.epoch) { leaseId = entry.first; break; }
+    }
+    if (!leaseId.empty()) endDispatch(leaseId, "preempted");
+    LogInfoEx(LOG_P25, "emergency preempted ordinary allocation, srcId = %u, dstId = %u, chNo = %u, epoch = %llu", allocation.source, victim, allocation.channel, (unsigned long long)allocation.epoch);
+    return true;
 }
 
