+// SPDX-License-Identifier: GPL-2.0-only
+/* AllStart RF requests wait for Site/Zone approval before an RF grant is
+ * emitted. REST only records decisions; the protocol clock owns allocation. */
+#include "p25/Control.h"
+#include "common/p25/acl/AccessControl.h"
+#include "common/p25/P25Defines.h"
+#include <algorithm>
+#include <iomanip>
+#include <random>
+#include <sstream>
+
+using namespace p25;
+using Clock = std::chrono::steady_clock;
+
+bool Control::queueRFAdmission(uint32_t source, uint32_t destination, uint8_t serviceOptions)
+{
+    if (!m_managedSite || !m_zoneConnected.load() || m_rfAllStartTalkgroups.count(destination) == 0U)
+        return false;
+    auto allocations = m_affiliations->lockGrants();
+    std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+    const auto now = Clock::now();
+    for (const auto& entry : m_rfAdmissions) {
+        const auto& old = entry.second;
+        if (old.srcId != source || old.dstId != destination) continue;
+        if ((old.state == "pending" || old.state == "approved" || old.state == "committing") && now < old.deadline)
+            return true; // one queued transaction for an SU's retry
+        if (old.state == "committed" && m_affiliations->ownsGrant(destination, source, old.channelNo, old.grantEpoch))
+            return false; // reaffirm an existing allocation without a new Zone call
+    }
+    if (m_rfAdmissions.size() >= 256U) {
+        m_control->writeRF_TSDU_Deny(source, destination, defines::ReasonCode::DENY_NO_RF_RSRC_AVAIL, defines::TSBKO::IOSP_GRP_VCH, true, true);
+        return true;
+    }
+    static const uint64_t nonce = (uint64_t(std::random_device{}()) << 32U) | std::random_device{}();
+    static std::atomic<uint64_t> next{0U};
+    RFAdmission request;
+    request.epoch = ++next;
+    std::ostringstream text;
+    text << std::hex << std::setfill('0') << std::setw(16) << nonce << std::setw(16) << request.epoch;
+    request.id = text.str(); request.srcId = source; request.dstId = destination;
+    request.serviceOptions = serviceOptions; request.state = "pending";
+    request.deadline = now + std::chrono::seconds(5);
+    request.retainedUntil = request.deadline + std::chrono::seconds(30);
+    m_rfAdmissions.emplace(request.id, request);
+    m_control->writeRF_TSDU_Queue(source, destination, defines::ReasonCode::QUE_CHN_RESOURCE_NOT_AVAIL, defines::TSBKO::IOSP_GRP_VCH, true, true);
+    return true;
+}
+
+std::vector<RFAdmission> Control::rfAdmissions()
+{
+    std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+    std::vector<RFAdmission> out;
+    out.reserve(m_rfAdmissions.size());
+    for (const auto& entry : m_rfAdmissions) out.push_back(entry.second);
+    return out;
+}
+
+RFAdmission Control::decideRFAdmission(const std::string& id, uint64_t epoch, bool approved)
+{
+    std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+    const auto found = m_rfAdmissions.find(id);
+    if (found == m_rfAdmissions.end() || found->second.epoch != epoch) return RFAdmission();
+    auto& current = found->second;
+    if (!approved) {
+        if (current.state == "pending" || current.state == "approved") { current.state = "rejected"; current.cancel = true; }
+        else if (current.state == "committing" || current.state == "committed") current.cancel = true;
+    } else if (current.state == "pending") {
+        if (Clock::now() >= current.deadline) current.state = "expired";
+        else current.state = "approved";
+    }
+    return current;
+}
+
+void Control::clockRFAdmissions()
+{
+    std::vector<RFAdmission> approved, cancelled, denied;
+    const auto now = Clock::now();
+    {
+        auto allocations = m_affiliations->lockGrants();
+        std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+        for (auto i = m_rfAdmissions.begin(); i != m_rfAdmissions.end();) {
+            auto& current = i->second;
+            if (current.cancel) {
+                cancelled.push_back(current); current.cancel = false;
+                current.state = "rejected"; current.retainedUntil = now + std::chrono::seconds(30);
+            } else if (current.state == "pending" || current.state == "approved") {
+                if (now >= current.deadline || !m_zoneConnected.load()) {
+                    current.state = now >= current.deadline ? "expired" : "rejected";
+                    current.retainedUntil = now + std::chrono::seconds(30); denied.push_back(current);
+                } else if (current.state == "approved") {
+                    current.state = "committing"; approved.push_back(current);
+                }
+            } else if (current.state == "committed") {
+                if (!m_affiliations->ownsGrant(current.dstId, current.srcId, current.channelNo, current.grantEpoch)) {
+                    current.state = "ended"; current.retainedUntil = now + std::chrono::seconds(30);
+                }
+            }
+            if ((current.state == "ended" || current.state == "expired" || current.state == "rejected") && now >= current.retainedUntil) i = m_rfAdmissions.erase(i);
+            else ++i;
+        }
+    }
+    for (const auto& current : cancelled) {
+        auto guard = m_affiliations->lockGrants();
+        if (current.grantEpoch != 0U && m_affiliations->ownsGrant(current.dstId, current.srcId, current.channelNo, current.grantEpoch))
+            m_affiliations->releaseGrant(current.dstId, false);
+        if (current.grantEpoch == 0U) denied.push_back(current);
+    }
+    for (const auto& current : denied)
+        m_control->writeRF_TSDU_Deny(current.srcId, current.dstId, defines::ReasonCode::DENY_NO_RF_RSRC_AVAIL, defines::TSBKO::IOSP_GRP_VCH, true, true);
+    for (const auto& current : approved) {
+        const auto radio = m_ridLookup->find(current.srcId);
+        const auto group = m_tidLookup->find(current.dstId);
+        const auto affiliations = m_affiliations->grpAffTable();
+        const auto membership = affiliations.find(current.srcId);
+        const bool permitted = !radio.radioDefault() && radio.radioEnabled() && !group.isInvalid() && group.config().active() &&
+            acl::AccessControl::validateSrcId(current.srcId) && acl::AccessControl::validateTGId(current.dstId) &&
+            membership != affiliations.end() && membership->second == current.dstId;
+        bool committed = false;
+        const bool granted = permitted && dispatchReady() && m_control->writeRF_TSDU_Grant(current.srcId, current.dstId, current.serviceOptions, true, false, false, 0U, [&] {
+            std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+            auto found = m_rfAdmissions.find(current.id);
+            if (found == m_rfAdmissions.end() || found->second.epoch != current.epoch || found->second.cancel ||
+                found->second.state != "committing" || Clock::now() >= found->second.deadline || !m_zoneConnected.load()) return false;
+            committed = true;
+            return true;
+        });
+        const auto allocation = m_affiliations->lockGrants();
+        std::lock_guard<std::mutex> lock(m_rfAdmissionMutex);
+        auto& result = m_rfAdmissions.at(current.id);
+        result.state = granted && committed ? "committed" : "rejected";
+        result.retainedUntil = Clock::now() + std::chrono::seconds(30);
+        if (granted && committed) {
+            result.channelNo = m_affiliations->getGrantedCh(current.dstId);
+            result.grantEpoch = m_affiliations->grantEpoch(current.dstId);
+        } else {
+            m_control->writeRF_TSDU_Deny(current.srcId, current.dstId, defines::ReasonCode::DENY_NO_RF_RSRC_AVAIL, defines::TSBKO::IOSP_GRP_VCH, true, true);
+        }
+    }
+}
