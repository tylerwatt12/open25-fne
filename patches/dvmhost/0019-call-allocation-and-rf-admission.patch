+namespace {
+json::object admissionPayload(const p25::RFAdmission& admission)
+{
+    json::object out;
+    out["id"].set<std::string>(admission.id); out["epoch"].set<std::string>(std::to_string(admission.epoch));
+    out["srcId"].set<uint32_t>(admission.srcId); out["dstId"].set<uint32_t>(admission.dstId);
+    const bool emergency = (admission.serviceOptions & 0x80U) != 0U, secure = (admission.serviceOptions & 0x40U) != 0U;
+    out["emergency"].set<bool>(emergency);
+    out["secure"].set<bool>(secure);
+    out["state"].set<std::string>(admission.state);
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(admission.deadline - std::chrono::steady_clock::now()).count();
+    const uint32_t expires = uint32_t(std::max<int64_t>(0, remaining));
+    out["expiresMs"].set<uint32_t>(expires);
+    out["grantEpoch"].set<std::string>(std::to_string(admission.grantEpoch));
+    out["channelNo"].set<uint32_t>(admission.channelNo);
+    return out;
+}
+}
+void RESTAPI::restAPI_GetRFAdmissions(const HTTPPayload& request, HTTPPayload& reply, const RequestMatch&)
+{
+    if (!validateAuth(request, reply)) { reply.status = HTTPPayload::UNAUTHORIZED; return; }
+    if (m_p25 == nullptr) { reply = HTTPPayload::statusPayload(HTTPPayload::SERVICE_UNAVAILABLE, "application/json"); return; }
+    json::object out; const int status = 200; out["status"].set<int>(status);
+    json::array pending;
+    for (const auto& admission : m_p25->rfAdmissions()) pending.push_back(json::value(admissionPayload(admission)));
+    out["requests"].set<json::array>(pending);
+    reply.payload(out, HTTPPayload::OK);
+}
+void RESTAPI::restAPI_PutRFAdmission(const HTTPPayload& request, HTTPPayload& reply, const RequestMatch&)
+{
+    if (!validateAuth(request, reply)) { reply.status = HTTPPayload::UNAUTHORIZED; return; }
+    if (m_p25 == nullptr) { reply = HTTPPayload::statusPayload(HTTPPayload::SERVICE_UNAVAILABLE, "application/json"); return; }
+    json::object body;
+    if (!parseRequestBody(request, reply, body)) { reply.status = HTTPPayload::BAD_REQUEST; return; }
+    if (!body["id"].is<std::string>() || !body["epoch"].is<std::string>() || !body["approved"].is<bool>()) {
+        reply = HTTPPayload::statusPayload(HTTPPayload::BAD_REQUEST, "application/json"); return;
+    }
+    const auto id = body["id"].get<std::string>(), epoch = body["epoch"].get<std::string>();
+    if (id.size() != 32U || id.find_first_not_of("0123456789abcdef") != std::string::npos || epoch.empty() || epoch.size() > 20U || epoch.find_first_not_of("0123456789") != std::string::npos) {
+        reply = HTTPPayload::statusPayload(HTTPPayload::BAD_REQUEST, "application/json"); return;
+    }
+    uint64_t number = 0U;
+    try { number = std::stoull(epoch); } catch (const std::exception&) { reply = HTTPPayload::statusPayload(HTTPPayload::BAD_REQUEST, "application/json"); return; }
+    const auto result = m_p25->decideRFAdmission(id, number, body["approved"].get<bool>());
+    auto out = admissionPayload(result);
+    const int status = result.state == "unknown" ? 404 : 200;
+    out["status"].set<int>(status);
+    reply.payload(out, result.state == "unknown" ? HTTPPayload::NOT_FOUND : HTTPPayload::OK);
+}
